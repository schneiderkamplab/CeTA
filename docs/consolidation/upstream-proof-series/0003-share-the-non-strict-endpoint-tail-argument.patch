+lemma SN_rel_min_endpoint_order_lookahead:
+  assumes sn: "SN S"
+    and compat_NS_S: "NS O S \<subseteq> S"
+    and compat_S_NS: "S O NS \<subseteq> S"
+    and trans_NS: "trans NS"
+    and target_SN: "\<And>s t. (s,t) \<in> B \<Longrightarrow> SN_on A {t}"
+    and pair_order: "\<And>s t u v w x. SN_on A {s} \<Longrightarrow>
+      (s,t) \<in> B \<Longrightarrow> (t,u) \<in> A\<^sup>* \<Longrightarrow> (u,v) \<in> B \<Longrightarrow>
+      (v,w) \<in> A\<^sup>* \<Longrightarrow> (w,x) \<in> B \<Longrightarrow>
+      (s,t) \<in> S \<union> NS"
+    and pair_residual: "\<And>s t u v w x. SN_on A {s} \<Longrightarrow>
+      (s,t) \<in> B \<Longrightarrow> (t,u) \<in> A\<^sup>* \<Longrightarrow> (u,v) \<in> B \<Longrightarrow>
+      (v,w) \<in> A\<^sup>* \<Longrightarrow> (w,x) \<in> B \<Longrightarrow>
+      (s,t) \<notin> S \<Longrightarrow> (s,t) \<in> C"
+    and steps_order: "\<And>p s t u v w. SN_on A {s} \<Longrightarrow>
+      (p,s) \<in> B \<Longrightarrow> (s,t) \<in> A\<^sup>* \<Longrightarrow> (t,u) \<in> B \<Longrightarrow>
+      (u,v) \<in> A\<^sup>* \<Longrightarrow> (v,w) \<in> B \<Longrightarrow> (s,t) \<in> NS"
+    and fin: "SN_rel C A"
+  shows "SN_rel B A"
+proof (rule ccontr)
+  assume not_fin: "\<not> SN_rel B A"
+  obtain a b where pair: "\<And>i. (a i,b i) \<in> B"
+    and between: "\<And>i. (b i,a (Suc i)) \<in> A\<^sup>*"
+    and a_sn: "\<And>i. SN_on A {a i}"
+    and not_strict: "\<And>i. (a i,b i) \<notin> S"
+  proof (rule not_SN_rel_min_endpoint_tail[where S=S and NS=NS and A=A and B=B,
+      OF sn compat_NS_S compat_S_NS trans_NS target_SN pair_order steps_order not_fin])
+    fix a b
+    assume pair: "\<And>i. (a i,b i) \<in> B"
+      and between: "\<And>i. (b i,a (Suc i)) \<in> A\<^sup>*"
+      and a_sn: "\<And>i. SN_on A {a i}"
+      and not_strict: "\<And>i. (a i,b i) \<notin> S"
+    show thesis by (rule that[of a b, OF pair between a_sn not_strict])
+  qed
+  have residual: "(a i,b i) \<in> C" for i
+    by (rule pair_residual[OF a_sn pair between pair between pair not_strict])
+  have residual_chain: "chain (A\<^sup>* O C O A\<^sup>*) a"
+    using residual between by auto
+  have "\<not> SN_on (A\<^sup>* O C O A\<^sup>*) UNIV"
     by (rule not_SN_onI[OF _ residual_chain], simp)
-  ultimately show False by contradiction
+  with fin show False unfolding SN_rel_on_def by contradiction
 qed
 
