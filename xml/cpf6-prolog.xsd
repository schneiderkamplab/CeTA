<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:annotation>
    <xs:documentation>Prolog source certificates. Schema validity is not certification.</xs:documentation>
  </xs:annotation>
  <xs:element name="prologInput">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="executionProfile" type="xs:string"/>
        <xs:element name="program" type="lp6CutProgram"/>
        <xs:element name="query" type="lp6CutQuery"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="lp6PrologSignature">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="arity" type="xs:nonNegativeInteger"/>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="prologStaticSEGProof">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="predicates">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="signature" type="lp6PrologSignature" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element ref="certificationProblem"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="prologStaticNonterminationProof">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="predicates">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="signature" type="lp6PrologSignature" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element ref="certificationProblem"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="prologStaticUniformRecursionProof">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="predicates">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="signature" type="lp6PrologSignature" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element ref="certificationProblem"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="prologUndefinedQueryProof">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="definitions">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="signature" type="lp6PrologSignature" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:group name="lp6PrologReturnAction">
    <xs:choice>
      <xs:element name="cut">
        <xs:complexType>
          <xs:sequence>
            <xs:group ref="lp6CutReturnAction"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="variableTest">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="predicate" type="xs:string"/>
            <xs:group ref="lp6CutTerm"/>
            <xs:element name="goals">
              <xs:complexType>
                <xs:sequence>
                  <xs:group ref="lp6CutGoal" minOccurs="0" maxOccurs="unbounded"/>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="active">
              <xs:complexType>
                <xs:sequence>
                  <xs:group ref="lp6CutTerm" minOccurs="0" maxOccurs="unbounded"/>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="returnState" type="lp6CutReturnState"/>
            <xs:element name="link" type="lp6CutLink"/>
            <xs:element name="link" type="lp6CutLink"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="identityTest">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="predicate" type="xs:string"/>
            <xs:group ref="lp6CutTerm"/>
            <xs:group ref="lp6CutTerm"/>
            <xs:element name="goals">
              <xs:complexType>
                <xs:sequence>
                  <xs:group ref="lp6CutGoal" minOccurs="0" maxOccurs="unbounded"/>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="active">
              <xs:complexType>
                <xs:sequence>
                  <xs:group ref="lp6CutTerm" minOccurs="0" maxOccurs="unbounded"/>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="returnState" type="lp6CutReturnState"/>
            <xs:element name="link" type="lp6CutLink"/>
            <xs:element name="link" type="lp6CutLink"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:choice>
  </xs:group>
  <xs:element name="prologVarReturnDependencyTriplesProof">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="fuel" type="xs:nonNegativeInteger"/>
        <xs:element name="root" type="xs:nonNegativeInteger"/>
        <xs:element name="nodes">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="node" type="lp6CutNode" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="returnStates">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="returnState" type="lp6CutReturnState" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="returnSymbol">
          <xs:complexType>
            <xs:sequence>
              <xs:group ref="lp6CutSymbol"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="returnArity" type="xs:nonNegativeInteger"/>
        <xs:element name="actions">
          <xs:complexType>
            <xs:sequence>
              <xs:group ref="lp6PrologReturnAction" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="residual">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="clause" type="lp6CutResidualClause" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="predicateEncoding">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="encoding" type="lp6CutEncoding" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="dataEncoding">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="encoding" type="lp6CutEncoding" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element ref="certificationProblem"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:group name="lp6PrologReturnModuleAction">
    <xs:choice>
      <xs:group ref="lp6PrologReturnAction"/>
      <xs:element name="trimBarriers">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="returnState" type="lp6CutReturnState"/>
            <xs:element name="returnState" type="lp6CutReturnState"/>
            <xs:element name="link" type="lp6CutLink"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="parallelAlternatives">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="links">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="link" type="lp6CutLink" minOccurs="0" maxOccurs="unbounded"/>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="refutedGuard">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="index" type="xs:nonNegativeInteger"/>
            <xs:element name="prefix" type="xs:nonNegativeInteger"/>
            <xs:element name="bindings">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="binding" type="lp6CutBinding" minOccurs="0" maxOccurs="unbounded"/>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:choice>
  </xs:group>
  <xs:element name="prologModularReturnDependencyTriplesProof">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="fuel" type="xs:nonNegativeInteger"/>
        <xs:element name="root" type="xs:nonNegativeInteger"/>
        <xs:element name="nodes">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="node" type="lp6CutNode" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="returnStates">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="returnState" type="lp6CutReturnState" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="returnSymbol">
          <xs:complexType>
            <xs:sequence>
              <xs:group ref="lp6CutSymbol"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="returnArity" type="xs:nonNegativeInteger"/>
        <xs:element name="actions">
          <xs:complexType>
            <xs:sequence>
              <xs:group ref="lp6PrologReturnModuleAction" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="residual">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="clause" type="lp6CutResidualClause" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="predicateEncoding">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="encoding" type="lp6CutEncoding" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="dataEncoding">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="encoding" type="lp6CutEncoding" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element ref="certificationProblem"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:group name="lp6PrologNoAction">
    <xs:choice>
      <xs:element name="ordinary">
        <xs:complexType>
          <xs:sequence>
            <xs:group ref="lp6CutNoAction"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="test" type="lp6CutEmpty"/>
    </xs:choice>
  </xs:group>
  <xs:complexType name="lp6PrologNoTrace">
    <xs:sequence>
      <xs:element name="step" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:sequence>
            <xs:group ref="lp6PrologNoAction"/>
            <xs:element name="state">
              <xs:complexType>
                <xs:sequence>
                  <xs:group ref="lp6CutEntry" minOccurs="0" maxOccurs="unbounded"/>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="prologTestSourceNonterminationProof">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="predicates">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="signature" type="lp6PrologSignature" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="fuel" type="xs:nonNegativeInteger"/>
        <xs:element name="arguments">
          <xs:complexType>
            <xs:sequence>
              <xs:group ref="lp6CutTerm" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="core">
          <xs:complexType>
            <xs:sequence>
              <xs:group ref="lp6CutTerm"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="before">
          <xs:complexType>
            <xs:sequence>
              <xs:group ref="lp6CutEntry" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="after">
          <xs:complexType>
            <xs:sequence>
              <xs:group ref="lp6CutEntry" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="prefix" type="lp6PrologNoTrace"/>
        <xs:element name="loop" type="lp6CutNoTrace"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:group name="lp6RationalGoal">
    <xs:choice>
      <xs:element name="atom">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="ref" type="xs:nonNegativeInteger"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="meta">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="ref" type="xs:nonNegativeInteger"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="unify">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="ref" type="xs:nonNegativeInteger" minOccurs="2" maxOccurs="2"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="cut" type="xs:nonNegativeInteger"/>
      <xs:element name="true" type="lp6CutEmpty"/>
      <xs:element name="fail" type="lp6CutEmpty"/>
    </xs:choice>
  </xs:group>
  <xs:group name="lp6RationalEntry">
    <xs:choice>
      <xs:element name="goals">
        <xs:complexType>
          <xs:sequence>
            <xs:group ref="lp6RationalGoal" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="clauseChoice">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="goals">
              <xs:complexType>
                <xs:sequence>
                  <xs:group ref="lp6RationalGoal" minOccurs="0" maxOccurs="unbounded"/>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="index" type="xs:nonNegativeInteger"/>
            <xs:element name="scope" type="xs:nonNegativeInteger"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="barrier" type="xs:nonNegativeInteger"/>
    </xs:choice>
  </xs:group>
  <xs:group name="lp6RationalClash">
    <xs:choice>
      <xs:element name="constructorClash">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="index" type="xs:nonNegativeInteger" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="repeatedVariableClash">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="left">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="index" type="xs:nonNegativeInteger" minOccurs="0" maxOccurs="unbounded"/>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="right">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="index" type="xs:nonNegativeInteger" minOccurs="0" maxOccurs="unbounded"/>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:choice>
  </xs:group>
  <xs:group name="lp6RationalAction">
    <xs:choice>
      <xs:element name="admin" type="lp6CutEmpty"/>
      <xs:element name="case">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="scope" type="xs:nonNegativeInteger"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="resolve">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="environment">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="binding" minOccurs="0" maxOccurs="unbounded">
                    <xs:complexType>
                      <xs:sequence>
                        <xs:element name="var" type="xs:string"/>
                        <xs:element name="ref" type="xs:nonNegativeInteger"/>
                      </xs:sequence>
                    </xs:complexType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="body">
              <xs:complexType>
                <xs:sequence>
                  <xs:group ref="lp6RationalGoal" minOccurs="0" maxOccurs="unbounded"/>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="backtrack">
        <xs:complexType>
          <xs:sequence>
            <xs:group ref="lp6RationalClash"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:choice>
  </xs:group>
  <xs:element name="prologRationalSourceNonterminationProof">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="predicates">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="signature" type="lp6PrologSignature" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="fuel" type="xs:nonNegativeInteger"/>
        <xs:element name="arguments">
          <xs:complexType>
            <xs:sequence>
              <xs:group ref="lp6CutTerm" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="graph">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="node" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:group ref="lp6CutSymbol"/>
                    <xs:element name="children">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="ref" type="xs:nonNegativeInteger" minOccurs="0" maxOccurs="unbounded"/>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="anchors">
          <xs:complexType>
            <xs:sequence>
              <xs:group ref="lp6CutTerm" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="variable" type="xs:string"/>
        <xs:element name="rhs">
          <xs:complexType>
            <xs:sequence>
              <xs:group ref="lp6CutTerm"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="bindingRoot" type="xs:nonNegativeInteger"/>
        <xs:element name="call">
          <xs:complexType>
            <xs:sequence>
              <xs:group ref="lp6CutTerm"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="callRoot" type="xs:nonNegativeInteger"/>
        <xs:element name="before">
          <xs:complexType>
            <xs:sequence>
              <xs:group ref="lp6CutEntry" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="after">
          <xs:complexType>
            <xs:sequence>
              <xs:group ref="lp6RationalEntry" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="prefix" type="lp6CutNoTrace"/>
        <xs:element name="loop">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="step" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:group ref="lp6RationalAction"/>
                    <xs:element name="state">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:group ref="lp6RationalEntry" minOccurs="0" maxOccurs="unbounded"/>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:group name="lp6IntegerNoAction">
    <xs:choice>
      <xs:group ref="lp6PrologNoAction"/>
      <xs:element name="integerIdentity">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="integer" type="xs:integer"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:choice>
  </xs:group>
  <xs:complexType name="lp6IntegerNoTrace">
    <xs:sequence>
      <xs:element name="step" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:sequence>
            <xs:group ref="lp6IntegerNoAction"/>
            <xs:element name="state">
              <xs:complexType>
                <xs:sequence>
                  <xs:group ref="lp6CutEntry" minOccurs="0" maxOccurs="unbounded"/>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="prologIntegerSourceNonterminationProof">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="fuel" type="xs:nonNegativeInteger"/>
        <xs:element name="arguments">
          <xs:complexType>
            <xs:sequence>
              <xs:group ref="lp6CutTerm" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="core">
          <xs:complexType>
            <xs:sequence>
              <xs:group ref="lp6CutTerm"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="before">
          <xs:complexType>
            <xs:sequence>
              <xs:group ref="lp6CutEntry" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="after">
          <xs:complexType>
            <xs:sequence>
              <xs:group ref="lp6CutEntry" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="prefix" type="lp6IntegerNoTrace"/>
        <xs:element name="loop" type="lp6IntegerNoTrace"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:group name="lp6IntegerExpression">
    <xs:choice>
      <xs:element name="integer" type="xs:integer"/>
      <xs:element name="var" type="xs:string"/>
      <xs:element name="positive">
        <xs:complexType>
          <xs:sequence>
            <xs:group ref="lp6IntegerExpression"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="negate">
        <xs:complexType>
          <xs:sequence>
            <xs:group ref="lp6IntegerExpression"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="add">
        <xs:complexType>
          <xs:sequence>
            <xs:group ref="lp6IntegerExpression" minOccurs="2" maxOccurs="2"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="subtract">
        <xs:complexType>
          <xs:sequence>
            <xs:group ref="lp6IntegerExpression" minOccurs="2" maxOccurs="2"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="multiply">
        <xs:complexType>
          <xs:sequence>
            <xs:group ref="lp6IntegerExpression" minOccurs="2" maxOccurs="2"/>
          </xs:sequence>
        </xs:complexType>
