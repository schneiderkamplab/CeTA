context ren_wf_trs
begin
sublocale R:left_lin_no_var_lhs R ..
sublocale S:left_lin_no_var_lhs S ..

definition alt_cond where "alt_cond \<tau> rdp_A l \<beta> q A B As renamed_lhs_\<alpha>s = 
  (A \<in> wf_pterm R \<and> B \<in> wf_pterm S \<and> 
    redex_patterns A = rdp_A \<and> redex_patterns B = [(\<beta>, q)] \<and> 
    renamed_lhs_\<alpha>s = rename_list (map (\<lambda>(\<alpha>, p). lhs \<alpha>) rdp_A) \<and>      
    (q = [] \<or> snd (hd rdp_A) = []) \<and>     
    l = replace_at (hd renamed_lhs_\<alpha>s) q (map_vars_term (ren_l ren) (lhs \<beta>)) \<and>
    mgu_list (map2 (\<lambda> lhs_\<alpha> p. (lhs_\<alpha>, l|_p)) renamed_lhs_\<alpha>s (map snd rdp_A)) = Some \<tau> \<and> 
    join_list As = Some A 
    \<and> As = map2 (\<lambda>(\<alpha>i, pi) i. (ctxt_of_pos_term pi (to_pterm (l \<cdot> \<tau>)))\<langle>Prule \<alpha>i (map (to_pterm \<circ> \<tau> \<circ> rename_many' ren i) (vars_term_list (lhs \<alpha>i)))\<rangle>)
          rdp_A [0..<length rdp_A]
    \<and> B = replace_at (to_pterm (l \<cdot> \<tau>)) q (Prule \<beta> (map (to_pterm \<circ> \<tau> \<circ> ren_l ren) (vars_term_list (lhs \<beta>))))
    \<and> (\<forall> (\<alpha>,p) \<in> set rdp_A. (@) p ` fun_poss (lhs \<alpha>) \<inter> (@) q ` fun_poss (lhs \<beta>) \<noteq> {})
    \<and> (\<forall> (\<alpha>,p) \<in> set rdp_A. to_rule \<alpha> \<in> R)
    \<and> to_rule \<beta> \<in> S
    \<and> rdp_A \<noteq> [])" 

lemma sim_cp_alt_def:
  "sim_cp = { (A, B) | \<tau> rdp_A l \<beta> q A B As renamed_lhs_\<alpha>s. 
    alt_cond \<tau> rdp_A l \<beta> q A B As renamed_lhs_\<alpha>s}" (is "_ = ?RHS")
proof -
  have "sim_cp = { (A, B) | \<tau> rdp_A l \<beta> q A B As renamed_lhs_\<alpha>s. 
    A \<in> wf_pterm R \<and> B \<in> wf_pterm S \<and> 
    redex_patterns A = rdp_A \<and> redex_patterns B = [(\<beta>, q)] \<and> 
    renamed_lhs_\<alpha>s = rename_list (map (\<lambda>(\<alpha>, p). lhs \<alpha>) rdp_A) \<and>
    (q = [] \<or> snd (hd rdp_A) = []) \<and>     
    l = replace_at (hd renamed_lhs_\<alpha>s) q (map_vars_term (ren_l ren) (lhs \<beta>)) \<and>
    mgu_list (map2 (\<lambda> lhs_\<alpha> p. (lhs_\<alpha>, l|_p)) renamed_lhs_\<alpha>s (map snd rdp_A)) = Some \<tau> \<and> 
    join_list As = Some A \<and>
    As = map2 (\<lambda>(\<alpha>i, pi) i. (ctxt_of_pos_term pi (to_pterm (l \<cdot> \<tau>)))\<langle>Prule \<alpha>i (map (to_pterm \<circ> \<tau> \<circ> rename_many' ren i) (var_rule \<alpha>i))\<rangle>)
          rdp_A [0..<length rdp_A] \<and>
    B = replace_at (to_pterm (l \<cdot> \<tau>)) q (Prule \<beta> (map (to_pterm \<circ> \<tau> \<circ> ren_l ren) (var_rule \<beta>))) \<and>
    get_overlapping_part A B = Some A \<and> True}" 
    unfolding sim_cp_def map_map by blast
  also have "\<dots> = ?RHS" unfolding alt_cond_def
  proof (intro Collect_cong ex_cong1 conj_cong refl)
    fix \<tau> rdp_A l \<beta> q A B As renamed_lhs_\<alpha>s
    assume A: "A \<in> wf_pterm R" and B: "B \<in> wf_pterm S" and rdp_A: "redex_patterns A = rdp_A" 
      and rdp_B: "redex_patterns B = [(\<beta>, q)]" 
      and join: "join_list As = Some A" 
    have \<beta>: "to_rule \<beta> \<in> S" using B rdp_B S.redex_pattern_rule_symbol by simp
    from join have Asne: "As \<noteq> []" by auto
    show "(As =
        map2
         (\<lambda>x. case x of
               (\<alpha>i, pi) \<Rightarrow>
                 \<lambda>i. (ctxt_of_pos_term pi
                        (to_pterm
                          (l \<cdot> \<tau>)))\<langle>Prule \<alpha>i (map (to_pterm \<circ> \<tau> \<circ> rename_many' ren i) (var_rule \<alpha>i))\<rangle>)
         rdp_A [0..<length rdp_A]) =
       (As =
        map2
         (\<lambda>x. case x of
               (\<alpha>i, pi) \<Rightarrow>
                 \<lambda>i. (ctxt_of_pos_term pi
                        (to_pterm
                          (l \<cdot> \<tau>)))\<langle>Prule \<alpha>i
                                    (map (to_pterm \<circ> \<tau> \<circ> rename_many' ren i) (vars_term_list (lhs \<alpha>i)))\<rangle>)
         rdp_A [0..<length rdp_A])" 
      (is "_ = ?Aseq")
      apply (intro arg_cong[of _ _ "(=) _"])
      apply (intro map_cong refl prod.case_cong)
      subgoal for pair x y 
        apply (rule fun_cong[of _ _ y], intro prod.case_cong ext refl)
        subgoal for \<alpha> p
          apply (subst R.vars_rule_vars_lhs)
          subgoal using rdp_A A
            by (meson in_set_zipE R.redex_pattern_rule_symbol)
          subgoal by auto
          done
        done
      done  
    show "(B =
        (ctxt_of_pos_term q
          (to_pterm (l \<cdot> \<tau>)))\<langle>Prule \<beta> (map (to_pterm \<circ> \<tau> \<circ> rename_single ren) (var_rule \<beta>))\<rangle>) =
       (B =
        (ctxt_of_pos_term q
          (to_pterm (l \<cdot> \<tau>)))\<langle>Prule \<beta> (map (to_pterm \<circ> \<tau> \<circ> rename_single ren) (vars_term_list (lhs \<beta>)))\<rangle>)" 
      by (subst S.vars_rule_vars_lhs[OF \<beta>]) simp

    from rdp_B B have q: "q \<in> poss (source B)" 
      using S.redex_patterns_label by fastforce

    from R.redex_patterns_label[OF A] 
    have p: "(\<alpha>,p) \<in> set (redex_patterns A) \<Longrightarrow> p \<in> poss (source A)" for \<alpha> p
      by auto
    assume ?Aseq
    with Asne have rdp_ne: "rdp_A \<noteq> []" by auto
    with rdp_A A have "\<not> is_empty_step A" 
      by (metis redex_patterns_to_pterm source_empty_step)
    from R.get_overlap_cond_alt[OF A this]
    have "get_overlapping_part A B = Some A \<longleftrightarrow> (\<forall>A'\<in>set (single_steps A). possL A' \<inter> possL B \<noteq> {})" .
    also have "\<dots> = (\<forall> (\<alpha>,p) \<in> set rdp_A. (@) p ` fun_poss (lhs \<alpha>) \<inter> possL B \<noteq> {})" 
      using R.single_redex_possL[OF R.redex_pattern_rule_symbol[OF A] p]
      unfolding rdp_A by fastforce      
    also have "possL B = possL (ll_single_redex (source B) q \<beta>)" 
      using B rdp_B S.single_steps_singleton by fastforce
    also have "\<dots> = (@) q ` fun_poss (lhs \<beta>)" 
      by (subst S.single_redex_possL[OF \<beta> q], auto)
    finally show "(get_overlapping_part A B = Some A) =
      (\<forall> (\<alpha>,p) \<in> set rdp_A. (@) p ` fun_poss (lhs \<alpha>) \<inter> (@) q ` fun_poss (lhs \<beta>) \<noteq> {})" 
      by auto  
    show "True = ((\<forall>(\<alpha>, p)\<in>set rdp_A. to_rule \<alpha> \<in> R) \<and> to_rule \<beta> \<in> S \<and> rdp_A \<noteq> [])" 
      using \<beta> rdp_ne A rdp_A R.redex_pattern_rule_symbol[OF A] by auto
  qed 
  finally show ?thesis .
qed



definition sim_cp_root where "sim_cp_root = { (A, B) | \<tau> rdp_A l \<beta> A B As renamed_lhs_\<alpha>s. 
    alt_cond \<tau> rdp_A l \<beta> [] A B As renamed_lhs_\<alpha>s}" 

definition sim_cp_non_root where "sim_cp_non_root = { (A, B) | \<tau> rdp_A l \<beta> q A B As renamed_lhs_\<alpha>s. 
    alt_cond \<tau> rdp_A l \<beta> q A B As renamed_lhs_\<alpha>s \<and> q \<noteq> []}" 

lemma sim_cp_split: "sim_cp = sim_cp_root \<union> sim_cp_non_root" 
  unfolding sim_cp_alt_def sim_cp_root_def sim_cp_non_root_def by blast
    

lemma sim_cp_root_many_conds: "sim_cp_root = { (A, B) | \<tau> rdp_A l \<beta> A B As renamed_lhs_\<alpha>s. 
    alt_cond \<tau> rdp_A l \<beta> [] A B As renamed_lhs_\<alpha>s \<and> 
    (\<forall> (\<alpha>,p) \<in> set rdp_A. to_rule \<alpha> \<in> R \<and> p \<in> fun_poss (lhs \<beta>) 
      \<and> mgu_vd_list ren [(lhs \<beta>|_p, lhs \<alpha>)] \<noteq> None)}" (is "_ = ?Many")
proof
  show "?Many \<subseteq> sim_cp_root" unfolding sim_cp_root_def by blast
  show "sim_cp_root \<subseteq> ?Many" unfolding sim_cp_root_def
  proof (intro Collect_mono ex_mono, intro impI, elim conjE, goal_cases)
    case (1 pair \<tau> rdp_A l \<beta> A B As renamed_lhs_\<alpha>s)
    from \<open>alt_cond \<tau> rdp_A l \<beta> [] A B As renamed_lhs_\<alpha>s\<close>[unfolded alt_cond_def]
    have A: "A \<in> wf_pterm R" and B: "B \<in> wf_pterm S" 
     and rdp_A: "redex_patterns A = rdp_A" 
     and rdp_B: "redex_patterns B = [(\<beta>, [])]" 
     and l_def: "l = map_vars_term (rename_single ren) (lhs \<beta>)" 
     and unif: "mgu_list (map2 (\<lambda>x y. (x, l |_ y)) (rename_list (map (\<lambda>(\<alpha>, p). lhs \<alpha>) rdp_A)) (map snd rdp_A)) = Some \<tau>" 
     and rdp_cond: "(\<forall>(\<alpha>, p)\<in>set rdp_A. to_rule \<alpha> \<in> R \<and> (@) p ` fun_poss (lhs \<alpha>) \<inter> fun_poss (lhs \<beta>) \<noteq> {})" 
     and \<beta>: "to_rule \<beta> \<in> S" 
      by auto
    show ?case
    proof (intro conjI; (fact)?)
      {
        fix \<alpha> p
        assume mem: "(\<alpha>,p) \<in> set rdp_A" 
        with rdp_cond have rule: "to_rule \<alpha> \<in> R" and p: "(@) p ` fun_poss (lhs \<alpha>) \<inter> fun_poss (lhs \<beta>) \<noteq> {}"
          by auto
        from p have p: "p \<in> fun_poss (lhs \<beta>)" 
          using fun_poss_append_poss' by fastforce
        hence p': "p \<in> poss (lhs \<beta>)" using fun_poss_imp_poss by blast

        from mem obtain i where i: "i < length rdp_A" and rdp_A: "rdp_A ! i = (\<alpha>,p)" unfolding set_conv_nth by auto
        define list where "list = map2 (\<lambda>x y. (x, l |_ y)) (rename_list (map (\<lambda>(\<alpha>, p). lhs \<alpha>) rdp_A)) (map snd rdp_A)" 
        have len: "length list = length rdp_A" unfolding list_def by (auto simp: rename_list_def)
        from mgu_list_Some[OF unif(1), folded list_def, unfolded is_imgu_def unifiers_def]
        have unif: "\<And> pair. pair \<in> set list \<Longrightarrow> fst pair \<cdot> \<tau> = snd pair \<cdot> \<tau>" by auto
        have "(map_vars_term (rename_many' ren i) (lhs \<alpha>), l |_ p) = list ! i"  
          unfolding list_def rename_list_def using i rdp_A by auto
        also have "\<dots> \<in> set list" using i len by auto
        finally have "map_vars_term (rename_many' ren i) (lhs \<alpha>) \<cdot> \<tau> = l |_ p \<cdot> \<tau>" 
          using unif by auto
        also have "l |_ p = map_vars_term (rename_single ren) (lhs \<beta>) |_ p" 
          unfolding l_def by simp
        also have "\<dots> = map_vars_term (rename_single ren) (lhs \<beta> |_ p)" using p' by simp
        finally obtain \<sigma> \<delta> :: "('b,'a)subst" where "lhs \<beta> |_ p \<cdot> \<delta> = lhs \<alpha> \<cdot> \<sigma>" 
          unfolding map_vars_term_eq subst_subst by metis 
        hence mgu: "mgu_vd_list ren [(lhs \<beta>|_p, lhs \<alpha>)] \<noteq> None" 
          using mgu_vd_list_complete[of "[(lhs \<beta>|_p, lhs \<alpha>)]" "\<lambda> _. \<delta>" \<sigma> ren] by auto

        note p mgu rule
      }
      thus "\<forall>(\<alpha>, p)\<in>set rdp_A. to_rule \<alpha> \<in> R \<and> p \<in> fun_poss (lhs \<beta>) \<and> mgu_vd_list ren [(lhs \<beta> |_ p, lhs \<alpha>)] \<noteq> None" 
        by auto
    qed
  qed
qed


lemma sim_cp_non_root_many_conds: "sim_cp_non_root = { (A, B) | \<tau> rdp_A l \<beta> q A B As renamed_lhs_\<alpha>s. 
    alt_cond \<tau> rdp_A l \<beta> q A B As renamed_lhs_\<alpha>s \<and> q \<noteq> [] \<and>
    (\<exists> \<alpha> rdpA Bs. A = Prule \<alpha> Bs \<and> rdp_A = (\<alpha>,[]) # rdpA \<and> to_rule \<alpha> \<in> R \<and> q \<in> fun_poss (lhs \<alpha>) \<and> mgu_vd_list ren [(lhs \<beta>, lhs \<alpha> |_q)] \<noteq> None
       \<and> (\<forall> (\<alpha>',p) \<in> set rdpA. to_rule \<alpha>' \<in> R \<and> p \<in> (@) q ` fun_poss (lhs \<beta>) \<and> mgu_vd_list ren [(lhs \<beta> |_ (p -\<^sub>p q), lhs \<alpha>')] \<noteq> None))}" (is "_ = ?Many")
proof
  show "?Many \<subseteq> sim_cp_non_root" unfolding sim_cp_non_root_def by blast
  show "sim_cp_non_root \<subseteq> ?Many" unfolding sim_cp_non_root_def
  proof (intro Collect_mono ex_mono, intro impI, elim conjE, goal_cases)
    case (1 pair \<tau> rdp_A l \<beta> q A B As renamed_lhs_\<alpha>s)
    from \<open>alt_cond \<tau> rdp_A l \<beta> q A B As renamed_lhs_\<alpha>s\<close>[unfolded alt_cond_def] \<open>q \<noteq> []\<close>
    have A: "A \<in> wf_pterm R" and B: "B \<in> wf_pterm S" 
     and rdp_A: "redex_patterns A = rdp_A" 
     and rdp_B: "redex_patterns B = [(\<beta>, q)]" 
     and renl: "renamed_lhs_\<alpha>s = rename_list (map (\<lambda>(\<alpha>, p). lhs \<alpha>) rdp_A)" 
     and l_def: "l = (ctxt_of_pos_term q (hd renamed_lhs_\<alpha>s))\<langle>map_vars_term (rename_single ren) (lhs \<beta>)\<rangle>" 
     and unif: "mgu_list (map2 (\<lambda>x y. (x, l |_ y)) (rename_list (map (\<lambda>(\<alpha>, p). lhs \<alpha>) rdp_A)) (map snd rdp_A)) = Some \<tau>" 
     and rdp_cond: "\<And> \<alpha> p. (\<alpha>, p)\<in>set rdp_A \<Longrightarrow> to_rule \<alpha> \<in> R \<and> (@) p ` fun_poss (lhs \<alpha>) \<inter> (@) q ` fun_poss (lhs \<beta>) \<noteq> {}" 
     and \<beta>: "to_rule \<beta> \<in> S" 
     and ne: "rdp_A \<noteq> []" 
     and root: "snd (hd rdp_A) = []" 
      by auto
    from ne root obtain \<alpha> rdpA where split: "rdp_A = (\<alpha>,[]) # rdpA" by (cases rdp_A, auto)
    from split have \<alpha>mem: "(\<alpha>,[]) \<in> set rdp_A" by auto
    from rdp_cond[OF this]
    have \<alpha>: "to_rule \<alpha> \<in> R" and q: "q \<in> fun_poss (lhs \<alpha>)" by (auto simp: fun_poss_append_poss')
    define list where "list = map2 (\<lambda>x y. (x, l |_ y)) (rename_list (map (\<lambda>(\<alpha>, p). lhs \<alpha>) rdp_A)) (map snd rdp_A)" 
    have len: "length list = length rdp_A" unfolding list_def by (auto simp: rename_list_def)
    obtain other where [simp]: "[0..<length rdpA] @ [length rdpA] = 0 # other"
      by (metis gr0_conv_Suc less_eq_nat.simps(1) upt_Suc_append upt_conv_Cons)
    note q' = fun_poss_imp_poss[OF q]
    from mgu_list_Some[OF unif(1), folded list_def, unfolded is_imgu_def unifiers_def]
    have unif: "\<And> pair. pair \<in> set list \<Longrightarrow> fst pair \<cdot> \<tau> = snd pair \<cdot> \<tau>" by auto
    define \<sigma> :: "('b,'a)subst" where "\<sigma> = Var o rename_many' ren 0" 
    define \<delta> :: "('b,'a)subst" where "\<delta> = Var o rename_single ren" 
    have "(lhs \<alpha> \<cdot> \<sigma>, l) \<in> set list" 
      unfolding list_def split by (simp add: rename_list_def map_vars_term_eq \<sigma>_def)
    from unif[OF this]
    have "lhs \<alpha> \<cdot> (\<sigma> \<circ>\<^sub>s \<tau>) |_q = (l \<cdot> \<tau>) |_q" 
      by simp
    also have "l \<cdot> \<tau> = (ctxt_of_pos_term q (lhs \<alpha> \<cdot> \<sigma>))\<langle>lhs \<beta> \<cdot> \<delta>\<rangle> \<cdot> \<tau>" 
      unfolding l_def renl split rename_list_def \<sigma>_def map_vars_term_eq \<delta>_def
      by simp
    also have "\<dots> |_q = lhs \<beta> \<cdot> \<delta> \<cdot> \<tau>" 
      using q' by (metis hole_pos_ctxt_of_pos_term hole_pos_poss poss_imp_subst_poss replace_at_subt_at subt_at_subst)
    also have "\<dots> = lhs \<beta> \<cdot> (\<delta> \<circ>\<^sub>s \<tau>)" by simp
    also have "lhs \<alpha> \<cdot> (\<sigma> \<circ>\<^sub>s \<tau>) |_q = lhs \<alpha> |_q \<cdot> (\<sigma> \<circ>\<^sub>s \<tau>)" using q' by simp
    finally obtain \<sigma> \<delta> :: "('b,'a)subst" where "lhs \<beta> \<cdot> \<delta> = lhs \<alpha> |_q \<cdot> \<sigma>" by metis
    hence mgu_\<alpha>: "mgu_vd_list ren [(lhs \<beta>, lhs \<alpha> |_q)] \<noteq> None" 
      using mgu_vd_list_complete[of "[(lhs \<beta>, lhs \<alpha> |_q)]" "\<lambda> _. \<delta>" \<sigma> ren] by auto

    from split[folded rdp_A] have redA_eq: "redex_patterns A = (\<alpha>, []) # rdpA" by auto
    have "\<exists> As. A = Prule \<alpha> As"
    proof (cases A)
      case (Pfun f As)
      with redA_eq have "(\<alpha>,[]) \<in> set (concat (map2 (\<lambda>i. map (\<lambda>(\<alpha>, p). (\<alpha>, i # p))) [0..<length As] (map redex_patterns As)))"  by simp
      hence False unfolding set_concat set_zip by force
      thus ?thesis ..
    qed (insert redA_eq, auto)
    then obtain As where rule: "A = Prule \<alpha> As" by auto
    {
      fix \<alpha>' p
      assume memA: "(\<alpha>',p) \<in> set rdpA" 
      hence mem: "(\<alpha>',p) \<in> set rdp_A" unfolding split by auto
      from rdp_cond[OF this]
      have \<alpha>': "to_rule \<alpha>' \<in> R" and over: "(@) p ` fun_poss (lhs \<alpha>') \<inter> (@) q ` fun_poss (lhs \<beta>) \<noteq> {}" by auto
      then obtain p' q' where p': "p' \<in> fun_poss (lhs \<alpha>')" and q'': "q' \<in> fun_poss (lhs \<beta>)" and eq: "p @ p' = q @ q'" by auto
      from eq have disj: "p \<le>\<^sub>p q \<or> q \<le>\<^sub>p p" 
        by (metis prefix_append prefix_order.dual_order.eq_iff)
      
      {
        assume "p \<le>\<^sub>p q" 
        with q have p: "p \<in> fun_poss (lhs \<alpha>)"
          by (metis fun_poss_append_poss' prefix_def)
        from A[unfolded rule] 
        have lenv: "length (var_poss_list (lhs \<alpha>)) = length As" 
          by (metis Inl_inject term.simps(4) length_var_poss_list R.vars_rule_vars_lhs sum.simps(4) term.inject(2)
              wf_pterm.cases)

        from redA_eq[unfolded rule]
        have eq': "rdpA = concat (map2 (\<lambda>p1. map (\<lambda>(\<alpha>, p2). (\<alpha>, p1 @ p2))) (var_poss_list (lhs \<alpha>)) (map redex_patterns As))" by auto
        have "snd ` set rdpA \<subseteq> {(var_poss_list (lhs \<alpha>) ! i) @ p2 |i p2. i < length As}" 
          unfolding eq' by (force simp: set_zip)
        with memA obtain p2 i where i: "i < length As" and pp2: "p = var_poss_list (lhs \<alpha>) ! i @ p2" by auto
        let ?p1 = "var_poss_list (lhs \<alpha>) ! i" 
        from i lenv have "?p1 \<in> var_poss (lhs \<alpha>)"
          by (metis nth_mem var_poss_list_sound)
        hence "?p1 \<notin> fun_poss (lhs \<alpha>)"
          by (metis DiffE poss_simps(3))
        hence "?p1 @ p2 \<notin> fun_poss (lhs \<alpha>)" 
          using fun_poss_append_poss' by blast
        from this[folded pp2] p have False ..
      } note impossible = this
      have pq: "p \<in> (@) q ` fun_poss (lhs \<beta>)"
        by (smt (verit, best) eq fun_poss_append_poss' image_iff impossible pos_append_cases prefix_append prefix_order.order_refl q'')

      then obtain p1 where "p1 \<in> fun_poss (lhs \<beta>)" and peq: "p = q @ p1" by auto
      from this have p1: "p1 \<in> poss (lhs \<beta>)"
        using fun_poss_imp_poss by blast

      from mem obtain i where i: "i < length rdp_A" and rdpi: "rdp_A ! i = (\<alpha>',p)" unfolding set_conv_nth by auto
      define \<sigma> :: "('b,'a)subst" where "\<sigma> = Var o rename_many' ren i" 
      define \<delta> :: "('b,'a)subst" where "\<delta> = Var o rename_single ren" 
      from i len have "list ! i \<in> set list" by auto
      also have "list ! i = (lhs \<alpha>' \<cdot> \<sigma>, l |_ p)" using i unfolding list_def rename_list_def
        by (simp add: rdpi \<sigma>_def map_vars_term_as_subst o_def)
      finally have "(lhs \<alpha>' \<cdot> \<sigma>, l |_ p) \<in> set list" by auto
      from unif[OF this] have "lhs \<alpha>' \<cdot> \<sigma> \<cdot> \<tau> = l |_ p \<cdot> \<tau>" by auto
      also have "l |_ p = lhs \<beta> \<cdot> \<delta> |_ p1" using q' unfolding l_def peq renl split rename_list_def \<delta>_def o_def
        by (simp add: map_vars_term_as_subst replace_at_below_poss replace_at_subt_at)
      also have "\<dots> = lhs \<beta> |_ p1 \<cdot> \<delta>" using p1 by simp
      finally have "lhs \<beta> |_ p1 \<cdot> (\<delta> \<circ>\<^sub>s \<tau>) = lhs \<alpha>' \<cdot> (\<sigma> \<circ>\<^sub>s \<tau>)" 
        by simp
      then obtain \<sigma> \<delta> :: "('b,'a)subst" where "lhs \<beta> |_ p1  \<cdot> \<delta> = lhs \<alpha>' \<cdot> \<sigma>" by metis
      hence "mgu_vd_list ren [(lhs \<beta> |_ p1, lhs \<alpha>')] \<noteq> None" 
        using mgu_vd_list_complete[of "[(lhs \<beta> |_ p1, lhs \<alpha>')]" "\<lambda> _. \<delta>" \<sigma> ren] by auto
      also have "p1 = p -\<^sub>p q" using peq 
        by (metis disj impossible prefix_pos_diff same_append_eq) 
      finally have mgu_\<alpha>': "mgu_vd_list ren [(lhs \<beta> |_ (p -\<^sub>p q), lhs \<alpha>')] \<noteq> None" by auto

      note \<alpha>' pq mgu_\<alpha>'
    } note rdpA = this
    show ?case
      by (intro conjI exI; (fact)?) (insert rdpA, auto)
  qed
qed 
end

context
  fixes ren :: "'v :: infinite renamingN"
    and R :: "('f,'v)rules"
    and S :: "('f,'v)rules"
begin

function compute_rdp :: "('f,'v)term \<Rightarrow> (('f, 'v) prule \<times> pos) list list" where
  "compute_rdp (Var x) = [[]]"
| "compute_rdp (Fun f ts) =  
    (map concat o concat_lists) (map2 (\<lambda> i ti. map (map (map_prod id ((#) i))) (compute_rdp ti)) [0..<length ts] ts)
    @ List.maps (\<lambda> rule. let ps = filter ((\<noteq>) []) (var_poss_list (fst rule));
           rec = map (\<lambda> p. if p \<in> fun_poss (Fun f ts) then map (map (map_prod id ((@) p))) (compute_rdp (Fun f ts |_ p)) else [[]]) ps in
         map ((#) (Rule (fst rule) (snd rule), [])) ((map concat o concat_lists) rec))
       (filter (\<lambda> rule. mgu_vd_list ren [ (Fun f ts, fst rule)] \<noteq> None) R)" 
  by pat_completeness auto

termination
proof (standard, rule wf_measure[of size], goal_cases)
  case (2 f ts rule filt p)
  hence "p \<noteq> []" and "p \<in> poss (Fun f ts)" by (auto simp: fun_poss_imp_poss)
  then show ?case 
    by simp (metis nth_mem size_simp1 size_simp5 subt_at.simps(1,2) subt_at_subterm supt_size)
qed (auto simp: termination_simp)

lemma empty_compute_rdp: "[] \<in> set (compute_rdp t)" 
proof (induct t rule: compute_rdp.induct)
  case (2 f ts)
  define e :: "(('f, 'v) prule \<times> nat list) list" where "e = []" 
  have IH: "i < length ts \<Longrightarrow> e \<in> set (compute_rdp (ts ! i))" for i 
    using 2(1)[of "(i, ts ! i)", OF _ refl] by (force simp: set_zip e_def)
  let ?list = "map (\<lambda> i. map (map (map_prod id ((#) i))) (compute_rdp (ts ! i))) [0..<length ts]" 
  have "concat (replicate (length ts) e) \<in> set (compute_rdp (Fun f ts))" 
    unfolding compute_rdp.simps set_append 
    apply (intro UnI1)
    apply (unfold o_def)
    apply simp
    apply (intro imageI)
    using IH by (auto simp: e_def)
  also have "concat (replicate (length ts) e) = []" unfolding e_def by auto
  finally show ?case .
qed auto

lemma positions_compute_rdp: "snd ` (\<Union> (set ` set (compute_rdp t))) \<subseteq> poss t" 
proof (induct t rule: compute_rdp.induct)
  case (2 f ts)
  have len: "length [0..<length ts] = length ts" by simp
  define S1 where "S1 = set (map concat
               (concat_lists
                 (map (\<lambda>i. map (map (map_prod id ((#) i))) (compute_rdp (ts ! i)))
                   [0..<length ts])))" 
  define RR where "RR = (filter (\<lambda>rule. mgu_vd_list ren [(Fun f ts, fst rule)] \<noteq> None) R)" 
  define ff where "ff =  (\<lambda>p. if p \<in> fun_poss (Fun f ts)
                                  then map (map (map_prod id ((@) p)))
                                        (compute_rdp (Fun f ts |_ p))
                                  else [[]])" 
  define gen where "gen = (\<lambda> rule. let ps = filter ((\<noteq>) []) (var_poss_list (fst rule));
                      rec = map ff ps
                  in map ((#) (fst rule \<rightarrow> snd rule, [])) (map concat (concat_lists rec)))" 
  define S2 where "S2 = set (List.maps gen RR)" 
  show ?case unfolding compute_rdp.simps o_def map2_to_map' len image_comp image_Union set_append 
    unfolding S1_def[symmetric] ff_def[symmetric] gen_def[symmetric] RR_def[symmetric] S2_def[symmetric]
  proof (intro Union_least)
    fix P
    assume "P \<in> (\<lambda>x. snd ` set x) ` (S1 \<union> S2)" 
    then obtain rdp where rdp: "rdp \<in> S1 \<union> S2" and P: "P = snd ` set rdp" by auto    
    show "P \<subseteq> poss (Fun f ts)" 
    proof 
      fix p
      assume "p \<in> P" 
      with P rdp obtain rp where "rp \<in> S1 \<union> S2" and p: "p \<in> snd ` set rp" by auto
      from this(1) show "p \<in> poss (Fun f ts)" 
      proof
        assume "rp \<in> S1" 
        from this[unfolded S1_def, simplified]
        obtain as where len: "length as = length ts" 
          and as: "\<And> i. i < length ts \<Longrightarrow> as ! i \<in> map (map_prod id ((#) i)) ` set (compute_rdp (ts ! i))" 
          and rp: "rp = concat as" by auto
        from p[unfolded rp] obtain i where i: "i < length ts" and p: "p \<in> snd ` set (as ! i)" 
          using len set_conv_nth[of as] by auto
        from as[OF i] obtain rpi where rpi: "rpi \<in> set (compute_rdp (ts ! i))" and asi: "as ! i = map (map_prod id ((#) i)) rpi"  
          by auto
        from i have "(i, ts ! i) \<in> set (zip [0..<length ts] ts)" unfolding set_conv_nth by force
        from 2(1)[OF this refl] have IH: "snd ` \<Union> (set ` set (compute_rdp (ts ! i))) \<subseteq> poss (ts ! i)" .
        from p[unfolded asi] rpi obtain q where q: "q \<in> snd ` \<Union> (set ` set (compute_rdp (ts ! i)))" 
          and p: "p = i # q" by force
        from p q IH i show "p \<in> poss (Fun f ts)" by auto
      next
        assume "rp \<in> S2"
        from this[unfolded S2_def List.maps_eq]
        obtain rule where "rule \<in> set RR" and rp: "rp \<in> set (gen rule)" by auto
        define ps where "ps = filter ((\<noteq>) []) (var_poss_list (fst rule))" 
        from rp[unfolded gen_def, folded ps_def, unfolded Let_def] p
        have "p = [] \<or> (p \<noteq> [] \<and> (\<exists> rp. p \<in> snd ` set rp \<and> rp \<in> set (map concat (concat_lists (map ff ps)))))" (is "_ \<or> ?Ex")
          by (smt (verit) imageE image_eqI in_set_idx length_map list.inject list.set_cases nth_map
              nth_mem snd_conv) 
        thus "p \<in> poss (Fun f ts)" 
        proof
          assume ?Ex
          then obtain rp where p: "p \<in> snd ` set rp" and rp: "rp \<in> set (map concat (concat_lists (map ff ps)))"
              and pne: "p \<noteq> []" by blast
          note IH = 2(2)[OF ps_def]
          from rp obtain as where rp: "rp = concat as" 
            and len: "length as = length ps" 
            and as: "\<And> i. i < length ps \<Longrightarrow> as ! i \<in> set (ff (ps ! i))" by auto
          from p[unfolded rp, simplified] obtain i where i: "i < length ps" and p: "p \<in> snd ` set (as ! i)" 
            using len set_conv_nth[of as] by auto
          from i have pi: "ps ! i \<in> set ps" by auto
          note IH = IH[OF this]
          from as[OF i, unfolded ff_def] p pne 
          have mem: "ps ! i \<in> fun_poss (Fun f ts)" 
            and asi: "as ! i \<in> set (map (map (map_prod id ((@) (ps ! i)))) (compute_rdp (Fun f ts |_ ps ! i)))" 
            by (auto split: if_splits)
          from p asi[simplified] obtain q where q: "q \<in> snd ` \<Union> (set ` set (compute_rdp (Fun f ts |_ ps ! i)))" 
            and p: "p = ps ! i @ q" by fastforce
          from IH[OF mem] q have q: "q \<in> poss (Fun f ts |_ ps ! i)" by auto          
          show ?thesis using q pi unfolding p 
            using fun_poss_poss mem pos_append_poss by blast
        qed auto
      qed
    qed
  qed
qed auto


definition sim_cp_root_of where
  "sim_cp_root_of rule rdp_A = (let l = map_vars_term (ren_l ren) (fst rule);
         renamed_lhs_\<alpha>s = ren.rename_list ren (map (\<lambda>(\<alpha>, p). lhs \<alpha>) rdp_A) in 
         case mgu_list (map2 (\<lambda> lhs_\<alpha> p. (lhs_\<alpha>, l|_p)) renamed_lhs_\<alpha>s (map snd rdp_A)) of 
           None \<Rightarrow> []
         | Some \<tau> \<Rightarrow> (let As = map2 (\<lambda> prod i. case prod of (\<alpha>i, pi) \<Rightarrow> (ctxt_of_pos_term pi (to_pterm (l \<cdot> \<tau>)))\<langle>Prule \<alpha>i (map (to_pterm \<circ> \<tau> \<circ> rename_many' ren i) (vars_term_list (lhs \<alpha>i)))\<rangle>)
          rdp_A [0..<length rdp_A] 
           in (case join_list As of None \<Rightarrow> []
         | Some A \<Rightarrow> (let B = Prule (Rule (fst rule) (snd rule)) (map (to_pterm \<circ> \<tau> \<circ> ren_l ren) (vars_term_list (fst rule)))
           in [(A,B)]))))" 

definition sim_cp_root_impl where "sim_cp_root_impl = 
  List.maps (\<lambda> rule. List.maps (\<lambda> rdp_A. sim_cp_root_of rule rdp_A) (filter ((\<noteq>) []) (compute_rdp (fst rule)))) S"

definition non_root_rdps where "non_root_rdps \<alpha> q ll =
  (map concat (concat_lists (map (\<lambda> p. if q \<le>\<^sub>p p \<and> p -\<^sub>p q \<in> fun_poss ll 
    then map (map (map_prod id ((@) p))) (compute_rdp (ll |_ (p -\<^sub>p q))) else [[]]) (var_poss_list (lhs \<alpha>)))))" 

definition sim_cp_non_root_of where
  "sim_cp_non_root_of \<alpha> q \<beta> rdpA = (let rdp_A = (\<alpha>, []) # rdpA;
          renamed_lhs_\<alpha>s = ren.rename_list ren (map (\<lambda>(\<alpha>, p). lhs \<alpha>) rdp_A);
          l = replace_at (hd renamed_lhs_\<alpha>s) q (map_vars_term (ren_l ren) (lhs \<beta>))
       in (case mgu_list (map2 (\<lambda> lhs_\<alpha> p. (lhs_\<alpha>, l|_p)) renamed_lhs_\<alpha>s (map snd rdp_A)) of 
           None \<Rightarrow> []
         | Some \<tau> \<Rightarrow> (let As = map2 (\<lambda>(\<alpha>i, pi) i. (ctxt_of_pos_term pi (to_pterm (l \<cdot> \<tau>)))\<langle>Prule \<alpha>i (map (to_pterm \<circ> \<tau> \<circ> rename_many' ren i) (vars_term_list (lhs \<alpha>i)))\<rangle>)
          rdp_A [0..<length rdp_A] 
           in (case join_list As of None \<Rightarrow> []
         | Some A \<Rightarrow> (let B = replace_at (to_pterm (l \<cdot> \<tau>)) q (Prule \<beta> (map (to_pterm \<circ> \<tau> \<circ> ren_l ren) (vars_term_list (lhs \<beta>))))
            in [(A,B)])))))" 

definition non_root_sim_cps where "non_root_sim_cps \<alpha> q \<beta> = (List.maps (sim_cp_non_root_of \<alpha> q \<beta>) 
  (non_root_rdps \<alpha> q (lhs \<beta>)))"

definition sim_cp_non_root_impl where "sim_cp_non_root_impl = 
  List.maps (\<lambda> (lf,rf). let \<alpha> = Rule lf rf in List.maps (\<lambda> q. List.maps ( \<lambda> (ll,rr). non_root_sim_cps \<alpha> q (Rule ll rr))
    (filter (\<lambda> (ll,rr). mgu_vd_list ren [(ll, lf |_q)] \<noteq> None) S)) (filter ((\<noteq>) []) (fun_poss_list (lhs \<alpha>)))) R" 

definition sim_cp_impl where "sim_cp_impl = sim_cp_root_impl @ sim_cp_non_root_impl" 

definition sim_cps_impl where "sim_cps_impl = map (map_prod target target) sim_cp_impl" 
end


lemma no_pair_iff_empty[simp]: "(\<forall>a b. (a, b) \<notin> set xs) \<longleftrightarrow> xs = []"
  by (metis in_set_simps(3) length_greater_0_conv nth_mem old.prod.exhaust)

lemma split_upt: "i < length xs \<Longrightarrow> [0..< length xs] = [0..< i] @ i # [Suc i ..< length xs]"
  by (metis le_Suc_ex less_Suc_eq_le less_imp_le_nat upt_add_eq_append upt_rec zero_less_Suc)

lemma list_app_eqI: "xs = [] \<Longrightarrow> ys = us \<Longrightarrow> zs = [] \<Longrightarrow> xs @ ys @ zs = us" by auto

definition "below_var_poss p t = (\<exists> q \<in> var_poss t. q \<le>\<^sub>p p)" 

lemma below_var_poss_simps[simp]: "below_var_poss p (Var x)" 
  "\<not> below_var_poss [] (Fun f ts)" 
  "below_var_poss (i # p) (Fun f ts) = (i < length ts \<and> below_var_poss p (ts ! i))" 
  unfolding below_var_poss_def by force+

context ren_wf_trs
begin

context
  fixes RR :: "('b,'a)rules" 
    and SS :: "('b,'a)rules" 
  assumes RR: "set RR = R" and SS: "set SS = S" 
begin

lemma compute_rdp: "set (compute_rdp ren RR t) = 
  { rp | rp A. A \<in> wf_pterm R \<and> rp = redex_patterns A \<and>
       (\<forall> (\<alpha>,q) \<in> set rp. q \<in> fun_poss t \<and> mgu_vd_list ren [(t|_q, lhs \<alpha>)] \<noteq> None)}" 
  (is "?Left t = ?Right t")
proof -
  have empty: "[] \<in> ?Right t" for t
    by (auto intro!: exI[of _ "Var undefined"])
  hence [simp]: "\<exists>A. A \<in> wf_pterm R \<and> [] = redex_patterns A" by auto
  show ?thesis
  proof (induct t rule: compute_rdp.induct)
    case (2 f ts)
    let ?t = "Fun f ts" 
    define addi :: "nat \<Rightarrow> (('b, 'a) prule \<times> nat list) list \<Rightarrow> (('b, 'a) prule \<times> nat list) list" 
      where "addi = (\<lambda> i. map (map_prod id ((#) i)))" 
    have addi: "addi i = map (\<lambda>(\<alpha>, p). (\<alpha>, i # p))" for i unfolding addi_def by (intro ext, force)
    define addp :: "pos \<Rightarrow> (('b, 'a) prule \<times> nat list) list \<Rightarrow> (('b, 'a) prule \<times> nat list) list" 
      where "addp = (\<lambda> p. map (map_prod id ((@) p)))" 
    have addi: "addi i = map (\<lambda>(\<alpha>, p). (\<alpha>, i # p))" for i unfolding addi_def by (intro ext, force)
    have addp: "addp p = map (\<lambda>(\<alpha>, q). (\<alpha>, p @ q))" for p unfolding addp_def by (intro ext, force)
    define set1 where "set1 = concat ` set (concat_lists (map2 (\<lambda>x y. map (addi x) (compute_rdp ren RR y)) [0..<length ts] ts))" 
    let ?addp = "\<lambda> p. map (map (map_prod id ((@) p)))" 
    define set2 where "set2 = \<Union> (set `
        (\<lambda> rule.
            let ps = filter ((\<noteq>) []) (var_poss_list (fst rule));
                rec = map (\<lambda>p. if p \<in> fun_poss ?t then map (addp p) (compute_rdp ren RR (?t |_ p)) else [[]]) ps
            in map ((#) (fst rule \<rightarrow> snd rule, [])) (map concat (concat_lists rec))) `
        set (filter (\<lambda>rule. mgu_vd_list ren [(?t, fst rule)] \<noteq> None) RR))" 
    have left: "?Left ?t = set1 \<union> set2" 
      unfolding compute_rdp.simps set_append o_def set_map List.maps_eq set_concat addi_def addp_def set1_def set2_def by auto
    show ?case unfolding left
    proof 
      show "set1 \<union> set2 \<subseteq> ?Right ?t" 
      proof
        fix rp
        assume "rp \<in> set1 \<union> set2" 
        thus "rp \<in> ?Right ?t"
        proof
          assume "rp \<in> set1" 
          from this[unfolded set1_def, simplified]
          obtain rps where len: "length rps = length ts" and rps: "\<And> i. i<length ts \<Longrightarrow> rps ! i \<in> addi i ` ?Left (ts ! i)" 
            and rp: "rp = concat rps" by blast
          let ?cond = "\<lambda> i rpi Ai. rps ! i = addi i rpi \<and> Ai \<in> wf_pterm R \<and>
              rpi = redex_patterns Ai \<and> (\<forall>(\<alpha>, q)\<in>set rpi. q \<in> fun_poss (ts ! i) \<and> mgu_vd_list ren [(ts ! i |_ q, lhs \<alpha>)] \<noteq> None)" 
          {
            fix i
            assume i: "i < length ts"  
            hence "(i, ts ! i) \<in> set (zip [0..<length ts] ts)" by (force simp: set_zip)
            from 2(1)[OF this refl]
            have "?Left (ts ! i) = ?Right (ts ! i)" .
            from rps[OF i, unfolded this] have "\<exists> rpi Ai. ?cond i rpi Ai"  
              by auto
          }
          hence "\<forall> i. \<exists> rpi Ai. i < length ts \<longrightarrow> ?cond i rpi Ai" by blast
          from choice[OF this] obtain rpi where "\<forall> i. \<exists> Ai. i < length ts \<longrightarrow> ?cond i (rpi i) Ai" by blast
          from choice[OF this] obtain Ai where cond: "\<And> i. i < length ts \<Longrightarrow> ?cond i (rpi i) (Ai i)" by blast
          let ?A = "Pfun f (map Ai [0..<length ts])" 
          have A: "?A \<in> wf_pterm R" using cond by (auto intro!: wf_pterm.intros) 
          have rpA: "redex_patterns ?A = rp" unfolding rp redex_patterns.simps length_map length_upt
            apply (intro arg_cong[of _ _ concat], rule sym, rule nth_equalityI; unfold len)
             apply force
            subgoal for i using cond[of i] by (auto simp: addi)
            done
          {
            fix \<alpha> q
            assume "(\<alpha>,q) \<in> set rp" 
            from this[unfolded rp] obtain i where i: "i < length ts" and mem: "(\<alpha>,q) \<in> set (rps ! i)"
              by (metis in_set_conv_nth nth_concat_split len)
            note mem
            also have "rps ! i = addi i (rpi i)" using cond[OF i] by auto
            finally obtain r where mem: "(\<alpha>,r) \<in> set (rpi i)"  and q: "q = i # r" 
              unfolding addi_def by auto
            from cond[OF i] mem have "r \<in> fun_poss (ts ! i) \<and> mgu_vd_list ren [(ts ! i |_ r, lhs \<alpha>)] \<noteq> None" by auto
            hence "q \<in> fun_poss (Fun f ts) \<and> mgu_vd_list ren [(Fun f ts |_ q, lhs \<alpha>)] \<noteq> None" unfolding q using i by auto
          }
          thus ?thesis
            by (intro CollectI exI[of _ rp] exI[of _ ?A] conjI A refl rpA[symmetric], auto)
        next
          assume "rp \<in> set2" 
          from this[unfolded set2_def set_filter RR] obtain l r ps rec where 
            lr: "(l,r) \<in> R" 
            and mgu: "mgu_vd_list ren [(?t, l)] \<noteq> None" 
            and ps: "ps = filter ((\<noteq>) []) (var_poss_list (fst (l,r)))" 
            and rec: "rec = map (\<lambda>p. if p \<in> fun_poss ?t then map (addp p) (compute_rdp ren RR (?t |_ p)) else [[]]) ps" 
            and rp: "rp \<in> set (map ((#) (l \<rightarrow> r, [])) (map concat (concat_lists rec)))" 
            by force
          from rec have len_rec: "length rec = length ps" by auto
          note IH = 2(2)[OF ps]
          from lr have "is_Fun l" using R.no_var_lhs by fastforce
          hence "[] \<notin> set (var_poss_list l)" by (cases l, auto)
          hence ps: "ps = var_poss_list l" unfolding ps fst_conv
            using filter_id_conv  by blast
          from rp len_rec obtain rps where
            rp: "rp = (l \<rightarrow> r, []) # concat rps"  
            and len_rps: "length rps = length ps" 
            and as_mem: "\<And> i. i < length ps \<Longrightarrow>  rps ! i \<in> set (rec ! i)" 
            by auto
          let ?cond = "\<lambda> i rpi A. (A \<in> wf_pterm R \<and> rps ! i = addp (ps ! i) rpi \<and> rpi = redex_patterns A \<and>
                  (\<forall> \<alpha> q. (\<alpha>,q) \<in>set rpi \<longrightarrow>
                       q \<in> fun_poss (?t |_ ps ! i) \<and>
                       mgu_vd_list ren [(?t |_ ps ! i |_ q, lhs \<alpha>)] \<noteq> None))" 
          {
            fix i
            assume i: "i < length ps"
            hence mem: "ps ! i \<in> set ps" by auto
            {
              assume fp: "ps ! i \<in> fun_poss ?t" 
              have "set (rec ! i) = addp (ps ! i) ` ?Left (?t |_ ps ! i)" unfolding rec 
                using i fp by auto
              also have "\<dots> = addp (ps ! i) ` ?Right (?t |_ ps ! i)" unfolding IH[OF mem fp] ..
              finally have "set (rec ! i) = addp (ps ! i) ` ?Right (?t |_ ps ! i)" .
              from as_mem[OF i, unfolded this] 
              have "\<exists>A rpi. ?cond i rpi A" by fast
            } 
            moreover
            {
              assume "ps ! i \<notin> fun_poss ?t" 
              hence "rec ! i = [[]]" unfolding rec using i by auto
              from as_mem[OF i, unfolded this] have "rps ! i = []" by auto
              hence "\<exists> A rpi. ?cond i rpi A" 
                by (intro exI[of _ "Var undefined"], auto simp: addp)
            } 
            ultimately have "\<exists> A rpi. ?cond i rpi A" by blast
          }
          hence "\<forall> i. \<exists> A rpi. i < length ps \<longrightarrow> ?cond i rpi A" by blast
          from choice[OF this] obtain As where "\<forall> i. \<exists> rpi. i < length ps \<longrightarrow> ?cond i rpi (As i)" by blast
          from choice[OF this] obtain rpi where cond: "\<And> i. i < length ps \<Longrightarrow> ?cond i (rpi i) (As i)" by blast
          let ?A = "Prule (Rule l r) (map As [0..<length ps])" 
          let ?addi = "\<lambda> i. map (\<lambda>(\<alpha>, p2). (\<alpha>, ps ! i @ p2))" 
          from lr have len_ps: "length ps = length (var_rule (l \<rightarrow> r))" 
            unfolding ps by (metis length_var_poss_list R.length_var_rule prule.sel(1,2))
          have vpl: "var_poss_list (lhs (l \<rightarrow> r)) = ps" unfolding ps by simp
          let ?rp = "(l \<rightarrow> r, []) # concat (map (\<lambda> i. rps ! i) [0..<length ps])" 
          have rpA: "redex_patterns ?A = ?rp" 
            unfolding rp redex_patterns.simps vpl
            by (intro arg_cong[of _ _ "\<lambda> x. _ # concat x"], rule nth_equalityI; insert cond, auto simp: addp)
          have A: "?A \<in> wf_pterm R" using lr len_ps cond by (intro wf_pterm.intros, auto)
          have rp_id: "rp = ?rp" unfolding rp
            by (intro arg_cong[of _ _ "\<lambda> x. _ # concat x"], rule nth_equalityI; insert len_rps cond, auto)
          {
            fix \<alpha> q
            assume mem: "(\<alpha>,q) \<in> set ((l \<rightarrow> r, []) # concat (map ((!) rps) [0..<length ps]))" 
            have "q \<in> fun_poss (Fun f ts) \<and> mgu_vd_list ren [(Fun f ts |_ q, lhs \<alpha>)] \<noteq> None" 
            proof (cases "(\<alpha>,q) = (l \<rightarrow> r, [])")
              case True
              with mgu show ?thesis by auto
            next
              case False
              with mem obtain i where i: "i < length ps" and aq: "(\<alpha>,q) \<in> set (rps ! i)" by auto
              with cond[OF i] have "(\<alpha>,q) \<in> set (addp (ps ! i) (rpi i))" by auto
              then obtain p where mem: "(\<alpha>,p) \<in> set (rpi i)" and q: "q = ps ! i @ p"
                by (force simp: addp)
              from cond[OF i] mem
              have cond: "p \<in> fun_poss (?t |_ ps ! i)" "mgu_vd_list ren [(?t |_ ps ! i |_ p, lhs \<alpha>)] \<noteq> None" 
                by auto
              show ?thesis  
              proof (cases "ps ! i \<in> fun_poss ?t")
                case True
                hence "ps ! i \<in> poss ?t" by (rule fun_poss_imp_poss)
                hence id: "?t |_ ps ! i |_ p = ?t |_ q" unfolding q by auto
                with cond have mgu: "mgu_vd_list ren [(?t |_ q, lhs \<alpha>)] \<noteq> None" by auto
                from cond(1-2) True have "q \<in> fun_poss ?t" unfolding q 
                  by (metis Term.term.simps(4) fun_poss_fun_conv fun_poss_imp_poss id is_VarE poss_append_poss
                      poss_is_Fun_fun_poss q)
                thus ?thesis 
                  by (intro conjI mgu)
              next
                case False
                from False i have "set (rec ! i) = {[]}" unfolding rec by (force simp: addp_def)
                with as_mem[OF i] have "rps ! i = []" by auto
                with aq show ?thesis by auto
              qed
            qed                
          }
          thus ?thesis
            by (intro CollectI exI[of _ ?A] exI[of _ ?rp] conjI refl rpA[symmetric] A rp_id, blast)
        qed
      qed
      show "?Right ?t \<subseteq> set1 \<union> set2" 
      proof
        fix rp
        assume "rp \<in> ?Right ?t" 
        then obtain A where A: "A \<in> wf_pterm R" 
          and rp: "rp = redex_patterns A" 
          and cond: "\<And> \<alpha> q. (\<alpha>,q) \<in> set rp \<Longrightarrow> q \<in> fun_poss ?t \<and> mgu_vd_list ren [(?t |_ q, lhs \<alpha>)] \<noteq> None" by blast
        from A show "rp \<in> set1 \<union> set2"
        proof cases
          case Var: (1 x)
          with rp have "rp = []" by simp
          thus ?thesis unfolding left[symmetric] by (metis empty_compute_rdp)
        next
          case Pfun: (2 As f)
          hence Asi: "\<And> i. i < length As \<Longrightarrow> As ! i \<in> wf_pterm R" by auto
          define m where "m = min (length As) (length ts)" 
          define Bs where "Bs i = (if i < m then As ! i else Var undefined)" for i
          have Bsi: "\<And> i. Bs i \<in> wf_pterm R" unfolding Bs_def m_def using Asi by auto
          have "rp = concat (map2 addi [0..<length As] (map redex_patterns As))" 
            using rp Pfun by (simp add: addi)
          also have "map2 addi [0..<length As] (map redex_patterns As) = map (\<lambda> i. addi i (redex_patterns (As ! i))) [0..<length As]" 
            by (intro nth_equalityI, auto)
          finally have rp: "rp = concat (map (\<lambda> i. addi i (redex_patterns (As ! i))) [0..<length As])" .
          {
            fix i
            assume i: "i < length As" "\<not> i < length ts" 
            have "redex_patterns (As ! i) = []" 
            proof (rule ccontr)
              assume "\<not> ?thesis" 
              then obtain p \<alpha> Bs where "redex_patterns (As ! i) = (\<alpha>,p) # Bs" (is "?e = _") by (cases ?e, auto)
              with i have "(\<alpha>,i # p) \<in> set rp" unfolding rp addi by force
              from cond[OF this] i show False by auto
            qed
          } note large_i = this
          note rp
          also have "[0..<length As] = [0..<m] @ [m ..< length As]" unfolding m_def
            by (metis (no_types, lifting) append_Nil2 min.absorb1 min.absorb3 min.left_idem split_upt upt_eq_Nil_conv upt_rec)
          also have "map (\<lambda> i. addi i (redex_patterns (As ! i))) \<dots> = 
            map (\<lambda> i. addi i (redex_patterns (As ! i))) [0..<m] @ 
            map (\<lambda> i. addi i (redex_patterns (As ! i))) [m ..< length As]"
            by simp
          also have "map (\<lambda> i. addi i (redex_patterns (As ! i))) [m ..< length As] = map (\<lambda> _. []) [m ..< length As]" 
          proof (intro map_cong[OF refl])
            fix i
            assume "i \<in> set [m ..< length As]" 
            hence "i < length As" "\<not> i < length ts" unfolding m_def by force+
            from large_i[OF this]
            show "addi i (redex_patterns (As ! i)) = []" unfolding addi by simp
          qed
          also have "map (\<lambda> i. addi i (redex_patterns (As ! i))) [0..<m] = map (\<lambda> i. addi i (redex_patterns (Bs i))) [0..<m]" 
            unfolding Bs_def by auto
          finally have "rp = concat (map (\<lambda>i. addi i (redex_patterns (Bs i))) [0..<m])" by simp
          also have "\<dots> = \<dots> @ concat (map (\<lambda>i. addi i (redex_patterns (Bs i))) [m..<length ts])" 
            unfolding Bs_def by (auto simp: addi)
          also have "\<dots> = concat (map (\<lambda>i. addi i (redex_patterns (Bs i))) ([0..<m] @ [m ..<length ts]))" by simp
          also have "[0..<m] @ [m ..<length ts] = [0..<length ts]" unfolding m_def
            by (metis append_Nil2 le_neq_implies_less min.cobounded2 split_upt upt_rec)
          finally have rp_ts: "rp = concat (map (\<lambda>i. addi i (redex_patterns (Bs i))) [0..<length ts])" by auto
          have len_id: "length (zip [0..<length ts] ts) = length ts" by auto
          {
            fix i
            assume i: "i < length ts"
            have "addi i (redex_patterns (Bs i)) \<in> addi i ` set (compute_rdp ren RR (ts ! i))"
            proof (intro imageI, cases "i < length As")
              case False
              hence id: "redex_patterns (Bs i) = []" unfolding Bs_def m_def by auto
              show "redex_patterns (Bs i) \<in> set (compute_rdp ren RR (ts ! i))" 
                unfolding id by (rule empty_compute_rdp)
            next
              case True
              from i have "(i, ts ! i) \<in> set (zip [0..<length ts] ts)" by (force simp: set_zip)
              note IH = 2(1)[OF this refl]
              {
                fix \<alpha> q
                assume "(\<alpha>, q)\<in>set (redex_patterns (As ! i))" 
                hence "(\<alpha>, i # q) \<in> set rp" using True unfolding rp by (auto simp: addi)
                from cond[OF this]
                have "q \<in> fun_poss (ts ! i) \<and> mgu_vd_list ren [(ts ! i |_ q, lhs \<alpha>)] \<noteq> None"
                  by auto
              } note cond = this
              have "redex_patterns (Bs i) = redex_patterns (As ! i)" unfolding Bs_def using True i m_def by auto
              also have "\<dots> \<in> set (compute_rdp ren RR (ts ! i))" unfolding IH
                by (intro CollectI exI[of _ "redex_patterns (As ! i)"] exI[of _ "As ! i"] conjI refl Asi[OF True])
                  (insert cond, auto)
              finally show "redex_patterns (Bs i) \<in> set (compute_rdp ren RR (ts ! i))" .
            qed
          } note IH = this
          have "rp \<in> set1" unfolding set1_def rp_ts set_concat_lists length_map len_id
            by (intro imageI CollectI conjI, insert IH, auto)
          thus ?thesis ..
        next
          case Prule: (3 \<alpha> As)
          then obtain l r where \<alpha>: "\<alpha> = Rule l r" by (cases \<alpha>, auto)
          with Prule have lr: "(l,r) \<in> R" and lhs[simp]: "lhs \<alpha> = l" by auto 
          define fR where "fR = set (filter (\<lambda>rule. mgu_vd_list ren [(Fun f ts, fst rule)] \<noteq> None) RR)" 
          note rp_id = rp[unfolded Prule]
          hence rp: "rp = (\<alpha>, []) # concat (map2 addp (var_poss_list l) (map redex_patterns As))" 
            by (auto simp: addp)
          hence "(\<alpha>, []) \<in> set rp" by auto
          from cond[OF this] have "mgu_vd_list ren [(Fun f ts |_ [], l)] \<noteq> None" by auto
          hence lr_fR: "(l,r) \<in> fR" unfolding fR_def using lr RR by auto
          define ps where "ps = filter ((\<noteq>) []) (var_poss_list (fst (l,r)))" 
          from lr have "is_Fun l" 
            using A Prule(1) lhs R.lhs_is_Fun by blast
          hence "[] \<notin> set (var_poss_list l)" by (cases l, auto)
          hence ps: "ps = var_poss_list l" unfolding ps_def fst_conv
            using filter_id_conv by blast
          from Prule(3) have len: "length As = length ps" unfolding ps using lr
            by (metis \<alpha> left_lin.length_var_rule R.left_lin_axioms length_var_poss_list lhs prule.sel(2))
          let ?f = "(\<lambda>p. if p \<in> fun_poss ?t
                                 then map (addp p) (compute_rdp ren RR (?t |_ p)) else [[]])" 
          define rec where "rec = map ?f ps" 
          have "concat (map2 addp ps (map redex_patterns As)) \<in> concat ` set (concat_lists rec)" 
          proof (intro imageI, unfold set_concat_lists, intro CollectI conjI allI impI, force simp: len rec_def)
            fix i
            assume "i < length rec" 
            hence i: "i < length ps" "i < length As" 
              unfolding rec_def using len by auto
            have id1: "map2 addp ps (map redex_patterns As) ! i = addp (ps ! i) (redex_patterns (As ! i))" 
              using i by auto
            have id2: "set (rec ! i) = set (?f (ps ! i))" unfolding rec_def using i by auto
            from i have psi: "ps ! i \<in> set ps" by auto
            from Prule i have Asi: "As ! i \<in> wf_pterm R" by auto
            have "addp (ps ! i) (redex_patterns (As ! i)) \<in> set (?f (ps ! i))" 
            proof (cases "ps ! i \<in> fun_poss ?t")
              case False
              hence "redex_patterns (As ! i) = []"
                by (metis
                    \<open>\<And>thesis. (\<And>A. A \<in> wf_pterm R \<Longrightarrow> rp = redex_patterns A \<Longrightarrow> 
                        (\<And>\<alpha> q. (\<alpha>, q) \<in> set rp \<Longrightarrow> q \<in> fun_poss ?t \<and> mgu_vd_list ren [(?t |_ q, lhs \<alpha>)] \<noteq> None) \<Longrightarrow> thesis) \<Longrightarrow> thesis\<close>
                    rp_id fun_poss_append_poss' i(2) len lhs no_pair_iff_empty ps
                    redex_patterns_elem_rule')
              with False show ?thesis by (auto simp: addp)
            next
              case True
              hence id: "(ps ! i \<in> fun_poss (Fun f ts)) = True" by auto
              show ?thesis unfolding id if_True set_map
              proof (intro imageI)
                note IH = 2(2)[OF ps_def psi True]
                {
                  fix \<alpha> q
                  assume "(\<alpha>, q) \<in> set (redex_patterns (As ! i))"
                  hence "(\<alpha>, ps ! i @ q) \<in> set rp" unfolding rp[folded ps] addp using i 
                    by (metis lhs ps redex_patterns.simps(3) redex_patterns_elem_rule')                  
                  note cond = cond[OF this]
                  from True have psi': "ps ! i \<in> poss ?t" by (rule fun_poss_imp_poss)
                  from psi' have "?t |_ ps ! i |_ q = ?t |_ (ps ! i @ q)" by simp
                  with cond have unif: "mgu_vd_list ren [(?t |_ ps ! i |_ q, lhs \<alpha>)] \<noteq> None" by auto
                  from cond have "ps ! i @ q \<in> fun_poss ?t" by auto
                  hence q_fp: "q \<in> fun_poss (?t |_ ps ! i)" 
                    by (metis fun_poss_poss subterm_poss_conv)
                  note q_fp unif
                }
                thus "redex_patterns (As ! i) \<in> ?Left (Fun f ts |_ ps ! i)" 
                  unfolding IH
                  by (intro CollectI exI[of _ "redex_patterns (As ! i)"] exI[of _  "As ! i"] conjI refl Asi, auto)
              qed
            qed
            thus "map2 addp ps (map redex_patterns As) ! i \<in> set (rec ! i) " unfolding id1 id2 .
          qed
          hence rp: "rp \<in> set (map ((#) (\<alpha>, [])) (map concat (concat_lists rec)))" 
            unfolding rp ps by auto
          have "rp \<in> set2" unfolding set2_def fR_def[symmetric]
            apply (intro UnionI)
             apply (rule imageI, rule imageI)
             apply (rule lr_fR)
            using rp by (auto simp: rec_def ps_def Let_def \<alpha>)
          thus ?thesis ..
        qed
      qed
    qed
  qed auto
qed


lemma sim_cp_root_impl_complete: "sim_cp_root \<subseteq> set (sim_cp_root_impl ren RR SS)" 
proof
  fix A B
  assume "(A,B) \<in> sim_cp_root" 
  from this[unfolded sim_cp_root_many_conds]
  obtain \<tau> rdp_A l \<beta> As renamed_lhs_\<alpha>s where
    alt: "alt_cond \<tau> rdp_A l \<beta> [] A B As renamed_lhs_\<alpha>s" 
    and cond: "\<forall>(\<alpha>, p)\<in>set rdp_A. p \<in> fun_poss (lhs \<beta>) \<and> mgu_vd_list ren [(lhs \<beta> |_ p, lhs \<alpha>)] \<noteq> None" 
    by blast
  obtain ll rr where \<beta>: "\<beta> = Rule ll rr" by (cases \<beta>, auto)
  note alt = alt[unfolded alt_cond_def \<beta>]
  from alt have l: "l = map_vars_term (rename_single ren) ll"  by (simp add: \<beta>)
  from alt have ren_as: "renamed_lhs_\<alpha>s = rename_list (map (\<lambda>(\<alpha>, p). lhs \<alpha>) rdp_A)" by (simp add: \<beta>)
  from alt SS have llrr: "(ll,rr) \<in> set SS" by auto
  from alt have mgu: "mgu_list (map2 (\<lambda>x y. (x, l |_ y)) renamed_lhs_\<alpha>s (map snd rdp_A)) =  Some \<tau>" by auto
  from alt have As: "As = map2
                      (\<lambda> prod i. case prod of (\<alpha>i, pi) \<Rightarrow>
                          (ctxt_of_pos_term pi
                            (to_pterm (l \<cdot> \<tau>)))\<langle>Prule \<alpha>i (map (to_pterm \<circ> \<tau> \<circ> rename_many' ren i) (vars_term_list (lhs \<alpha>i)))\<rangle>)
                      rdp_A [0..<length rdp_A]" by auto
  from alt have join: "\<Squnion> As = Some A" by auto
  have rdp_A: "rdp_A \<in> set (filter ((\<noteq>) []) (compute_rdp ren RR ll))" 
    unfolding set_filter
    apply (intro CollectI conjI)
     apply (unfold compute_rdp, intro CollectI exI[of _ A] exI[of _ rdp_A])
    using alt cond by (auto simp add: \<beta>)
  have AB: "(A, B) \<in> set (sim_cp_root_of ren (ll,rr) rdp_A)" 
    unfolding sim_cp_root_of_def fst_conv snd_conv
    apply (unfold l[symmetric])
    apply (unfold ren_as[symmetric])
    apply (unfold Let_def[of l])
    apply (unfold Let_def[of renamed_lhs_\<alpha>s])
    apply (unfold mgu option.simps)
    apply (unfold As[symmetric] Let_def)
    apply (unfold join option.simps)
    using alt cond by auto
  show "(A,B) \<in> set (sim_cp_root_impl ren RR SS)" unfolding sim_cp_root_impl_def List.maps_eq set_concat set_map image_cong
    apply (intro UnionI, rule imageI, rule imageI[OF llrr])
    apply (unfold set_concat, intro UnionI, rule imageI)
     apply (unfold set_map fst_conv, rule imageI[OF rdp_A])
    by (rule AB)
qed

lemma sim_cp_non_root_impl_complete: "sim_cp_non_root \<subseteq> set (sim_cp_non_root_impl ren RR SS)" 
proof
  fix A B
  assume "(A,B) \<in> sim_cp_non_root" 
  from this[unfolded sim_cp_non_root_many_conds]
  obtain \<tau> rdp_A l \<beta> q As renamed_lhs_\<alpha>s \<alpha> rdpA Bs  where
    alt: "alt_cond \<tau> rdp_A l \<beta> q A B As renamed_lhs_\<alpha>s" 
    and q_ne: "q \<noteq> []" 
    and rdpA: "rdp_A = (\<alpha>, []) # rdpA"
    and ruleA: "to_rule \<alpha> \<in> R" 
    and q: "q \<in> fun_poss (lhs \<alpha>)" 
    and mgu_root: "mgu_vd_list ren [(lhs \<beta>, lhs \<alpha> |_ q)] \<noteq> None" 
    and cond: "\<forall>(\<alpha>', p)\<in>set rdpA. to_rule \<alpha>' \<in> R \<and> p \<in> (@) q ` fun_poss (lhs \<beta>) \<and> mgu_vd_list ren [(lhs \<beta> |_ (p -\<^sub>p q), lhs \<alpha>')] \<noteq> None" 
    and ABs: "A = Prule \<alpha> Bs"
    by blast
  define addp :: "pos \<Rightarrow> (('b, 'a) prule \<times> nat list) \<Rightarrow> (('b, 'a) prule \<times> nat list)" 
    where "addp p = (map_prod id ((@) p))" for p 
  have addp: "addp p = (\<lambda>(\<alpha>, q). (\<alpha>, p @ q))" for p unfolding addp_def by (intro ext, force)
  let ?addp = "\<lambda> p. map (addp p)" 
  obtain ll rr where \<beta>: "\<beta> = Rule ll rr" by (cases \<beta>, auto)
  hence lhsb: "lhs \<beta> = ll" by simp
  note cond = cond[unfolded this]
  obtain lf rf where \<alpha>: "\<alpha> = Rule lf rf" by (cases \<alpha>, auto)
  hence lhsa: "lhs \<alpha> = lf" by simp
  from q_ne q have qmem: "q \<in> set (filter ((\<noteq>) []) (fun_poss_list (lhs (Rule lf rf))))" by (auto simp: \<alpha>)
  note alt = alt[unfolded alt_cond_def \<beta> \<alpha>]
  from alt have l: "l = (ctxt_of_pos_term q (hd renamed_lhs_\<alpha>s))\<langle>map_vars_term (rename_single ren) ll\<rangle>" by (simp add: \<beta>)
  from alt have ren_as: "renamed_lhs_\<alpha>s = rename_list (map (\<lambda>(\<alpha>, p). lhs \<alpha>) rdp_A)" by (simp add: \<beta>)
  from alt SS have llrr: "(ll,rr) \<in> set SS" by auto
  from alt have mgu: "mgu_list (map2 (\<lambda>x y. (x, l |_ y)) renamed_lhs_\<alpha>s (map snd rdp_A)) =  Some \<tau>" by auto
  from alt have As: "As = map2
                      (\<lambda>(\<alpha>i, pi) i.
                          (ctxt_of_pos_term pi
                            (to_pterm (l \<cdot> \<tau>)))\<langle>Prule \<alpha>i (map (to_pterm \<circ> \<tau> \<circ> rename_many' ren i) (vars_term_list (lhs \<alpha>i)))\<rangle>)
                      rdp_A [0..<length rdp_A]" by auto
  from alt have join: "\<Squnion> As = Some A" by auto
  from alt have A: "A \<in> wf_pterm R" by auto
  from ruleA have lfrf: "(lf,rf) \<in> R" unfolding \<alpha> by auto
  define ps where "ps = var_poss_list (lhs \<alpha>)" 
  from A[unfolded ABs] have "length Bs = length (var_rule \<alpha>)" using wf_pterm.cases by force
  also have "\<dots> = length (var_poss_list (lhs \<alpha>))" using ruleA 
    by (metis length_var_poss_list R.vars_rule_vars_lhs)
  finally have len_ps: "length ps = length Bs" by (simp add: ps_def)
  from alt rdpA have "(\<alpha>, []) # rdpA = redex_patterns A" by simp
  also have "\<dots> = (\<alpha>, []) # concat (map2 ?addp ps (map redex_patterns Bs))" 
    unfolding ABs redex_patterns.simps addp ps_def by simp
  also have "map2 ?addp ps (map redex_patterns Bs) = map (\<lambda> i. ?addp (ps ! i) (redex_patterns (Bs ! i))) [0..<length Bs]" 
    using len_ps by (intro nth_equalityI, auto)
  finally have rdpABs: "rdpA = concat (map (\<lambda>i. ?addp (ps ! i) (redex_patterns (Bs ! i))) [0..<length Bs])" by auto
  from llrr have mgu_mem: "(ll,rr) \<in> set (filter (\<lambda>(ll, rr). mgu_vd_list ren [(ll, lf |_ q)] \<noteq> None) SS)" 
    using mgu_root unfolding \<alpha> \<beta> by auto
  have vp_lf: "var_poss_list lf = ps" unfolding ps_def \<alpha> by simp
  {
    fix i
    assume i: "i < length ps" 
    let ?p = "ps ! i" 
    have "?addp ?p (redex_patterns (Bs ! i))
         \<in> set (if q \<le>\<^sub>p ?p \<and> ?p -\<^sub>p q \<in> fun_poss ll then map (?addp ?p) (compute_rdp ren RR (ll |_ (?p -\<^sub>p q))) else [[]])" (is "?prp \<in> ?Set")
    proof (cases "q \<le>\<^sub>p ?p \<and> ?p -\<^sub>p q \<in> fun_poss ll")
      case False
      have "redex_patterns (Bs ! i) = []" 
      proof (rule ccontr)
        assume "\<not> ?thesis"
        then obtain \<gamma> r where mem: "(\<gamma>,r) \<in> set (redex_patterns (Bs ! i))" (is "_ \<in> set ?e") by (cases ?e, auto) 
        with i len_ps have "addp ?p (\<gamma>,r) \<in> set rdpA" unfolding rdpABs by auto
        from cond[rule_format, OF this]
        have "?p @ r \<in> (@) q ` fun_poss ll" by (auto simp: addp)
        then obtain u where u: "u \<in> fun_poss ll" and id: "?p @ r = q @ u" by auto
        from q have q: "q \<in> fun_poss lf" unfolding lhsa .
        from i have "?p \<in> set ps" by auto
        also have "set ps = var_poss lf" unfolding vp_lf[symmetric] by simp
        finally have "?p \<in> var_poss lf" by auto
        with q have not: "\<not> ?p \<le>\<^sub>p q"
          by (metis Term.term.simps(4) fun_poss_append_poss' fun_poss_fun_conv prefix_def var_poss_iff)
        with id have qp: "q \<le>\<^sub>p ?p" 
          by (metis prefixI prefix_append)
        with False have "\<not> ?p -\<^sub>p q \<in> fun_poss ll" by auto
        with id u qp show False
          by (metis fun_poss_append_poss' less_eq_pos_simps(2) prefixI prefix_pos_diff)
      qed
      with False show ?thesis by auto
    next
      case True
      hence qp: "q \<le>\<^sub>p ?p" and pq: "?p -\<^sub>p q \<in> fun_poss ll" by auto
      hence id: "?Set = ?addp ?p ` set (compute_rdp ren RR (ll |_ (?p -\<^sub>p q)))" by auto
      from A ABs i len_ps have Bsi: "Bs ! i \<in> wf_pterm R" by auto 
      {
        fix \<gamma> r 
        assume "(\<gamma>, r)\<in>set (redex_patterns (Bs ! i))"
        hence "addp ?p (\<gamma>, r) \<in> set rdpA" unfolding rdpABs using i len_ps by auto
        from cond[rule_format, OF this, unfolded split addp]
        have cond: "?p @ r \<in> (@) q ` fun_poss ll" "mgu_vd_list ren [(ll |_ ((?p @ r) -\<^sub>p q), lhs \<gamma>)] \<noteq> None" 
          by auto
        from qp fun_poss_imp_poss[OF pq] have "ll |_ ((?p @ r) -\<^sub>p q) = ll |_ (?p -\<^sub>p q) |_ r" 
          by (metis append.assoc less_eq_pos_simps(1) prefix_pos_diff same_append_eq subt_at_append)
        moreover from cond qp pq have "r \<in> fun_poss (ll |_ (?p -\<^sub>p q))"
          by (smt (verit, ccfv_threshold) append.assoc fun_poss_poss imageE prefix_pos_diff same_append_eq subterm_poss_conv)
        ultimately have "r \<in> fun_poss (ll |_ (?p -\<^sub>p q)) \<and> mgu_vd_list ren [(ll |_ (?p -\<^sub>p q) |_ r, lhs \<gamma>)] \<noteq> None" 
          using cond by auto
      } note mgu = this
      show ?thesis unfolding id 
      proof (rule imageI)
        show "redex_patterns (Bs ! i) \<in> set (compute_rdp ren RR (ll |_ (?p -\<^sub>p q)))" 
          unfolding compute_rdp
          apply (intro CollectI exI conjI)
             apply (rule refl)
            apply (rule Bsi)
          using mgu by auto
      qed        
    qed
  } note member = this
  have rdpA': "(lf \<rightarrow> rf, []) # rdpA = rdp_A" unfolding rdpA \<alpha> by simp
  show "(A,B) \<in> set (sim_cp_non_root_impl ren RR SS)" unfolding sim_cp_non_root_impl_def List.maps_eq set_concat set_map image_cong RR
    apply (intro UnionI, rule imageI, rule imageI[OF lfrf])
    apply (unfold split Let_def)
    apply (unfold set_concat, intro UnionI, rule imageI)
     apply (unfold set_map, rule imageI[OF qmem])
    apply (unfold set_concat, intro UnionI, rule imageI)
     apply (unfold set_map, rule imageI, rule mgu_mem)
    apply (unfold non_root_sim_cps_def List.maps_eq)
    apply (unfold split set_concat, intro UnionI, rule imageI)
     apply (unfold set_map, rule imageI)
     apply (rule eq_mem_trans[OF rdpABs])
    apply (unfold non_root_rdps_def set_concat set_map prule.sel)
     apply (rule imageI)
     apply (unfold vp_lf addp_def[symmetric])
     apply (unfold set_concat_lists length_map)
     apply (rule CollectI, rule conjI, force simp: len_ps)
     apply (intro allI impI)
    subgoal for i using member[of i] by (simp add: len_ps)
    apply (unfold sim_cp_non_root_of_def)
    apply (unfold rdpA' Let_def[of rdp_A])
    apply (unfold ren_as[symmetric] Let_def[of renamed_lhs_\<alpha>s] prule.sel)
    apply (unfold l[symmetric] Let_def[of l])
    apply (unfold mgu option.simps)
    apply (unfold As[symmetric] Let_def)
    apply (unfold join option.simps)
    using alt cond by auto
qed

lemma sim_cp_root_of_alt_cond: assumes AB: "(A,B) \<in> set (sim_cp_root_of ren (ll,rr) rdp_A)" 
  and llrr: "(ll,rr) \<in> S"
  and ne: "rdp_A \<noteq> []" 
  and rdpA: "rdp_A \<in> set (compute_rdp ren RR ll)" 
  shows "\<exists> \<tau> l As ren_as. alt_cond \<tau> rdp_A l (Rule ll rr) [] A B As ren_as" 
proof -
  from AB obtain l ren_as \<tau> As where
         l: "l = map_vars_term (rename_single ren) ll" 
     and ren_as: "ren_as = rename_list (map (\<lambda>(\<alpha>, p). lhs \<alpha>) rdp_A)" 
     and mgu: "mgu_list (map2 (\<lambda>x y. (x, l |_ y)) ren_as (map snd rdp_A)) = Some \<tau>" 
     and As: "As = map2  (\<lambda> prod i. case prod of (\<alpha>i, pi) \<Rightarrow> (ctxt_of_pos_term pi
           (to_pterm (l \<cdot> \<tau>)))\<langle>Prule \<alpha>i (map (to_pterm \<circ> \<tau> \<circ> rename_many' ren i) (vars_term_list (lhs \<alpha>i)))\<rangle>)
           rdp_A [0..<length rdp_A]" 
     and join: "\<Squnion> As = Some A" 
     and B: "B = Prule (ll \<rightarrow> rr) (map (to_pterm \<circ> \<tau> \<circ> rename_single ren) (vars_term_list ll))" 
    unfolding sim_cp_root_of_def
    by (force simp: Let_def o_def) 
  have As': "As = map2  (\<lambda> (\<alpha>i, pi) i. (ctxt_of_pos_term pi
           (to_pterm (l \<cdot> \<tau>)))\<langle>Prule \<alpha>i (map (to_pterm \<circ> \<tau> \<circ> rename_many' ren i) (vars_term_list (lhs \<alpha>i)))\<rangle>)
           rdp_A [0..<length rdp_A]" unfolding As by auto
  from rdpA[unfolded compute_rdp]
  obtain A' where A': "A' \<in> wf_pterm R" "rdp_A = redex_patterns A'" 
    and rdp_cond: "\<And> \<alpha> q. (\<alpha>,q) \<in> set rdp_A \<Longrightarrow> q \<in> fun_poss ll \<and> mgu_vd_list ren [(ll |_ q, lhs \<alpha>)] \<noteq> None" 
    by force
  show ?thesis
  proof (intro exI conjI)
    show "alt_cond \<tau> rdp_A l (Rule ll rr) [] A B As ren_as" unfolding alt_cond_def prule.sel ctxt_of_pos_term.simps intp_actxt.simps
    proof (intro conjI; (fact)?)
      {
        fix \<alpha> p
        assume mem: "(\<alpha>,p) \<in> set rdp_A" 
        with A' have rule: "to_rule \<alpha> \<in> R"
          using R.redex_pattern_rule_symbol by blast
        from rule have len: "length (vars_term_list (lhs \<alpha>)) = length (var_rule \<alpha>)"
          by (metis R.length_var_rule)
        from rule have fn: "is_Fun (lhs \<alpha>)" 
          using R.no_var_lhs by fastforce
        from rdp_cond[OF mem]
        have p: "p \<in> fun_poss ll" by auto
        hence inter: "p \<in> (@) p ` fun_poss (lhs \<alpha>) \<inter> (@) [] ` fun_poss ll" using fn by (cases "lhs \<alpha>", auto) 
        from fun_poss_imp_poss[OF p] have "p \<in> poss (l \<cdot> \<tau>)" unfolding l by auto
        note rule len inter this
      } note rdp_A_conds = this
      thus "\<forall>(\<alpha>, p)\<in>set rdp_A. (@) p ` fun_poss (lhs \<alpha>) \<inter> (@) [] ` fun_poss ll \<noteq> {}" "\<forall>(\<alpha>, p)\<in>set rdp_A. to_rule \<alpha> \<in> R" by fast+
      show "redex_patterns B = [(ll \<rightarrow> rr, [])]" unfolding B by (auto simp: set_zip redex_patterns_to_pterm)
      from llrr have "length (vars_term_list ll) = length (var_rule (Rule ll rr))"
        by (metis S.length_var_rule prule.sel(1,2))
      thus "B \<in> wf_pterm S" unfolding B by (auto intro!: wf_pterm.intros llrr)  
      {
        fix i \<alpha> p
        assume "i < length rdp_A" "(\<alpha>, p) = rdp_A ! i" 
        hence "(\<alpha>,p) \<in> set rdp_A" by auto
        note rdp_A_conds = rdp_A_conds[OF this]
      } note rdp_A_conds_ith = this
      have wf_As: "set As \<subseteq> wf_pterm R" unfolding As using rdp_A_conds_ith
        by (auto simp: wf_pterm_ctxt_apply set_zip intro!: ctxt_of_pos_term_well wf_pterm.intros)
      thus wf_A: "A \<in> wf_pterm R" using R.join_list_wf_pterm[OF _ join] by auto
      from R.redex_patterns_join_list[OF join] wf_As
      have "set (redex_patterns A) = \<Union> (set (map (set \<circ> redex_patterns) As))" by auto
      also have "\<dots> = \<Union> { set (redex_patterns ((ctxt_of_pos_term pi (to_pterm (l \<cdot> \<tau>)))\<langle>Prule \<alpha>i (map (\<lambda>x. to_pterm (\<tau> (rename_many' ren i x))) (vars_term_list (lhs \<alpha>i)))\<rangle>))
          | i \<alpha>i pi. i < length rdp_A \<and> rdp_A ! i = (\<alpha>i,pi)}" unfolding set_map o_def As set_zip by force
      also have "\<dots> = \<Union> { {(\<alpha>i, pi)} | i \<alpha>i pi. i < length rdp_A \<and> rdp_A ! i = (\<alpha>i,pi)}" 
      proof (intro arg_cong[of _ _ "(\<Union>)"] Collect_cong ex_cong1 rev_conj_cong refl arg_cong[of _ _ "(=) _"])
        fix \<alpha>i pi i
        assume "i < length rdp_A \<and> rdp_A ! i = (\<alpha>i, pi)" 
        hence "(\<alpha>i, pi) \<in> set rdp_A" by (force simp: set_conv_nth)
        from rdp_A_conds[OF this] 
        have "to_rule \<alpha>i \<in> R" and pi: "pi \<in> poss (l \<cdot> \<tau>)" by auto
        have "set (redex_patterns
             (ctxt_of_pos_term pi (to_pterm (l \<cdot> \<tau>)))\<langle>Prule \<alpha>i (map (\<lambda>x. to_pterm (\<tau> (rename_many' ren i x))) (vars_term_list (lhs \<alpha>i)))\<rangle>)
          = (\<lambda>(\<alpha>, q). (\<alpha>, pi @ q)) ` set (redex_patterns (Prule \<alpha>i (map (\<lambda>x. to_pterm (\<tau> (rename_many' ren i x))) (vars_term_list (lhs \<alpha>i)))))" (is "?lhs = _")
          by (subst R.redex_patterns_context[OF pi], simp)
        also have "set (redex_patterns (Prule \<alpha>i (map (\<lambda>x. to_pterm (\<tau> (rename_many' ren i x))) (vars_term_list (lhs \<alpha>i))))) = {(\<alpha>i, [])}" 
          by (auto simp: o_def redex_patterns_to_pterm set_zip)
        also have "(\<lambda>(\<alpha>, q). (\<alpha>, pi @ q)) ` \<dots> = {(\<alpha>i, pi)}" by auto
        finally show "?lhs = {(\<alpha>i, pi)} " .
      qed
      also have "\<dots> = \<Union> {u. \<exists>i. u = {rdp_A ! i} \<and> i < length rdp_A}" 
        by (intro arg_cong[of _ _ "(\<Union>)"] Collect_cong ex_cong1, force)  
      also have "\<dots> = set rdp_A" unfolding set_conv_nth by blast
      finally have "set rdp_A = set (redex_patterns A)" by auto
      from R.redex_patterns_equal[OF wf_A _ this] A'
      show "redex_patterns A = rdp_A" using R.redex_patterns_sorted by auto
    qed auto
  qed
qed
  

lemma sim_cp_root_impl_sound: "set (sim_cp_root_impl ren RR SS) \<subseteq> sim_cp_root" 
proof
  fix A B
  assume "(A, B) \<in> set (sim_cp_root_impl ren RR SS)" 
  from this[unfolded sim_cp_root_impl_def List.maps_eq, simplified] SS obtain rule rdp_A 
    where llrr: "rule \<in> S" 
     and rdpA: "rdp_A \<in> set (compute_rdp ren RR (fst rule))" 
     and ne: "rdp_A \<noteq> []" 
     and AB: "(A, B) \<in> set (sim_cp_root_of ren rule rdp_A)" by auto
  obtain ll rr where rule: "rule = (ll,rr)" by force
  from sim_cp_root_of_alt_cond[OF AB[unfolded rule] llrr[unfolded rule]] ne rdpA[unfolded rule fst_conv]
  show "(A,B) \<in> sim_cp_root" unfolding sim_cp_root_def by blast
qed

lemma sim_cp_non_root_of_alt_cond: 
  assumes lfrf: "(lf,rf) \<in> R"
    and llrr: "(ll,rr) \<in> S" 
    and q_ne: "q \<noteq> []" 
    and q: "q \<in> fun_poss lf" 
    and rdpA: "rdpA \<in> set (non_root_rdps ren RR (Rule lf rf) q ll)" 
    and AB: "(A,B) \<in> set (sim_cp_non_root_of ren (Rule lf rf) q (Rule ll rr) rdpA)"
  shows "\<exists> l As \<tau> ren_as Bs. alt_cond \<tau> ((Rule lf rf, []) # rdpA) l (Rule ll rr) q A B As ren_as \<and> q \<noteq> [] \<and> A = Prule (Rule lf rf) Bs"
proof -
  define rdp_A where rdp_A_eq: "rdp_A = (Rule lf rf, []) # rdpA" 
  define ren_as where ren_as: "ren_as = rename_list (map (\<lambda>(\<alpha>, p). lhs \<alpha>) rdp_A)"
  define l where l: "l = (ctxt_of_pos_term q (hd ren_as))\<langle>map_vars_term (rename_single ren) ll\<rangle>"
  from AB[unfolded sim_cp_non_root_of_def List.maps_eq Let_def prule.sel, folded rdp_A_eq, folded ren_as, folded l]
  obtain As \<tau>
    where mgu: "mgu_list (map2 (\<lambda> lhs_\<alpha> p. (lhs_\<alpha>, l|_p)) ren_as (map snd rdp_A)) = Some \<tau>" 
      and As: "As = map2 (\<lambda>(\<alpha>i, pi) i. (ctxt_of_pos_term pi (to_pterm (l \<cdot> \<tau>)))\<langle>Prule \<alpha>i (map (to_pterm \<circ> \<tau> \<circ> rename_many' ren i) 
          (vars_term_list (lhs \<alpha>i)))\<rangle>) rdp_A [0..<length rdp_A]" 
      and join: "\<Squnion> As = Some A" 
      and B: "B = replace_at (to_pterm (l \<cdot> \<tau>)) q (Prule (Rule ll rr) (map (to_pterm \<circ> \<tau> \<circ> ren_l ren) (vars_term_list ll)))"  
    by (force simp: Let_def o_def)
  show ?thesis unfolding rdp_A_eq[symmetric]
    unfolding alt_cond_def
  proof (intro exI conjI)
    show "mgu_list (map2 (\<lambda> lhs_\<alpha> p. (lhs_\<alpha>, l|_p)) ren_as (map snd rdp_A)) = Some \<tau>" by fact
    show "ren_as = rename_list (map (\<lambda>(\<alpha>, p). lhs \<alpha>) rdp_A)" by fact
    show "l = (ctxt_of_pos_term q (hd ren_as))\<langle>map_vars_term (rename_single ren) (lhs (Rule ll rr))\<rangle>" 
      unfolding l by simp
    show "q = [] \<or> snd (hd rdp_A) = []" unfolding rdp_A_eq by auto
    show "\<Squnion> As = Some A" by fact
    show "B = (ctxt_of_pos_term q (to_pterm (l \<cdot> \<tau>)))\<langle>Prule (ll \<rightarrow> rr) (map (to_pterm \<circ> \<tau> \<circ> rename_single ren) (vars_term_list (lhs (ll \<rightarrow> rr))))\<rangle>"
      unfolding B by simp
    show "rdp_A \<noteq> []" unfolding rdp_A_eq by simp
    show "to_rule (ll \<rightarrow> rr) \<in> S" using llrr by auto
    show "q \<noteq> []" by fact
    show "As =
      map2 (\<lambda>(\<alpha>i, pi) i. (ctxt_of_pos_term pi (to_pterm (l \<cdot> \<tau>)))\<langle>Prule \<alpha>i (map (to_pterm \<circ> \<tau> \<circ> rename_many' ren i) (vars_term_list (lhs \<alpha>i)))\<rangle>)
        rdp_A [0..<length rdp_A]" 
      by fact
    have idx: "[0..<length (x # rdpA)] = 0 # map Suc [0..<length rdpA]" for x unfolding rdp_A_eq 
      using map_Suc_upt upt_rec by fastforce
    from fun_poss_imp_poss[OF q] have ql: "q \<in> poss l" unfolding l ren_as rename_list_def rdp_A_eq length_map idx
      by simp (metis hole_pos_ctxt_of_pos_term hole_pos_poss poss_map_vars_term)
    show "redex_patterns B = [(ll \<rightarrow> rr, q)]" unfolding B o_def 
      by (subst S.redex_patterns_context, insert ql, auto dest!: set_zip_rightD simp: redex_patterns_to_pterm)
    from llrr have len_llrr: "length (var_rule (Rule ll rr)) = length (vars_term_list ll)"       
      by (metis prule.sel(1,2) S.vars_rule_vars_lhs)
    show "B \<in> wf_pterm S" unfolding B using len_llrr ql
      by (auto simp: wf_pterm_ctxt_apply to_pterm_trs_ctxt intro!: wf_pterm.intros llrr)
    have len_As: "length As = length rdp_A" unfolding As by auto
    define ps where "ps = var_poss_list lf" 
    define addp :: "pos \<Rightarrow> (('b, 'a) prule \<times> nat list) \<Rightarrow> (('b, 'a) prule \<times> nat list)" 
      where "addp p = (map_prod id ((@) p))" for p 
    have addp: "addp p = (\<lambda>(\<alpha>, q). (\<alpha>, p @ q))" for p unfolding addp_def by (intro ext, force)
    from rdpA[unfolded non_root_rdps_def set_map set_concat_lists prule.sel, folded ps_def, simplified]
    obtain rdps where rdpA_conv: "rdpA = concat rdps" 
      and len_rdps: "length rdps = length ps" 
      and rdps_cond: "\<And> i. i < length ps \<Longrightarrow> rdps ! i
          \<in> set (if q \<le>\<^sub>p ps ! i \<and> ps ! i -\<^sub>p q \<in> fun_poss ll
                  then map (map (addp (ps ! i))) (compute_rdp ren RR (ll |_ (ps ! i -\<^sub>p q))) else [[]])" 
      unfolding addp_def by auto
    from llrr have funl: "is_Fun ll" 
      using S.no_var_lhs by auto 
    hence qll: "q \<in> (@) q ` fun_poss (lhs (ll \<rightarrow> rr))" by (cases ll, auto)
    {
      fix \<alpha>i p
      assume "(\<alpha>i,p) \<in> set rdpA" 
      from this[unfolded rdpA_conv set_concat set_conv_nth[of rdps] len_rdps]
      obtain i where i: "i < length ps" and mem: "(\<alpha>i,p) \<in> set (rdps ! i)" by auto
      from rdps_cond[OF i] mem
      have pos: "q \<le>\<^sub>p ps ! i" "ps ! i -\<^sub>p q \<in> fun_poss ll" 
        and rdpsi: "rdps ! i \<in> map (addp (ps ! i)) ` set (compute_rdp ren RR (ll |_ (ps ! i -\<^sub>p q)))" 
        by (auto split: if_splits)
      then obtain rdpi where rdpi: "rdpi \<in> set (compute_rdp ren RR (ll |_ (ps ! i -\<^sub>p q)))" 
        and rdpsi: "rdps ! i = map (addp (ps ! i)) rdpi" by auto
      from mem[unfolded rdpsi] obtain u where mem: "(\<alpha>i,u) \<in> set rdpi" 
        and p: "p = ps ! i @ u" unfolding addp_def by auto
      from rdpi[unfolded compute_rdp] mem obtain C where C: "(\<alpha>i,u) \<in> set (redex_patterns C)" "C \<in> wf_pterm R" 
        and u: "u \<in> fun_poss (ll |_ (ps ! i -\<^sub>p q))" by auto
      from C have \<alpha>i: "to_rule \<alpha>i \<in> R" using R.redex_pattern_rule_symbol by blast

      hence "is_Fun (lhs \<alpha>i)" 
        using R.no_var_lhs by fastforce
      hence "p \<in> (@) p ` fun_poss (lhs \<alpha>i)" by (cases "lhs \<alpha>i", auto)
      moreover have p: "p \<in> (@) q ` fun_poss (lhs (ll \<rightarrow> rr))" using u p pos
        by simp (smt (verit, best) append.assoc fun_poss_poss image_eqI poss_append_poss prefix_pos_diff subt_at_append)
      ultimately have over: "(@) p ` fun_poss (lhs \<alpha>i) \<inter> (@) q ` fun_poss (lhs (ll \<rightarrow> rr)) \<noteq> {}" by auto

      from p have "p \<in> (@) q ` fun_poss ll" by auto

      note \<alpha>i over this
    } note rdpA_cond = this
    thus "\<forall>(\<alpha>, p)\<in>set rdp_A. (@) p ` fun_poss (lhs \<alpha>) \<inter> (@) q ` fun_poss (lhs (ll \<rightarrow> rr)) \<noteq> {}" 
      "\<forall>(\<alpha>, p)\<in>set rdp_A. to_rule \<alpha> \<in> R" 
      unfolding rdp_A_eq using lfrf qll q
      by auto
    {
      fix i
      assume i: "i < length ps" 
      have "\<exists> C. C \<in> wf_pterm R \<and> rdps ! i = map (addp (ps ! i)) (redex_patterns C)" 
      proof (cases "q \<le>\<^sub>p ps ! i \<and> ps ! i -\<^sub>p q \<in> fun_poss ll")
        case True
        with rdps_cond[OF i] compute_rdp[of "ll |_ (ps ! i -\<^sub>p q)"]
        show ?thesis by auto
      next
        case False
        with rdps_cond[OF i]
        show ?thesis by (intro exI[of _ "Var undefined"], auto)
      qed
    } 
    hence "\<forall> i. \<exists> C. i < length ps \<longrightarrow> C \<in> wf_pterm R \<and> rdps ! i = map (addp (ps ! i)) (redex_patterns C)" by auto
    from choice[OF this] obtain C where C: "\<And> i. i < length ps \<Longrightarrow> C i \<in> wf_pterm R" 
      and rdpsi: "\<And>i. i < length ps \<Longrightarrow> rdps ! i = map (addp (ps ! i)) (redex_patterns (C i))" by auto
    have rdpsC: "rdpA = concat (map (\<lambda> i. map (addp (ps ! i)) (redex_patterns (C i))) [0..<length ps])" 
      unfolding rdpA_conv 
      by (rule arg_cong[of _ _ concat], rule nth_equalityI, insert rdpsi, auto simp: len_rdps)
    hence rdp_AC: "rdp_A = (lf \<rightarrow> rf, []) # concat (map (\<lambda> i. map (addp (ps ! i)) (redex_patterns (C i))) [0..<length ps])" 
      unfolding rdp_A_eq by auto
    let ?D = "Prule (lf \<rightarrow> rf) (map C [0..<length ps])" 
    from lfrf have len_lf: "length (var_rule (lf \<rightarrow> rf)) = length ps"
      by (metis length_var_poss_list R.length_var_rule prule.sel(1,2) ps_def)
    have D: "?D \<in> wf_pterm R" using lfrf len_lf C by (auto intro!: wf_pterm.intros)
    have rp_D: "redex_patterns ?D = rdp_A" unfolding rdp_AC using len_lf
      by (auto simp: addp o_def ps_def[symmetric] intro!: arg_cong[of _ _ concat] nth_equalityI)
    have As: "As = Prule (lf \<rightarrow> rf) (map (to_pterm \<circ> \<tau> \<circ> rename_many' ren 0) (vars_term_list lf)) # 
      map (\<lambda> i. case rdpA ! i of (\<alpha>i,pi) \<Rightarrow> 
      (ctxt_of_pos_term pi (to_pterm (l \<cdot> \<tau>)))\<langle>Prule \<alpha>i (map (to_pterm \<circ> \<tau> \<circ> rename_many' ren (Suc i)) (vars_term_list (lhs \<alpha>i)))\<rangle>) 
      [0..<length rdpA]" 
      unfolding As rdp_A_eq idx 
      apply simp
      apply (intro nth_equalityI)
       apply force
      subgoal for i by (cases "rdpA ! i", auto)
      done
    have len_lf': "length (var_rule (Rule lf rf)) = length (vars_term_list lf)" 
      unfolding len_lf ps_def using length_var_poss_list by blast
    have "hd ren_as = map_vars_term (rename_many' ren 0) lf" 
      unfolding ren_as rdp_A_eq rename_list_def length_map 
      by (simp add: upt_conv_Cons del: upt_Suc)
    note l = l[unfolded this]
    {
      fix i \<alpha> p
      assume "i < length rdpA" "rdpA ! i = (\<alpha>, p)"
      hence "(\<alpha>,p) \<in> set rdpA" by (force simp: set_conv_nth)
      from rdpA_cond[OF this] have rule: "to_rule \<alpha> \<in> R" 
          and "p \<in> (@) q ` fun_poss ll" by auto
      then obtain r where p: "p = q @ r" "r \<in> fun_poss ll" by auto
      from rule have len: "length (vars_term_list (lhs \<alpha>)) = length (var_rule \<alpha>)"
        using R.length_var_rule by auto
      have p: "p \<in> poss (l \<cdot> \<tau>)" unfolding l using fun_poss_imp_poss[OF q] fun_poss_imp_poss[OF p(2)] p(1) 
        by (auto simp add: poss_ctxt_apply map_vars_term_as_subst)
      note p rule len
    } note rdpA_conds = this
    hence wf_As: "\<forall>a\<in>set As. a \<in> wf_pterm R" unfolding As using len_lf'
      by (auto split: prod.splits simp: wf_pterm_ctxt_apply intro!: ctxt_of_pos_term_well wf_pterm.intros lfrf)
    from R.join_list_wf_pterm[OF wf_As join] 
    show A: "A \<in> wf_pterm R" by auto
    show "redex_patterns A = rdp_A" 
    proof (rule R.redex_patterns_equal[OF A R.redex_patterns_sorted, symmetric, unfolded R.redex_patterns_join_list[OF join wf_As],
        OF D, unfolded rp_D])
      have "\<Union> (set (map (set \<circ> redex_patterns) As)) = 
        insert (lf \<rightarrow> rf, [])
      (\<Union>x\<in>{0..<length rdpA}. case rdpA ! x of
                 (\<alpha>i, pi) \<Rightarrow>
          set (redex_patterns                (
                   (ctxt_of_pos_term pi
                     (to_pterm (l \<cdot> \<tau>)))\<langle>Prule \<alpha>i (map (\<lambda>xa. to_pterm (\<tau> (rename_many' ren (Suc x) xa))) (vars_term_list (lhs \<alpha>i)))\<rangle>)))" (is "_ = insert ?rp ?rest")
        unfolding As o_def set_map
        by (auto simp add: set_zip o_def redex_patterns_to_pterm)
      also have "?rest = (\<Union>x\<in>{0..<length rdpA}. {rdpA ! x})" 
      proof (rule arg_cong[of _ _ Union], intro image_cong refl, goal_cases)
        case (1 i) 
        hence i: "i < length rdpA" by auto
        obtain \<alpha>i pi where eq: "rdpA ! i = (\<alpha>i,pi)" by force
        from rdpA_conds[OF i eq] have pi: "pi \<in> poss (l \<cdot> \<tau>)" by auto
        have "set (redex_patterns
                  (ctxt_of_pos_term pi
                    (to_pterm (l \<cdot> \<tau>)))\<langle>Prule \<alpha>i (map (\<lambda>xa. to_pterm (\<tau> (rename_many' ren (Suc i) xa))) (vars_term_list (lhs \<alpha>i)))\<rangle>)
          = {(\<alpha>i,pi)}" 
          unfolding R.redex_patterns_context[OF pi]
          by (auto simp add: o_def redex_patterns_to_pterm set_zip)
        with eq show ?case by simp
      qed
      also have "\<dots> = set rdpA" unfolding set_conv_nth by auto
      also have "insert ?rp \<dots> = set rdp_A" unfolding rdp_A_eq by simp
      finally show "set rdp_A = \<Union> (set (map (set \<circ> redex_patterns) As))" ..
    qed
    note rdp = this[unfolded rdp_A_eq] 
    have "\<exists> As. A = Prule (Rule lf rf) As"  
    proof (cases A)
      case (Pfun f As)
      have "[] \<notin> snd ` set (redex_patterns A)" unfolding Pfun by force
      from this[unfolded rdp] have False by force 
      thus ?thesis by auto
    qed (insert rdp, auto)
    thus "A = Prule (Rule lf rf) (args A)" by (cases A, auto)
  qed
qed

lemma non_root_sim_cps_alt_cond: 
  assumes lfrf: "(lf,rf) \<in> R"
    and llrr: "(ll,rr) \<in> S" 
    and q_ne: "q \<noteq> []" 
    and q: "q \<in> fun_poss lf" 
    and AB: "(A,B) \<in> set (non_root_sim_cps ren RR (Rule lf rf) q (Rule ll rr))"
  shows "\<exists> rdp_A l As \<tau> ren_as Bs. alt_cond \<tau> rdp_A l (Rule ll rr) q A B As ren_as \<and> q \<noteq> [] \<and> A = Prule (Rule lf rf) Bs"
proof -
  from AB[unfolded non_root_sim_cps_def List.maps_eq, simplified]
  obtain rdpA where "rdpA \<in> set (non_root_rdps ren RR (Rule lf rf) q ll)" 
    and "(A, B) \<in> set (sim_cp_non_root_of ren (Rule lf rf) q (Rule ll rr) rdpA)" by auto
  from sim_cp_non_root_of_alt_cond[OF lfrf llrr q_ne q this]
  show ?thesis by blast
qed


lemma sim_cp_non_root_impl_sound: "set (sim_cp_non_root_impl ren RR SS) \<subseteq> sim_cp_non_root" 
proof
  fix A B
  assume "(A, B) \<in> set (sim_cp_non_root_impl ren RR SS)" 
  from this[unfolded sim_cp_non_root_impl_def List.maps_eq Let_def o_def, simplified] RR SS obtain lf rf q ll rr 
    where lfrf: "(lf,rf) \<in> R"
      and llrr: "(ll,rr) \<in> S" 
      and q_ne: "q \<noteq> []" 
      and q: "q \<in> fun_poss lf" 
      and AB: "(A,B) \<in> set (non_root_sim_cps ren RR (Rule lf rf) q (Rule ll rr))" 
    by metis
  from non_root_sim_cps_alt_cond[OF this]
  show "(A,B) \<in> sim_cp_non_root" unfolding sim_cp_non_root_def using q_ne by blast
qed

lemma sim_cp_root_impl: "set (sim_cp_root_impl ren RR SS) = sim_cp_root" 
  using sim_cp_root_impl_sound sim_cp_root_impl_complete by blast

lemma sim_cp_non_root_impl: "set (sim_cp_non_root_impl ren RR SS) = sim_cp_non_root" 
  using sim_cp_non_root_impl_sound sim_cp_non_root_impl_complete by blast

theorem sim_cp_impl: "set (sim_cp_impl ren RR SS) = sim_cp" 
  unfolding sim_cp_impl_def set_append sim_cp_root_impl sim_cp_non_root_impl
  by (metis sim_cp_split)

lemma sim_cp_root_non_root_disj: "sim_cp_root \<inter> sim_cp_non_root = {}" 
