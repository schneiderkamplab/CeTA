lemma evalAsInf_represents_step:
  assumes
    "evalAsInf prog as\<^sub>1 as\<^sub>2"
    "represents_state cs\<^sub>1 as\<^sub>1 v\<^sub>1"
  shows 
    "isOK (step prog cs\<^sub>1)"
    "step prog cs\<^sub>1 = Inr cs\<^sub>2 \<Longrightarrow> (\<exists>v\<^sub>2. represents_state cs\<^sub>2 as\<^sub>2 v\<^sub>2 \<and> as_as_step as\<^sub>1 as\<^sub>2 v\<^sub>1 v\<^sub>2 id)"
proof -
  (* I choose this format for the lemmas, so that the lemma namespace doesn't get too crowded *)
  have "isOK (step prog cs\<^sub>1)
     \<and> (\<forall>cs\<^sub>2. step prog cs\<^sub>1 = Inr cs\<^sub>2 \<longrightarrow> (\<exists>v\<^sub>2. represents_state cs\<^sub>2 as\<^sub>2 v\<^sub>2 \<and> as_as_step as\<^sub>1 as\<^sub>2 v\<^sub>1 v\<^sub>2 id))"
    using assms proof(induction rule: evalAsInf.induct)
    case (1 n binop o\<^sub>1 o\<^sub>2 l\<^sub>1 te\<^sub>1 l\<^sub>2 te\<^sub>2 \<phi> v\<^sub>n)
    note u = `update_as as\<^sub>1 as\<^sub>2 n (IntType l\<^sub>1) v\<^sub>n \<phi>`
    obtain f\<^sub>1 fs\<^sub>1  where cs\<^sub>1: "frames cs\<^sub>1 = (f\<^sub>1 # fs\<^sub>1)"
      using 1 unfolding represents_state.simps by (metis hd_Cons_tl)
    interpret small_step alloc store load empty_mem prog cs\<^sub>1 f\<^sub>1 fs\<^sub>1 .
    have [simp]: "hd (frames cs\<^sub>1) = f\<^sub>1"
      by (simp add: cs\<^sub>1)
    obtain fn bn p where p: "pos as\<^sub>1 = (fn, bn, p)"
      using prod_cases3 by blast
    then have p': "frame.pos f\<^sub>1 = (fn, bn, p)"
      using 1 cs\<^sub>1 by (auto simp add: represents_state.simps represents_frame.simps)
    have v: "represents_frame f\<^sub>1 as\<^sub>1 v\<^sub>1"
      using 1 unfolding represents_state.simps by auto
    obtain i\<^sub>1 where i\<^sub>1: "IA.eval te\<^sub>1 v\<^sub>1 = IA.Int i\<^sub>1"
      using \<open>SE_Graph.operand_value as\<^sub>1 o\<^sub>1 = Some (IntType l\<^sub>1, te\<^sub>1)\<close> v IA.assignment_eval_int[of v\<^sub>1]
      unfolding represents_frame.simps
        (* Why is this proof taking so long? *)
      by (cases o\<^sub>1) (fastforce elim: SE_Graph.operand_value.elims)+
    obtain i\<^sub>2 where i\<^sub>2: "IA.eval te\<^sub>2 v\<^sub>1 = IA.Int i\<^sub>2"
      using \<open>SE_Graph.operand_value as\<^sub>1 o\<^sub>2 = Some (IntType l\<^sub>2, te\<^sub>2)\<close> v IA.assignment_eval_int[of v\<^sub>1]
      unfolding represents_frame.simps
      by (cases o\<^sub>2) (fastforce elim: SE_Graph.operand_value.elims)+
    have o\<^sub>1: "operand_value o\<^sub>1 = Inr (IntegerValue l\<^sub>1 i\<^sub>1)" "operand_value o\<^sub>2 = Inr (IntegerValue l\<^sub>1 i\<^sub>2)"
      using v 1 i\<^sub>1 i\<^sub>2 operand_value_int_represents_frame by (blast)+
    define s\<^sub>2 where
      "s\<^sub>2 = Mapping.update n (IntegerValue l\<^sub>1 (binop_instruction binop i\<^sub>1 i\<^sub>2)) (frame.stack f\<^sub>1)"
    define f\<^sub>2 where "f\<^sub>2 = update_pos (\<lambda>_. (fn, bn, Suc p)) (LLVM_State.update_stack (\<lambda>_. s\<^sub>2) f\<^sub>1)"
    define cs\<^sub>2 where "cs\<^sub>2 = Llvm_state (f\<^sub>2 # fs\<^sub>1)"
    have cs\<^sub>2: "step prog cs\<^sub>1 = Inr cs\<^sub>2"
      using o\<^sub>1 cs\<^sub>1 1 p' p by (auto simp add: cs\<^sub>2_def f\<^sub>2_def s\<^sub>2_def)
    define v\<^sub>2 where "v\<^sub>2 = v\<^sub>1((v\<^sub>n, IA.IntT) := IA.Int (binop_instruction binop i\<^sub>1 i\<^sub>2))"
    have "represents_state cs\<^sub>2' as\<^sub>2 v\<^sub>2 \<and> as_as_step as\<^sub>1 as\<^sub>2 v\<^sub>1 v\<^sub>2 id" if "step prog cs\<^sub>1 = Inr cs\<^sub>2'" for cs\<^sub>2'
    proof -
      have cs\<^sub>2': "cs\<^sub>2' = cs\<^sub>2"
        using that cs\<^sub>2 by simp
      have v\<^sub>2: "v\<^sub>2 (v\<^sub>n, IA.IntT) = IA.Int (binop_instruction binop i\<^sub>1 i\<^sub>2)"
        unfolding v\<^sub>2_def by simp
      have [simp]: "IA.assignment v\<^sub>2"
        using v unfolding v\<^sub>2_def represents_frame.simps by fastforce
      have v\<^sub>2_i\<^sub>1: "IA.eval te\<^sub>1 v\<^sub>2 = IA.Int i\<^sub>1" "IA.eval te\<^sub>2 v\<^sub>2 = IA.Int i\<^sub>2"
        using 1 i\<^sub>1 i\<^sub>2 unfolding v\<^sub>2_def update_as.simps
        by (auto simp add: IA.eval_with_fresh_var[OF operand_value_fresh])
      have [simp]: "v\<^sub>2 \<Turnstile>\<^sub>I\<^sub>A kb as\<^sub>1"
      proof -
        have "(v\<^sub>n, IA.IntT) \<notin> vars_formula (kb as\<^sub>1)"
          using u by (auto simp add: all_sym_vars_def update_as.simps)
        then show ?thesis
          using u v by (auto simp add: represents_frame.simps v\<^sub>2_def)
      qed
      have [simp]: "v\<^sub>2 \<Turnstile>\<^sub>I\<^sub>A \<phi>"
        unfolding `\<phi> = encode_binop binop v\<^sub>n te\<^sub>1 te\<^sub>2` by (cases binop) (auto simp add: i\<^sub>1 i\<^sub>2 v\<^sub>2_i\<^sub>1 v\<^sub>2)
      have [simp]: "v\<^sub>2 \<Turnstile>\<^sub>I\<^sub>A kb as\<^sub>2"
        apply(rule IA.impliesD[of "kb as\<^sub>1 \<and>\<^sub>f \<phi>"])
        using update_as.simps u apply(metis)
        using represents_frame.simps by (auto)
      have a: "same_stack_names s\<^sub>2 (abstract_state.stack as\<^sub>2)"
        using v unfolding represents_frame.simps s\<^sub>2_def
        by (intro ssn_update[OF u, of "frame.stack f\<^sub>1"]) auto
      have vp: "valid_pointers (pointers as\<^sub>2) v\<^sub>2 (mem f\<^sub>2)"
      proof -
        have "x \<noteq> v\<^sub>n" if "pointers as\<^sub>1 a = Some (lt, x)" for a lt x
          using that u ranI unfolding update_as.simps all_sym_vars_def by fastforce
        then have a: "v\<^sub>1 (a, IA.IntT) = v\<^sub>2 (a, IA.IntT) \<and> v\<^sub>1 (x, IA.IntT) = v\<^sub>2 (x, IA.IntT)"
          if "pointers as\<^sub>2 a = Some (lt, x) " for a lt x
          using that 1 u unfolding update_as.simps by (auto simp add: v\<^sub>2_def all_sym_vars_def)
        show ?thesis
          using 1 v a unfolding f\<^sub>2_def represents_frame.simps
          by (auto intro: valid_pointers_mem_unchanged_intro)
      qed
      have r_f\<^sub>2_v\<^sub>2: "represents_frame f\<^sub>2 as\<^sub>2 v\<^sub>2"
        apply(auto simp add: f\<^sub>2_def represents_frame.simps)
        subgoal
          using 1  by (auto simp add: p)
        subgoal using a by simp
        subgoal
          unfolding s\<^sub>2_def
          apply(rule vvm_update_int[OF _ u, of "frame.stack f\<^sub>1" v\<^sub>1])
          using represents_frame.cases v apply blast
          using v\<^sub>2_def apply(simp)
          using v\<^sub>2_def by (blast)
        apply(rule valid_allocs_mem_unchanged_intro[of "allocs as\<^sub>1" v\<^sub>1 "mem f\<^sub>1"])
        using v unfolding represents_frame.simps apply(blast)
        using 1 apply(blast)
        unfolding v\<^sub>2_def using u vp by (auto simp add: update_as.simps all_sym_vars_def v\<^sub>2_def f\<^sub>2_def)
      have "represents_state cs\<^sub>2 as\<^sub>2 v\<^sub>2"
        unfolding cs\<^sub>2_def represents_state.simps using r_f\<^sub>2_v\<^sub>2 by auto
      moreover have "as_as_step as\<^sub>1 as\<^sub>2 v\<^sub>1 v\<^sub>2 id"
        apply(rule as_as_step.intros[where v\<^sub>1'=v\<^sub>2])
        using v assignment_assig_of_state unfolding represents_frame.simps 
        using u unfolding update_as.simps apply (auto)
        using u unfolding update_as.simps by (auto simp add: v\<^sub>2_def)
      ultimately show ?thesis
        using cs\<^sub>2' by auto
    qed
    then show ?case
      using cs\<^sub>2 by blast
  qed
  then show "isOK (step prog cs\<^sub>1)"
    "step prog cs\<^sub>1 = Inr cs\<^sub>2 \<Longrightarrow> \<exists>v\<^sub>2. represents_state cs\<^sub>2 as\<^sub>2 v\<^sub>2 \<and> as_as_step as\<^sub>1 as\<^sub>2 v\<^sub>1 v\<^sub>2 id"
    by blast+
qed

inductive genAsInf for as\<^sub>1 as\<^sub>2 \<mu> where
  "pos as\<^sub>1 = pos as\<^sub>2 \<Longrightarrow>
   dom (stack as\<^sub>1) = dom (stack as\<^sub>2) \<Longrightarrow>
   kb as\<^sub>1 \<Longrightarrow>\<^sub>I\<^sub>A rename_vars \<mu> (kb as\<^sub>2) \<Longrightarrow>
   (\<forall>n lv t. stack as\<^sub>2 n = Some (t, lv) \<longrightarrow> stack as\<^sub>1 n = Some (t, (\<mu> lv))) \<Longrightarrow>
   (\<forall>(lb, ub) \<in> allocs as\<^sub>2. (\<mu> lb, \<mu> ub) \<in> allocs as\<^sub>1) \<Longrightarrow>
   (\<forall>a lt x. (pointers as\<^sub>2) a = Some (lt, x) \<longrightarrow> (pointers as\<^sub>1) (\<mu> a) = Some (lt, \<mu> x)) \<Longrightarrow>
   genAsInf as\<^sub>1 as\<^sub>2 \<mu>"

lemma genAsInf_represents:
  assumes "genAsInf as\<^sub>1 as\<^sub>2 \<mu>" "represents_state cs as\<^sub>1 v\<^sub>1"
  shows "\<exists>v\<^sub>2. represents_state cs as\<^sub>2 v\<^sub>2 \<and> as_as_step as\<^sub>1 as\<^sub>2 v\<^sub>1 v\<^sub>2 \<mu>"
  using assms proof (induction rule: genAsInf.induct)
  case (1)
  obtain f fs where cs: "frames cs = f#fs"
    using 1 unfolding represents_state.simps by (meson list.exhaust)
  have r: "represents_frame f as\<^sub>1 v\<^sub>1"
    using 1 cs unfolding represents_state.simps by auto
  have v: "valid_var_mapping (frame.stack f) (abstract_state.stack as\<^sub>1) v\<^sub>1" "v\<^sub>1 \<Turnstile>\<^sub>I\<^sub>A kb as\<^sub>1"
    "IA.assignment v\<^sub>1" "valid_allocs (allocs as\<^sub>1) v\<^sub>1 (mem f)" "valid_pointers (pointers as\<^sub>1) v\<^sub>1 (mem f)"
    and pos: "frame.pos f = abstract_state.pos as\<^sub>1" and sn: "same_stack_names (frame.stack f) (abstract_state.stack as\<^sub>1)"
    using r unfolding represents_frame.simps by auto
  define v\<^sub>2 where "v\<^sub>2 = v\<^sub>1 \<circ> (map_prod \<mu> id)"
  have a: "IA.assignment v\<^sub>1" "IA.assignment v\<^sub>2"
    using v(3) unfolding v\<^sub>2_def unfolding IA.assignment_def by auto
  have sn': "same_stack_names (frame.stack f) (abstract_state.stack as\<^sub>2)"
    using sn 1  unfolding same_stack_names.simps by blast
  have vvm: "valid_var_mapping (frame.stack f) (abstract_state.stack as\<^sub>2) v\<^sub>2"
    using 1 v unfolding v\<^sub>2_def valid_var_mapping.simps by (auto)
  moreover have kbt: "v\<^sub>2 \<Turnstile>\<^sub>I\<^sub>A kb as\<^sub>2"
  proof -
    have "v\<^sub>1 \<Turnstile>\<^sub>I\<^sub>A map_formula (rename_vars \<mu>) (kb as\<^sub>2)"
      using v 1 a by blast
    then show ?thesis
      using a unfolding v\<^sub>2_def by (metis IA.satisfies_rename_vars comp_apply id_apply map_prod_simp)
  qed
  have aas: "as_as_step as\<^sub>1 as\<^sub>2 v\<^sub>1 v\<^sub>2 \<mu>"
    using kbt v a by (auto intro!: as_as_step.intros simp add: v\<^sub>2_def)
  have allocs: "valid_allocs (allocs as\<^sub>2) v\<^sub>2 (mem f)"
    using `\<forall>(lb, ub)\<in>allocs as\<^sub>2. (\<mu> lb, \<mu> ub) \<in> allocs as\<^sub>1` `valid_allocs (allocs as\<^sub>1) v\<^sub>1 (mem f)`
    by (intro valid_allocs.intros) (auto simp add: valid_allocs.simps v\<^sub>2_def)
  have pointers: "valid_pointers (pointers as\<^sub>2) v\<^sub>2 (mem f)"
    using `valid_pointers (pointers as\<^sub>1) v\<^sub>1 (mem f)`
      `\<forall>a lt x. pointers as\<^sub>2 a = Some (lt, x) \<longrightarrow> pointers as\<^sub>1 (\<mu> a) = Some (lt, \<mu> x)`
      unfolding valid_pointers.simps v\<^sub>2_def by (fastforce intro!: valid_pointers.intros)
  have "represents_state cs as\<^sub>2 v\<^sub>2 \<and> as_as_step as\<^sub>1 as\<^sub>2 v\<^sub>1 v\<^sub>2 \<mu>"
    using a sn' cs aas kbt vvm allocs r 1 pointers
    unfolding represents_state.simps represents_frame.simps by (auto)
  then show ?thesis
    by blast
qed

fun encode_alloc where                   
  "encode_alloc vlb vub te\<^sub>l ll_type =
     (let len = encode_int_const (int (len_of ll_type)) in
     encode_eq (encode_int_var vub)
               (Fun (IA.SumF 2) [encode_int_var vlb, Fun (IA.ProdF 2) [te\<^sub>l, len]]))"

inductive allocAsInf for prog as\<^sub>1 as\<^sub>2 where
  "allocAsInf prog as\<^sub>1 as\<^sub>2"
if
  "find_statement prog (pos as\<^sub>1) = Inr (Instruction (Assignment n (Alloca lt o\<^sub>1)))"
  "pos as\<^sub>2 = inc_pos (pos as\<^sub>1)"
  "Some (IntType l\<^sub>1, te\<^sub>1) = (case o\<^sub>1 of None \<Rightarrow> Some (IntType 32, encode_int_const 1) | Some o\<^sub>1 \<Rightarrow> operand_value as\<^sub>1 o\<^sub>1)"
  "0 < l\<^sub>1"
  "kb as\<^sub>1 \<Longrightarrow>\<^sub>I\<^sub>A encode_sig IA.LessF (encode_int_const 0) te\<^sub>1"
  "vub \<notin> all_sym_vars as\<^sub>1"
  "vub \<noteq> vlb"
  "\<phi> = encode_alloc vlb vub te\<^sub>1 lt"
  "update_as as\<^sub>1 as\<^sub>2 n (PointerType lt) vlb \<phi>"
  "allocs as\<^sub>2 = allocs as\<^sub>1 \<union> {(vlb, vub)}"
  "pointers as\<^sub>2 = pointers as\<^sub>1"

lemma (in ll_mem) allocAsInf_represents_step:
  assumes
    "allocAsInf prog as\<^sub>1 as\<^sub>2"
    "represents_state cs\<^sub>1 as\<^sub>1 v\<^sub>1"
  shows 
    "isOK (step prog cs\<^sub>1)"
    "step prog cs\<^sub>1 = Inr cs\<^sub>2 \<Longrightarrow> (\<exists>v\<^sub>2. represents_state cs\<^sub>2 as\<^sub>2 v\<^sub>2 \<and> as_as_step as\<^sub>1 as\<^sub>2 v\<^sub>1 v\<^sub>2 id)"
proof -
  have "isOK (step prog cs\<^sub>1)
     \<and> (\<forall>cs\<^sub>2. step prog cs\<^sub>1 = Inr cs\<^sub>2 \<longrightarrow> (\<exists>v\<^sub>2. represents_state cs\<^sub>2 as\<^sub>2 v\<^sub>2 \<and> as_as_step as\<^sub>1 as\<^sub>2 v\<^sub>1 v\<^sub>2 id))"
    using assms proof(induction rule: allocAsInf.induct)
    case (1 n lt o\<^sub>1 l\<^sub>1 te\<^sub>1 vub vlb \<phi>)
    note o\<^sub>1 = 1(3)[symmetric]
    note u = `update_as as\<^sub>1 as\<^sub>2 n (PointerType lt) vlb \<phi>`
    obtain f\<^sub>1 fs\<^sub>1  where cs\<^sub>1: "frames cs\<^sub>1 = (f\<^sub>1 # fs\<^sub>1)"
      using 1 unfolding represents_state.simps by (metis hd_Cons_tl)
    interpret small_step alloc store load empty_mem prog cs\<^sub>1 f\<^sub>1 fs\<^sub>1 .
    have [simp]: "hd (frames cs\<^sub>1) = f\<^sub>1"
      by (simp add: cs\<^sub>1)
    obtain fn bn p where p: "pos as\<^sub>1 = (fn, bn, p)"
      using prod_cases3 by blast
    then have p': "frame.pos f\<^sub>1 = (fn, bn, p)"
      using 1 cs\<^sub>1 by (auto simp add: represents_state.simps represents_frame.simps)
    have v: "represents_frame f\<^sub>1 as\<^sub>1 v\<^sub>1"
      using 1 unfolding represents_state.simps by auto
    have kb: "IA.satisfies v\<^sub>1 (kb as\<^sub>1)" "IA.assignment v\<^sub>1"
      using v unfolding represents_frame.simps by auto
    have "\<exists>i\<^sub>1. IA.eval te\<^sub>1 v\<^sub>1 = IA.Int i\<^sub>1"
    proof -
      have a: ?thesis if "o\<^sub>1 = Some (LocalReference x)" for x
        using o\<^sub>1 that v IA.assignment_eval_int[of v\<^sub>1] unfolding represents_frame.simps
        by auto
      have b: ?thesis if "o\<^sub>1 = Some (ConstantOperand x)" for x
        using that o\<^sub>1 by (cases x) (auto)
      show ?thesis
        using a b o\<^sub>1 by (cases o\<^sub>1) (auto intro: operand.exhaust)
    qed
    then obtain i\<^sub>1 where i\<^sub>1: "IA.eval te\<^sub>1 v\<^sub>1 = IA.Int i\<^sub>1"
      by blast
    have some_o\<^sub>1: "SE_Graph.operand_value as\<^sub>1 x = Some (IntType l\<^sub>1, te\<^sub>1)" if "o\<^sub>1 = Some x" for x
      using that o\<^sub>1 by (auto)
    have o\<^sub>1_i\<^sub>1: "(case o\<^sub>1 of None \<Rightarrow> Inr (IntegerValue 32 1) | Some x \<Rightarrow> local.operand_value x)
          = Inr (IntegerValue l\<^sub>1 i\<^sub>1)"
      using v o\<^sub>1 some_o\<^sub>1 1 i\<^sub>1 operand_value_int_represents_frame[OF some_o\<^sub>1]
      by (auto split: option.splits)
    have i\<^sub>1_0: "0 < i\<^sub>1"
    proof -
      have "IA.satisfies v\<^sub>1 (encode_sig IA.LessF (encode_int_const 0) te\<^sub>1)"
        using 1(5) kb by blast
      then show ?thesis
        using i\<^sub>1 by simp
    qed
    obtain lb ub mem' where mem': "alloc (mem f\<^sub>1) lt i\<^sub>1 = Inr ((lb, ub), mem')"
      using i\<^sub>1_0 S2 by fast
    define f\<^sub>2 where "f\<^sub>2 = update_pos inc_pos (LLVM_State.update_stack (Mapping.update n (Pointer lt lb)) (update_mem (\<lambda>_. mem') f\<^sub>1))"
    define cs\<^sub>2 where "cs\<^sub>2 = Llvm_state (f\<^sub>2 # fs\<^sub>1)"
    have cs\<^sub>2: "step prog cs\<^sub>1 = Inr cs\<^sub>2"
      using cs\<^sub>1 1 v o\<^sub>1_i\<^sub>1 mem' unfolding cs\<^sub>2_def f\<^sub>2_def represents_frame.simps 
      by (auto split: prod.splits)
    define v\<^sub>2 where "v\<^sub>2 = v\<^sub>1((vub, IA.IntT) := IA.Int ub, (vlb, IA.IntT) := IA.Int lb)"
    have ub: "ub = lb + len_of lt * i\<^sub>1"
      using mem' S3 by fastforce
    have "represents_state cs\<^sub>2' as\<^sub>2 v\<^sub>2 \<and> as_as_step as\<^sub>1 as\<^sub>2 v\<^sub>1 v\<^sub>2 id" if "step prog cs\<^sub>1 = Inr cs\<^sub>2'" for cs\<^sub>2'
    proof -
      have cs\<^sub>2': "cs\<^sub>2' = cs\<^sub>2"
        using that cs\<^sub>2 by simp
      have v\<^sub>2: "v\<^sub>2 (vlb, IA.IntT) = IA.Int lb"
        "v\<^sub>2 (vub, IA.IntT) = IA.Int (lb + len_of lt * i\<^sub>1)"
        using 1 unfolding v\<^sub>2_def ub by (auto)
      have [simp]: "IA.assignment v\<^sub>2"
        using v unfolding v\<^sub>2_def represents_frame.simps by fastforce
      have "(vlb, IA.IntT) \<notin> vars_term te\<^sub>1" "(vub, IA.IntT) \<notin> vars_term te\<^sub>1"
        using 1 u o\<^sub>1 operand_value_fresh unfolding update_as.simps by (fastforce split: option.splits)+
      then have v\<^sub>2_i\<^sub>1: "IA.eval te\<^sub>1 v\<^sub>2 = IA.Int i\<^sub>1"
        unfolding v\<^sub>2_def using i\<^sub>1 by auto
      have [simp]: "v\<^sub>2 \<Turnstile>\<^sub>I\<^sub>A kb as\<^sub>1"
      proof -
        have "(vlb, IA.IntT) \<notin> vars_formula (kb as\<^sub>1)" "(vub, IA.IntT) \<notin> vars_formula (kb as\<^sub>1)"
          using 1 u by (auto simp add: all_sym_vars_def update_as.simps)
        then show ?thesis
          using u v by (auto simp add: represents_frame.simps v\<^sub>2_def)
      qed
      have [simp]: "v\<^sub>2 \<Turnstile>\<^sub>I\<^sub>A \<phi>"
        unfolding `\<phi> =  encode_alloc vlb vub te\<^sub>1 lt` by (auto simp add: v\<^sub>2_i\<^sub>1 v\<^sub>2)
      have [simp]: "v\<^sub>2 \<Turnstile>\<^sub>I\<^sub>A kb as\<^sub>2"
        apply(rule IA.impliesD[of "kb as\<^sub>1 \<and>\<^sub>f \<phi>"])
        using update_as.simps u apply(metis)
        using represents_frame.simps by (auto)
      have a: "same_stack_names (frame.stack f\<^sub>2) (abstract_state.stack as\<^sub>2)"
        using v unfolding represents_frame.simps
        by (intro ssn_update[OF u, of "frame.stack f\<^sub>1"]) (auto simp add: f\<^sub>2_def)
      have va: "valid_allocs (allocs as\<^sub>2) v\<^sub>2 (mem f\<^sub>2)"
      proof -
        have "bounds (mem f\<^sub>2) a = Some (lb', ub')"
          if a: "(lbv, ubv) \<in> allocs as\<^sub>2" "v\<^sub>2 (lbv, IA.IntT) = IA.Int lb'"
            "v\<^sub>2 (ubv, IA.IntT) = IA.Int ub'" "lb' \<le> a" "a < ub'" for lbv ubv lb' ub' a
        proof -
          have b: "lb = lb' \<and> ub = ub'" if "lb \<le> a \<and> a < ub"
          proof (cases "lbv = vlb \<and> ubv = vub")
            case True
            then show ?thesis
              using a 1 by (auto simp add: v\<^sub>2_def)
          next
            case False
            then have c: "(lbv, ubv) \<in> allocs as\<^sub>1"
              using 1 a by blast
            have d: "lbv \<noteq> vlb" "ubv \<noteq> vub" "lbv \<noteq> vub" "ubv \<noteq> vlb"
              using c 1 u unfolding update_as.simps all_sym_vars_def by auto
            have "bounds (mem f\<^sub>1) a = Some (lb', ub')"
              using c d a v unfolding v\<^sub>2_def represents_frame.simps valid_allocs.simps by (auto)
            then have False
              using mem' a S7 that by auto
            then show ?thesis
              by simp
          qed
          have c: "bounds (mem f\<^sub>1) a = Some (lb', ub')" if "a \<notin> {lb..<ub}"
          proof -
            have c: "(lbv, ubv) \<in> allocs as\<^sub>1"
              using 1 a that by (auto simp add: v\<^sub>2_def)
            have d: "lbv \<noteq> vlb" "ubv \<noteq> vub" "lbv \<noteq> vub" "ubv \<noteq> vlb"
              using c 1 u unfolding update_as.simps all_sym_vars_def by auto
            show ?thesis
              using c d a v unfolding v\<^sub>2_def represents_frame.simps valid_allocs.simps by (auto)
          qed
          show ?thesis
            apply(subst alloc_allocated_address_def[of "mem f\<^sub>1" lt i\<^sub>1 lb ub])
            using a b c mem' f\<^sub>2_def by (auto)
        qed
        then show ?thesis
          by (auto intro: valid_allocs.intros)
      qed
      have vp: "valid_pointers (pointers as\<^sub>2) v\<^sub>2 (mem f\<^sub>2)"
      proof (rule valid_pointers.intros, goal_cases case1)
        case (case1 a llt x a' x')
        have "x \<noteq> vlb" "x \<noteq> vub" "a \<noteq> vlb" "a \<noteq> vub"
          using 1(6) 1(11) case1 u ranI unfolding update_as.simps all_sym_vars_def by fastforce+
        then have a: "v\<^sub>2 (a, IA.IntT) = v\<^sub>1 (a, IA.IntT) \<and> v\<^sub>2 (x, IA.IntT) = v\<^sub>1 (x, IA.IntT)"
          using that 1 u unfolding update_as.simps v\<^sub>2_def all_sym_vars_def by auto
        then obtain y where aa': "allocated_address (mem f\<^sub>1) a'"
          "load (mem f\<^sub>1) llt a' = Inr y \<and> stack_value_to_int y = x' \<and> ll_typeof y = llt"
          using v case1 1 unfolding represents_frame.simps valid_pointers.simps by metis
        then have albub: "a' \<notin> {lb..<ub}"
           unfolding allocated_address_def using S7 mem' by metis
        then have "allocated_address (mem f\<^sub>2) a'"
          using aa' mem' S6 unfolding allocated_address_def f\<^sub>2_def by (simp)
        then show ?case
          using albub mem' aa' S4[OF mem' albub] unfolding f\<^sub>2_def by (auto)
      qed
      have r_f\<^sub>2_v\<^sub>2: "represents_frame f\<^sub>2 as\<^sub>2 v\<^sub>2"
        apply(auto simp add: f\<^sub>2_def represents_frame.simps)
        subgoal
          using 1 by (auto simp add: p' p)
        subgoal using f\<^sub>2_def a by simp
        subgoal
          apply(rule vvm_update_pointer[OF _ u, of "frame.stack f\<^sub>1" "v\<^sub>1((vub, IA.IntT) := IA.Int (lb + len_of lt * i\<^sub>1))"])
          subgoal
            apply(rule vvm_non_update_stack)
              defer 
              apply(simp)
            using 1 apply(blast)
            using v unfolding represents_frame.simps by simp
          using v\<^sub>2_def apply(simp add: ub)
          using v\<^sub>2_def by (blast)
        subgoal using va unfolding f\<^sub>2_def by simp
        using vp unfolding f\<^sub>2_def by auto
      have "represents_state cs\<^sub>2 as\<^sub>2 v\<^sub>2"
        unfolding cs\<^sub>2_def represents_state.simps using r_f\<^sub>2_v\<^sub>2 by auto
      moreover have "as_as_step as\<^sub>1 as\<^sub>2 v\<^sub>1 v\<^sub>2 id"
        apply(rule as_as_step.intros[where v\<^sub>1'=v\<^sub>2])
        using v assignment_assig_of_state unfolding represents_frame.simps 
        using u unfolding update_as.simps apply (auto)
        using u 1 unfolding update_as.simps by (auto simp add: v\<^sub>2_def)
      ultimately show ?thesis
        using cs\<^sub>2' by auto
    qed
    then show ?case
      using cs\<^sub>2 by blast
  qed
  then show "isOK (step prog cs\<^sub>1)"
    "step prog cs\<^sub>1 = Inr cs\<^sub>2 \<Longrightarrow> \<exists>v\<^sub>2. represents_state cs\<^sub>2 as\<^sub>2 v\<^sub>2 \<and> as_as_step as\<^sub>1 as\<^sub>2 v\<^sub>1 v\<^sub>2 id"
    by blast+
qed

inductive proper_store for kb allocs va t where
   "proper_store kb allocs va t"
 if
   "(lb, ub) \<in> allocs"
   "kb \<Longrightarrow>\<^sub>I\<^sub>A encode_sig IA.LeF (encode_int_var lb) (encode_int_var va)"
   "kb \<Longrightarrow>\<^sub>I\<^sub>A encode_sig IA.LeF ((Fun (IA.SumF 2) [encode_int_var va, encode_int_const (len_of t)])) (encode_int_var ub)"


inductive filter_pointers for kb pointers pt va t where
   "filter_pointers kb pointers pt va t"
 if
   "\<And>a t' v'. pt a = Some (t', v')
    \<Longrightarrow> pointers a = Some (t', v')
    \<and> (kb \<Longrightarrow>\<^sub>I\<^sub>A (encode_sig IA.LeF (Fun (IA.SumF 2) [encode_int_var va, encode_int_const (len_of t)]) (encode_int_var a)
                \<or>\<^sub>f encode_sig IA.LeF (Fun (IA.SumF 2) [encode_int_var a, encode_int_const (len_of t')]) (encode_int_var va)))"

inductive storeAsInf for prog as\<^sub>1 as\<^sub>2 where
   "storeAsInf prog as\<^sub>1 as\<^sub>2"
 if
   "find_statement prog (pos as\<^sub>1) = Inr (Instruction (Store t ov (LocalReference na)))"
   "pos as\<^sub>2 = inc_pos (pos as\<^sub>1)"
   "(stack as\<^sub>1) na = Some (type\<^sub>a, v\<^sub>a)"
   "operand_value as\<^sub>1 ov = Some (type\<^sub>v, term\<^sub>v)"
   "type\<^sub>a = PointerType type\<^sub>v"
   "t = type\<^sub>v"
   "proper_store (kb as\<^sub>1) (allocs as\<^sub>1) v\<^sub>a type\<^sub>v"
   "w \<notin> all_sym_vars as\<^sub>1"
   "IA.implies (kb as\<^sub>1 \<and>\<^sub>f encode_eq (encode_int_var w) term\<^sub>v) (kb as\<^sub>2)"
   "filter_pointers (kb as\<^sub>1) (pointers as\<^sub>1) pt v\<^sub>a type\<^sub>v"
   "pointers as\<^sub>2 = (pt(v\<^sub>a \<mapsto> (type\<^sub>v, w)))"
   "stack as\<^sub>2 = stack as\<^sub>1"
   "allocs as\<^sub>2 = allocs as\<^sub>1"

lemma (in ll_mem) storeAsInf_represents_step:
  assumes
    "storeAsInf prog as\<^sub>1 as\<^sub>2"
    "represents_state cs\<^sub>1 as\<^sub>1 v\<^sub>1"
  shows 
    "isOK (step prog cs\<^sub>1)"
    "step prog cs\<^sub>1 = Inr cs\<^sub>2 \<Longrightarrow> (\<exists>v\<^sub>2. represents_state cs\<^sub>2 as\<^sub>2 v\<^sub>2 \<and> as_as_step as\<^sub>1 as\<^sub>2 v\<^sub>1 v\<^sub>2 id)"
proof -
  have "isOK (step prog cs\<^sub>1)
     \<and> (\<forall>cs\<^sub>2. step prog cs\<^sub>1 = Inr cs\<^sub>2 \<longrightarrow> (\<exists>v\<^sub>2. represents_state cs\<^sub>2 as\<^sub>2 v\<^sub>2 \<and> as_as_step as\<^sub>1 as\<^sub>2 v\<^sub>1 v\<^sub>2 id))"
    using assms proof(induction rule: storeAsInf.induct)
    case (1 t ov na type\<^sub>a v\<^sub>a type\<^sub>v term\<^sub>v w pt)
    obtain f\<^sub>1 fs\<^sub>1  where cs\<^sub>1: "frames cs\<^sub>1 = (f\<^sub>1 # fs\<^sub>1)"
      using 1 unfolding represents_state.simps by (metis hd_Cons_tl)
    interpret small_step alloc store load empty_mem prog cs\<^sub>1 f\<^sub>1 fs\<^sub>1 .
    have [simp]: "hd (frames cs\<^sub>1) = f\<^sub>1"
      by (simp add: cs\<^sub>1)
    obtain fn bn p where p: "pos as\<^sub>1 = (fn, bn, p)"
      using prod_cases3 by blast
    then have p': "frame.pos f\<^sub>1 = (fn, bn, p)"
      using 1 cs\<^sub>1 by (auto simp add: represents_state.simps represents_frame.simps)
    have v: "represents_frame f\<^sub>1 as\<^sub>1 v\<^sub>1"
      using 1 unfolding represents_state.simps by auto
    have kb: "IA.satisfies v\<^sub>1 (kb as\<^sub>1)" "IA.assignment v\<^sub>1"
      using v unfolding represents_frame.simps by auto
    obtain i\<^sub>v where i\<^sub>v: "IA.eval term\<^sub>v v\<^sub>1 = IA.Int i\<^sub>v"
      using \<open>SE_Graph.operand_value as\<^sub>1 ov = Some (type\<^sub>v, term\<^sub>v)\<close> v IA.assignment_eval_int[of v\<^sub>1]
      unfolding represents_frame.simps
      by (cases ov) (fastforce elim: SE_Graph.operand_value.elims)+
    obtain i\<^sub>a where i\<^sub>a: "IA.eval (encode_int_var v\<^sub>a) v\<^sub>1 = IA.Int i\<^sub>a"
      using v IA.assignment_eval_int[of v\<^sub>1]  unfolding represents_frame.simps by (fastforce)
    obtain x where ov: "operand_value ov = Inr x" "stack_value_to_int x = i\<^sub>v" "ll_typeof x = type\<^sub>v"
      using v 1 i\<^sub>v operand_value_represents_frame by blast
    have oa: "operand_value (LocalReference na) = Inr (Pointer type\<^sub>v i\<^sub>a)"
      using 1 i\<^sub>a by (subst operand_value_pointer_represents_frame[symmetric, OF _ v]) auto

    obtain v\<^sub>l\<^sub>b v\<^sub>u\<^sub>b where v\<^sub>l\<^sub>b: "(v\<^sub>l\<^sub>b, v\<^sub>u\<^sub>b) \<in> allocs as\<^sub>1"
      "kb as\<^sub>1 \<Longrightarrow>\<^sub>I\<^sub>A encode_sig IA.LeF (encode_int_var v\<^sub>l\<^sub>b) (encode_int_var v\<^sub>a)"
      "kb as\<^sub>1 \<Longrightarrow>\<^sub>I\<^sub>A encode_sig IA.LeF ((Fun (IA.SumF 2)
                     [encode_int_var v\<^sub>a, encode_int_const (len_of type\<^sub>v)])) (encode_int_var v\<^sub>u\<^sub>b)"
      using 1 unfolding proper_store.simps by auto
    define lb ub where lb_ub_def:
      "lb = IA.to_int (v\<^sub>1 (v\<^sub>l\<^sub>b, IA.IntT))" "ub = IA.to_int (v\<^sub>1 (v\<^sub>u\<^sub>b, IA.IntT))"
    then have lb_ub_alt_def: "v\<^sub>1 (v\<^sub>l\<^sub>b, IA.IntT) = IA.Int lb" "v\<^sub>1 (v\<^sub>u\<^sub>b, IA.IntT) = IA.Int ub"
      using IA.assignment_eval_to_int v unfolding represents_frame.simps by metis+
    have "v\<^sub>1 \<in> {\<alpha>. IA.assignment \<alpha> \<and> IA.to_int (\<alpha> (v\<^sub>l\<^sub>b, IA.IntT)) \<le> IA.to_int (\<alpha> (v\<^sub>a, IA.IntT))}"
      "v\<^sub>1 \<in> {\<alpha>. IA.assignment \<alpha> \<and> IA.to_int (\<alpha> (v\<^sub>a, IA.IntT)) + int (len_of type\<^sub>v) \<le> IA.to_int (\<alpha> (v\<^sub>u\<^sub>b, IA.IntT))}"
      using v v\<^sub>l\<^sub>b unfolding represents_frame.simps by (auto simp add: IA.satisfies_Language)
    then have lbub: "lb \<le> i\<^sub>a" "i\<^sub>a + int (len_of type\<^sub>v) \<le> ub"
      unfolding lb_ub_def using i\<^sub>a by auto
    have i\<^sub>a_ub: "i\<^sub>a < ub"
      using lbub S1 by auto
    then have bounds_i\<^sub>a: "bounds (mem f\<^sub>1) i\<^sub>a = Some (lb, ub)"
      using v\<^sub>l\<^sub>b lbub v lb_ub_alt_def unfolding represents_frame.simps valid_allocs.simps by auto
    obtain mem' where mem': "store (mem f\<^sub>1) i\<^sub>a (ll_typeof x) x = Inr mem'"
      using S8 bounds_i\<^sub>a lbub i\<^sub>a_ub 1 ov by blast
    define f\<^sub>2 where "f\<^sub>2 = update_pos inc_pos (update_mem (\<lambda>_. mem') f\<^sub>1)"
    define cs\<^sub>2 where "cs\<^sub>2 = Llvm_state (f\<^sub>2#fs\<^sub>1)"
    have cs\<^sub>2: "step prog cs\<^sub>1 = Inr cs\<^sub>2"
      using cs\<^sub>1 1 v ov oa mem' unfolding represents_frame.simps cs\<^sub>2_def f\<^sub>2_def by auto
    define v\<^sub>2 where "v\<^sub>2 = v\<^sub>1((w, IA.IntT) := IA.Int i\<^sub>v)"
    have "represents_state cs\<^sub>2' as\<^sub>2 v\<^sub>2 \<and> as_as_step as\<^sub>1 as\<^sub>2 v\<^sub>1 v\<^sub>2 id" if "step prog cs\<^sub>1 = Inr cs\<^sub>2'" for cs\<^sub>2'
    proof -
      have cs\<^sub>2': "cs\<^sub>2' = cs\<^sub>2"
        using that cs\<^sub>2 by simp
      have v\<^sub>2: "v\<^sub>2 (w, IA.IntT) = IA.Int i\<^sub>v"
        unfolding v\<^sub>2_def by (auto)
      have [simp]: "IA.assignment v\<^sub>2"
        using v unfolding v\<^sub>2_def represents_frame.simps by fastforce
      have v\<^sub>2_kb\<^sub>1: "v\<^sub>2 \<Turnstile>\<^sub>I\<^sub>A kb as\<^sub>1"
      proof -
        have "(w, IA.IntT) \<notin> vars_formula (kb as\<^sub>1)"
          using 1 by (auto simp add: all_sym_vars_def update_as.simps)
        then show ?thesis
          using v by (auto simp add: represents_frame.simps v\<^sub>2_def)
      qed
      have "(w, IA.IntT) \<notin> vars_term term\<^sub>v"
        using 1  operand_value_fresh unfolding update_as.simps by (fastforce split: option.splits)
      then have "v\<^sub>2 \<Turnstile>\<^sub>I\<^sub>A encode_eq (encode_int_var w) term\<^sub>v"
        using v i\<^sub>v unfolding represents_frame.simps by (auto simp add: v\<^sub>2_def)
      have v\<^sub>2_kb: "v\<^sub>2 \<Turnstile>\<^sub>I\<^sub>A kb as\<^sub>2"
        apply(rule IA.impliesD[of "kb as\<^sub>1 \<and>\<^sub>f encode_eq (encode_int_var w) term\<^sub>v"])
        using 1 i\<^sub>v `v\<^sub>2 \<Turnstile>\<^sub>I\<^sub>A kb as\<^sub>1` `v\<^sub>2 \<Turnstile>\<^sub>I\<^sub>A encode_eq (encode_int_var w) term\<^sub>v` by auto
      have a: "same_stack_names (frame.stack f\<^sub>2) (abstract_state.stack as\<^sub>2)"
        using v 1 unfolding represents_frame.simps f\<^sub>2_def by (auto)
      have va: "valid_allocs (allocs as\<^sub>2) v\<^sub>2 (mem f\<^sub>2)"
        apply(rule valid_allocs_mem_unchanged_intro[of "allocs as\<^sub>1" v\<^sub>1 "mem f\<^sub>1"])
        using v 1 S9 mem' by (auto simp add: all_sym_vars_def v\<^sub>2_def f\<^sub>2_def represents_frame.simps)
      have vvm: "valid_var_mapping (frame.stack f\<^sub>1) (abstract_state.stack as\<^sub>1) v\<^sub>2"
        apply(rule vvm_non_update_stack[of _ _ v\<^sub>1 _ w i\<^sub>v])
        using 1 v unfolding v\<^sub>2_def represents_frame.simps by auto
      have vp: "valid_pointers (pointers as\<^sub>2) v\<^sub>2 (mem f\<^sub>2)"
      proof (rule valid_pointers.intros, goal_cases case1)
        case (case1 av llt xv a' x')
        consider (a) "pt av = Some (llt, xv)" | (b) "av = v\<^sub>a"
          using case1 unfolding 1 by fastforce
        then show ?case
        proof cases
          case a
          define \<phi> where "\<phi> = (encode_sig IA.LeF (Fun (IA.SumF 2) [encode_int_var v\<^sub>a, encode_int_const (len_of type\<^sub>v)]) (encode_int_var av)
                     \<or>\<^sub>f encode_sig IA.LeF (Fun (IA.SumF 2) [encode_int_var av, encode_int_const (len_of llt)]) (encode_int_var v\<^sub>a))"
          have p: "(pointers as\<^sub>1) av = Some (llt, xv)" and k: "kb as\<^sub>1 \<Longrightarrow>\<^sub>I\<^sub>A \<phi>"
            using a 1 unfolding \<phi>_def filter_pointers.simps by blast+
          have avw: "av \<noteq> w" "xv \<noteq> w"
            using case1 1 p unfolding v\<^sub>2_def by (auto simp add: all_sym_vars_def) (meson img_snd ranI)
          then obtain y where aa': "allocated_address (mem f\<^sub>1) a'"
            and y: "load (mem f\<^sub>1) llt a' = Inr y \<and> stack_value_to_int y = x' \<and> ll_typeof y = llt"
            using p case1 v unfolding represents_frame.simps valid_pointers.simps by (fastforce simp add: v\<^sub>2_def)
          have "IA.satisfies v\<^sub>1 \<phi>"
            using k v unfolding represents_frame.simps by blast
          then have "a' + int (len_of llt) \<le> i\<^sub>a \<or> i\<^sub>a + int (len_of (ll_typeof x)) \<le> a'"
            using avw case1 i\<^sub>a unfolding \<phi>_def ov by (auto simp add: v\<^sub>2_def)
          then have l: "load mem' llt a' = load (mem f\<^sub>1) llt a'"
            using S10 mem' by blast
          have "allocated_address mem' a'"
            using aa' mem' S9 unfolding allocated_address_def  by auto
          then show ?thesis
            using l y unfolding f\<^sub>2_def by (auto)
        next
          case b
          then have c: "llt = type\<^sub>v" "xv = w" 
            using case1 unfolding 1 by auto
          have "v\<^sub>a \<noteq> w"
            using 1 by (auto simp add: all_sym_vars_def) (meson img_snd ranI)
          then have a': "a' = i\<^sub>a"
            using case1 b i\<^sub>a 1 by (auto simp add: v\<^sub>2_def all_sym_vars_def)
          have x': "stack_value_to_int x = x' \<and> ll_typeof x = llt"
            using case1 ov c by (simp add: v\<^sub>2_def)
          then have l: "load mem' llt a' = Inr x"
            using mem' a' S11  ov c by (auto)
          have "allocated_address mem' a'"
            using a' bounds_i\<^sub>a S9[OF mem'] unfolding allocated_address_def by simp
          then show ?thesis
            using x' l by (auto simp add: f\<^sub>2_def)
        qed
      qed
      have r_f\<^sub>2_v\<^sub>2: "represents_frame f\<^sub>2 as\<^sub>2 v\<^sub>2"
        apply(rule)
        using v 1 a va vp v\<^sub>2_kb vvm by (auto simp add: f\<^sub>2_def represents_frame.simps)
      have "represents_state cs\<^sub>2 as\<^sub>2 v\<^sub>2"
        unfolding cs\<^sub>2_def represents_state.simps using r_f\<^sub>2_v\<^sub>2 by auto
      moreover have "as_as_step as\<^sub>1 as\<^sub>2 v\<^sub>1 v\<^sub>2 id"
        apply(rule as_as_step.intros[where v\<^sub>1'=v\<^sub>2])
        using 1 v v\<^sub>2_kb v\<^sub>2_kb\<^sub>1 assignment_assig_of_state unfolding represents_frame.simps
         by (auto simp add: v\<^sub>2_def)
      ultimately show ?thesis
        using cs\<^sub>2' by auto
    qed
    then show ?case
      using cs\<^sub>2 by blast
  qed
  then show "isOK (step prog cs\<^sub>1)"
    "step prog cs\<^sub>1 = Inr cs\<^sub>2 \<Longrightarrow> \<exists>v\<^sub>2. represents_state cs\<^sub>2 as\<^sub>2 v\<^sub>2 \<and> as_as_step as\<^sub>1 as\<^sub>2 v\<^sub>1 v\<^sub>2 id"
    by blast+
qed

