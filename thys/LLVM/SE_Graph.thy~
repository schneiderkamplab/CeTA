locale llvm_se_graph =
  graph' as_of_node
  + ll_mem _ _ _ empty_mem
  for as_of_node :: "'n \<Rightarrow> ('lv::linorder) abstract_state"
  and empty_mem :: "'mem"
  +
  fixes prog :: llvm_prog
begin

inductive represents for cs n v where
  "represents cs n v"
if "n \<in> nodes" "represents_state cs (as_of_node n) v"

inductive evalInf for n\<^sub>1 n\<^sub>2 where
  "evalAsInf prog as\<^sub>1 as\<^sub>2 \<Longrightarrow>
   as_of_node n\<^sub>1 = as\<^sub>1 \<Longrightarrow>
   as_of_node n\<^sub>2 = as\<^sub>2 \<Longrightarrow>
   renaming_of_edge (n\<^sub>1, n\<^sub>2) = id \<Longrightarrow>
   n\<^sub>1 \<in> nodes \<Longrightarrow> n\<^sub>2 \<in> nodes \<Longrightarrow> (n\<^sub>1,n\<^sub>2) \<in> edges \<Longrightarrow>
   evalInf n\<^sub>1 n\<^sub>2"

