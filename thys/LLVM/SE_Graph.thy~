  define v\<^sub>2 where "v\<^sub>2 = v((v\<^sub>n, IA.IntT) := vv)"
  have [simp]: "IA.assignment v\<^sub>2"
    using v unfolding v\<^sub>2_def vv_def represents_frame.simps by (fastforce)
  have [simp]: "v\<^sub>2 \<Turnstile>\<^sub>I\<^sub>A kb as\<^sub>1"
    using u v by (simp add: update_as.simps represents_frame.simps v\<^sub>2_def)
  have ttii [simp]: "IA.to_int (\<lbrakk>t\<^sub>1\<rbrakk>\<^sub>I\<^sub>A v\<^sub>2) = i" "IA.to_int (\<lbrakk>t\<^sub>2\<rbrakk>\<^sub>I\<^sub>A v\<^sub>2) = i'"
    unfolding v\<^sub>2_def
    using "1.hyps"(7,8) cs\<^sub>1 li_def operand_value_valid_var_mapping represents_frame.simps
      operand_value_fresh u v IA.eval_with_fresh_var  SE_Graph.operand_value_fresh
    by (smt)+
  have \<chi>[simp]: "v\<^sub>2 \<Turnstile>\<^sub>I\<^sub>A \<chi>"
    unfolding `\<chi> = (if b then encode_eq (encode_var v\<^sub>n) (Fun (IA.ConstF 1) []) else encode_eq (encode_var v\<^sub>n) (Fun (IA.ConstF 0) []))`
    unfolding `\<phi> = encode_pred p t\<^sub>1 t\<^sub>2`
    apply (cases p)
      apply (auto simp add: v\<^sub>2_def vv_def `\<phi> = encode_pred p t\<^sub>1 t\<^sub>2`)
         apply (metis (no_types, lifting) "1.hyps"(2) "1.hyps"(4) \<open>IA.assignment v\<^sub>2\<close> \<open>v\<^sub>2 \<Turnstile>\<^sub>I\<^sub>A kb as\<^sub>1\<close> encode_pred.simps(1) encode_sig.elims formula.implies_def formula.satisfies_not)
    using "1.hyps"(2) "1.hyps"(3) apply (auto)
    apply (metis (no_types, lifting) "1.hyps"(4) \<open>IA.assignment v\<^sub>2\<close> \<open>v\<^sub>2 \<Turnstile>\<^sub>I\<^sub>A kb as\<^sub>1\<close> formula.implies_def formula.satisfies_not)
    apply (metis "1"(4) \<open>IA.assignment v\<^sub>2\<close> \<open>v\<^sub>2 \<Turnstile>\<^sub>I\<^sub>A kb as\<^sub>1\<close> IA.impliesE IA.satisfies_not)
    apply (smt "1"(4) \<open>IA.assignment v\<^sub>2\<close> \<open>v\<^sub>2 \<Turnstile>\<^sub>I\<^sub>A kb as\<^sub>1\<close> form_not.simps(1) formula.impliesD IA.satisfies_NegAtom)
    by (metis "1"(4) \<open>IA.assignment v\<^sub>2\<close> \<open>v\<^sub>2 \<Turnstile>\<^sub>I\<^sub>A kb as\<^sub>1\<close> formula.satisfies_not IA.impliesD )+
  have [simp]: "v\<^sub>2 \<Turnstile>\<^sub>I\<^sub>A kb as\<^sub>2"
    apply(rule IA.impliesD[of "kb as\<^sub>1 \<and>\<^sub>f \<chi>"])
