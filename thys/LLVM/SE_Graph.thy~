inductive icmpAsInf for prog as\<^sub>1 as\<^sub>2 where
  "icmpAsInf prog as\<^sub>1 as\<^sub>2"
if
  "find_statement prog (pos as\<^sub>1) = Inr (Instruction (Assignment n (Icmp p o\<^sub>1 o\<^sub>2)))"
  "\<phi> = encode_pred p t\<^sub>1 t\<^sub>2"
  "(b \<Longrightarrow> kb as\<^sub>1 \<Longrightarrow>\<^sub>I\<^sub>A \<phi>)"
  "(\<not>b \<Longrightarrow> kb as\<^sub>1 \<Longrightarrow>\<^sub>I\<^sub>A (\<not>\<^sub>f \<phi>))"
  "\<chi> = (if b then encode_eq (encode_var v\<^sub>n) (Fun (IA.ConstF 1) []) else encode_eq (encode_var v\<^sub>n) (Fun (IA.ConstF 0) []))"
  "pos as\<^sub>2 = inc_pos (pos as\<^sub>1)"
  "operand_value as\<^sub>1 o\<^sub>1 = Some t\<^sub>1"
  "operand_value as\<^sub>1 o\<^sub>2 = Some t\<^sub>2"
  "update_as as\<^sub>1 as\<^sub>2 n v\<^sub>n \<chi>"

lemma icmpAsInf_represents:
  assumes "icmpAsInf prog as\<^sub>1 as\<^sub>2" "represents_state cs\<^sub>1 as\<^sub>1" "step prog cs\<^sub>1 = Inr cs\<^sub>2"
  shows "represents_state cs\<^sub>2 as\<^sub>2 \<and> as_as_step as\<^sub>1 as\<^sub>2 (assig_of_state cs\<^sub>1) (assig_of_state cs\<^sub>2) id"
using assms proof(induction rule: icmpAsInf.induct)
  case (1 n p o\<^sub>1 o\<^sub>2 \<phi> t\<^sub>1 t\<^sub>2 b \<chi> v\<^sub>n)
  note IA.implies_Language[simp del]
  note u = `update_as as\<^sub>1 as\<^sub>2 n v\<^sub>n \<chi>`
  define ins where "ins = (Assignment n (Icmp p o\<^sub>1 o\<^sub>2))"
  obtain f\<^sub>1 fs\<^sub>1 where cs\<^sub>1: "frames cs\<^sub>1 = f\<^sub>1 # fs\<^sub>1"
    using 1 unfolding represents_state.simps
    by (metis list.exhaust_sel llvm_state.collapse)
  interpret small_step prog cs\<^sub>1 f\<^sub>1 fs\<^sub>1 .
  have [simp]: "hd (frames cs\<^sub>1) = f\<^sub>1"
    by (simp add: cs\<^sub>1)
  obtain fn bn pp where p: "pos as\<^sub>1 = (fn, bn, pp)"
      using prod_cases3 by blast
  then have p': "frame.pos f\<^sub>1 = (fn, bn, pp)"
    using 1 cs\<^sub>1 by (auto simp add: represents_state.simps represents_frame.simps)
  have "Inr cs\<^sub>2 = step prog cs\<^sub>1"
    using 1 by auto
  also have "\<dots> = run_instruction ins"
    using 1(1) p p' ins_def cs\<^sub>1 by (auto)
  finally have cs\<^sub>2': "run_instruction ins = Inr cs\<^sub>2"
    by simp
  then obtain x x' l i l' i' where
    li_def: "operand_value o\<^sub>1 = Inr x" "x = IntConstant l i"
            "operand_value o\<^sub>2 = Inr x'" "x' = IntConstant l' i'"
    by (auto simp add: ins_def split: sum_bind_splits elim!: icmp_llvm_constant.elims)
      (meson llvm_constant.exhaust)+
  define f\<^sub>2 where "f\<^sub>2 = LLVM_Syntax.update_stack
         (\<lambda>_. Mapping.update n (icmp_llvm_constant p x x') (frame.stack f\<^sub>1))
         (update_pos (\<lambda>_. (fn, bn, Suc pp)) f\<^sub>1)"
  have cs\<^sub>2: "cs\<^sub>2 =  update_frames (\<lambda>_. f\<^sub>2 # fs\<^sub>1) cs\<^sub>1"
    using cs\<^sub>2' li_def unfolding ins_def f\<^sub>2_def
    by (auto simp add: p' ins_def split: if_splits sum_bind_splits intro: frame.expand)
  obtain v where v: "represents_frame f\<^sub>1 as\<^sub>1 v"
    using 1 unfolding represents_state.simps by auto
