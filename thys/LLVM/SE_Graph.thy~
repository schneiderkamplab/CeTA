    show ?thesis
      apply(auto simp add: f\<^sub>2_def represents_frame.simps)
      subgoal
        using 1  by (auto simp add: p)
      subgoal
        using a by simp
      apply(rule vvm_update[OF _ u, of "frame.stack f\<^sub>1" v, where l=1 ])
      using represents_frame.cases v apply blast
      using v\<^sub>2_def vv_def apply(blast)
      using iI  apply auto
