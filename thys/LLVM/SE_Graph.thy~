inductive branchAsInf for prog as\<^sub>1 as\<^sub>2 where
  "find_statement prog (pos as\<^sub>1) = Inr (Terminator (Br new_b_id)) \<Longrightarrow>
   pos as\<^sub>1 = (f_id, old_b_id, p) \<Longrightarrow>
   pos as\<^sub>2 = (f_id, new_b_id, length phis_stats) \<Longrightarrow>
   Inr phis_stats = find_phis prog f_id new_b_id \<Longrightarrow>
   phi_abstract as\<^sub>1 as\<^sub>2 phis_stats \<phi>s old_b_id \<Longrightarrow>
   (Conjunction (map (\<lambda>(v\<^sub>x,t\<^sub>x). encode_eq (encode_var v\<^sub>x) t\<^sub>x) \<phi>s)) \<and>\<^sub>f (kb as\<^sub>1) \<Longrightarrow>\<^sub>I\<^sub>A kb as\<^sub>2 \<Longrightarrow>
   inj_on (stack as\<^sub>2) (fst ` set phis_stats) \<Longrightarrow>
   (\<forall>a \<in> fst ` \<Union> (vars_term ` snd ` set \<phi>s). a \<notin> fst ` set \<phi>s) \<Longrightarrow>
   (\<forall>x \<in> dom (stack as\<^sub>1). x \<notin> (fst ` set phis_stats) \<longrightarrow> stack as\<^sub>2 x = stack as\<^sub>1 x) \<Longrightarrow>
   dom (stack as\<^sub>2) = dom (stack as\<^sub>1) \<union> fst ` set phis_stats \<Longrightarrow>
   distinct (map fst \<phi>s) \<Longrightarrow>
   distinct (map fst phis_stats) \<Longrightarrow>
   branchAsInf prog as\<^sub>1 as\<^sub>2"

