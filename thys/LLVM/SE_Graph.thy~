      using t by (metis u update_as.simps rangeI)
    then have "v\<^sub>2 (lv, IA.IntT) = v (lv, IA.IntT)"
      unfolding v\<^sub>2_def by simp
    then show ?thesis
      by (metis llvm_constant.sel(2) look option.sel represents_frame.cases that v
          valid_var_mapping.cases)
  qed
  have iI: "icmp_llvm_constant p x x' = IntConstant 1 (if b then 1 else 0)"
    unfolding `\<chi> = (if b then encode_eq (encode_var v\<^sub>n) (Fun (IA.ConstF 1) []) else encode_eq (encode_var v\<^sub>n) (Fun (IA.ConstF 0) []))`
    unfolding `\<phi> = encode_pred p t\<^sub>1 t\<^sub>2` apply (cases p)
      apply (auto simp add: v\<^sub>2_def vv_def `\<phi> = encode_pred p t\<^sub>1 t\<^sub>2`)
    using 1(3) 1(4) 1(5) apply (auto simp add: v\<^sub>2_def vv_def `\<phi> = encode_pred p t\<^sub>1 t\<^sub>2` li_def split: if_splits)

    using IA.impliesD[OF _ \<open>IA.assignment v\<^sub>2\<close> \<open>v\<^sub>2 \<Turnstile>\<^sub>I\<^sub>A kb as\<^sub>1\<close>]
    by force+
  have r_f\<^sub>2_v\<^sub>2: "represents_frame f\<^sub>2 as\<^sub>2 v\<^sub>2"
  proof -
    have a: "same_stack_names (Mapping.update n (icmp_llvm_constant p x x') (frame.stack f\<^sub>1))
