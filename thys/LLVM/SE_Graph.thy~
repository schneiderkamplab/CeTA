lemma step'_Inl_Inr:
  assumes "step' prog s\<^sub>1 (Inr s\<^sub>2)"
  shows "\<nexists>e. step' prog s\<^sub>1 (Inl e)"
proof -
  have ?thesis if "find_statement prog (frame.pos f) = Inl x" "frames s\<^sub>1 = f#fs" for f fs x
