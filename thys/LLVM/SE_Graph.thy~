    have a: "same_stack_names (frame.stack f\<^sub>2) (abstract_state.stack as\<^sub>s)"
      using v\<^sub>1 skipCallInf unfolding f\<^sub>2_def c
      by (auto intro: ssn_update simp add: represents_frame.simps small_step.update_stack.simps)
    have b: "IA.assignment v\<^sub>2"
      using v\<^sub>1 unfolding v\<^sub>2_def represents_frame.simps by (auto)
    have c: "valid_var_mapping (frame.stack f\<^sub>2) (abstract_state.stack as\<^sub>s) v\<^sub>2"
      using v\<^sub>1 skipCallInf unfolding v\<^sub>2_def f\<^sub>2_def represents_frame.simps
      by (auto intro: vvm_update simp add: small_step.update_stack.simps c)
    have d: "v\<^sub>2 \<Turnstile>\<^sub>I\<^sub>A kb as\<^sub>1"
      using v\<^sub>1 skipCallInf by (simp add: update_as.simps represents_frame.simps v\<^sub>2_def)
    have e: "v\<^sub>2 \<Turnstile>\<^sub>I\<^sub>A kb as\<^sub>s"
