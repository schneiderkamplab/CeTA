        then obtain p\<^sub>o where p\<^sub>o: "(n, p\<^sub>o) \<in> set xs"
          by blast
        have "\<exists>v\<^sub>n t. linkParams' as\<^sub>1 as\<^sub>f n p\<^sub>o v\<^sub>n t"
          using lPa p\<^sub>o by (induction as\<^sub>1 as\<^sub>f  xs vs rule: linkParams.induct) (auto)
        then show ?thesis
          unfolding linkParams'.simps by auto
      qed
      moreover have "\<exists>x. Mapping.lookup zs n = Some x" if "abstract_state.stack as\<^sub>f n = Some y" for n y
      proof -
        have a: "n \<in> set (map parameter_name ps\<^sub>g)"
          using callCallInf that by blast
        then show "\<exists>x. Mapping.lookup zs n = Some x"
          using zs_def
          by (induction ls ps\<^sub>g arbitrary: zs n x rule: small_step.zip_parameters.induct)
            (fastforce split: sum_bind_splits simp add: small_step.zip_parameters.simps)+
      qed
      ultimately show ?thesis
        using same_stack_names.intros by (auto simp add: f\<^sub>2_def intro!: same_stack_names.intros)
    qed
    have e: "valid_var_mapping (frame.stack f\<^sub>2) (abstract_state.stack as\<^sub>f) v\<^sub>2"
    proof -
      have "v\<^sub>2 (lv, IA.IntT) = IA.Int i" if "Mapping.lookup zs n = Some (IntConstant l i)"
        "abstract_state.stack as\<^sub>f n = Some lv"  for lv l i n
      proof -
        have "n \<in> set (map parameter_name ps\<^sub>g)"
          using zs_def that
          by(induction ls ps\<^sub>g arbitrary: zs n x rule: small_step.zip_parameters.induct)
