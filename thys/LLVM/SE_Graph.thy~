lemma vvm_non_update_stack:
  assumes
    "valid_var_mapping s (stack as\<^sub>1) v"
    "v' = v ((v\<^sub>m, IA.IntT) := IA.Int i)"
    "v\<^sub>m \<notin> all_sym_vars as\<^sub>1"
 shows "valid_var_mapping s (stack as\<^sub>1) v'"
proof -
  show ?thesis
    unfolding valid_var_mapping.simps using assms ranI[of "abstract_state.stack as\<^sub>1"]
    by (fastforce simp add: Mapping.lookup_update Mapping.lookup_update' valid_var_mapping.simps
        update_as.simps all_sym_vars_def)
qed

lemma vvm_update_int:
  assumes "valid_var_mapping s (stack as\<^sub>1) v" "update_as as\<^sub>1 as\<^sub>2 n (IntType l) v\<^sub>n \<phi>"
    "v' = v ((v\<^sub>n, IA.IntT) := IA.Int i)"
    "s' = Mapping.update n (IntegerValue l i) s"
 shows "valid_var_mapping s' (stack as\<^sub>2) v'"
proof -
  show ?thesis
    unfolding valid_var_mapping.simps using assms ranI[of "abstract_state.stack as\<^sub>1"]
    apply(auto simp add: Mapping.lookup_update Mapping.lookup_update' valid_var_mapping.simps
        update_as.simps all_sym_vars_def)
    by blast
qed

lemma vvm_update_pointer:
  assumes "valid_var_mapping s (stack as\<^sub>1) v" "update_as as\<^sub>1 as\<^sub>2 n (PointerType lt) v\<^sub>n \<phi>"
    "v' = v ((v\<^sub>n, IA.IntT) := IA.Int i)"
    "s' = Mapping.update n (Pointer lt i) s"
 shows "valid_var_mapping s' (stack as\<^sub>2) v'"
proof -
  show ?thesis
    unfolding valid_var_mapping.simps using assms ranI[of "abstract_state.stack as\<^sub>1"]
    apply(auto simp add: Mapping.lookup_update Mapping.lookup_update' valid_var_mapping.simps
        update_as.simps all_sym_vars_def)
    by blast
qed

lemma operand_value_vvm_ssn:
  assumes op: "SE_Graph.operand_value as op = Some (IntType l, lvt)"
    and val: "valid_var_mapping (frame.stack f) (abstract_state.stack as) v"
    and ssn: "same_stack_names (frame.stack f) (abstract_state.stack as)"
  shows "IA.eval lvt v = IA.Int i \<longleftrightarrow> small_step.operand_value f op = Inr (IntegerValue l i)"
proof (cases op)
  case (ConstantOperand c)
  then show ?thesis using op by (cases c) (auto simp add: small_step.operand_value.simps)
next
  case (LocalReference n)
  have 1: "IA.eval lvt v = IA.Int i" if "small_step.operand_value f op = Inr (IntegerValue l i)"
    using LocalReference op that val[unfolded valid_var_mapping.simps, rule_format, of n]
    by (auto simp: small_step.operand_value.simps elim!: option_to_sum.elims)
  have 2: "small_step.operand_value f op = Inr (IntegerValue l i)" if "IA.eval lvt v = IA.Int i"
  proof -
    obtain lv where lv: "abstract_state.stack as n = Some (IntType l, lv)" "lvt = encode_int_var lv"
      using LocalReference op by auto
    obtain iv where iv: "Mapping.lookup (frame.stack f) n = Some iv"
      using lv ssn unfolding same_stack_names.simps by blast
    note val' = val[unfolded valid_var_mapping.simps, rule_format, of n iv ]
    have iv': "iv = IntegerValue l i"
      using LocalReference iv lv op that val'
      by (cases iv) (auto simp: small_step.operand_value.simps same_stack_names.simps)
    then show ?thesis
      using iv LocalReference by (auto simp: small_step.operand_value.simps )
  qed
  show ?thesis
    using 1 2 by blast
qed

lemma operand_value_pointer_vvm_ssn:
  assumes op: "SE_Graph.operand_value as op = Some (PointerType t, lvt)"
    and val: "valid_var_mapping (frame.stack f) (abstract_state.stack as) v"
    and ssn: "same_stack_names (frame.stack f) (abstract_state.stack as)"
  shows "IA.eval lvt v = IA.Int i \<longleftrightarrow> small_step.operand_value f op = Inr (Pointer t i)"
proof (cases op)
  case (ConstantOperand c)
  then show ?thesis using op by (cases c) (auto simp add: small_step.operand_value.simps)
next
  case (LocalReference n)
  have 1: "IA.eval lvt v = IA.Int i" if "small_step.operand_value f op = Inr (Pointer t i)"
    using LocalReference op that val[unfolded valid_var_mapping.simps, rule_format, of n]
    by (auto simp: small_step.operand_value.simps elim!: option_to_sum.elims)
  have 2: "small_step.operand_value f op = Inr (Pointer t i)" if "IA.eval lvt v = IA.Int i"
  proof -
    obtain lv where lv: "abstract_state.stack as n = Some (PointerType t, lv)" "lvt = encode_int_var lv"
      using LocalReference op by auto
    obtain iv where iv: "Mapping.lookup (frame.stack f) n = Some iv"
      using lv ssn unfolding same_stack_names.simps by blast
    note val' = val[unfolded valid_var_mapping.simps, rule_format, of n iv ]
    have iv': "iv = (Pointer t i)"
      using LocalReference iv lv op that val'
      by (cases iv) (auto simp: small_step.operand_value.simps same_stack_names.simps)
    then show ?thesis
      using iv LocalReference by (auto simp: small_step.operand_value.simps )
  qed
  show ?thesis
    using 1 2 by blast
qed

lemma (in ll_mem_funs_extra) operand_value_int_represents_frame:
  assumes op: "SE_Graph.operand_value as op = Some (IntType l, lvt)"
    and val: "represents_frame f as v"
  shows "IA.eval lvt v = IA.Int i \<longleftrightarrow> small_step.operand_value f op = Inr (IntegerValue l i)"
  using assms operand_value_vvm_ssn  unfolding represents_frame.simps by blast

lemma (in ll_mem_funs_extra) operand_value_pointer_represents_frame:
  assumes op: "SE_Graph.operand_value as op = Some (PointerType t, lvt)"
    and val: "represents_frame f as v"
  shows "IA.eval lvt v = IA.Int i \<longleftrightarrow> small_step.operand_value f op = Inr (Pointer t i)"
  using assms operand_value_pointer_vvm_ssn  unfolding represents_frame.simps by blast

lemma (in ll_mem_funs_extra) operand_value_represents_frame:
  assumes op: "SE_Graph.operand_value as op = Some (t, lvt)"
    and val: "represents_frame f as v"
  shows "IA.eval lvt v = IA.Int i
         \<longleftrightarrow> (\<exists>x. small_step.operand_value f op = Inr x \<and> stack_value_to_int x = i \<and> ll_typeof x = t)"
proof (cases t)
  case (IntType x1)
  have "ll_typeof x = IntType x1 \<Longrightarrow> i = stack_value_to_int x
   \<Longrightarrow> x = IntegerValue x1 (stack_value_to_int x)" for x
    by (cases x) auto
  then show ?thesis
    using IntType assms by (auto simp add: operand_value_int_represents_frame)
next
  case (PointerType x3)
  have "ll_typeof x = PointerType x3 \<Longrightarrow> i = stack_value_to_int x
    \<Longrightarrow> x = Pointer x3 (stack_value_to_int x)" for x
    by (cases x) auto
  then show ?thesis
    using PointerType assms by (auto simp add: operand_value_pointer_represents_frame)
qed

fun new_b_id_pos where
  "new_b_id_pos (fn, _, _) new_b_id = (fn, new_b_id, 0)"

inductive evalAsInf for prog as\<^sub>1 as\<^sub>2 where
  "find_statement prog (pos as\<^sub>1) = Inr (Instruction (Assignment n (Binop binop o\<^sub>1 o\<^sub>2))) \<Longrightarrow>
   pos as\<^sub>2 = inc_pos (pos as\<^sub>1) \<Longrightarrow>
   operand_value as\<^sub>1 o\<^sub>1 = Some (IntType l\<^sub>1, te\<^sub>1) \<Longrightarrow>
   operand_value as\<^sub>1 o\<^sub>2 = Some (IntType l\<^sub>2, te\<^sub>2) \<Longrightarrow>
   l\<^sub>2 = l\<^sub>1 \<Longrightarrow>
   0 < l\<^sub>1 \<Longrightarrow>
   \<phi> = encode_binop binop v\<^sub>n te\<^sub>1 te\<^sub>2 \<Longrightarrow>
   update_as as\<^sub>1 as\<^sub>2 n (IntType l\<^sub>1)  v\<^sub>n \<phi> \<Longrightarrow>
   allocs as\<^sub>2 = allocs as\<^sub>1 \<Longrightarrow>
   pointers as\<^sub>2 = pointers as\<^sub>1 \<Longrightarrow>
   evalAsInf prog as\<^sub>1 as\<^sub>2"


lemma update_pos_stack:
  "update_pos (\<lambda>_. p) (update_stack (\<lambda>_. f) x) = update_stack (\<lambda>_. f) (update_pos (\<lambda>_. p) x)"
  by (cases x) (auto)

lemma option_to_sum:
  "option_to_sum m l = Inr y \<Longrightarrow> m = Some y"
  by (cases m)  auto



locale ll_mem = ll_mem_funs_extra _ _ _ _  +
  assumes S1: "len_of t > 0"
  assumes S2: "l > 0 \<Longrightarrow> isOK (alloc m t l)"
  assumes S3: "alloc m t l = Inr ((lb, ub), m') \<Longrightarrow> ub - lb = int (len_of t) * l"
  assumes S4: "alloc m t l = Inr ((lb, ub), m') \<Longrightarrow> a \<notin> {lb..<ub} \<Longrightarrow> load m' t' a = load m t' a"
  assumes S5: "alloc m t l = Inr ((lb, ub), m') \<Longrightarrow> a \<in> {lb..<ub} \<Longrightarrow> bounds m' a = Some (lb, ub)"
  assumes S6: "alloc m t l = Inr ((lb, ub), m') \<Longrightarrow> a \<notin> {lb..<ub} \<Longrightarrow> bounds m' a = bounds m a"
  assumes S7: "alloc m t l = Inr ((lb, ub), m') \<Longrightarrow> a \<in> {lb..<ub} \<Longrightarrow> bounds m a = None"
  assumes S8: "bounds m a = Some (lb, ub) \<Longrightarrow> lb \<le> a \<Longrightarrow> a + len_of t \<le> ub \<Longrightarrow> (\<exists>m'. store m a t v = Inr m')"
  assumes S9: "store m a t v = Inr m' \<Longrightarrow> bounds m' = bounds m"
  assumes S10: "store m a t v = Inr m' \<Longrightarrow> a' + (len_of t') \<le> a \<or> a + (len_of t) \<le> a' \<Longrightarrow> load m' t' a' = load m t' a'"
  assumes S11: "store m a t v = Inr m' \<Longrightarrow> load m' t a = Inr v"


lemma (in IA_locale) assignment_eval_int: "assignment ev \<Longrightarrow> \<exists>i. ev (lv, IA.IntT) = IA.Int i"
  by (metis IA.assignmentD IA.mem_Values_of_typeD prod.sel(2))

lemma (in IA_locale) assignment_eval_to_int:
  "assignment ev \<Longrightarrow> IA.to_int (ev (lv, IA.IntT)) = i \<Longrightarrow> ev (lv, IA.IntT) = IA.Int i"
  using assignment_eval_int[of ev lv] by auto 


lemma (in ll_mem) alloc_allocated_address_def:
  assumes "alloc m t l = Inr ((lb, ub), m')"
  shows  "bounds m' a = (if a \<in> {lb..<ub} then Some (lb, ub) else bounds m a)"
  using assms S6 S5 by (auto)

