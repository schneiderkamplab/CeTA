        using cs\<^sub>2 A a unfolding f\<^sub>2_def represents_frame.simps same_stack_names.simps by fastforce
      moreover have "IA.Int (integerValue y) = v\<^sub>2 (lv, IA.IntT)"
        using v\<^sub>1 y A c  unfolding represents_frame.simps valid_var_mapping.simps by (cases y) (auto)
      ultimately show ?thesis
        unfolding assig_of_state_def cs\<^sub>2 using a by (auto simp add: v\<^sub>2_def)
    qed
    ultimately have f: "as_as_step as\<^sub>1 as\<^sub>s (assig_of_state cs\<^sub>1) (assig_of_state cs\<^sub>2) id"
      using 1 b e d assignment_assig_of_state by (auto intro: as_as_step.intros)
    moreover have "represents_state cs\<^sub>2 as\<^sub>s"
      using a b c e skipCallInf unfolding cs\<^sub>2 f\<^sub>2_def
      by (auto simp add: represents_state.simps represents_frame.simps)
    ultimately show ?thesis
      by (auto)
  qed
