lemma callInf_represents_step':
  assumes "callAsInf prog as\<^sub>1 as\<^sub>f as\<^sub>s" "represents_state cs\<^sub>1 as\<^sub>1" "step' prog cs\<^sub>1 (Inr cs\<^sub>2)"
  shows "represents_state cs\<^sub>2 as\<^sub>f \<and> as_as_step as\<^sub>1 as\<^sub>f (assig_of_state cs\<^sub>1) (assig_of_state cs\<^sub>2) id
       \<or> represents_state cs\<^sub>2 as\<^sub>s \<and>  as_as_step as\<^sub>1 as\<^sub>s (assig_of_state cs\<^sub>1) (assig_of_state cs\<^sub>2) id"
  using assms proof (induction rule: callAsInf.induct)
  case (1 x t g ls v\<^sub>n vs)
  note callInf = 1
  obtain f\<^sub>1 fs\<^sub>1 where f\<^sub>1: "frames cs\<^sub>1 = f\<^sub>1#fs\<^sub>1"
    using callInf by (auto simp add: step'_def split: list.splits)
  have [simp]: "pos as\<^sub>1 = frame.pos f\<^sub>1"
    using callInf by (auto simp add: represents_simps f\<^sub>1)
  obtain t\<^sub>g ps\<^sub>g b\<^sub>g bs\<^sub>g where find_fun: "small_step.map_of_funs prog g = Some (Function t\<^sub>g g ps\<^sub>g b\<^sub>g bs\<^sub>g)"
    using callInf unfolding callCallInf.simps using map_of_funs_name by auto blast
  have callCallInf: "abstract_state.pos as\<^sub>f = (g, basic_block.name b\<^sub>g, 0)"
    "linkParams as\<^sub>1 as\<^sub>f (zip (map parameter_name ps\<^sub>g) ls) vs"
    "distinct (map fst vs)"
    "dom (abstract_state.stack as\<^sub>f) = set (map parameter_name ps\<^sub>g)"
    "(\<And>\<^sub>f (v\<^sub>x, y)\<leftarrow>vs. encode_eq (encode_var v\<^sub>x) y) \<and>\<^sub>f kb as\<^sub>1 \<Longrightarrow>\<^sub>I\<^sub>A kb as\<^sub>f"
    "(\<forall>x \<in> fst ` \<Union> (vars_term ` snd ` set vs). x \<notin> fst ` set vs)"
    "distinct (map parameter_name ps\<^sub>g)"
    using find_fun callInf(3)[unfolded callCallInf.simps] by (force)+
  obtain v\<^sub>1 where v\<^sub>1: "represents_frame f\<^sub>1 as\<^sub>1 v\<^sub>1"
    using callInf unfolding represents_state.simps f\<^sub>1 by auto
  have "step_call prog cs\<^sub>1 f\<^sub>1 fs\<^sub>1 x t g ls (Inr cs\<^sub>2)"
    using callInf by (auto simp add: f\<^sub>1 step'_def split: list.splits)
  then consider
    (call) "small_step.call_external_function prog cs\<^sub>1 f\<^sub>1 fs\<^sub>1 g ls x (Inr cs\<^sub>2)"
    | (skip) f' c where "Inr f' = small_step.enter_frame prog f\<^sub>1 g ls"
      "(Inr (update_frames (\<lambda>_. [f']) cs\<^sub>1), Inl (ReturnValue c)) \<in> (step_rel_e prog)\<^sup>+"
      "Inr cs\<^sub>2 = small_step.update_frames_stack cs\<^sub>1 f\<^sub>1 fs\<^sub>1 x (Inr c)"
    unfolding step_call.simps by blast
  then show ?case
  proof (cases)
    case call
    then have call: "Inr cs\<^sub>2 = small_step.run_instruction prog cs\<^sub>1 f\<^sub>1 fs\<^sub>1 (Assignment x (R_Call (Call t g ls)))"
      unfolding small_step.call_external_function_def using find_fun by (auto simp add: small_step.simps)
    have a: "Inr cs\<^sub>2 =
     small_step.zip_parameters f\<^sub>1 ls ps\<^sub>g \<bind>
    (\<lambda>zs. Inr (Llvm_state (Frame (g, basic_block.name b\<^sub>g, 0) zs # f\<^sub>1 # fs\<^sub>1)))"
      using callInf find_fun  unfolding call callCallInf.simps
      by (auto simp add: small_step.simps split: sum_bind_splits)
    obtain zs where zs_def: "Inr zs = small_step.zip_parameters f\<^sub>1 ls ps\<^sub>g"
      using callInf find_fun step'_Inl_Inr [OF \<open>step' prog cs\<^sub>1 (Inr cs\<^sub>2)\<close>] unfolding call callCallInf.simps
      by (auto simp add: small_step.simps split: sum_bind_splits)
    define f\<^sub>2 where "f\<^sub>2 = Frame (g, basic_block.name b\<^sub>g, 0) zs"
    have cs\<^sub>2: "cs\<^sub>2 = Llvm_state (f\<^sub>2 # f\<^sub>1 # fs\<^sub>1)"
      using f\<^sub>2_def a zs_def by (auto split: sum_bind_splits)
    define v\<^sub>2 where "v\<^sub>2 = (\<lambda>(v, t).
     if t = IA.IntT
     then case map_of vs v of Some t\<^sub>x \<Rightarrow> (\<lbrakk>t\<^sub>x\<rbrakk>\<^sub>I\<^sub>A v\<^sub>1) | None \<Rightarrow> v\<^sub>1 (v,t)
     else v\<^sub>1 (v,t))"
    have v\<^sub>2_v\<^sub>1: "v\<^sub>2 (v,t) = v\<^sub>1 (v,t)" if "v \<notin> fst ` set vs" for v t
      using that map_of_eq_None_iff 1 unfolding v\<^sub>2_def callCallInf.simps by (auto split: option.splits)
    have v\<^sub>2_s: "v\<^sub>2 (v,IA.IntT) = (\<lbrakk>t\<^sub>x\<rbrakk>\<^sub>I\<^sub>A v\<^sub>1)" if "(v,t\<^sub>x) \<in> set vs" for v t\<^sub>x
      using that map_of_eq_Some_iff 1 unfolding v\<^sub>2_def callCallInf.simps by (auto)
    have b: "lv \<notin> fst ` set vs" if "abstract_state.stack as\<^sub>1 pv = Some lv" for lv pv
      using `linkParams as\<^sub>1 as\<^sub>f (zip (map parameter_name ps\<^sub>g) ls) vs` that
      by (induction rule: linkParams.induct) (auto simp add: linkParams'.simps ranI)
    have vars_term_t\<^sub>x: "a \<notin> fst ` set vs" if "(a, b) \<in> vars_term t\<^sub>x" "(v\<^sub>x,t\<^sub>x) \<in> set vs" for v\<^sub>x a b t\<^sub>x
      using callCallInf that by blast
    have t\<^sub>x_IntT: "IA.has_type t\<^sub>x IA.IntT" if "(v\<^sub>x,t\<^sub>x) \<in> set vs" for v\<^sub>x t\<^sub>x
      using `linkParams as\<^sub>1 as\<^sub>f (zip (map parameter_name ps\<^sub>g) ls) vs` that
      by (induction rule: linkParams.induct) (auto simp add: linkParams'.simps ranI)
    have v\<^sub>2_assig: "IA.assignment v\<^sub>2"
    proof -
      have a: "v\<^sub>1 (n, IA.IntT) \<in> range IA.Int" for n
        using v\<^sub>1 unfolding represents_frame.simps IA.assignment_def by fastforce
      have "IA.has_type t IA.IntT" if "map_of vs n = Some t" for n t
        using that t\<^sub>x_IntT  by (meson map_of_SomeD)
      then have b: "\<lbrakk>t\<rbrakk>\<^sub>I\<^sub>A v\<^sub>1 \<in> range IA.Int" if "map_of vs n = Some t" for n t
        using that IA.eval_types IA_locale.Values_of_type.simps(2) represents_frame.cases v\<^sub>1
        by metis
      show ?thesis
        using v\<^sub>1 a b unfolding represents_frame.simps v\<^sub>2_def IA.assignment_def
        by (auto split: option.splits)
    qed
    have vs_kb_as\<^sub>1: "fst ` set vs \<inter> fst ` vars_formula (kb as\<^sub>1) = {}"
      using `linkParams as\<^sub>1 as\<^sub>f (zip (map parameter_name ps\<^sub>g) ls) vs`
      by (induction rule: linkParams.induct) (auto simp add: linkParams'.simps)
    have c: "v\<^sub>2 \<Turnstile>\<^sub>I\<^sub>A kb as\<^sub>1"
    proof -
      have "v\<^sub>2 x = v\<^sub>1 x" if "x \<in> vars_formula (kb as\<^sub>1)" for x
        using vs_kb_as\<^sub>1 that by (cases x) (auto intro!: v\<^sub>2_v\<^sub>1)
      then show ?thesis
        by (rule vars_formula_satisfies[of _ _ v\<^sub>1])
          (use v\<^sub>1 in \<open>auto simp add: represents_frame.simps\<close>)
    qed
    have v\<^sub>2_kb: "v\<^sub>2 \<Turnstile>\<^sub>I\<^sub>A kb as\<^sub>f"
    proof -
      have a: "v\<^sub>1 x = v\<^sub>2 x" if "(n, t) \<in> set vs" "x \<in> vars_term t" for n t x
        using vars_term_t\<^sub>x that by (cases x) (auto simp add: v\<^sub>2_v\<^sub>1)
      then have b: "v\<^sub>2 \<Turnstile>\<^sub>I\<^sub>A (\<And>\<^sub>f (v\<^sub>x, t\<^sub>x)\<leftarrow>vs. encode_eq (encode_var v\<^sub>x) t\<^sub>x) \<and>\<^sub>f kb as\<^sub>1" (is "_ \<Turnstile>\<^sub>I\<^sub>A ?f")
        using c by (auto simp add: v\<^sub>2_s IA.eval_same_vars[OF a])
      show ?thesis
        by (rule IA.impliesD[of ?f]) (use callCallInf v\<^sub>2_assig b in auto)
    qed
    define xs where "xs = zip (map parameter_name ps\<^sub>g) ls"
    have ls: "length ls = length ps\<^sub>g"
      using zs_def
      by(induction ls ps\<^sub>g arbitrary: zs x rule: small_step.zip_parameters.induct)
        (fastforce split: sum_bind_splits simp add: small_step.zip_parameters.simps)+
    have lPa: "linkParams as\<^sub>1 as\<^sub>f xs vs"
      unfolding xs_def using callCallInf by blast
    have d: "same_stack_names (frame.stack f\<^sub>2) (abstract_state.stack as\<^sub>f)"
    proof -
      have  "\<exists>y. abstract_state.stack as\<^sub>f n = Some y" if "Mapping.lookup zs n = Some x" for n x
      proof -
        have "n \<in> set (map parameter_name ps\<^sub>g)"
          using zs_def that
          by(induction ls ps\<^sub>g arbitrary: zs n x rule: small_step.zip_parameters.induct)
            (fastforce split: sum_bind_splits simp add: small_step.zip_parameters.simps)+
        then have "\<exists>p\<^sub>o. (n, p\<^sub>o) \<in> set xs"
