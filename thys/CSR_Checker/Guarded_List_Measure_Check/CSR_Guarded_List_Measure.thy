      (v,w) \<in> A\<^sup>* \<Longrightarrow> (w,x) \<in> B \<Longrightarrow>
      (s,t) \<notin> S \<Longrightarrow> (u,v) \<in> S"
  shows "SN_rel B A"
proof (rule ccontr)
