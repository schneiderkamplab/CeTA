lemma csr_guard_strict_pair_instance_gt:
  assumes symbols: "distinct [a,u11,u21,u31,z,su,len,ni,co,ta,zs]"
    and marked_u11: "Sharp u11 \<notin> set [a,u11,u21,u31]"
