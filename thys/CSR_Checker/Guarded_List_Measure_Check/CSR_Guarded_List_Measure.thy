theory CSR_Guarded_List_Measure
  imports CSR_Checker_Extensions.CSR_Minimal_CSDP_Proofs
begin

text \<open>
  Semantic ranks for the common membership-guarded list pattern used by
  context-sensitive specifications.  The three mutually recursive sorts are
  kept semantic: the same constructor may build a finite list or a possibly
  infinite list depending on the demanded result sort.  Every recursive call
  is on a proper syntactic subterm, so the rank is executable and independent
  of a particular benchmark spelling.
\<close>

datatype csr_guard_sort = Guard_Nat | Guard_List | Guard_IList

datatype ('v) csr_guard_form = Guard_Form
  "('v \<times> csr_guard_sort) list"
  "('v \<times> csr_guard_sort) list"
  nat

text \<open>
  Administrative symbols produced by the standard conditional-rule
  compilation are erased to the constructor expression they resume.  This
  makes the semantic rank stable across U11/U21/U31 steps without assigning
  an ad-hoc value to a guard term.
\<close>

fun csr_guard_erase_admin ::
  "'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow>
   'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow> ('f,'v) term \<Rightarrow> ('f,'v) term"
where
  "csr_guard_erase_admin u11 u21 u31 su len ni co ta (Var x) = Var x"
| "csr_guard_erase_admin u11 u21 u31 su len ni co ta (Fun f ts) =
    (if f = u11 \<and> length ts = 2 then
       Fun su [Fun len [csr_guard_erase_admin u11 u21 u31 su len ni co ta (ts ! 1)]]
     else if f = u21 \<and> length ts = 1 then Fun ni []
     else if f = u31 \<and> length ts = 4 then
       Fun co
         [csr_guard_erase_admin u11 u21 u31 su len ni co ta (ts ! 3),
          Fun ta
            [csr_guard_erase_admin u11 u21 u31 su len ni co ta (ts ! 2),
             csr_guard_erase_admin u11 u21 u31 su len ni co ta (ts ! 1)]]
     else Fun f (map (csr_guard_erase_admin u11 u21 u31 su len ni co ta) ts))"

lemma csr_guard_erase_admin_subst:
  "csr_guard_erase_admin u11 u21 u31 su len ni co ta (t \<cdot> \<sigma>) =
    csr_guard_erase_admin u11 u21 u31 su len ni co ta t \<cdot>
      (\<lambda>x. csr_guard_erase_admin u11 u21 u31 su len ni co ta (\<sigma> x))"
proof (induction t)
  case (Var x)
  then show ?case by simp
next
  case (Fun f ts)
  then show ?case by (simp split: if_splits)
qed

lemma csr_guard_erase_admin_u11:
  assumes distinct: "distinct [u11,u21,u31,su,len,ni,co,ta]"
  shows "csr_guard_erase_admin u11 u21 u31 su len ni co ta
      (Fun u11 [q,l]) =
    csr_guard_erase_admin u11 u21 u31 su len ni co ta
      (Fun su [Fun len [l]])"
  using distinct by (simp; fastforce)

lemma csr_guard_erase_admin_u21:
  assumes distinct: "distinct [u11,u21,u31,su,len,ni,co,ta]"
  shows "csr_guard_erase_admin u11 u21 u31 su len ni co ta
      (Fun u21 [q]) =
    csr_guard_erase_admin u11 u21 u31 su len ni co ta (Fun ni [])"
  using distinct by (simp; fastforce)

lemma csr_guard_erase_admin_u31:
  assumes distinct: "distinct [u11,u21,u31,su,len,ni,co,ta]"
  shows "csr_guard_erase_admin u11 u21 u31 su len ni co ta
      (Fun u31 [q,il,m,n]) =
    csr_guard_erase_admin u11 u21 u31 su len ni co ta
      (Fun co [n, Fun ta [m,il]])"
  using distinct by (simp; fastforce)

text \<open>
  The sequential conjunction generated by the conditional-rule compiler
  resumes with its second argument after the first guard succeeds.  Its
  numerical continuation is therefore the second argument independently of
  the guard's current reduction state.
\<close>

fun csr_guard_erase_and ::
  "'f \<Rightarrow> ('f,'v) term \<Rightarrow> ('f,'v) term"
where
  "csr_guard_erase_and a (Var x) = Var x"
| "csr_guard_erase_and a (Fun f ts) =
    (if f = a \<and> length ts = 2 then csr_guard_erase_and a (ts ! 1)
     else Fun f (map (csr_guard_erase_and a) ts))"

lemma csr_guard_erase_and_subst:
  "csr_guard_erase_and a (t \<cdot> \<sigma>) =
    csr_guard_erase_and a t \<cdot> (\<lambda>x. csr_guard_erase_and a (\<sigma> x))"
proof (induction t)
  case (Var x)
  then show ?case by simp
next
  case (Fun f ts)
  then show ?case by (simp split: if_splits)
qed

definition csr_guard_normalize where
  "csr_guard_normalize a u11 u21 u31 su len ni co ta t =
    csr_guard_erase_and a
      (csr_guard_erase_admin u11 u21 u31 su len ni co ta t)"

lemma csr_guard_normalize_subst:
  "csr_guard_normalize a u11 u21 u31 su len ni co ta (t \<cdot> \<sigma>) =
    csr_guard_normalize a u11 u21 u31 su len ni co ta t \<cdot>
      (\<lambda>x. csr_guard_normalize a u11 u21 u31 su len ni co ta (\<sigma> x))"
  unfolding csr_guard_normalize_def csr_guard_erase_admin_subst
    csr_guard_erase_and_subst by simp

fun csr_guard_form_requirements where
  "csr_guard_form_requirements (Guard_Form req cs c) = req"

fun csr_guard_form_coefficients where
  "csr_guard_form_coefficients (Guard_Form req cs c) = cs"

fun csr_guard_form_constant where
  "csr_guard_form_constant (Guard_Form req cs c) = c"

text \<open>
  A symbolic form contains, in order, the variable-sort requirements needed
  for definedness, the variables occurring with coefficient one in the rank,
  and the natural constant.  Repetition represents larger coefficients.  The
  distinction between requirements and coefficients matters for constructor
  heads: a list element must be a natural although its numerical value does
  not contribute to list length.
\<close>

fun csr_guard_symbolic_rank ::
  "'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow>
   'f \<Rightarrow> 'f \<Rightarrow> csr_guard_sort \<Rightarrow>
   ('f,'v) term \<Rightarrow> 'v csr_guard_form option"
where
  "csr_guard_symbolic_rank z su len ni co ta zs A (Var x) =
    Some (Guard_Form [(x,A)] [(x,A)] 0)"
| "csr_guard_symbolic_rank z su len ni co ta zs Guard_Nat (Fun f ts) =
    (if f = z \<and> ts = [] then Some (Guard_Form [] [] 0)
     else if f = su \<and> length ts = 1 then
       (case csr_guard_symbolic_rank z su len ni co ta zs Guard_Nat (ts ! 0) of
          None \<Rightarrow> None
        | Some (Guard_Form req cs c) \<Rightarrow>
            Some (Guard_Form req cs (Suc c)))
     else if f = len \<and> length ts = 1 then
       csr_guard_symbolic_rank z su len ni co ta zs Guard_List (ts ! 0)
     else None)"
| "csr_guard_symbolic_rank z su len ni co ta zs Guard_List (Fun f ts) =
    (if f = ni \<and> ts = [] then Some (Guard_Form [] [] 0)
     else if f = co \<and> length ts = 2 then
       (case (csr_guard_symbolic_rank z su len ni co ta zs Guard_Nat (ts ! 0),
              csr_guard_symbolic_rank z su len ni co ta zs Guard_List (ts ! 1)) of
          (Some (Guard_Form reqn coeffn cn),
           Some (Guard_Form reql coeffl cl)) \<Rightarrow>
             Some (Guard_Form (reqn @ reql) coeffl (Suc cl))
        | _ \<Rightarrow> None)
     else if f = ta \<and> length ts = 2 then
       (case (csr_guard_symbolic_rank z su len ni co ta zs Guard_Nat (ts ! 0),
              csr_guard_symbolic_rank z su len ni co ta zs Guard_IList (ts ! 1)) of
          (Some (Guard_Form reqn coeffn cn),
           Some (Guard_Form reqi coeffi ci)) \<Rightarrow>
             Some (Guard_Form (reqn @ reqi) coeffn cn)
        | _ \<Rightarrow> None)
     else None)"
| "csr_guard_symbolic_rank z su len ni co ta zs Guard_IList (Fun f ts) =
    (if f = zs \<and> ts = [] then Some (Guard_Form [] [] 0)
     else if f = co \<and> length ts = 2 then
       (case (csr_guard_symbolic_rank z su len ni co ta zs Guard_Nat (ts ! 0),
              csr_guard_symbolic_rank z su len ni co ta zs Guard_IList (ts ! 1)) of
          (Some (Guard_Form reqn coeffn cn),
           Some (Guard_Form reqi coeffi ci)) \<Rightarrow>
             Some (Guard_Form (reqn @ reqi) [] 0)
        | _ \<Rightarrow> None)
     else if f = ni \<and> ts = [] then Some (Guard_Form [] [] 0)
     else if f = ta \<and> length ts = 2 then
       (case (csr_guard_symbolic_rank z su len ni co ta zs Guard_Nat (ts ! 0),
              csr_guard_symbolic_rank z su len ni co ta zs Guard_IList (ts ! 1)) of
          (Some (Guard_Form reqn coeffn cn),
           Some (Guard_Form reqi coeffi ci)) \<Rightarrow>
             Some (Guard_Form (reqn @ reqi) [] 0)
        | _ \<Rightarrow> None)
     else None)"

fun csr_guard_rank ::
  "'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow>
   'f \<Rightarrow> 'f \<Rightarrow> csr_guard_sort \<Rightarrow>
   ('f,'v) term \<Rightarrow> nat option"
where
  "csr_guard_rank z su len ni co ta zs Guard_Nat (Var x) = None"
| "csr_guard_rank z su len ni co ta zs Guard_Nat (Fun f ts) =
    (if f = z \<and> ts = [] then Some 0
     else if f = su \<and> length ts = 1 then
       map_option Suc
         (csr_guard_rank z su len ni co ta zs Guard_Nat (ts ! 0))
     else if f = len \<and> length ts = 1 then
       csr_guard_rank z su len ni co ta zs Guard_List (ts ! 0)
     else None)"
| "csr_guard_rank z su len ni co ta zs Guard_List (Var x) = None"
| "csr_guard_rank z su len ni co ta zs Guard_List (Fun f ts) =
    (if f = ni \<and> ts = [] then Some 0
     else if f = co \<and> length ts = 2 then
       (case csr_guard_rank z su len ni co ta zs Guard_Nat (ts ! 0) of
          None \<Rightarrow> None
        | Some n \<Rightarrow> map_option Suc
            (csr_guard_rank z su len ni co ta zs Guard_List (ts ! 1)))
     else if f = ta \<and> length ts = 2 then
       (case csr_guard_rank z su len ni co ta zs Guard_Nat (ts ! 0) of
          None \<Rightarrow> None
        | Some n \<Rightarrow>
            (case csr_guard_rank z su len ni co ta zs Guard_IList (ts ! 1) of
               None \<Rightarrow> None
             | Some m \<Rightarrow> Some n))
     else None)"
| "csr_guard_rank z su len ni co ta zs Guard_IList (Var x) = None"
| "csr_guard_rank z su len ni co ta zs Guard_IList (Fun f ts) =
    (if f = zs \<and> ts = [] then Some 0
     else if f = co \<and> length ts = 2 then
       (case csr_guard_rank z su len ni co ta zs Guard_Nat (ts ! 0) of
          None \<Rightarrow> None
        | Some n \<Rightarrow>
            (case csr_guard_rank z su len ni co ta zs Guard_IList (ts ! 1) of
               None \<Rightarrow> None
             | Some m \<Rightarrow> Some 0))
     else if f = ni \<and> ts = [] then Some 0
     else if f = ta \<and> length ts = 2 then
       (case csr_guard_rank z su len ni co ta zs Guard_Nat (ts ! 0) of
          None \<Rightarrow> None
        | Some n \<Rightarrow>
            (case csr_guard_rank z su len ni co ta zs Guard_IList (ts ! 1) of
               None \<Rightarrow> None
             | Some m \<Rightarrow> Some 0))
     else None)"

definition csr_guard_erased_rank where
  "csr_guard_erased_rank u11 u21 u31 z su len ni co ta zs A t =
    csr_guard_rank z su len ni co ta zs A
      (csr_guard_erase_admin u11 u21 u31 su len ni co ta t)"

definition csr_guard_erased_symbolic_rank where
  "csr_guard_erased_symbolic_rank u11 u21 u31 z su len ni co ta zs A t =
    csr_guard_symbolic_rank z su len ni co ta zs A
      (csr_guard_erase_admin u11 u21 u31 su len ni co ta t)"

definition csr_guard_normal_rank where
  "csr_guard_normal_rank a u11 u21 u31 z su len ni co ta zs A t =
    csr_guard_rank z su len ni co ta zs A
      (csr_guard_normalize a u11 u21 u31 su len ni co ta t)"

definition csr_guard_normal_symbolic_rank where
  "csr_guard_normal_symbolic_rank a u11 u21 u31 z su len ni co ta zs A t =
    csr_guard_symbolic_rank z su len ni co ta zs A
      (csr_guard_normalize a u11 u21 u31 su len ni co ta t)"

fun csr_guard_form_value ::
  "(('v \<times> csr_guard_sort) \<Rightarrow> nat) \<Rightarrow>
   'v csr_guard_form \<Rightarrow> nat"
where
  "csr_guard_form_value \<rho> (Guard_Form req cs c) =
    c + sum_list (map \<rho> cs)"

definition csr_guard_requirements_realized where
  "csr_guard_requirements_realized z su len ni co ta zs \<sigma> \<rho> req \<longleftrightarrow>
    (\<forall>x A. (x,A) \<in> set req \<longrightarrow>
      csr_guard_rank z su len ni co ta zs A (\<sigma> x) = Some (\<rho> (x,A)))"

lemma csr_guard_requirements_realized_Nil [simp]:
  "csr_guard_requirements_realized z su len ni co ta zs \<sigma> \<rho> []"
  unfolding csr_guard_requirements_realized_def by simp

lemma csr_guard_requirements_realized_append [simp]:
  "csr_guard_requirements_realized z su len ni co ta zs \<sigma> \<rho> (xs @ ys) \<longleftrightarrow>
    csr_guard_requirements_realized z su len ni co ta zs \<sigma> \<rho> xs \<and>
    csr_guard_requirements_realized z su len ni co ta zs \<sigma> \<rho> ys"
  unfolding csr_guard_requirements_realized_def by auto

lemma csr_guard_symbolic_rank_Var_sound:
  assumes form:
    "csr_guard_symbolic_rank z su len ni co ta zs A (Var x) = Some F"
    and realized: "csr_guard_requirements_realized
      z su len ni co ta zs \<sigma> \<rho> (csr_guard_form_requirements F)"
  shows "csr_guard_rank z su len ni co ta zs A (Var x \<cdot> \<sigma>) =
    Some (csr_guard_form_value \<rho> F)"
  using form realized
  unfolding csr_guard_requirements_realized_def by auto

lemma csr_guard_symbolic_rank_sound:
  assumes distinct: "distinct [z,su,len,ni,co,ta,zs]"
    and symbolic:
    "csr_guard_symbolic_rank z su len ni co ta zs A t = Some F"
    and realized: "csr_guard_requirements_realized
      z su len ni co ta zs \<sigma> \<rho> (csr_guard_form_requirements F)"
  shows "csr_guard_rank z su len ni co ta zs A (t \<cdot> \<sigma>) =
    Some (csr_guard_form_value \<rho> F)"
  using symbolic realized
proof (induction t arbitrary: A F)
  case (Var x)
  then show ?case
    unfolding csr_guard_requirements_realized_def by auto
next
  case (Fun f ts)
  show ?case
  proof (cases A)
    case Guard_Nat
    have symbolic':
      "csr_guard_symbolic_rank z su len ni co ta zs Guard_Nat (Fun f ts) = Some F"
      using Fun.prems(1) Guard_Nat by simp
    consider
        (zero) "f = z" "ts = []" "F = Guard_Form [] [] 0"
      | (succ) req cs c where
          "f = su" "length ts = 1"
          "csr_guard_symbolic_rank z su len ni co ta zs Guard_Nat (ts ! 0) =
             Some (Guard_Form req cs c)"
          "F = Guard_Form req cs (Suc c)"
      | (length) "f = len" "length ts = 1"
          "csr_guard_symbolic_rank z su len ni co ta zs Guard_List (ts ! 0) = Some F"
      using symbolic'
      by (auto simp: csr_guard_symbolic_rank.simps
          split: if_splits option.splits csr_guard_form.splits)
    then show ?thesis
    proof cases
      case zero
      then show ?thesis unfolding Guard_Nat by simp
    next
      case (succ req cs c)
      have mem: "ts ! 0 \<in> set ts" using succ(2) by simp
      have realized_child: "csr_guard_requirements_realized
          z su len ni co ta zs \<sigma> \<rho> req"
        using Fun.prems(2) succ(4) by simp
      have child: "csr_guard_rank z su len ni co ta zs Guard_Nat
          (ts ! 0 \<cdot> \<sigma>) = Some (c + sum_list (map \<rho> cs))"
        using Fun.IH[OF mem succ(3)] realized_child by simp
      show ?thesis unfolding Guard_Nat using succ child distinct by simp
    next
      case length
      have mem: "ts ! 0 \<in> set ts" using length(2) by simp
      have child: "csr_guard_rank z su len ni co ta zs Guard_List
          (ts ! 0 \<cdot> \<sigma>) = Some (csr_guard_form_value \<rho> F)"
        using Fun.IH[OF mem length(3)] Fun.prems(2) by simp
      show ?thesis unfolding Guard_Nat using length child distinct by fastforce
    qed
  next
    case Guard_List
    have symbolic':
      "csr_guard_symbolic_rank z su len ni co ta zs Guard_List (Fun f ts) = Some F"
      using Fun.prems(1) Guard_List by simp
    consider
        (nil) "f = ni" "ts = []" "F = Guard_Form [] [] 0"
      | (cons) reqn coeffn cn reql coeffl cl where
          "f = co" "length ts = 2"
          "csr_guard_symbolic_rank z su len ni co ta zs Guard_Nat (ts ! 0) =
             Some (Guard_Form reqn coeffn cn)"
          "csr_guard_symbolic_rank z su len ni co ta zs Guard_List (ts ! 1) =
             Some (Guard_Form reql coeffl cl)"
          "F = Guard_Form (reqn @ reql) coeffl (Suc cl)"
      | (take) reqn coeffn cn reqi coeffi ci where
          "f = ta" "length ts = 2"
          "csr_guard_symbolic_rank z su len ni co ta zs Guard_Nat (ts ! 0) =
             Some (Guard_Form reqn coeffn cn)"
          "csr_guard_symbolic_rank z su len ni co ta zs Guard_IList (ts ! 1) =
             Some (Guard_Form reqi coeffi ci)"
          "F = Guard_Form (reqn @ reqi) coeffn cn"
      using symbolic'
      by (auto simp: csr_guard_symbolic_rank.simps
          split: if_splits option.splits csr_guard_form.splits prod.splits)
    then show ?thesis
    proof cases
      case nil
      then show ?thesis unfolding Guard_List by simp
    next
      case (cons reqn coeffn cn reql coeffl cl)
      have mem0: "ts ! 0 \<in> set ts" and mem1: "ts ! 1 \<in> set ts"
        using cons(2) by auto
      have realized_n: "csr_guard_requirements_realized
          z su len ni co ta zs \<sigma> \<rho> reqn"
        and realized_l: "csr_guard_requirements_realized
          z su len ni co ta zs \<sigma> \<rho> reql"
        using Fun.prems(2) cons(5) by simp_all
      have child_n: "csr_guard_rank z su len ni co ta zs Guard_Nat
          (ts ! 0 \<cdot> \<sigma>) = Some (cn + sum_list (map \<rho> coeffn))"
        using Fun.IH[OF mem0 cons(3)] realized_n by simp
      have child_l: "csr_guard_rank z su len ni co ta zs Guard_List
          (ts ! 1 \<cdot> \<sigma>) = Some (cl + sum_list (map \<rho> coeffl))"
        using Fun.IH[OF mem1 cons(4)] realized_l by simp
      show ?thesis unfolding Guard_List using cons child_n child_l distinct by fastforce
    next
      case (take reqn coeffn cn reqi coeffi ci)
      have mem0: "ts ! 0 \<in> set ts" and mem1: "ts ! 1 \<in> set ts"
        using take(2) by auto
      have realized_n: "csr_guard_requirements_realized
          z su len ni co ta zs \<sigma> \<rho> reqn"
        and realized_i: "csr_guard_requirements_realized
          z su len ni co ta zs \<sigma> \<rho> reqi"
        using Fun.prems(2) take(5) by simp_all
      have child_n: "csr_guard_rank z su len ni co ta zs Guard_Nat
          (ts ! 0 \<cdot> \<sigma>) = Some (cn + sum_list (map \<rho> coeffn))"
        using Fun.IH[OF mem0 take(3)] realized_n by simp
      have child_i: "csr_guard_rank z su len ni co ta zs Guard_IList
          (ts ! 1 \<cdot> \<sigma>) = Some (ci + sum_list (map \<rho> coeffi))"
        using Fun.IH[OF mem1 take(4)] realized_i by simp
      show ?thesis unfolding Guard_List using take child_n child_i distinct by fastforce
    qed
  next
    case Guard_IList
    have symbolic':
      "csr_guard_symbolic_rank z su len ni co ta zs Guard_IList (Fun f ts) = Some F"
      using Fun.prems(1) Guard_IList by simp
    consider
        (zeros) "f = zs" "ts = []" "F = Guard_Form [] [] 0"
      | (cons) reqn coeffn cn reqi coeffi ci where
          "f = co" "length ts = 2"
          "csr_guard_symbolic_rank z su len ni co ta zs Guard_Nat (ts ! 0) =
             Some (Guard_Form reqn coeffn cn)"
          "csr_guard_symbolic_rank z su len ni co ta zs Guard_IList (ts ! 1) =
             Some (Guard_Form reqi coeffi ci)"
          "F = Guard_Form (reqn @ reqi) [] 0"
      | (nil) "f = ni" "ts = []" "F = Guard_Form [] [] 0"
      | (take) reqn coeffn cn reqi coeffi ci where
          "f = ta" "length ts = 2"
          "csr_guard_symbolic_rank z su len ni co ta zs Guard_Nat (ts ! 0) =
             Some (Guard_Form reqn coeffn cn)"
          "csr_guard_symbolic_rank z su len ni co ta zs Guard_IList (ts ! 1) =
             Some (Guard_Form reqi coeffi ci)"
          "F = Guard_Form (reqn @ reqi) [] 0"
      using symbolic'
      by (auto simp: csr_guard_symbolic_rank.simps
          split: if_splits option.splits csr_guard_form.splits prod.splits)
    then show ?thesis
    proof cases
      case zeros
      then show ?thesis unfolding Guard_IList by simp
    next
      case (cons reqn coeffn cn reqi coeffi ci)
      have mem0: "ts ! 0 \<in> set ts" and mem1: "ts ! 1 \<in> set ts"
        using cons(2) by auto
      have realized_n: "csr_guard_requirements_realized
          z su len ni co ta zs \<sigma> \<rho> reqn"
        and realized_i: "csr_guard_requirements_realized
          z su len ni co ta zs \<sigma> \<rho> reqi"
        using Fun.prems(2) cons(5) by simp_all
      have child_n: "\<exists>n. csr_guard_rank z su len ni co ta zs Guard_Nat
          (ts ! 0 \<cdot> \<sigma>) = Some n"
        using Fun.IH[OF mem0 cons(3)] realized_n by fastforce
      have child_i: "\<exists>n. csr_guard_rank z su len ni co ta zs Guard_IList
          (ts ! 1 \<cdot> \<sigma>) = Some n"
        using Fun.IH[OF mem1 cons(4)] realized_i by fastforce
      show ?thesis unfolding Guard_IList using cons child_n child_i distinct by fastforce
    next
      case nil
      then show ?thesis unfolding Guard_IList using distinct by simp
    next
      case (take reqn coeffn cn reqi coeffi ci)
      have mem0: "ts ! 0 \<in> set ts" and mem1: "ts ! 1 \<in> set ts"
        using take(2) by auto
      have realized_n: "csr_guard_requirements_realized
          z su len ni co ta zs \<sigma> \<rho> reqn"
        and realized_i: "csr_guard_requirements_realized
          z su len ni co ta zs \<sigma> \<rho> reqi"
        using Fun.prems(2) take(5) by simp_all
      have child_n: "\<exists>n. csr_guard_rank z su len ni co ta zs Guard_Nat
          (ts ! 0 \<cdot> \<sigma>) = Some n"
        using Fun.IH[OF mem0 take(3)] realized_n by fastforce
      have child_i: "\<exists>n. csr_guard_rank z su len ni co ta zs Guard_IList
          (ts ! 1 \<cdot> \<sigma>) = Some n"
        using Fun.IH[OF mem1 take(4)] realized_i by fastforce
      show ?thesis unfolding Guard_IList using take child_n child_i distinct by fastforce
    qed
  qed
qed

definition csr_guard_rank_environment where
  "csr_guard_rank_environment z su len ni co ta zs \<sigma> xA =
    (case xA of (x,A) \<Rightarrow>
      the_default 0 (csr_guard_rank z su len ni co ta zs A (\<sigma> x)))"

lemma csr_guard_symbolic_rank_complete:
  assumes distinct: "distinct [z,su,len,ni,co,ta,zs]"
    and ground:
      "csr_guard_rank z su len ni co ta zs A (t \<cdot> \<sigma>) = Some n"
  shows "\<exists>F.
    csr_guard_symbolic_rank z su len ni co ta zs A t = Some F \<and>
    csr_guard_requirements_realized z su len ni co ta zs \<sigma>
      (csr_guard_rank_environment z su len ni co ta zs \<sigma>)
      (csr_guard_form_requirements F) \<and>
    csr_guard_form_value
      (csr_guard_rank_environment z su len ni co ta zs \<sigma>) F = n"
  using ground
proof (induction t arbitrary: A n)
  case (Var x)
  show ?case
  proof (intro exI conjI)
    show "csr_guard_symbolic_rank z su len ni co ta zs A (Var x) =
        Some (Guard_Form [(x,A)] [(x,A)] 0)"
      by simp
    show "csr_guard_requirements_realized z su len ni co ta zs \<sigma>
        (csr_guard_rank_environment z su len ni co ta zs \<sigma>)
        (csr_guard_form_requirements (Guard_Form [(x,A)] [(x,A)] 0))"
      using Var.prems
      unfolding csr_guard_requirements_realized_def
        csr_guard_rank_environment_def by simp
    show "csr_guard_form_value
        (csr_guard_rank_environment z su len ni co ta zs \<sigma>)
        (Guard_Form [(x,A)] [(x,A)] 0) = n"
      using Var.prems unfolding csr_guard_rank_environment_def by simp
  qed
next
  case (Fun f ts)
  show ?case
  proof (cases A)
    case Guard_Nat
    have ground': "csr_guard_rank z su len ni co ta zs Guard_Nat
        (Fun f ts \<cdot> \<sigma>) = Some n"
      using Fun.prems Guard_Nat by simp
    consider
        (zero) "f = z" "ts = []" "n = 0"
      | (succ) m where "f = su" "length ts = 1"
          "csr_guard_rank z su len ni co ta zs Guard_Nat
            (ts ! 0 \<cdot> \<sigma>) = Some m" "n = Suc m"
      | (length) m where "f = len" "length ts = 1"
          "csr_guard_rank z su len ni co ta zs Guard_List
            (ts ! 0 \<cdot> \<sigma>) = Some m" "n = m"
      using ground' distinct
      by (auto simp: csr_guard_rank.simps
          split: if_splits option.splits)
    then show ?thesis
    proof cases
      case zero
      then show ?thesis unfolding Guard_Nat by simp
    next
      case (succ m)
      have mem: "ts ! 0 \<in> set ts" using succ(2) by simp
      obtain F where symbolic:
          "csr_guard_symbolic_rank z su len ni co ta zs Guard_Nat
            (ts ! 0) = Some F"
        and realized: "csr_guard_requirements_realized z su len ni co ta zs \<sigma>
            (csr_guard_rank_environment z su len ni co ta zs \<sigma>)
            (csr_guard_form_requirements F)"
        and valF: "csr_guard_form_value
            (csr_guard_rank_environment z su len ni co ta zs \<sigma>) F = m"
        using Fun.IH[OF mem succ(3)] by blast
      obtain req cs c where F: "F = Guard_Form req cs c" by (cases F)
      show ?thesis
        unfolding Guard_Nat using succ symbolic realized valF F distinct
        by (intro exI[of _ "Guard_Form req cs (Suc c)"]) simp
    next
      case (length m)
      have mem: "ts ! 0 \<in> set ts" using length(2) by simp
      obtain F where symbolic:
          "csr_guard_symbolic_rank z su len ni co ta zs Guard_List
            (ts ! 0) = Some F"
        and realized: "csr_guard_requirements_realized z su len ni co ta zs \<sigma>
            (csr_guard_rank_environment z su len ni co ta zs \<sigma>)
            (csr_guard_form_requirements F)"
        and valF: "csr_guard_form_value
            (csr_guard_rank_environment z su len ni co ta zs \<sigma>) F = m"
        using Fun.IH[OF mem length(3)] by blast
      show ?thesis unfolding Guard_Nat using length symbolic realized valF distinct by force
    qed
  next
    case Guard_List
    have ground': "csr_guard_rank z su len ni co ta zs Guard_List
        (Fun f ts \<cdot> \<sigma>) = Some n"
      using Fun.prems Guard_List by simp
    consider
        (nil) "f = ni" "ts = []" "n = 0"
      | (cons) p q where "f = co" "length ts = 2"
          "csr_guard_rank z su len ni co ta zs Guard_Nat
            (ts ! 0 \<cdot> \<sigma>) = Some p"
          "csr_guard_rank z su len ni co ta zs Guard_List
            (ts ! 1 \<cdot> \<sigma>) = Some q" "n = Suc q"
      | (take) p q where "f = ta" "length ts = 2"
          "csr_guard_rank z su len ni co ta zs Guard_Nat
            (ts ! 0 \<cdot> \<sigma>) = Some p"
          "csr_guard_rank z su len ni co ta zs Guard_IList
            (ts ! 1 \<cdot> \<sigma>) = Some q" "n = p"
      using ground' distinct
      by (auto simp: csr_guard_rank.simps
          split: if_splits option.splits)
    then show ?thesis
    proof cases
      case nil
      then show ?thesis unfolding Guard_List by simp
    next
      case (cons p q)
      have mem0: "ts ! 0 \<in> set ts" and mem1: "ts ! 1 \<in> set ts"
        using cons(2) by auto
      obtain Fn where sn:
          "csr_guard_symbolic_rank z su len ni co ta zs Guard_Nat (ts ! 0) = Some Fn"
        and rn: "csr_guard_requirements_realized z su len ni co ta zs \<sigma>
          (csr_guard_rank_environment z su len ni co ta zs \<sigma>)
          (csr_guard_form_requirements Fn)"
        and vn: "csr_guard_form_value
          (csr_guard_rank_environment z su len ni co ta zs \<sigma>) Fn = p"
        using Fun.IH[OF mem0 cons(3)] by blast
      obtain Fl where sl:
          "csr_guard_symbolic_rank z su len ni co ta zs Guard_List (ts ! 1) = Some Fl"
        and rl: "csr_guard_requirements_realized z su len ni co ta zs \<sigma>
          (csr_guard_rank_environment z su len ni co ta zs \<sigma>)
          (csr_guard_form_requirements Fl)"
        and vl: "csr_guard_form_value
          (csr_guard_rank_environment z su len ni co ta zs \<sigma>) Fl = q"
        using Fun.IH[OF mem1 cons(4)] by blast
      obtain reqn csn cn where Fn: "Fn = Guard_Form reqn csn cn" by (cases Fn)
      obtain reql csl cl where Fl: "Fl = Guard_Form reql csl cl" by (cases Fl)
      have co_ni: "co \<noteq> ni" using distinct by auto
      show ?thesis
        unfolding Guard_List using cons sn rn vn sl rl vl Fn Fl co_ni
        by (intro exI[of _ "Guard_Form (reqn @ reql) csl (Suc cl)"]) simp
    next
      case (take p q)
      have mem0: "ts ! 0 \<in> set ts" and mem1: "ts ! 1 \<in> set ts"
        using take(2) by auto
      obtain Fn where sn:
          "csr_guard_symbolic_rank z su len ni co ta zs Guard_Nat (ts ! 0) = Some Fn"
        and rn: "csr_guard_requirements_realized z su len ni co ta zs \<sigma>
          (csr_guard_rank_environment z su len ni co ta zs \<sigma>)
          (csr_guard_form_requirements Fn)"
        and vn: "csr_guard_form_value
          (csr_guard_rank_environment z su len ni co ta zs \<sigma>) Fn = p"
        using Fun.IH[OF mem0 take(3)] by blast
      obtain Fi where si:
          "csr_guard_symbolic_rank z su len ni co ta zs Guard_IList (ts ! 1) = Some Fi"
        and ri: "csr_guard_requirements_realized z su len ni co ta zs \<sigma>
          (csr_guard_rank_environment z su len ni co ta zs \<sigma>)
          (csr_guard_form_requirements Fi)"
        and vi: "csr_guard_form_value
          (csr_guard_rank_environment z su len ni co ta zs \<sigma>) Fi = q"
        using Fun.IH[OF mem1 take(4)] by blast
      obtain reqn csn cn where Fn: "Fn = Guard_Form reqn csn cn" by (cases Fn)
      obtain reqi csi ci where Fi: "Fi = Guard_Form reqi csi ci" by (cases Fi)
      have ta_ni: "ta \<noteq> ni" and ta_co: "ta \<noteq> co"
        using distinct by auto
      show ?thesis
        unfolding Guard_List using take sn rn vn si ri vi Fn Fi ta_ni ta_co
        by (intro exI[of _ "Guard_Form (reqn @ reqi) csn cn"]) simp
    qed
  next
    case Guard_IList
    have ground': "csr_guard_rank z su len ni co ta zs Guard_IList
        (Fun f ts \<cdot> \<sigma>) = Some n"
      using Fun.prems Guard_IList by simp
    consider
        (zeros) "f = zs" "ts = []" "n = 0"
      | (cons) p q where "f = co" "length ts = 2"
          "csr_guard_rank z su len ni co ta zs Guard_Nat
            (ts ! 0 \<cdot> \<sigma>) = Some p"
          "csr_guard_rank z su len ni co ta zs Guard_IList
            (ts ! 1 \<cdot> \<sigma>) = Some q" "n = 0"
      | (nil) "f = ni" "ts = []" "n = 0"
      | (take) p q where "f = ta" "length ts = 2"
          "csr_guard_rank z su len ni co ta zs Guard_Nat
            (ts ! 0 \<cdot> \<sigma>) = Some p"
          "csr_guard_rank z su len ni co ta zs Guard_IList
            (ts ! 1 \<cdot> \<sigma>) = Some q" "n = 0"
      using ground' distinct
      by (auto simp: csr_guard_rank.simps
          split: if_splits option.splits)
    then show ?thesis
    proof cases
      case zeros
      then show ?thesis unfolding Guard_IList by simp
    next
      case (cons p q)
      have mem0: "ts ! 0 \<in> set ts" and mem1: "ts ! 1 \<in> set ts"
        using cons(2) by auto
      obtain Fn where sn:
          "csr_guard_symbolic_rank z su len ni co ta zs Guard_Nat (ts ! 0) = Some Fn"
        and rn: "csr_guard_requirements_realized z su len ni co ta zs \<sigma>
          (csr_guard_rank_environment z su len ni co ta zs \<sigma>)
          (csr_guard_form_requirements Fn)"
        using Fun.IH[OF mem0 cons(3)] by blast
      obtain Fi where si:
          "csr_guard_symbolic_rank z su len ni co ta zs Guard_IList (ts ! 1) = Some Fi"
        and ri: "csr_guard_requirements_realized z su len ni co ta zs \<sigma>
          (csr_guard_rank_environment z su len ni co ta zs \<sigma>)
          (csr_guard_form_requirements Fi)"
        using Fun.IH[OF mem1 cons(4)] by blast
      obtain reqn csn cn where Fn: "Fn = Guard_Form reqn csn cn" by (cases Fn)
      obtain reqi csi ci where Fi: "Fi = Guard_Form reqi csi ci" by (cases Fi)
      have co_zs: "co \<noteq> zs" using distinct by auto
      show ?thesis
        unfolding Guard_IList using cons sn rn si ri Fn Fi co_zs
        by (intro exI[of _ "Guard_Form (reqn @ reqi) [] 0"]) simp
    next
      case nil
      have ni_zs: "ni \<noteq> zs" and ni_co: "ni \<noteq> co"
        using distinct by auto
      show ?thesis unfolding Guard_IList using nil ni_zs ni_co by simp
    next
      case (take p q)
      have mem0: "ts ! 0 \<in> set ts" and mem1: "ts ! 1 \<in> set ts"
        using take(2) by auto
      obtain Fn where sn:
          "csr_guard_symbolic_rank z su len ni co ta zs Guard_Nat (ts ! 0) = Some Fn"
        and rn: "csr_guard_requirements_realized z su len ni co ta zs \<sigma>
          (csr_guard_rank_environment z su len ni co ta zs \<sigma>)
          (csr_guard_form_requirements Fn)"
        using Fun.IH[OF mem0 take(3)] by blast
      obtain Fi where si:
          "csr_guard_symbolic_rank z su len ni co ta zs Guard_IList (ts ! 1) = Some Fi"
        and ri: "csr_guard_requirements_realized z su len ni co ta zs \<sigma>
          (csr_guard_rank_environment z su len ni co ta zs \<sigma>)
          (csr_guard_form_requirements Fi)"
        using Fun.IH[OF mem1 take(4)] by blast
      obtain reqn csn cn where Fn: "Fn = Guard_Form reqn csn cn" by (cases Fn)
      obtain reqi csi ci where Fi: "Fi = Guard_Form reqi csi ci" by (cases Fi)
      have ta_zs: "ta \<noteq> zs" and ta_co: "ta \<noteq> co" and ta_ni: "ta \<noteq> ni"
        using distinct by auto
      show ?thesis
        unfolding Guard_IList using take sn rn si ri Fn Fi ta_zs ta_co ta_ni
        by (intro exI[of _ "Guard_Form (reqn @ reqi) [] 0"]) simp
    qed
  qed
qed

lemma csr_guard_erased_symbolic_rank_sound:
  assumes distinct: "distinct [z,su,len,ni,co,ta,zs]"
    and symbolic:
      "csr_guard_erased_symbolic_rank u11 u21 u31 z su len ni co ta zs A t =
        Some F"
    and realized: "csr_guard_requirements_realized z su len ni co ta zs
      (\<lambda>x. csr_guard_erase_admin u11 u21 u31 su len ni co ta (\<sigma> x))
      \<rho> (csr_guard_form_requirements F)"
  shows "csr_guard_erased_rank u11 u21 u31 z su len ni co ta zs A (t \<cdot> \<sigma>) =
    Some (csr_guard_form_value \<rho> F)"
proof -
  have symbolic': "csr_guard_symbolic_rank z su len ni co ta zs A
      (csr_guard_erase_admin u11 u21 u31 su len ni co ta t) = Some F"
    using symbolic unfolding csr_guard_erased_symbolic_rank_def .
  have sound: "csr_guard_rank z su len ni co ta zs A
      (csr_guard_erase_admin u11 u21 u31 su len ni co ta t \<cdot>
        (\<lambda>x. csr_guard_erase_admin u11 u21 u31 su len ni co ta (\<sigma> x))) =
      Some (csr_guard_form_value \<rho> F)"
    by (rule csr_guard_symbolic_rank_sound[OF distinct symbolic' realized])
  show ?thesis
    unfolding csr_guard_erased_rank_def csr_guard_erase_admin_subst
    by (rule sound)
qed

lemma csr_guard_normal_symbolic_rank_sound:
  assumes distinct: "distinct [z,su,len,ni,co,ta,zs]"
    and symbolic:
      "csr_guard_normal_symbolic_rank a u11 u21 u31 z su len ni co ta zs A t =
        Some F"
    and realized: "csr_guard_requirements_realized z su len ni co ta zs
      (\<lambda>x. csr_guard_normalize a u11 u21 u31 su len ni co ta (\<sigma> x))
      \<rho> (csr_guard_form_requirements F)"
  shows "csr_guard_normal_rank a u11 u21 u31 z su len ni co ta zs A (t \<cdot> \<sigma>) =
    Some (csr_guard_form_value \<rho> F)"
proof -
  have symbolic': "csr_guard_symbolic_rank z su len ni co ta zs A
      (csr_guard_normalize a u11 u21 u31 su len ni co ta t) = Some F"
    using symbolic unfolding csr_guard_normal_symbolic_rank_def .
  have sound: "csr_guard_rank z su len ni co ta zs A
      (csr_guard_normalize a u11 u21 u31 su len ni co ta t \<cdot>
        (\<lambda>x. csr_guard_normalize a u11 u21 u31 su len ni co ta (\<sigma> x))) =
      Some (csr_guard_form_value \<rho> F)"
    by (rule csr_guard_symbolic_rank_sound[OF distinct symbolic' realized])
  show ?thesis
    unfolding csr_guard_normal_rank_def csr_guard_normalize_subst
    by (rule sound)
qed

definition csr_guard_normal_rank_environment where
  "csr_guard_normal_rank_environment a u11 u21 u31 z su len ni co ta zs \<sigma> =
    csr_guard_rank_environment z su len ni co ta zs
      (\<lambda>x. csr_guard_normalize a u11 u21 u31 su len ni co ta (\<sigma> x))"

lemma csr_guard_normal_symbolic_rank_complete:
  assumes distinct: "distinct [z,su,len,ni,co,ta,zs]"
    and ground:
      "csr_guard_normal_rank a u11 u21 u31 z su len ni co ta zs A
        (t \<cdot> \<sigma>) = Some n"
  shows "\<exists>F.
    csr_guard_normal_symbolic_rank a u11 u21 u31 z su len ni co ta zs A t = Some F \<and>
    csr_guard_requirements_realized z su len ni co ta zs
      (\<lambda>x. csr_guard_normalize a u11 u21 u31 su len ni co ta (\<sigma> x))
      (csr_guard_normal_rank_environment a u11 u21 u31 z su len ni co ta zs \<sigma>)
      (csr_guard_form_requirements F) \<and>
    csr_guard_form_value
      (csr_guard_normal_rank_environment a u11 u21 u31 z su len ni co ta zs \<sigma>) F = n"
proof -
  have ground': "csr_guard_rank z su len ni co ta zs A
      (csr_guard_normalize a u11 u21 u31 su len ni co ta t \<cdot>
        (\<lambda>x. csr_guard_normalize a u11 u21 u31 su len ni co ta (\<sigma> x))) = Some n"
    using ground unfolding csr_guard_normal_rank_def csr_guard_normalize_subst .
  obtain F where symbolic:
      "csr_guard_symbolic_rank z su len ni co ta zs A
        (csr_guard_normalize a u11 u21 u31 su len ni co ta t) = Some F"
    and realized: "csr_guard_requirements_realized z su len ni co ta zs
      (\<lambda>x. csr_guard_normalize a u11 u21 u31 su len ni co ta (\<sigma> x))
      (csr_guard_rank_environment z su len ni co ta zs
        (\<lambda>x. csr_guard_normalize a u11 u21 u31 su len ni co ta (\<sigma> x)))
      (csr_guard_form_requirements F)"
    and valF: "csr_guard_form_value
      (csr_guard_rank_environment z su len ni co ta zs
        (\<lambda>x. csr_guard_normalize a u11 u21 u31 su len ni co ta (\<sigma> x))) F = n"
    using csr_guard_symbolic_rank_complete[OF distinct ground'] by blast
  show ?thesis
    using symbolic realized valF
    unfolding csr_guard_normal_symbolic_rank_def
      csr_guard_normal_rank_environment_def by blast
qed

fun csr_guard_coefficients_le where
  "csr_guard_coefficients_le [] ys = True"
| "csr_guard_coefficients_le (x # xs) ys =
    (x \<in> set ys \<and> csr_guard_coefficients_le xs (remove1 x ys))"

lemma csr_guard_coefficients_le_sum:
  fixes \<rho> :: "'a \<Rightarrow> nat"
  assumes "csr_guard_coefficients_le xs ys"
  shows "sum_list (map \<rho> xs) \<le> sum_list (map \<rho> ys)"
  using assms
proof (induction xs arbitrary: ys)
  case Nil
  then show ?case by simp
next
  case (Cons x xs)
  then have x: "x \<in> set ys"
    and rest: "csr_guard_coefficients_le xs (remove1 x ys)"
    by simp_all
  have ih: "sum_list (map \<rho> xs) \<le>
      sum_list (map \<rho> (remove1 x ys))"
    by (rule Cons.IH[OF rest])
  have decompose: "sum_list (map \<rho> ys) =
      \<rho> x + sum_list (map \<rho> (remove1 x ys))"
    by (rule sum_list_map_remove1[OF x])
  show ?case using ih decompose by simp
qed

fun csr_guard_form_ge where
  "csr_guard_form_ge (Guard_Form req_l cs_l c_l)
      (Guard_Form req_r cs_r c_r) =
    (set req_r \<subseteq> set req_l \<and>
     csr_guard_coefficients_le cs_r cs_l \<and> c_r \<le> c_l)"

fun csr_guard_form_gt where
  "csr_guard_form_gt (Guard_Form req_l cs_l c_l)
      (Guard_Form req_r cs_r c_r) =
    (set req_r \<subseteq> set req_l \<and>
     csr_guard_coefficients_le cs_r cs_l \<and> c_r < c_l)"

fun csr_guard_form_backward_eq where
  "csr_guard_form_backward_eq (Guard_Form req_l cs_l c_l)
      (Guard_Form req_r cs_r c_r) =
    (set req_l \<subseteq> set req_r \<and>
     csr_guard_coefficients_le cs_l cs_r \<and>
     csr_guard_coefficients_le cs_r cs_l \<and> c_l = c_r)"

lemma csr_guard_requirements_realized_mono:
  assumes realized: "csr_guard_requirements_realized
      z su len ni co ta zs \<sigma> \<rho> req_l"
    and subset: "set req_r \<subseteq> set req_l"
  shows "csr_guard_requirements_realized
      z su len ni co ta zs \<sigma> \<rho> req_r"
  using realized subset unfolding csr_guard_requirements_realized_def by auto

lemma csr_guard_form_ge_value:
  assumes "csr_guard_form_ge F G"
  shows "csr_guard_form_value \<rho> F \<ge> csr_guard_form_value \<rho> G"
proof (cases F; cases G)
  fix req_l cs_l c_l req_r cs_r c_r
  assume F: "F = Guard_Form req_l cs_l c_l"
    and G: "G = Guard_Form req_r cs_r c_r"
  have constants: "c_r \<le> c_l" and coefficients:
      "csr_guard_coefficients_le cs_r cs_l"
    using assms unfolding F G by simp_all
  have sums: "sum_list (map \<rho> cs_r) \<le> sum_list (map \<rho> cs_l)"
    by (rule csr_guard_coefficients_le_sum[OF coefficients])
  show ?thesis unfolding F G using add_le_mono[OF constants sums] by simp
qed

lemma csr_guard_form_gt_value:
  assumes "csr_guard_form_gt F G"
  shows "csr_guard_form_value \<rho> F > csr_guard_form_value \<rho> G"
proof (cases F; cases G)
  fix req_l cs_l c_l req_r cs_r c_r
  assume F: "F = Guard_Form req_l cs_l c_l"
    and G: "G = Guard_Form req_r cs_r c_r"
  have constants: "c_r < c_l" and coefficients:
      "csr_guard_coefficients_le cs_r cs_l"
    using assms unfolding F G by simp_all
  have sums: "sum_list (map \<rho> cs_r) \<le> sum_list (map \<rho> cs_l)"
    by (rule csr_guard_coefficients_le_sum[OF coefficients])
  show ?thesis unfolding F G using add_less_le_mono[OF constants sums] by simp
qed

lemma csr_guard_form_backward_eq_value:
  assumes "csr_guard_form_backward_eq F G"
  shows "csr_guard_form_value \<rho> F = csr_guard_form_value \<rho> G"
proof (cases F; cases G)
  fix req_l cs_l c_l req_r cs_r c_r
  assume F: "F = Guard_Form req_l cs_l c_l"
    and G: "G = Guard_Form req_r cs_r c_r"
  have constants: "c_l = c_r"
    and lr: "csr_guard_coefficients_le cs_l cs_r"
    and rl: "csr_guard_coefficients_le cs_r cs_l"
    using assms unfolding F G by simp_all
  have sums: "sum_list (map \<rho> cs_l) = sum_list (map \<rho> cs_r)"
    using csr_guard_coefficients_le_sum[OF lr]
      csr_guard_coefficients_le_sum[OF rl] by (rule antisym)
  show ?thesis unfolding F G using constants sums by simp
qed

definition csr_guard_normal_rule_backward_eq where
  "csr_guard_normal_rule_backward_eq a u11 u21 u31 z su len ni co ta zs A l r \<longleftrightarrow>
    (case csr_guard_normal_symbolic_rank
              a u11 u21 u31 z su len ni co ta zs A r of
       None \<Rightarrow> True
     | Some G \<Rightarrow>
         (case csr_guard_normal_symbolic_rank
                a u11 u21 u31 z su len ni co ta zs A l of
            None \<Rightarrow> False
          | Some F \<Rightarrow> csr_guard_form_backward_eq F G))"

lemma csr_guard_normal_rule_backward_eq_sound:
  assumes distinct: "distinct [z,su,len,ni,co,ta,zs]"
    and checked: "csr_guard_normal_rule_backward_eq
      a u11 u21 u31 z su len ni co ta zs A l r"
    and target: "csr_guard_normal_rank
      a u11 u21 u31 z su len ni co ta zs A (r \<cdot> \<sigma>) = Some n"
  shows "csr_guard_normal_rank
      a u11 u21 u31 z su len ni co ta zs A (l \<cdot> \<sigma>) = Some n"
proof -
  obtain F G where lhs:
      "csr_guard_normal_symbolic_rank
        a u11 u21 u31 z su len ni co ta zs A l = Some F"
    and rhs: "csr_guard_normal_symbolic_rank
        a u11 u21 u31 z su len ni co ta zs A r = Some G"
    and eq: "csr_guard_form_backward_eq F G"
    using checked unfolding csr_guard_normal_rule_backward_eq_def
    using csr_guard_normal_symbolic_rank_complete[OF distinct target]
    by (auto split: option.splits)
  obtain H where rhs_again:
      "csr_guard_normal_symbolic_rank
        a u11 u21 u31 z su len ni co ta zs A r = Some H"
    and realized_H: "csr_guard_requirements_realized z su len ni co ta zs
      (\<lambda>x. csr_guard_normalize a u11 u21 u31 su len ni co ta (\<sigma> x))
      (csr_guard_normal_rank_environment a u11 u21 u31 z su len ni co ta zs \<sigma>)
      (csr_guard_form_requirements H)"
    and value_H: "csr_guard_form_value
      (csr_guard_normal_rank_environment a u11 u21 u31 z su len ni co ta zs \<sigma>) H = n"
    using csr_guard_normal_symbolic_rank_complete[OF distinct target] by blast
  have HG: "H = G" using rhs rhs_again by simp
  have req_subset: "set (csr_guard_form_requirements F) \<subseteq>
      set (csr_guard_form_requirements G)"
    using eq by (cases F; cases G) simp
  have realized_F: "csr_guard_requirements_realized z su len ni co ta zs
      (\<lambda>x. csr_guard_normalize a u11 u21 u31 su len ni co ta (\<sigma> x))
      (csr_guard_normal_rank_environment a u11 u21 u31 z su len ni co ta zs \<sigma>)
      (csr_guard_form_requirements F)"
    by (rule csr_guard_requirements_realized_mono[OF realized_H[unfolded HG] req_subset])
  have source: "csr_guard_normal_rank
      a u11 u21 u31 z su len ni co ta zs A (l \<cdot> \<sigma>) =
      Some (csr_guard_form_value
        (csr_guard_normal_rank_environment a u11 u21 u31 z su len ni co ta zs \<sigma>) F)"
    by (rule csr_guard_normal_symbolic_rank_sound[OF distinct lhs realized_F])
  have vals: "csr_guard_form_value
      (csr_guard_normal_rank_environment a u11 u21 u31 z su len ni co ta zs \<sigma>) F =
      csr_guard_form_value
      (csr_guard_normal_rank_environment a u11 u21 u31 z su len ni co ta zs \<sigma>) G"
    by (rule csr_guard_form_backward_eq_value[OF eq])
  show ?thesis using source value_H vals HG by simp
qed

lemma csr_guard_rank_Fun_backward:
  assumes distinct: "distinct [z,su,guard_len_sym,ni,co,ta,zs]"
    and len: "length xs = length ys"
    and args: "\<And>i A n. i < length ys \<Longrightarrow>
      csr_guard_rank z su guard_len_sym ni co ta zs A (ys ! i) = Some n \<Longrightarrow>
      csr_guard_rank z su guard_len_sym ni co ta zs A (xs ! i) = Some n"
    and target: "csr_guard_rank z su guard_len_sym ni co ta zs A (Fun f ys) = Some n"
  shows "csr_guard_rank z su guard_len_sym ni co ta zs A (Fun f xs) = Some n"
proof (cases A)
  case Guard_Nat
  consider
      (zero) "f = z" "ys = []" "n = 0"
    | (succ) m where "f = su" "length ys = 1"
        "csr_guard_rank z su guard_len_sym ni co ta zs Guard_Nat (ys ! 0) = Some m"
        "n = Suc m"
    | (length) m where "f = guard_len_sym" "length ys = 1"
        "csr_guard_rank z su guard_len_sym ni co ta zs Guard_List (ys ! 0) = Some m"
        "n = m"
    using target unfolding Guard_Nat
    by (auto simp: csr_guard_rank.simps split: if_splits option.splits)
  then show ?thesis
  proof cases
    case zero
    with len have "xs = []" by simp
    with zero show ?thesis unfolding Guard_Nat by simp
  next
    case (succ m)
    have child: "csr_guard_rank z su guard_len_sym ni co ta zs Guard_Nat (xs ! 0) = Some m"
      by (rule args[OF _ succ(3)], use succ(2) in simp)
    show ?thesis unfolding Guard_Nat using len succ child distinct by simp
  next
    case (length m)
    have child: "csr_guard_rank z su guard_len_sym ni co ta zs Guard_List (xs ! 0) = Some m"
      by (rule args[OF _ length(3)], use length(2) in simp)
    show ?thesis unfolding Guard_Nat using len length child distinct by fastforce
  qed
next
  case Guard_List
  consider
      (nil) "f = ni" "ys = []" "n = 0"
    | (cons) p q where "f = co" "length ys = 2"
        "csr_guard_rank z su guard_len_sym ni co ta zs Guard_Nat (ys ! 0) = Some p"
        "csr_guard_rank z su guard_len_sym ni co ta zs Guard_List (ys ! 1) = Some q"
        "n = Suc q"
    | (take) p q where "f = ta" "length ys = 2"
        "csr_guard_rank z su guard_len_sym ni co ta zs Guard_Nat (ys ! 0) = Some p"
        "csr_guard_rank z su guard_len_sym ni co ta zs Guard_IList (ys ! 1) = Some q"
        "n = p"
    using target unfolding Guard_List
    by (auto simp: csr_guard_rank.simps split: if_splits option.splits)
  then show ?thesis
  proof cases
    case nil
    with len have "xs = []" by simp
    with nil show ?thesis unfolding Guard_List by simp
  next
    case (cons p q)
    have child0: "csr_guard_rank z su guard_len_sym ni co ta zs Guard_Nat (xs ! 0) = Some p"
      by (rule args[OF _ cons(3)], use cons(2) in simp)
    have child1: "csr_guard_rank z su guard_len_sym ni co ta zs Guard_List (xs ! 1) = Some q"
      by (rule args[OF _ cons(4)], use cons(2) in simp)
    have co_ni: "co \<noteq> ni" using distinct by auto
    show ?thesis unfolding Guard_List using len cons child0 child1 co_ni by simp
  next
    case (take p q)
    have child0: "csr_guard_rank z su guard_len_sym ni co ta zs Guard_Nat (xs ! 0) = Some p"
      by (rule args[OF _ take(3)], use take(2) in simp)
    have child1: "csr_guard_rank z su guard_len_sym ni co ta zs Guard_IList (xs ! 1) = Some q"
      by (rule args[OF _ take(4)], use take(2) in simp)
    have ta_ni: "ta \<noteq> ni" and ta_co: "ta \<noteq> co" using distinct by auto
    show ?thesis unfolding Guard_List using len take child0 child1 ta_ni ta_co by simp
  qed
next
  case Guard_IList
  consider
      (zeros) "f = zs" "ys = []" "n = 0"
    | (cons) p q where "f = co" "length ys = 2"
        "csr_guard_rank z su guard_len_sym ni co ta zs Guard_Nat (ys ! 0) = Some p"
        "csr_guard_rank z su guard_len_sym ni co ta zs Guard_IList (ys ! 1) = Some q"
        "n = 0"
    | (nil) "f = ni" "ys = []" "n = 0"
    | (take) p q where "f = ta" "length ys = 2"
        "csr_guard_rank z su guard_len_sym ni co ta zs Guard_Nat (ys ! 0) = Some p"
        "csr_guard_rank z su guard_len_sym ni co ta zs Guard_IList (ys ! 1) = Some q"
        "n = 0"
    using target unfolding Guard_IList
    by (auto simp: csr_guard_rank.simps split: if_splits option.splits)
  then show ?thesis
  proof cases
    case zeros
    with len have "xs = []" by simp
    with zeros show ?thesis unfolding Guard_IList by simp
  next
    case (cons p q)
    have child0: "csr_guard_rank z su guard_len_sym ni co ta zs Guard_Nat (xs ! 0) = Some p"
      by (rule args[OF _ cons(3)], use cons(2) in simp)
    have child1: "csr_guard_rank z su guard_len_sym ni co ta zs Guard_IList (xs ! 1) = Some q"
      by (rule args[OF _ cons(4)], use cons(2) in simp)
    have co_zs: "co \<noteq> zs" using distinct by auto
    show ?thesis unfolding Guard_IList using len cons child0 child1 co_zs by simp
  next
    case nil
    with len have "xs = []" by simp
    moreover have ni_zs: "ni \<noteq> zs" and ni_co: "ni \<noteq> co"
      using distinct by auto
    ultimately show ?thesis unfolding Guard_IList using nil by simp
  next
    case (take p q)
    have child0: "csr_guard_rank z su guard_len_sym ni co ta zs Guard_Nat (xs ! 0) = Some p"
      by (rule args[OF _ take(3)], use take(2) in simp)
    have child1: "csr_guard_rank z su guard_len_sym ni co ta zs Guard_IList (xs ! 1) = Some q"
      by (rule args[OF _ take(4)], use take(2) in simp)
    have ta_zs: "ta \<noteq> zs" and ta_co: "ta \<noteq> co" and ta_ni: "ta \<noteq> ni"
      using distinct by auto
    show ?thesis unfolding Guard_IList using len take child0 child1 ta_zs ta_co ta_ni by simp
  qed
qed

lemma csr_guard_rank_ctxt_backward:
  assumes distinct: "distinct [z,su,len,ni,co,ta,zs]"
    and local: "\<And>A n.
      csr_guard_rank z su len ni co ta zs A y = Some n \<Longrightarrow>
      csr_guard_rank z su len ni co ta zs A x = Some n"
    and target: "csr_guard_rank z su len ni co ta zs A C\<langle>y\<rangle> = Some n"
  shows "csr_guard_rank z su len ni co ta zs A C\<langle>x\<rangle> = Some n"
  using target
proof (induction C arbitrary: A n)
  case Hole
  then show ?case using local by simp
next
  case (More f bef C aft)
  have nth_backward: "\<And>i A n.
      i < length (bef @ C\<langle>y\<rangle> # aft) \<Longrightarrow>
      csr_guard_rank z su len ni co ta zs A
        ((bef @ C\<langle>y\<rangle> # aft) ! i) = Some n \<Longrightarrow>
      csr_guard_rank z su len ni co ta zs A
        ((bef @ C\<langle>x\<rangle> # aft) ! i) = Some n"
  proof -
    fix i A n
    assume bound: "i < length (bef @ C\<langle>y\<rangle> # aft)"
      and target: "csr_guard_rank z su len ni co ta zs A
        ((bef @ C\<langle>y\<rangle> # aft) ! i) = Some n"
    show "csr_guard_rank z su len ni co ta zs A
        ((bef @ C\<langle>x\<rangle> # aft) ! i) = Some n"
    proof (cases "i < length bef")
      case True
      then show ?thesis using target by (simp add: nth_append)
    next
      case False
      note not_less = False
      show ?thesis
      proof (cases "i = length bef")
        case True
        then show ?thesis using More.IH target by (simp add: nth_append)
      next
        case False
        with not_less have "length bef < i" by simp
        then show ?thesis using target bound by (simp add: nth_append)
      qed
    qed
  qed
  have target': "csr_guard_rank z su len ni co ta zs A
      (Fun f (bef @ C\<langle>y\<rangle> # aft)) = Some n"
    using More.prems by simp
  have result: "csr_guard_rank z su len ni co ta zs A
      (Fun f (bef @ C\<langle>x\<rangle> # aft)) = Some n"
    by (rule csr_guard_rank_Fun_backward[OF distinct _ nth_backward target'], simp)
  show ?case using result by simp
qed

definition csr_guard_context_normalizes where
  "csr_guard_context_normalizes a u11 u21 u31 su len ni co ta C \<longleftrightarrow>
    ((\<exists>D. \<forall>t. csr_guard_normalize a u11 u21 u31 su len ni co ta C\<langle>t\<rangle> =
        D\<langle>csr_guard_normalize a u11 u21 u31 su len ni co ta t\<rangle>) \<or>
     (\<exists>u. \<forall>t. csr_guard_normalize a u11 u21 u31 su len ni co ta C\<langle>t\<rangle> = u))"

lemma csr_guard_normal_rank_ctxt_backward_if:
  assumes distinct: "distinct [z,su,len,ni,co,ta,zs]"
    and normalized: "csr_guard_context_normalizes
      a u11 u21 u31 su len ni co ta C"
    and local: "\<And>A n.
      csr_guard_normal_rank a u11 u21 u31 z su len ni co ta zs A y = Some n \<Longrightarrow>
      csr_guard_normal_rank a u11 u21 u31 z su len ni co ta zs A x = Some n"
    and target: "csr_guard_normal_rank
      a u11 u21 u31 z su len ni co ta zs A C\<langle>y\<rangle> = Some n"
  shows "csr_guard_normal_rank
      a u11 u21 u31 z su len ni co ta zs A C\<langle>x\<rangle> = Some n"
proof -
  from normalized consider
      (dependent) D where "\<And>t. csr_guard_normalize a u11 u21 u31 su len ni co ta C\<langle>t\<rangle> =
        D\<langle>csr_guard_normalize a u11 u21 u31 su len ni co ta t\<rangle>"
    | (independent) u where "\<And>t.
        csr_guard_normalize a u11 u21 u31 su len ni co ta C\<langle>t\<rangle> = u"
    unfolding csr_guard_context_normalizes_def by blast
  then show ?thesis
  proof cases
    case (dependent D)
    have local': "\<And>A n.
        csr_guard_rank z su len ni co ta zs A
          (csr_guard_normalize a u11 u21 u31 su len ni co ta y) = Some n \<Longrightarrow>
        csr_guard_rank z su len ni co ta zs A
          (csr_guard_normalize a u11 u21 u31 su len ni co ta x) = Some n"
      using local unfolding csr_guard_normal_rank_def by blast
    have target': "csr_guard_rank z su len ni co ta zs A
        D\<langle>csr_guard_normalize a u11 u21 u31 su len ni co ta y\<rangle> = Some n"
      using target dependent unfolding csr_guard_normal_rank_def by simp
    have "csr_guard_rank z su len ni co ta zs A
        D\<langle>csr_guard_normalize a u11 u21 u31 su len ni co ta x\<rangle> = Some n"
      by (rule csr_guard_rank_ctxt_backward[OF distinct local' target'])
    then show ?thesis using dependent unfolding csr_guard_normal_rank_def by simp
  next
    case (independent u)
    then show ?thesis using target unfolding csr_guard_normal_rank_def by simp
  qed
qed

lemma csr_guard_symbolic_rank_ge_sound:
  assumes distinct: "distinct [z,su,len,ni,co,ta,zs]"
    and lhs: "csr_guard_symbolic_rank z su len ni co ta zs A l = Some F"
    and rhs: "csr_guard_symbolic_rank z su len ni co ta zs A r = Some G"
    and orient: "csr_guard_form_ge F G"
    and realized: "csr_guard_requirements_realized
      z su len ni co ta zs \<sigma> \<rho> (csr_guard_form_requirements F)"
  obtains m n where
    "csr_guard_rank z su len ni co ta zs A (l \<cdot> \<sigma>) = Some m"
    "csr_guard_rank z su len ni co ta zs A (r \<cdot> \<sigma>) = Some n"
    "m \<ge> n"
proof
  have req_subset: "set (csr_guard_form_requirements G) \<subseteq>
      set (csr_guard_form_requirements F)"
    using orient by (cases F; cases G) simp
  have realized_r: "csr_guard_requirements_realized
      z su len ni co ta zs \<sigma> \<rho> (csr_guard_form_requirements G)"
    by (rule csr_guard_requirements_realized_mono[OF realized req_subset])
  show "csr_guard_rank z su len ni co ta zs A (l \<cdot> \<sigma>) =
      Some (csr_guard_form_value \<rho> F)"
    by (rule csr_guard_symbolic_rank_sound[OF distinct lhs realized])
  show "csr_guard_rank z su len ni co ta zs A (r \<cdot> \<sigma>) =
      Some (csr_guard_form_value \<rho> G)"
    by (rule csr_guard_symbolic_rank_sound[OF distinct rhs realized_r])
  show "csr_guard_form_value \<rho> F \<ge> csr_guard_form_value \<rho> G"
    by (rule csr_guard_form_ge_value[OF orient])
qed

lemma csr_guard_symbolic_rank_gt_sound:
  assumes distinct: "distinct [z,su,len,ni,co,ta,zs]"
    and lhs: "csr_guard_symbolic_rank z su len ni co ta zs A l = Some F"
    and rhs: "csr_guard_symbolic_rank z su len ni co ta zs A r = Some G"
    and orient: "csr_guard_form_gt F G"
    and realized: "csr_guard_requirements_realized
      z su len ni co ta zs \<sigma> \<rho> (csr_guard_form_requirements F)"
  obtains m n where
    "csr_guard_rank z su len ni co ta zs A (l \<cdot> \<sigma>) = Some m"
    "csr_guard_rank z su len ni co ta zs A (r \<cdot> \<sigma>) = Some n"
    "m > n"
proof
  have req_subset: "set (csr_guard_form_requirements G) \<subseteq>
      set (csr_guard_form_requirements F)"
    using orient by (cases F; cases G) simp
  have realized_r: "csr_guard_requirements_realized
      z su len ni co ta zs \<sigma> \<rho> (csr_guard_form_requirements G)"
    by (rule csr_guard_requirements_realized_mono[OF realized req_subset])
  show "csr_guard_rank z su len ni co ta zs A (l \<cdot> \<sigma>) =
      Some (csr_guard_form_value \<rho> F)"
    by (rule csr_guard_symbolic_rank_sound[OF distinct lhs realized])
  show "csr_guard_rank z su len ni co ta zs A (r \<cdot> \<sigma>) =
      Some (csr_guard_form_value \<rho> G)"
    by (rule csr_guard_symbolic_rank_sound[OF distinct rhs realized_r])
  show "csr_guard_form_value \<rho> F > csr_guard_form_value \<rho> G"
    by (rule csr_guard_form_gt_value[OF orient])
qed

text \<open>
  The guarded list measure is observed at the two marked roots of the hard
  component.  Both marked calls denote the length of their list argument;
  the surrounding guard argument of the marked U-call is deliberately
  ignored by the numerical measure but remains available to the later
  recognizer check.
\<close>

fun csr_guard_pair_symbolic_rank where
  "csr_guard_pair_symbolic_rank u11s lens z su len ni co ta zs (Var x) = None"
| "csr_guard_pair_symbolic_rank u11s lens z su len ni co ta zs (Fun f ts) =
    (if f = u11s \<and> length ts = 2 then
       csr_guard_symbolic_rank z su len ni co ta zs Guard_List (ts ! 1)
     else if f = lens \<and> length ts = 1 then
       csr_guard_symbolic_rank z su len ni co ta zs Guard_List (ts ! 0)
     else None)"

fun csr_guard_pair_rank where
  "csr_guard_pair_rank u11s lens z su len ni co ta zs (Var x) = None"
| "csr_guard_pair_rank u11s lens z su len ni co ta zs (Fun f ts) =
    (if f = u11s \<and> length ts = 2 then
       csr_guard_rank z su len ni co ta zs Guard_List (ts ! 1)
     else if f = lens \<and> length ts = 1 then
       csr_guard_rank z su len ni co ta zs Guard_List (ts ! 0)
     else None)"

definition csr_guard_normal_pair_symbolic_rank where
  "csr_guard_normal_pair_symbolic_rank a u11 u21 u31 u11s lens
      z su len ni co ta zs t =
    csr_guard_pair_symbolic_rank u11s lens z su len ni co ta zs
      (csr_guard_normalize a u11 u21 u31 su len ni co ta t)"

definition csr_guard_normal_pair_rank where
  "csr_guard_normal_pair_rank a u11 u21 u31 u11s lens
      z su len ni co ta zs t =
    csr_guard_pair_rank u11s lens z su len ni co ta zs
      (csr_guard_normalize a u11 u21 u31 su len ni co ta t)"

lemma csr_guard_pair_symbolic_rank_sound:
  assumes distinct: "distinct [z,su,len,ni,co,ta,zs]"
    and symbolic:
      "csr_guard_pair_symbolic_rank u11s lens z su len ni co ta zs t = Some F"
    and realized: "csr_guard_requirements_realized
      z su len ni co ta zs \<sigma> \<rho> (csr_guard_form_requirements F)"
  shows "csr_guard_pair_rank u11s lens z su len ni co ta zs (t \<cdot> \<sigma>) =
    Some (csr_guard_form_value \<rho> F)"
proof (cases t)
  case (Var x)
  then show ?thesis using symbolic by simp
next
  case (Fun f ts)
  consider
      (u11) "f = u11s" "length ts = 2"
        "csr_guard_symbolic_rank z su len ni co ta zs Guard_List (ts ! 1) = Some F"
    | (length) "\<not> (f = u11s \<and> length ts = 2)"
        "f = lens" "length ts = 1"
        "csr_guard_symbolic_rank z su len ni co ta zs Guard_List (ts ! 0) = Some F"
    using symbolic unfolding Fun
    by (auto split: if_splits)
  then show ?thesis
  proof cases
    case u11
    have child: "csr_guard_rank z su len ni co ta zs Guard_List
        (ts ! 1 \<cdot> \<sigma>) = Some (csr_guard_form_value \<rho> F)"
      by (rule csr_guard_symbolic_rank_sound[OF distinct u11(3) realized])
    show ?thesis unfolding Fun using u11 child by simp
  next
    case length
    have child: "csr_guard_rank z su len ni co ta zs Guard_List
        (ts ! 0 \<cdot> \<sigma>) = Some (csr_guard_form_value \<rho> F)"
      by (rule csr_guard_symbolic_rank_sound[OF distinct length(4) realized])
    show ?thesis unfolding Fun using length child by simp
  qed
qed

lemma csr_guard_normal_pair_symbolic_rank_sound:
  assumes distinct: "distinct [z,su,len,ni,co,ta,zs]"
    and symbolic:
      "csr_guard_normal_pair_symbolic_rank a u11 u21 u31 u11s lens
        z su len ni co ta zs t = Some F"
    and realized: "csr_guard_requirements_realized z su len ni co ta zs
      (\<lambda>x. csr_guard_normalize a u11 u21 u31 su len ni co ta (\<sigma> x))
      \<rho> (csr_guard_form_requirements F)"
  shows "csr_guard_normal_pair_rank a u11 u21 u31 u11s lens
      z su len ni co ta zs (t \<cdot> \<sigma>) = Some (csr_guard_form_value \<rho> F)"
proof -
  have symbolic': "csr_guard_pair_symbolic_rank u11s lens z su len ni co ta zs
      (csr_guard_normalize a u11 u21 u31 su len ni co ta t) = Some F"
    using symbolic unfolding csr_guard_normal_pair_symbolic_rank_def .
  have sound: "csr_guard_pair_rank u11s lens z su len ni co ta zs
      (csr_guard_normalize a u11 u21 u31 su len ni co ta t \<cdot>
        (\<lambda>x. csr_guard_normalize a u11 u21 u31 su len ni co ta (\<sigma> x))) =
      Some (csr_guard_form_value \<rho> F)"
    by (rule csr_guard_pair_symbolic_rank_sound[OF distinct symbolic' realized])
  show ?thesis
    unfolding csr_guard_normal_pair_rank_def csr_guard_normalize_subst
    by (rule sound)
qed

lemma csr_guard_pair_symbolic_rank_ge_sound:
  assumes distinct: "distinct [z,su,len,ni,co,ta,zs]"
    and lhs: "csr_guard_pair_symbolic_rank u11s lens z su len ni co ta zs l = Some F"
    and rhs: "csr_guard_pair_symbolic_rank u11s lens z su len ni co ta zs r = Some G"
    and orient: "csr_guard_form_ge F G"
    and realized: "csr_guard_requirements_realized
      z su len ni co ta zs \<sigma> \<rho> (csr_guard_form_requirements F)"
  obtains m n where
    "csr_guard_pair_rank u11s lens z su len ni co ta zs (l \<cdot> \<sigma>) = Some m"
    "csr_guard_pair_rank u11s lens z su len ni co ta zs (r \<cdot> \<sigma>) = Some n"
    "m \<ge> n"
proof
  have req_subset: "set (csr_guard_form_requirements G) \<subseteq>
      set (csr_guard_form_requirements F)"
    using orient by (cases F; cases G) simp
  have realized_r: "csr_guard_requirements_realized
      z su len ni co ta zs \<sigma> \<rho> (csr_guard_form_requirements G)"
    by (rule csr_guard_requirements_realized_mono[OF realized req_subset])
  show "csr_guard_pair_rank u11s lens z su len ni co ta zs (l \<cdot> \<sigma>) =
      Some (csr_guard_form_value \<rho> F)"
    by (rule csr_guard_pair_symbolic_rank_sound[OF distinct lhs realized])
  show "csr_guard_pair_rank u11s lens z su len ni co ta zs (r \<cdot> \<sigma>) =
      Some (csr_guard_form_value \<rho> G)"
    by (rule csr_guard_pair_symbolic_rank_sound[OF distinct rhs realized_r])
  show "csr_guard_form_value \<rho> F \<ge> csr_guard_form_value \<rho> G"
    by (rule csr_guard_form_ge_value[OF orient])
qed

lemma csr_guard_pair_symbolic_rank_gt_sound:
  assumes distinct: "distinct [z,su,len,ni,co,ta,zs]"
    and lhs: "csr_guard_pair_symbolic_rank u11s lens z su len ni co ta zs l = Some F"
    and rhs: "csr_guard_pair_symbolic_rank u11s lens z su len ni co ta zs r = Some G"
    and orient: "csr_guard_form_gt F G"
    and realized: "csr_guard_requirements_realized
      z su len ni co ta zs \<sigma> \<rho> (csr_guard_form_requirements F)"
  obtains m n where
    "csr_guard_pair_rank u11s lens z su len ni co ta zs (l \<cdot> \<sigma>) = Some m"
    "csr_guard_pair_rank u11s lens z su len ni co ta zs (r \<cdot> \<sigma>) = Some n"
    "m > n"
proof
  have req_subset: "set (csr_guard_form_requirements G) \<subseteq>
      set (csr_guard_form_requirements F)"
    using orient by (cases F; cases G) simp
  have realized_r: "csr_guard_requirements_realized
      z su len ni co ta zs \<sigma> \<rho> (csr_guard_form_requirements G)"
    by (rule csr_guard_requirements_realized_mono[OF realized req_subset])
  show "csr_guard_pair_rank u11s lens z su len ni co ta zs (l \<cdot> \<sigma>) =
      Some (csr_guard_form_value \<rho> F)"
    by (rule csr_guard_pair_symbolic_rank_sound[OF distinct lhs realized])
  show "csr_guard_pair_rank u11s lens z su len ni co ta zs (r \<cdot> \<sigma>) =
      Some (csr_guard_form_value \<rho> G)"
    by (rule csr_guard_pair_symbolic_rank_sound[OF distinct rhs realized_r])
  show "csr_guard_form_value \<rho> F > csr_guard_form_value \<rho> G"
    by (rule csr_guard_form_gt_value[OF orient])
qed

lemma csr_guard_pair_u11_length_weak:
  fixes q :: "('f,'v) term" and L :: 'v
  assumes wrappers: "u11s \<noteq> lens"
  defines "l \<equiv> Fun u11s [q, Var L]"
    and "r \<equiv> Fun lens [Var L]"
  obtains F G where
    "csr_guard_pair_symbolic_rank u11s lens z su len ni co ta zs l = Some F"
    "csr_guard_pair_symbolic_rank u11s lens z su len ni co ta zs r = Some G"
    "csr_guard_form_ge F G"
proof
  show "csr_guard_pair_symbolic_rank u11s lens z su len ni co ta zs l =
      Some (Guard_Form [(L,Guard_List)] [(L,Guard_List)] 0)"
    unfolding l_def by simp
  show "csr_guard_pair_symbolic_rank u11s lens z su len ni co ta zs r =
      Some (Guard_Form [(L,Guard_List)] [(L,Guard_List)] 0)"
    unfolding r_def using wrappers by simp
  show "csr_guard_form_ge
      (Guard_Form [(L,Guard_List)] [(L,Guard_List)] 0)
      (Guard_Form [(L,Guard_List)] [(L,Guard_List)] 0)"
    by simp
qed

lemma csr_guard_pair_length_cons_u11_strict:
  fixes q :: "('f,'v) term" and N L :: 'v
  assumes wrappers: "lens \<noteq> u11s"
    and constructors: "co \<noteq> ni" "co \<noteq> ta"
  defines "l \<equiv> Fun lens [Fun co [Var N, Var L]]"
    and "r \<equiv> Fun u11s [q, Var L]"
  obtains F G where
    "csr_guard_pair_symbolic_rank u11s lens z su len ni co ta zs l = Some F"
    "csr_guard_pair_symbolic_rank u11s lens z su len ni co ta zs r = Some G"
    "csr_guard_form_gt F G"
proof
  show "csr_guard_pair_symbolic_rank u11s lens z su len ni co ta zs l =
      Some (Guard_Form
        [(N,Guard_Nat),(L,Guard_List)] [(L,Guard_List)] 1)"
    unfolding l_def using wrappers constructors by simp
  show "csr_guard_pair_symbolic_rank u11s lens z su len ni co ta zs r =
      Some (Guard_Form [(L,Guard_List)] [(L,Guard_List)] 0)"
    unfolding r_def by simp
  show "csr_guard_form_gt
      (Guard_Form [(N,Guard_Nat),(L,Guard_List)] [(L,Guard_List)] 1)
      (Guard_Form [(L,Guard_List)] [(L,Guard_List)] 0)"
    by simp
qed

definition csr_guard_pair_rank_gt where
  "csr_guard_pair_rank_gt u11s lens z su len ni co ta zs =
    {(s,t). \<exists>m n.
      csr_guard_pair_rank u11s lens z su len ni co ta zs s = Some m \<and>
      csr_guard_pair_rank u11s lens z su len ni co ta zs t = Some n \<and> m > n}"

definition csr_guard_pair_rank_ge where
  "csr_guard_pair_rank_ge u11s lens z su len ni co ta zs =
    {(s,t). \<exists>m n.
      csr_guard_pair_rank u11s lens z su len ni co ta zs s = Some m \<and>
      csr_guard_pair_rank u11s lens z su len ni co ta zs t = Some n \<and> m \<ge> n}"

lemma csr_guard_pair_rank_gt_ge_comp:
  "csr_guard_pair_rank_gt u11s lens z su len ni co ta zs O
      csr_guard_pair_rank_ge u11s lens z su len ni co ta zs
    \<subseteq> csr_guard_pair_rank_gt u11s lens z su len ni co ta zs"
  unfolding csr_guard_pair_rank_gt_def csr_guard_pair_rank_ge_def by auto

lemma csr_guard_pair_rank_ge_gt_comp:
  "csr_guard_pair_rank_ge u11s lens z su len ni co ta zs O
      csr_guard_pair_rank_gt u11s lens z su len ni co ta zs
    \<subseteq> csr_guard_pair_rank_gt u11s lens z su len ni co ta zs"
  unfolding csr_guard_pair_rank_gt_def csr_guard_pair_rank_ge_def by auto

lemma csr_guard_pair_rank_ge_trans:
  "trans (csr_guard_pair_rank_ge u11s lens z su len ni co ta zs)"
  unfolding trans_def csr_guard_pair_rank_ge_def by auto

lemma SN_csr_guard_pair_rank_gt:
  "SN (csr_guard_pair_rank_gt u11s lens z su len ni co ta zs)"
proof -
  have sub: "csr_guard_pair_rank_gt u11s lens z su len ni co ta zs
      \<subseteq> inv_image {(m,n). m > n}
        (the \<circ> csr_guard_pair_rank u11s lens z su len ni co ta zs)"
    unfolding csr_guard_pair_rank_gt_def inv_image_def by auto
  have "SN (inv_image {(m,n). m > n}
      (the \<circ> csr_guard_pair_rank u11s lens z su len ni co ta zs))"
    by (rule SN_inv_image[OF SN_nat_gt])
  then show ?thesis by (rule SN_subset[OF _ sub])
qed

lemma SN_rel_csr_guard_pair_rank:
  "SN_rel (csr_guard_pair_rank_gt u11s lens z su len ni co ta zs)
    (csr_guard_pair_rank_ge u11s lens z su len ni co ta zs)"
proof -
  let ?S = "csr_guard_pair_rank_gt u11s lens z su len ni co ta zs"
  let ?NS = "csr_guard_pair_rank_ge u11s lens z su len ni co ta zs"
  have compat: "?NS O ?S \<subseteq> ?S"
    by (rule csr_guard_pair_rank_ge_gt_comp)
  have sn: "SN ((?NS \<union> ?S)\<^sup>* O ?S O (?NS \<union> ?S)\<^sup>*)"
    by (rule compatible_SN'[OF compat SN_csr_guard_pair_rank_gt])
  have sub: "?NS\<^sup>* O ?S O ?NS\<^sup>*
      \<subseteq> (?NS \<union> ?S)\<^sup>* O ?S O (?NS \<union> ?S)\<^sup>*"
  proof -
    have ns: "?NS\<^sup>* \<subseteq> (?NS \<union> ?S)\<^sup>*"
      by (rule rtrancl_mono, auto)
    show ?thesis
      by (rule relcomp_mono[OF ns relcomp_mono[OF subset_refl ns]])
  qed
  show ?thesis unfolding SN_rel_defs by (rule SN_subset[OF sn sub])
qed

text \<open>
  Minimal-chain deletion only needs an order on the pair-event endpoints.
  In particular, it does not require a substitution-closed reduction pair on
  every untyped term.  This is the abstract processor boundary used by the
  guarded recognizer proof below.
\<close>

lemma SN_rel_min_endpoint_order:
  assumes sn: "SN S"
    and compat_NS_S: "NS O S \<subseteq> S"
    and compat_S_NS: "S O NS \<subseteq> S"
    and trans_NS: "trans NS"
    and target_SN: "\<And>s t. (s,t) \<in> B \<Longrightarrow> SN_on A {t}"
    and pair_order: "\<And>s t. SN_on A {s} \<Longrightarrow> (s,t) \<in> B \<Longrightarrow>
      (s,t) \<in> S \<union> NS"
    and pair_residual: "\<And>s t. SN_on A {s} \<Longrightarrow>
      (s,t) \<in> B \<Longrightarrow> (s,t) \<notin> S \<Longrightarrow> (s,t) \<in> C"
    and steps_order: "\<And>s t u. SN_on A {s} \<Longrightarrow>
      (s,t) \<in> A\<^sup>* \<Longrightarrow> (t,u) \<in> B \<Longrightarrow> (s,t) \<in> NS"
    and fin: "SN_rel C A"
  shows "SN_rel B A"
proof (rule ccontr)
  let ?PB = "A\<^sup>* O B O A\<^sup>*"
  let ?PC = "A\<^sup>* O C O A\<^sup>*"
  assume not_fin: "\<not> SN_rel B A"
  then obtain f where chain: "chain ?PB f"
    unfolding SN_rel_on_def SN_defs by auto
  have ex_mid: "\<forall>i. \<exists>a b. (f i,a) \<in> A\<^sup>* \<and>
      (a,b) \<in> B \<and> (b,f (Suc i)) \<in> A\<^sup>*"
  proof
    fix i
    from chain[rule_format, of i] obtain a b where
      pre: "(f i,a) \<in> A\<^sup>*" and pair: "(a,b) \<in> B"
      and post: "(b,f (Suc i)) \<in> A\<^sup>*" by auto
    show "\<exists>a b. (f i,a) \<in> A\<^sup>* \<and> (a,b) \<in> B \<and>
      (b,f (Suc i)) \<in> A\<^sup>*" using pre pair post by auto
  qed
  from choice[OF ex_mid] obtain a where choose_a:
      "\<forall>i. \<exists>b. (f i,a i) \<in> A\<^sup>* \<and>
        (a i,b) \<in> B \<and> (b,f (Suc i)) \<in> A\<^sup>*" by auto
  from choice[OF choose_a] obtain b where chosen:
      "\<forall>i. (f i,a i) \<in> A\<^sup>* \<and>
        (a i,b i) \<in> B \<and> (b i,f (Suc i)) \<in> A\<^sup>*" by auto
  from chosen have pre: "\<And>i. (f i,a i) \<in> A\<^sup>*"
    and pair: "\<And>i. (a i,b i) \<in> B"
    and post: "\<And>i. (b i,f (Suc i)) \<in> A\<^sup>*" by auto
  have between: "(b i,a (Suc i)) \<in> A\<^sup>*" for i
    by (rule rtrancl_trans[OF post[of i] pre[of "Suc i"]])
  have b_sn: "SN_on A {b i}" for i by (rule target_SN[OF pair])
  have a_sn: "SN_on A {a (Suc i)}" for i
  proof (rule ccontr)
    assume not_sn: "\<not> SN_on A {a (Suc i)}"
    from steps_notSN_on_source[OF between[of i] not_sn]
      b_sn[of i] show False by contradiction
  qed
  have weak: "(b i,a (Suc i)) \<in> NS" for i
    by (rule steps_order[OF b_sn between pair])
  have pord: "(a (Suc i),b (Suc i)) \<in> S \<union> NS" for i
    by (rule pair_order[OF a_sn pair])
  let ?x = "\<lambda>i. a (Suc i)"
  have xstep: "(?x i,?x (Suc i)) \<in> NS \<union> S" for i
  proof (cases "(a (Suc i),b (Suc i)) \<in> S")
    case True
    have comp: "(a (Suc i),a (Suc (Suc i))) \<in> S O NS"
      by (rule relcompI[OF True weak[of "Suc i"]])
    have "(a (Suc i),a (Suc (Suc i))) \<in> S"
      by (rule compat_S_NS[THEN subsetD, OF comp])
    then show ?thesis by simp
  next
    case False
    with pord[of i] have first: "(a (Suc i),b (Suc i)) \<in> NS" by auto
    from transD[OF trans_NS first weak[of "Suc i"]] show ?thesis by simp
  qed
  have xchain: "chain (NS \<union> S) ?x" using xstep by simp
  have sn0: "SN_on S {?x 0}" using sn unfolding SN_on_def by auto
  from non_strict_ending[OF xchain compat_NS_S sn0]
  obtain j where tail: "\<And>k. k \<ge> j \<Longrightarrow>
    (?x k,?x (Suc k)) \<in> NS - S" by auto
  have tail_pair: "(a (Suc (k+j)),b (Suc (k+j))) \<in> C" for k
  proof -
    have not_strict: "(a (Suc (k+j)),b (Suc (k+j))) \<notin> S"
    proof
      assume strict: "(a (Suc (k+j)),b (Suc (k+j))) \<in> S"
      have comp: "(a (Suc (k+j)),a (Suc (Suc (k+j)))) \<in> S O NS"
        by (rule relcompI[OF strict weak[of "Suc (k+j)"]])
      have "(?x (k+j),?x (Suc (k+j))) \<in> S"
        by (rule compat_S_NS[THEN subsetD, OF comp])
      moreover from tail[of "k+j"] have
        "(?x (k+j),?x (Suc (k+j))) \<notin> S" by auto
      ultimately show False by contradiction
    qed
    show ?thesis by (rule pair_residual[OF a_sn pair not_strict])
  qed
  let ?h = "shift f (Suc j)"
  have residual_chain: "chain ?PC ?h"
  proof
    fix k
    have pre_k: "(f (Suc (k+j)),a (Suc (k+j))) \<in> A\<^sup>*" by (rule pre)
    have post_k: "(b (Suc (k+j)),f (Suc (Suc (k+j)))) \<in> A\<^sup>*" by (rule post)
    have member: "(f (Suc (k+j)),f (Suc (Suc (k+j)))) \<in> ?PC"
      using pre_k tail_pair[of k] post_k by auto
    show "(?h k,?h (Suc k)) \<in> ?PC" using member by simp
  qed
  from fin have "SN_on ?PC UNIV" unfolding SN_rel_on_def .
  moreover have "\<not> SN_on ?PC UNIV"
    by (rule not_SN_onI[OF _ residual_chain], simp)
  ultimately show False by contradiction
qed

lemma finite_min_csr_dpp_guarded_endpoint_delete:
  assumes pair_order: "\<And>s t.
      SN_on (csdp_step shp \<mu> R) {s} \<Longrightarrow>
      (s,t) \<in> csr_min_pair_step shp \<mu> P R \<Longrightarrow>
      (s,t) \<in> csr_guard_pair_rank_gt u11s lens z su len ni co ta zs \<union>
        csr_guard_pair_rank_ge u11s lens z su len ni co ta zs"
    and pair_residual: "\<And>s t.
      SN_on (csdp_step shp \<mu> R) {s} \<Longrightarrow>
      (s,t) \<in> csr_min_pair_step shp \<mu> P R \<Longrightarrow>
      (s,t) \<notin> csr_guard_pair_rank_gt u11s lens z su len ni co ta zs \<Longrightarrow>
      (s,t) \<in> csr_min_pair_step shp \<mu> Q R"
    and between_order: "\<And>s t u.
      SN_on (csdp_step shp \<mu> R) {s} \<Longrightarrow>
      (s,t) \<in> (csdp_step shp \<mu> R)\<^sup>* \<Longrightarrow>
      (t,u) \<in> csr_min_pair_step shp \<mu> P R \<Longrightarrow>
      (s,t) \<in> csr_guard_pair_rank_ge u11s lens z su len ni co ta zs"
    and fin: "finite_min_csr_dpp shp \<mu> Q R"
  shows "finite_min_csr_dpp shp \<mu> P R"
proof -
  let ?S = "csr_guard_pair_rank_gt u11s lens z su len ni co ta zs"
  let ?NS = "csr_guard_pair_rank_ge u11s lens z su len ni co ta zs"
  let ?A = "csdp_step shp \<mu> R"
  let ?B = "csr_min_pair_step shp \<mu> P R"
  let ?C = "csr_min_pair_step shp \<mu> Q R"
  have target: "\<And>s t. (s,t) \<in> ?B \<Longrightarrow> SN_on ?A {t}"
    unfolding csr_min_pair_step_def by auto
  have rel: "SN_rel ?B ?A"
    by (rule SN_rel_min_endpoint_order[
        OF SN_csr_guard_pair_rank_gt
          csr_guard_pair_rank_ge_gt_comp
          csr_guard_pair_rank_gt_ge_comp
          csr_guard_pair_rank_ge_trans target
          pair_order pair_residual between_order
          fin[unfolded finite_min_csr_dpp_def]])
  show ?thesis unfolding finite_min_csr_dpp_def by (rule rel)
qed

lemma option_measure_backward_rtrancl:
  fixes measure :: "'a \<Rightarrow> nat option"
  assumes preserve: "\<And>x y n. (x,y) \<in> A \<Longrightarrow>
      measure y = Some n \<Longrightarrow> measure x = Some n"
    and steps: "(s,t) \<in> A\<^sup>*"
    and target: "measure t = Some n"
  shows "measure s = Some n"
  using steps target
proof (induction rule: converse_rtrancl_induct)
  case base
  then show ?case .
next
  case (step s u)
  have "measure u = Some n" by (rule step.IH[OF step.prems])
  then show ?case by (rule preserve[OF step.hyps(1)])
qed

definition csr_guard_rank_backward_preserving where
  "csr_guard_rank_backward_preserving u11 u21 u31 z su len ni co ta zs \<mu> R \<longleftrightarrow>
    (\<forall>A s t n. (s,t) \<in> csstep \<mu> R \<longrightarrow>
      csr_guard_erased_rank u11 u21 u31 z su len ni co ta zs A t = Some n \<longrightarrow>
      csr_guard_erased_rank u11 u21 u31 z su len ni co ta zs A s = Some n)"

lemma csr_guard_rank_backward_cssteps:
  assumes preserving: "csr_guard_rank_backward_preserving
      u11 u21 u31 z su len ni co ta zs \<mu> R"
    and steps: "(s,t) \<in> (csstep \<mu> R)\<^sup>*"
    and target: "csr_guard_erased_rank
      u11 u21 u31 z su len ni co ta zs A t = Some n"
  shows "csr_guard_erased_rank
      u11 u21 u31 z su len ni co ta zs A s = Some n"
proof (rule option_measure_backward_rtrancl[
    where measure = "csr_guard_erased_rank
      u11 u21 u31 z su len ni co ta zs A"
    and A = "csstep \<mu> R", OF _ steps target])
  fix x y n
  assume xy: "(x,y) \<in> csstep \<mu> R"
    and yn: "csr_guard_erased_rank
      u11 u21 u31 z su len ni co ta zs A y = Some n"
  show "csr_guard_erased_rank
      u11 u21 u31 z su len ni co ta zs A x = Some n"
    using preserving xy yn
    unfolding csr_guard_rank_backward_preserving_def by blast
qed

lemma csr_guard_symbolic_rank_zero [simp]:
  "csr_guard_symbolic_rank z su len ni co ta zs Guard_Nat (Fun z []) =
    Some (Guard_Form [] [] 0)"
  by simp

lemma csr_guard_symbolic_rank_nil:
  assumes "ni \<noteq> co" "ni \<noteq> ta"
  shows "csr_guard_symbolic_rank z su len ni co ta zs Guard_List (Fun ni []) =
    Some (Guard_Form [] [] 0)"
  using assms by simp

lemma csr_guard_rank_cons_list:
  assumes distinct: "co \<noteq> ni" "co \<noteq> ta"
    and arity: "csr_guard_rank z su len ni co ta zs Guard_Nat n = Some kn"
      "csr_guard_rank z su len ni co ta zs Guard_List l = Some kl"
  shows "csr_guard_rank z su len ni co ta zs Guard_List
      (Fun co [n,l]) = Some (Suc kl)"
  using assms by simp

lemma csr_guard_rank_cons_list_strict:
  assumes distinct: "co \<noteq> ni" "co \<noteq> ta"
    and arity: "csr_guard_rank z su len ni co ta zs Guard_Nat n = Some kn"
      "csr_guard_rank z su len ni co ta zs Guard_List l = Some kl"
  obtains k where
    "csr_guard_rank z su len ni co ta zs Guard_List
       (Fun co [n,l]) = Some k"
    "csr_guard_rank z su len ni co ta zs Guard_List l = Some kl"
    "k > kl"
proof
  show "csr_guard_rank z su len ni co ta zs Guard_List
       (Fun co [n,l]) = Some (Suc kl)"
    by (rule csr_guard_rank_cons_list[OF distinct arity])
  show "csr_guard_rank z su len ni co ta zs Guard_List l = Some kl"
    by (rule arity(2))
  show "Suc kl > kl" by simp
qed

text \<open>
  The executable processor will validate the recognizer/schema rules and use
  the following relation as its strict component.  Keeping it explicit makes
  mutation-negative tests possible before it is connected to CPF parsing.
\<close>

definition csr_guard_rank_gt where
  "csr_guard_rank_gt z su len ni co ta zs A =
    {(s,t). \<exists>m n.
      csr_guard_rank z su len ni co ta zs A s = Some m \<and>
      csr_guard_rank z su len ni co ta zs A t = Some n \<and> m > n}"

definition csr_guard_rank_ge where
  "csr_guard_rank_ge z su len ni co ta zs A =
    {(s,t). \<exists>m n.
      csr_guard_rank z su len ni co ta zs A s = Some m \<and>
      csr_guard_rank z su len ni co ta zs A t = Some n \<and> m \<ge> n}"

lemma csr_guard_rank_gt_ge_comp:
  "csr_guard_rank_gt z su len ni co ta zs A O
      csr_guard_rank_ge z su len ni co ta zs A
    \<subseteq> csr_guard_rank_gt z su len ni co ta zs A"
  unfolding csr_guard_rank_gt_def csr_guard_rank_ge_def by auto

lemma csr_guard_rank_ge_gt_comp:
  "csr_guard_rank_ge z su len ni co ta zs A O
      csr_guard_rank_gt z su len ni co ta zs A
    \<subseteq> csr_guard_rank_gt z su len ni co ta zs A"
  unfolding csr_guard_rank_gt_def csr_guard_rank_ge_def by auto

lemma csr_guard_rank_ge_refl_on:
  "{t. \<exists>n. csr_guard_rank z su len ni co ta zs A t = Some n}
    \<subseteq> {t. (t,t) \<in> csr_guard_rank_ge z su len ni co ta zs A}"
  unfolding csr_guard_rank_ge_def by auto

lemma SN_csr_guard_rank_gt:
  "SN (csr_guard_rank_gt z su len ni co ta zs A)"
proof -
  have sub: "csr_guard_rank_gt z su len ni co ta zs A
      \<subseteq> inv_image {(m,n). m > n}
        (the \<circ> csr_guard_rank z su len ni co ta zs A)"
    unfolding csr_guard_rank_gt_def inv_image_def by auto
  have "SN (inv_image {(m,n). m > n}
      (the \<circ> csr_guard_rank z su len ni co ta zs A))"
    by (rule SN_inv_image[OF SN_nat_gt])
  then show ?thesis by (rule SN_subset[OF _ sub])
qed

lemma SN_rel_csr_guard_rank:
  "SN_rel (csr_guard_rank_gt z su len ni co ta zs A)
    (csr_guard_rank_ge z su len ni co ta zs A)"
proof -
  let ?S = "csr_guard_rank_gt z su len ni co ta zs A"
  let ?NS = "csr_guard_rank_ge z su len ni co ta zs A"
  have compat: "?NS O ?S \<subseteq> ?S"
    by (rule csr_guard_rank_ge_gt_comp)
  have sn: "SN ((?NS \<union> ?S)\<^sup>* O ?S O (?NS \<union> ?S)\<^sup>*)"
    by (rule compatible_SN'[OF compat SN_csr_guard_rank_gt])
  have sub: "?NS\<^sup>* O ?S O ?NS\<^sup>*
      \<subseteq> (?NS \<union> ?S)\<^sup>* O ?S O (?NS \<union> ?S)\<^sup>*"
  proof -
    have ns: "?NS\<^sup>* \<subseteq> (?NS \<union> ?S)\<^sup>*"
      by (rule rtrancl_mono, auto)
    show ?thesis
      by (rule relcomp_mono[OF ns relcomp_mono[OF subset_refl ns]])
  qed
  show ?thesis unfolding SN_rel_defs by (rule SN_subset[OF sn sub])
qed

text \<open>
  This is the framework boundary needed by an executable guarded-list
  processor.  The checker may establish the two inclusions using a typed
  symbolic rank calculation; the generic CSR-DP soundness argument below is
  independent of the concrete recognizer names and rules.
\<close>

lemma finite_min_csr_dpp_by_guard_rank:
  assumes strict: "csr_min_pair_step shp \<mu> P R
      \<subseteq> csr_guard_rank_gt z su len ni co ta zs A"
    and weak: "csdp_step shp \<mu> R
      \<subseteq> csr_guard_rank_ge z su len ni co ta zs A"
  shows "finite_min_csr_dpp shp \<mu> P R"
  unfolding finite_min_csr_dpp_def
  by (rule SN_rel_mono[OF strict weak SN_rel_csr_guard_rank])

end
