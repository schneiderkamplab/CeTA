theory CSR_Guarded_List_Measure
  imports CSR_Checker_Extensions.CSR_Minimal_CSDP_Proofs
begin

text \<open>
  Semantic ranks for the common membership-guarded list pattern used by
  context-sensitive specifications.  The three mutually recursive sorts are
  kept semantic: the same constructor may build a finite list or a possibly
  infinite list depending on the demanded result sort.  Every recursive call
  is on a proper syntactic subterm, so the rank is executable and independent
  of a particular benchmark spelling.
\<close>

datatype csr_guard_sort = Guard_Nat | Guard_List | Guard_IList

datatype ('v) csr_guard_form = Guard_Form
  "('v \<times> csr_guard_sort) list"
  "('v \<times> csr_guard_sort) list"
  nat

text \<open>
  Administrative symbols produced by the standard conditional-rule
  compilation are erased to the constructor expression they resume.  This
  makes the semantic rank stable across U11/U21/U31 steps without assigning
  an ad-hoc value to a guard term.
\<close>

fun csr_guard_erase_admin ::
  "'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow>
   'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow> ('f,'v) term \<Rightarrow> ('f,'v) term"
where
  "csr_guard_erase_admin u11 u21 u31 su len ni co ta (Var x) = Var x"
| "csr_guard_erase_admin u11 u21 u31 su len ni co ta (Fun f ts) =
    (if f = u11 \<and> length ts = 2 then
       Fun su [Fun len [csr_guard_erase_admin u11 u21 u31 su len ni co ta (ts ! 1)]]
     else if f = u21 \<and> length ts = 1 then Fun ni []
     else if f = u31 \<and> length ts = 4 then
       Fun co
         [csr_guard_erase_admin u11 u21 u31 su len ni co ta (ts ! 3),
          Fun ta
            [csr_guard_erase_admin u11 u21 u31 su len ni co ta (ts ! 2),
             csr_guard_erase_admin u11 u21 u31 su len ni co ta (ts ! 1)]]
     else Fun f (map (csr_guard_erase_admin u11 u21 u31 su len ni co ta) ts))"

lemma csr_guard_erase_admin_subst:
  "csr_guard_erase_admin u11 u21 u31 su len ni co ta (t \<cdot> \<sigma>) =
    csr_guard_erase_admin u11 u21 u31 su len ni co ta t \<cdot>
      (\<lambda>x. csr_guard_erase_admin u11 u21 u31 su len ni co ta (\<sigma> x))"
proof (induction t)
  case (Var x)
  then show ?case by simp
next
  case (Fun f ts)
  then show ?case by (simp split: if_splits)
qed

lemma csr_guard_erase_admin_u11:
  assumes distinct: "distinct [u11,u21,u31,su,len,ni,co,ta]"
  shows "csr_guard_erase_admin u11 u21 u31 su len ni co ta
      (Fun u11 [q,l]) =
    csr_guard_erase_admin u11 u21 u31 su len ni co ta
      (Fun su [Fun len [l]])"
  using distinct by (simp; fastforce)

lemma csr_guard_erase_admin_u21:
  assumes distinct: "distinct [u11,u21,u31,su,len,ni,co,ta]"
  shows "csr_guard_erase_admin u11 u21 u31 su len ni co ta
      (Fun u21 [q]) =
    csr_guard_erase_admin u11 u21 u31 su len ni co ta (Fun ni [])"
  using distinct by (simp; fastforce)

lemma csr_guard_erase_admin_u31:
  assumes distinct: "distinct [u11,u21,u31,su,len,ni,co,ta]"
  shows "csr_guard_erase_admin u11 u21 u31 su len ni co ta
      (Fun u31 [q,il,m,n]) =
    csr_guard_erase_admin u11 u21 u31 su len ni co ta
      (Fun co [n, Fun ta [m,il]])"
  using distinct by (simp; fastforce)

text \<open>
  The sequential conjunction generated by the conditional-rule compiler
  resumes with its second argument after the first guard succeeds.  Its
  numerical continuation is therefore the second argument independently of
  the guard's current reduction state.
\<close>

fun csr_guard_erase_and ::
  "'f \<Rightarrow> ('f,'v) term \<Rightarrow> ('f,'v) term"
where
  "csr_guard_erase_and a (Var x) = Var x"
| "csr_guard_erase_and a (Fun f ts) =
    (if f = a \<and> length ts = 2 then csr_guard_erase_and a (ts ! 1)
     else Fun f (map (csr_guard_erase_and a) ts))"

lemma csr_guard_erase_and_subst:
  "csr_guard_erase_and a (t \<cdot> \<sigma>) =
    csr_guard_erase_and a t \<cdot> (\<lambda>x. csr_guard_erase_and a (\<sigma> x))"
proof (induction t)
  case (Var x)
  then show ?case by simp
next
  case (Fun f ts)
  then show ?case by (simp split: if_splits)
qed

definition csr_guard_normalize where
  "csr_guard_normalize a u11 u21 u31 su len ni co ta t =
    csr_guard_erase_and a
      (csr_guard_erase_admin u11 u21 u31 su len ni co ta t)"

lemma csr_guard_normalize_subst:
  "csr_guard_normalize a u11 u21 u31 su len ni co ta (t \<cdot> \<sigma>) =
    csr_guard_normalize a u11 u21 u31 su len ni co ta t \<cdot>
      (\<lambda>x. csr_guard_normalize a u11 u21 u31 su len ni co ta (\<sigma> x))"
  unfolding csr_guard_normalize_def csr_guard_erase_admin_subst
    csr_guard_erase_and_subst by simp

lemma csr_guard_normalize_Fun:
  assumes distinct: "distinct [a,u11,u21,u31,su,len,ni,co,ta]"
  shows "csr_guard_normalize a u11 u21 u31 su len ni co ta (Fun f ts) =
    (if f = u11 \<and> length ts = 2 then
       Fun su [Fun len [csr_guard_normalize a u11 u21 u31 su len ni co ta (ts ! 1)]]
     else if f = u21 \<and> length ts = 1 then Fun ni []
     else if f = u31 \<and> length ts = 4 then
       Fun co
         [csr_guard_normalize a u11 u21 u31 su len ni co ta (ts ! 3),
          Fun ta
            [csr_guard_normalize a u11 u21 u31 su len ni co ta (ts ! 2),
             csr_guard_normalize a u11 u21 u31 su len ni co ta (ts ! 1)]]
     else if f = a \<and> length ts = 2 then
       csr_guard_normalize a u11 u21 u31 su len ni co ta (ts ! 1)
     else Fun f (map (csr_guard_normalize a u11 u21 u31 su len ni co ta) ts))"
  using distinct unfolding csr_guard_normalize_def
  by (auto simp: nth_map split: if_splits)

lemma csr_guard_normalize_Fun_cong:
  assumes distinct: "distinct [a,u11,u21,u31,su,len,ni,co,ta]"
    and args: "map (csr_guard_normalize a u11 u21 u31 su len ni co ta) xs =
      map (csr_guard_normalize a u11 u21 u31 su len ni co ta) ys"
  shows "csr_guard_normalize a u11 u21 u31 su len ni co ta (Fun f xs) =
    csr_guard_normalize a u11 u21 u31 su len ni co ta (Fun f ys)"
proof -
  have lengths: "length xs = length ys" using args by (metis length_map)
  have nth: "\<And>i. i < length xs \<Longrightarrow>
      csr_guard_normalize a u11 u21 u31 su len ni co ta (xs ! i) =
      csr_guard_normalize a u11 u21 u31 su len ni co ta (ys ! i)"
    using args lengths by (metis nth_map)
  show ?thesis
    unfolding csr_guard_normalize_Fun[OF distinct]
    using args lengths distinct by (auto intro: nth)
qed

fun csr_guard_form_requirements where
  "csr_guard_form_requirements (Guard_Form req cs c) = req"

fun csr_guard_form_coefficients where
  "csr_guard_form_coefficients (Guard_Form req cs c) = cs"

fun csr_guard_form_constant where
  "csr_guard_form_constant (Guard_Form req cs c) = c"

text \<open>
  A symbolic form contains, in order, the variable-sort requirements needed
  for definedness, the variables occurring with coefficient one in the rank,
  and the natural constant.  Repetition represents larger coefficients.  The
  distinction between requirements and coefficients matters for constructor
  heads: a list element must be a natural although its numerical value does
  not contribute to list length.
\<close>

fun csr_guard_symbolic_rank ::
  "'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow>
   'f \<Rightarrow> 'f \<Rightarrow> csr_guard_sort \<Rightarrow>
   ('f,'v) term \<Rightarrow> 'v csr_guard_form option"
where
  "csr_guard_symbolic_rank z su len ni co ta zs A (Var x) =
    Some (Guard_Form [(x,A)] [(x,A)] 0)"
| "csr_guard_symbolic_rank z su len ni co ta zs Guard_Nat (Fun f ts) =
    (if f = z \<and> ts = [] then Some (Guard_Form [] [] 0)
     else if f = su \<and> length ts = 1 then
       (case csr_guard_symbolic_rank z su len ni co ta zs Guard_Nat (ts ! 0) of
          None \<Rightarrow> None
        | Some (Guard_Form req cs c) \<Rightarrow>
            Some (Guard_Form req cs (Suc c)))
     else if f = len \<and> length ts = 1 then
       csr_guard_symbolic_rank z su len ni co ta zs Guard_List (ts ! 0)
     else None)"
| "csr_guard_symbolic_rank z su len ni co ta zs Guard_List (Fun f ts) =
    (if f = ni \<and> ts = [] then Some (Guard_Form [] [] 0)
     else if f = co \<and> length ts = 2 then
       (case csr_guard_symbolic_rank z su len ni co ta zs Guard_List (ts ! 1) of
          Some (Guard_Form reql coeffl cl) \<Rightarrow>
            Some (Guard_Form reql coeffl (Suc cl))
        | None \<Rightarrow> None)
     else if f = ta \<and> length ts = 2 then
       (case (csr_guard_symbolic_rank z su len ni co ta zs Guard_Nat (ts ! 0),
              csr_guard_symbolic_rank z su len ni co ta zs Guard_IList (ts ! 1)) of
          (Some (Guard_Form reqn coeffn cn),
           Some (Guard_Form reqi coeffi ci)) \<Rightarrow>
             Some (Guard_Form (reqn @ reqi) coeffn cn)
        | _ \<Rightarrow> None)
     else None)"
| "csr_guard_symbolic_rank z su len ni co ta zs Guard_IList (Fun f ts) =
    (if f = zs \<and> ts = [] then Some (Guard_Form [] [] 0)
     else if f = co \<and> length ts = 2 then
       (case csr_guard_symbolic_rank z su len ni co ta zs Guard_IList (ts ! 1) of
          Some (Guard_Form reqi coeffi ci) \<Rightarrow>
            Some (Guard_Form reqi [] 0)
        | None \<Rightarrow> None)
     else if f = ni \<and> ts = [] then Some (Guard_Form [] [] 0)
     else if f = ta \<and> length ts = 2 then
       (case (csr_guard_symbolic_rank z su len ni co ta zs Guard_Nat (ts ! 0),
              csr_guard_symbolic_rank z su len ni co ta zs Guard_IList (ts ! 1)) of
          (Some (Guard_Form reqn coeffn cn),
           Some (Guard_Form reqi coeffi ci)) \<Rightarrow>
             Some (Guard_Form (reqn @ reqi) [] 0)
        | _ \<Rightarrow> None)
     else None)"

fun csr_guard_rank ::
  "'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow>
   'f \<Rightarrow> 'f \<Rightarrow> csr_guard_sort \<Rightarrow>
   ('f,'v) term \<Rightarrow> nat option"
where
  "csr_guard_rank z su len ni co ta zs Guard_Nat (Var x) = None"
| "csr_guard_rank z su len ni co ta zs Guard_Nat (Fun f ts) =
    (if f = z \<and> ts = [] then Some 0
     else if f = su \<and> length ts = 1 then
       map_option Suc
         (csr_guard_rank z su len ni co ta zs Guard_Nat (ts ! 0))
     else if f = len \<and> length ts = 1 then
       csr_guard_rank z su len ni co ta zs Guard_List (ts ! 0)
     else None)"

| "csr_guard_rank z su len ni co ta zs Guard_List (Var x) = None"
| "csr_guard_rank z su len ni co ta zs Guard_List (Fun f ts) =
    (if f = ni \<and> ts = [] then Some 0
     else if f = co \<and> length ts = 2 then
       map_option Suc
         (csr_guard_rank z su len ni co ta zs Guard_List (ts ! 1))
     else if f = ta \<and> length ts = 2 then
       (case csr_guard_rank z su len ni co ta zs Guard_Nat (ts ! 0) of
          None \<Rightarrow> None
        | Some n \<Rightarrow>
            (case csr_guard_rank z su len ni co ta zs Guard_IList (ts ! 1) of
               None \<Rightarrow> None
             | Some m \<Rightarrow> Some n))
     else None)"

| "csr_guard_rank z su len ni co ta zs Guard_IList (Var x) = None"
| "csr_guard_rank z su len ni co ta zs Guard_IList (Fun f ts) =
    (if f = zs \<and> ts = [] then Some 0
     else if f = co \<and> length ts = 2 then
       (case csr_guard_rank z su len ni co ta zs Guard_IList (ts ! 1) of
          None \<Rightarrow> None
        | Some m \<Rightarrow> Some 0)
     else if f = ni \<and> ts = [] then Some 0
     else if f = ta \<and> length ts = 2 then
       (case csr_guard_rank z su len ni co ta zs Guard_Nat (ts ! 0) of
          None \<Rightarrow> None
        | Some n \<Rightarrow>
            (case csr_guard_rank z su len ni co ta zs Guard_IList (ts ! 1) of
               None \<Rightarrow> None
             | Some m \<Rightarrow> Some 0))
     else None)"

lemma csr_guard_normalize_constructor:
  assumes symbols: "distinct [a,u11,u21,u31,z,su,len,ni,co,ta,zs]"
    and constructor: "f \<in> set [z,su,len,ni,co,ta,zs]"
  shows "csr_guard_normalize a u11 u21 u31 su len ni co ta (Fun f ts) =
    Fun f (map (csr_guard_normalize a u11 u21 u31 su len ni co ta) ts)"
proof -
  have admin: "distinct [a,u11,u21,u31,su,len,ni,co,ta]"
    using symbols by simp
  have no_admin: "f \<noteq> a \<and> f \<noteq> u11 \<and> f \<noteq> u21 \<and> f \<noteq> u31"
    using symbols constructor by auto
  show ?thesis
    using no_admin by (simp add: csr_guard_normalize_Fun[OF admin])
qed

lemma csr_guard_rank_normalize_defined:
  assumes symbols: "distinct [a,u11,u21,u31,z,su,len,ni,co,ta,zs]"
    and rank: "csr_guard_rank z su len ni co ta zs A t = Some n"
  shows "csr_guard_rank z su len ni co ta zs A
      (csr_guard_normalize a u11 u21 u31 su len ni co ta t) = Some n"
  using rank
proof (induction t arbitrary: A n)
  case (Var x)
  then show ?case by (cases A; simp)
next
  case (Fun f ts)
  have admin: "distinct [a,u11,u21,u31,su,len,ni,co,ta]"
    using symbols by simp
  have z_su: "z \<noteq> su" and z_len: "z \<noteq> len"
    and su_z: "su \<noteq> z" and su_len: "su \<noteq> len"
    and len_z: "len \<noteq> z" and len_su: "len \<noteq> su"
    and ni_co: "ni \<noteq> co" and ni_ta: "ni \<noteq> ta" and ni_zs: "ni \<noteq> zs"
    and co_ni: "co \<noteq> ni" and co_ta: "co \<noteq> ta" and co_zs: "co \<noteq> zs"
    and ta_ni: "ta \<noteq> ni" and ta_co: "ta \<noteq> co" and ta_zs: "ta \<noteq> zs"
    and zs_ni: "zs \<noteq> ni" and zs_co: "zs \<noteq> co" and zs_ta: "zs \<noteq> ta"
    using symbols by auto
  note ctor_neq = z_su z_len su_z su_len len_z len_su
    ni_co ni_ta ni_zs co_ni co_ta co_zs ta_ni ta_co ta_zs zs_ni zs_co zs_ta
  have child: "\<And>i B m. i < length ts \<Longrightarrow>
      csr_guard_rank z su len ni co ta zs B (ts ! i) = Some m \<Longrightarrow>
      csr_guard_rank z su len ni co ta zs B
        (csr_guard_normalize a u11 u21 u31 su len ni co ta (ts ! i)) = Some m"
    by (rule Fun.IH, simp)
  show ?case
  proof (cases A)
    case Guard_Nat
    consider
        (zero) "f = z" "ts = []" "n = 0"
      | (suc) k where "f = su" "length ts = 1"
          "csr_guard_rank z su len ni co ta zs Guard_Nat (ts ! 0) = Some k"
          "n = Suc k"
      | (length) "f = len" "length ts = 1"
          "csr_guard_rank z su len ni co ta zs Guard_List (ts ! 0) = Some n"
      using Fun.prems unfolding Guard_Nat
      by (auto split: if_splits option.splits)
    then show ?thesis
    proof cases
      case zero
      then show ?thesis using ctor_neq Guard_Nat
        by (simp add: csr_guard_normalize_constructor[OF symbols] neq_commute)
    next
      case (suc k)
      have c: "csr_guard_rank z su len ni co ta zs Guard_Nat
          (csr_guard_normalize a u11 u21 u31 su len ni co ta (ts ! 0)) = Some k"
        by (rule child[OF _ suc(3)], use suc(2) in simp)
      show ?thesis using ctor_neq Guard_Nat suc c
        by (simp add: csr_guard_normalize_constructor[OF symbols] nth_map neq_commute)
    next
      case length
      have c: "csr_guard_rank z su len ni co ta zs Guard_List
          (csr_guard_normalize a u11 u21 u31 su len ni co ta (ts ! 0)) = Some n"
        by (rule child[OF _ length(3)], use length(2) in simp)
      show ?thesis using ctor_neq Guard_Nat length c
        by (simp add: csr_guard_normalize_constructor[OF symbols] nth_map neq_commute)
    qed
  next
    case Guard_List
    consider
        (nil) "f = ni" "ts = []" "n = 0"
      | (cons) k where "f = co" "length ts = 2"
          "csr_guard_rank z su len ni co ta zs Guard_List (ts ! 1) = Some k"
          "n = Suc k"
      | (take) k m where "f = ta" "length ts = 2"
          "csr_guard_rank z su len ni co ta zs Guard_Nat (ts ! 0) = Some k"
          "csr_guard_rank z su len ni co ta zs Guard_IList (ts ! 1) = Some m"
          "n = k"
      using Fun.prems unfolding Guard_List
      by (auto split: if_splits option.splits)
    then show ?thesis
    proof cases
      case nil
      then show ?thesis using ctor_neq Guard_List
        by (simp add: csr_guard_normalize_constructor[OF symbols] neq_commute)
    next
      case (cons k)
      have c: "csr_guard_rank z su len ni co ta zs Guard_List
          (csr_guard_normalize a u11 u21 u31 su len ni co ta (ts ! 1)) = Some k"
        by (rule child[OF _ cons(3)], use cons(2) in simp)
      show ?thesis using ctor_neq Guard_List cons c
        by (simp add: csr_guard_normalize_constructor[OF symbols] nth_map neq_commute)
    next
      case (take k m)
      have c0: "csr_guard_rank z su len ni co ta zs Guard_Nat
          (csr_guard_normalize a u11 u21 u31 su len ni co ta (ts ! 0)) = Some k"
        by (rule child[OF _ take(3)], use take(2) in simp)
      have c1: "csr_guard_rank z su len ni co ta zs Guard_IList
          (csr_guard_normalize a u11 u21 u31 su len ni co ta (ts ! 1)) = Some m"
        by (rule child[OF _ take(4)], use take(2) in simp)
      show ?thesis using ctor_neq Guard_List take c0 c1
        by (simp add: csr_guard_normalize_constructor[OF symbols] nth_map neq_commute)
    qed
  next
    case Guard_IList
    consider
        (zeros) "f = zs" "ts = []" "n = 0"
      | (cons) m where "f = co" "length ts = 2"
          "csr_guard_rank z su len ni co ta zs Guard_IList (ts ! 1) = Some m"
          "n = 0"
      | (nil) "f = ni" "ts = []" "n = 0"
      | (take) k m where "f = ta" "length ts = 2"
          "csr_guard_rank z su len ni co ta zs Guard_Nat (ts ! 0) = Some k"
          "csr_guard_rank z su len ni co ta zs Guard_IList (ts ! 1) = Some m"
          "n = 0"
      using Fun.prems unfolding Guard_IList
      by (auto split: if_splits option.splits)
    then show ?thesis
    proof cases
      case zeros
      then show ?thesis using ctor_neq Guard_IList
        by (simp add: csr_guard_normalize_constructor[OF symbols] neq_commute)
    next
      case (cons m)
      have c: "csr_guard_rank z su len ni co ta zs Guard_IList
          (csr_guard_normalize a u11 u21 u31 su len ni co ta (ts ! 1)) = Some m"
        by (rule child[OF _ cons(3)], use cons(2) in simp)
      show ?thesis using ctor_neq Guard_IList cons c
        by (simp add: csr_guard_normalize_constructor[OF symbols] nth_map neq_commute)
    next
      case nil
      then show ?thesis using ctor_neq Guard_IList
        by (simp add: csr_guard_normalize_constructor[OF symbols] neq_commute)
    next
      case (take k m)
      have c0: "csr_guard_rank z su len ni co ta zs Guard_Nat
          (csr_guard_normalize a u11 u21 u31 su len ni co ta (ts ! 0)) = Some k"
        by (rule child[OF _ take(3)], use take(2) in simp)
      have c1: "csr_guard_rank z su len ni co ta zs Guard_IList
          (csr_guard_normalize a u11 u21 u31 su len ni co ta (ts ! 1)) = Some m"
        by (rule child[OF _ take(4)], use take(2) in simp)
      show ?thesis using ctor_neq Guard_IList take c0 c1
        by (simp add: csr_guard_normalize_constructor[OF symbols] nth_map neq_commute)
    qed
  qed
qed

fun csr_guard_truth ::
  "'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow>
   'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow>
   ('f,'v) term \<Rightarrow> bool"
where
  "csr_guard_truth tt a natp listp ilistp z su len ni co ta zs (Var x) = False"
| "csr_guard_truth tt a natp listp ilistp z su len ni co ta zs (Fun f ts) =
    (if f = tt \<and> ts = [] then True
     else if f = a \<and> length ts = 2 then
       csr_guard_truth tt a natp listp ilistp z su len ni co ta zs (ts ! 0) \<and>
       csr_guard_truth tt a natp listp ilistp z su len ni co ta zs (ts ! 1)
     else if f = natp \<and> length ts = 1 then
       csr_guard_rank z su len ni co ta zs Guard_Nat (ts ! 0) \<noteq> None
     else if f = listp \<and> length ts = 1 then
       csr_guard_rank z su len ni co ta zs Guard_List (ts ! 0) \<noteq> None
     else if f = ilistp \<and> length ts = 1 then
       csr_guard_rank z su len ni co ta zs Guard_IList (ts ! 0) \<noteq> None
     else False)"

definition csr_guard_truth_rules_backward ::
  "'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow>
   'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow>
   ('f,'v) trs \<Rightarrow> bool"
where
  "csr_guard_truth_rules_backward tt a natp listp ilistp z su len ni co ta zs rules \<longleftrightarrow>
    (\<forall>lr \<in> rules. \<forall>(\<sigma> :: 'v \<Rightarrow> ('f,'v) term).
      csr_guard_truth tt a natp listp ilistp z su len ni co ta zs (snd lr \<cdot> \<sigma>) \<longrightarrow>
      csr_guard_truth tt a natp listp ilistp z su len ni co ta zs (fst lr \<cdot> \<sigma>))"

definition csr_guard_rank_rules_backward ::
  "('f,'v) trs \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow>
   'f \<Rightarrow> 'f \<Rightarrow> 'f \<Rightarrow> bool"
where
  "csr_guard_rank_rules_backward rules z su len ni co ta zs \<longleftrightarrow>
    (\<forall>lr \<in> rules. \<forall>(\<sigma> :: 'v \<Rightarrow> ('f,'v) term) n.
      (csr_guard_rank z su len ni co ta zs Guard_Nat (snd lr \<cdot> \<sigma>) = Some n \<longrightarrow>
       csr_guard_rank z su len ni co ta zs Guard_Nat (fst lr \<cdot> \<sigma>) = Some n) \<and>
      (csr_guard_rank z su len ni co ta zs Guard_List (snd lr \<cdot> \<sigma>) = Some n \<longrightarrow>
       csr_guard_rank z su len ni co ta zs Guard_List (fst lr \<cdot> \<sigma>) = Some n) \<and>
      (csr_guard_rank z su len ni co ta zs Guard_IList (snd lr \<cdot> \<sigma>) = Some n \<longrightarrow>
       csr_guard_rank z su len ni co ta zs Guard_IList (fst lr \<cdot> \<sigma>) = Some n))"

definition csr_guard_erased_rank where
  "csr_guard_erased_rank u11 u21 u31 z su len ni co ta zs A t =
    csr_guard_rank z su len ni co ta zs A
      (csr_guard_erase_admin u11 u21 u31 su len ni co ta t)"

definition csr_guard_erased_symbolic_rank where
  "csr_guard_erased_symbolic_rank u11 u21 u31 z su len ni co ta zs A t =
    csr_guard_symbolic_rank z su len ni co ta zs A
      (csr_guard_erase_admin u11 u21 u31 su len ni co ta t)"

definition csr_guard_normal_rank where
  "csr_guard_normal_rank a u11 u21 u31 z su len ni co ta zs A t =
    csr_guard_rank z su len ni co ta zs A
      (csr_guard_normalize a u11 u21 u31 su len ni co ta t)"

definition csr_guard_normal_symbolic_rank where
  "csr_guard_normal_symbolic_rank a u11 u21 u31 z su len ni co ta zs A t =
    csr_guard_symbolic_rank z su len ni co ta zs A
      (csr_guard_normalize a u11 u21 u31 su len ni co ta t)"

fun csr_guard_form_value ::
  "(('v \<times> csr_guard_sort) \<Rightarrow> nat) \<Rightarrow>
   'v csr_guard_form \<Rightarrow> nat"
where
  "csr_guard_form_value \<rho> (Guard_Form req cs c) =
    c + sum_list (map \<rho> cs)"

definition csr_guard_requirements_realized where
  "csr_guard_requirements_realized z su len ni co ta zs \<sigma> \<rho> req \<longleftrightarrow>
    (\<forall>x A. (x,A) \<in> set req \<longrightarrow>
      csr_guard_rank z su len ni co ta zs A (\<sigma> x) = Some (\<rho> (x,A)))"

lemma csr_guard_requirements_realized_Nil [simp]:
  "csr_guard_requirements_realized z su len ni co ta zs \<sigma> \<rho> []"
  unfolding csr_guard_requirements_realized_def by simp

lemma csr_guard_requirements_realized_append [simp]:
  "csr_guard_requirements_realized z su len ni co ta zs \<sigma> \<rho> (xs @ ys) \<longleftrightarrow>
    csr_guard_requirements_realized z su len ni co ta zs \<sigma> \<rho> xs \<and>
    csr_guard_requirements_realized z su len ni co ta zs \<sigma> \<rho> ys"
  unfolding csr_guard_requirements_realized_def by auto

lemma csr_guard_symbolic_rank_Var_sound:
  assumes form:
    "csr_guard_symbolic_rank z su len ni co ta zs A (Var x) = Some F"
    and realized: "csr_guard_requirements_realized
      z su len ni co ta zs \<sigma> \<rho> (csr_guard_form_requirements F)"
  shows "csr_guard_rank z su len ni co ta zs A (Var x \<cdot> \<sigma>) =
    Some (csr_guard_form_value \<rho> F)"
  using form realized
  unfolding csr_guard_requirements_realized_def by auto

lemma csr_guard_symbolic_rank_sound:
  assumes distinct: "distinct [z,su,len,ni,co,ta,zs]"
    and symbolic:
    "csr_guard_symbolic_rank z su len ni co ta zs A t = Some F"
    and realized: "csr_guard_requirements_realized
      z su len ni co ta zs \<sigma> \<rho> (csr_guard_form_requirements F)"
  shows "csr_guard_rank z su len ni co ta zs A (t \<cdot> \<sigma>) =
    Some (csr_guard_form_value \<rho> F)"
  using symbolic realized
proof (induction t arbitrary: A F)
  case (Var x)
  then show ?case
    unfolding csr_guard_requirements_realized_def by auto
next
  case (Fun f ts)
  show ?case
  proof (cases A)
    case Guard_Nat
    have symbolic':
      "csr_guard_symbolic_rank z su len ni co ta zs Guard_Nat (Fun f ts) = Some F"
      using Fun.prems(1) Guard_Nat by simp
    consider
        (zero) "f = z" "ts = []" "F = Guard_Form [] [] 0"
      | (succ) req cs c where
          "f = su" "length ts = 1"
          "csr_guard_symbolic_rank z su len ni co ta zs Guard_Nat (ts ! 0) =
             Some (Guard_Form req cs c)"
          "F = Guard_Form req cs (Suc c)"
      | (length) "f = len" "length ts = 1"
          "csr_guard_symbolic_rank z su len ni co ta zs Guard_List (ts ! 0) = Some F"
      using symbolic'
      by (auto simp: csr_guard_symbolic_rank.simps
          split: if_splits option.splits csr_guard_form.splits)
    then show ?thesis
    proof cases
      case zero
      then show ?thesis unfolding Guard_Nat by simp
    next
      case (succ req cs c)
      have mem: "ts ! 0 \<in> set ts" using succ(2) by simp
      have realized_child: "csr_guard_requirements_realized
          z su len ni co ta zs \<sigma> \<rho> req"
        using Fun.prems(2) succ(4) by simp
      have child: "csr_guard_rank z su len ni co ta zs Guard_Nat
          (ts ! 0 \<cdot> \<sigma>) = Some (c + sum_list (map \<rho> cs))"
        using Fun.IH[OF mem succ(3)] realized_child by simp
      show ?thesis unfolding Guard_Nat using succ child distinct by simp
    next
      case length
      have mem: "ts ! 0 \<in> set ts" using length(2) by simp
      have child: "csr_guard_rank z su len ni co ta zs Guard_List
          (ts ! 0 \<cdot> \<sigma>) = Some (csr_guard_form_value \<rho> F)"
        using Fun.IH[OF mem length(3)] Fun.prems(2) by simp
      show ?thesis unfolding Guard_Nat using length child distinct by fastforce
    qed
  next
    case Guard_List
    have symbolic':
      "csr_guard_symbolic_rank z su len ni co ta zs Guard_List (Fun f ts) = Some F"
      using Fun.prems(1) Guard_List by simp
    consider
        (nil) "f = ni" "ts = []" "F = Guard_Form [] [] 0"
      | (cons) reql coeffl cl where
          "f = co" "length ts = 2"
          "csr_guard_symbolic_rank z su len ni co ta zs Guard_List (ts ! 1) =
             Some (Guard_Form reql coeffl cl)"
          "F = Guard_Form reql coeffl (Suc cl)"
      | (take) reqn coeffn cn reqi coeffi ci where
          "f = ta" "length ts = 2"
          "csr_guard_symbolic_rank z su len ni co ta zs Guard_Nat (ts ! 0) =
             Some (Guard_Form reqn coeffn cn)"
          "csr_guard_symbolic_rank z su len ni co ta zs Guard_IList (ts ! 1) =
             Some (Guard_Form reqi coeffi ci)"
          "F = Guard_Form (reqn @ reqi) coeffn cn"
      using symbolic'
      by (auto simp: csr_guard_symbolic_rank.simps
          split: if_splits option.splits csr_guard_form.splits prod.splits)
    then show ?thesis
    proof cases
      case nil
      then show ?thesis unfolding Guard_List by simp
    next
      case (cons reql coeffl cl)
      have mem1: "ts ! 1 \<in> set ts" using cons(2) by auto
      have realized_l: "csr_guard_requirements_realized
          z su len ni co ta zs \<sigma> \<rho> reql"
        using Fun.prems(2) cons(4) by simp
      have child_l: "csr_guard_rank z su len ni co ta zs Guard_List
          (ts ! 1 \<cdot> \<sigma>) = Some (cl + sum_list (map \<rho> coeffl))"
        using Fun.IH[OF mem1 cons(3)] realized_l by simp
      show ?thesis unfolding Guard_List using cons child_l distinct by fastforce
    next
      case (take reqn coeffn cn reqi coeffi ci)
      have mem0: "ts ! 0 \<in> set ts" and mem1: "ts ! 1 \<in> set ts"
        using take(2) by auto
      have realized_n: "csr_guard_requirements_realized
          z su len ni co ta zs \<sigma> \<rho> reqn"
        and realized_i: "csr_guard_requirements_realized
          z su len ni co ta zs \<sigma> \<rho> reqi"
        using Fun.prems(2) take(5) by simp_all
      have child_n: "csr_guard_rank z su len ni co ta zs Guard_Nat
          (ts ! 0 \<cdot> \<sigma>) = Some (cn + sum_list (map \<rho> coeffn))"
        using Fun.IH[OF mem0 take(3)] realized_n by simp
      have child_i: "csr_guard_rank z su len ni co ta zs Guard_IList
          (ts ! 1 \<cdot> \<sigma>) = Some (ci + sum_list (map \<rho> coeffi))"
        using Fun.IH[OF mem1 take(4)] realized_i by simp
      show ?thesis unfolding Guard_List using take child_n child_i distinct by fastforce
    qed
  next
    case Guard_IList
    have symbolic':
      "csr_guard_symbolic_rank z su len ni co ta zs Guard_IList (Fun f ts) = Some F"
      using Fun.prems(1) Guard_IList by simp
    consider
        (zeros) "f = zs" "ts = []" "F = Guard_Form [] [] 0"
      | (cons) reqi coeffi ci where
          "f = co" "length ts = 2"
          "csr_guard_symbolic_rank z su len ni co ta zs Guard_IList (ts ! 1) =
             Some (Guard_Form reqi coeffi ci)"
          "F = Guard_Form reqi [] 0"
      | (nil) "f = ni" "ts = []" "F = Guard_Form [] [] 0"
      | (take) reqn coeffn cn reqi coeffi ci where
          "f = ta" "length ts = 2"
          "csr_guard_symbolic_rank z su len ni co ta zs Guard_Nat (ts ! 0) =
             Some (Guard_Form reqn coeffn cn)"
          "csr_guard_symbolic_rank z su len ni co ta zs Guard_IList (ts ! 1) =
             Some (Guard_Form reqi coeffi ci)"
          "F = Guard_Form (reqn @ reqi) [] 0"
      using symbolic'
      by (auto simp: csr_guard_symbolic_rank.simps
          split: if_splits option.splits csr_guard_form.splits prod.splits)
    then show ?thesis
    proof cases
      case zeros
      then show ?thesis unfolding Guard_IList by simp
    next
      case (cons reqi coeffi ci)
      have mem1: "ts ! 1 \<in> set ts" using cons(2) by auto
      have realized_i: "csr_guard_requirements_realized
          z su len ni co ta zs \<sigma> \<rho> reqi"
        using Fun.prems(2) cons(4) by simp
      have child_i: "\<exists>n. csr_guard_rank z su len ni co ta zs Guard_IList
          (ts ! 1 \<cdot> \<sigma>) = Some n"
        using Fun.IH[OF mem1 cons(3)] realized_i by fastforce
      show ?thesis unfolding Guard_IList using cons child_i distinct by fastforce
    next
      case nil
      then show ?thesis unfolding Guard_IList using distinct by simp
    next
      case (take reqn coeffn cn reqi coeffi ci)
      have mem0: "ts ! 0 \<in> set ts" and mem1: "ts ! 1 \<in> set ts"
        using take(2) by auto
      have realized_n: "csr_guard_requirements_realized
          z su len ni co ta zs \<sigma> \<rho> reqn"
        and realized_i: "csr_guard_requirements_realized
          z su len ni co ta zs \<sigma> \<rho> reqi"
        using Fun.prems(2) take(5) by simp_all
      have child_n: "\<exists>n. csr_guard_rank z su len ni co ta zs Guard_Nat
          (ts ! 0 \<cdot> \<sigma>) = Some n"
        using Fun.IH[OF mem0 take(3)] realized_n by fastforce
      have child_i: "\<exists>n. csr_guard_rank z su len ni co ta zs Guard_IList
          (ts ! 1 \<cdot> \<sigma>) = Some n"
        using Fun.IH[OF mem1 take(4)] realized_i by fastforce
      show ?thesis unfolding Guard_IList using take child_n child_i distinct by fastforce
    qed
  qed
qed

definition csr_guard_rank_environment where
  "csr_guard_rank_environment z su len ni co ta zs \<sigma> xA =
    (case xA of (x,A) \<Rightarrow>
      the_default 0 (csr_guard_rank z su len ni co ta zs A (\<sigma> x)))"

lemma csr_guard_symbolic_rank_complete:
  assumes distinct: "distinct [z,su,len,ni,co,ta,zs]"
    and ground:
      "csr_guard_rank z su len ni co ta zs A (t \<cdot> \<sigma>) = Some n"
  shows "\<exists>F.
    csr_guard_symbolic_rank z su len ni co ta zs A t = Some F \<and>
    csr_guard_requirements_realized z su len ni co ta zs \<sigma>
      (csr_guard_rank_environment z su len ni co ta zs \<sigma>)
      (csr_guard_form_requirements F) \<and>
    csr_guard_form_value
      (csr_guard_rank_environment z su len ni co ta zs \<sigma>) F = n"
  using ground
proof (induction t arbitrary: A n)
  case (Var x)
  show ?case
  proof (intro exI conjI)
    show "csr_guard_symbolic_rank z su len ni co ta zs A (Var x) =
        Some (Guard_Form [(x,A)] [(x,A)] 0)"
      by simp
    show "csr_guard_requirements_realized z su len ni co ta zs \<sigma>
        (csr_guard_rank_environment z su len ni co ta zs \<sigma>)
        (csr_guard_form_requirements (Guard_Form [(x,A)] [(x,A)] 0))"
      using Var.prems
      unfolding csr_guard_requirements_realized_def
        csr_guard_rank_environment_def by simp
    show "csr_guard_form_value
        (csr_guard_rank_environment z su len ni co ta zs \<sigma>)
        (Guard_Form [(x,A)] [(x,A)] 0) = n"
      using Var.prems unfolding csr_guard_rank_environment_def by simp
  qed
next
  case (Fun f ts)
  show ?case
  proof (cases A)
    case Guard_Nat
    have ground': "csr_guard_rank z su len ni co ta zs Guard_Nat
        (Fun f ts \<cdot> \<sigma>) = Some n"
      using Fun.prems Guard_Nat by simp
    consider
        (zero) "f = z" "ts = []" "n = 0"
      | (succ) m where "f = su" "length ts = 1"
          "csr_guard_rank z su len ni co ta zs Guard_Nat
            (ts ! 0 \<cdot> \<sigma>) = Some m" "n = Suc m"
      | (length) m where "f = len" "length ts = 1"
          "csr_guard_rank z su len ni co ta zs Guard_List
            (ts ! 0 \<cdot> \<sigma>) = Some m" "n = m"
      using ground' distinct
      by (auto simp: csr_guard_rank.simps
          split: if_splits option.splits)
    then show ?thesis
    proof cases
      case zero
      then show ?thesis unfolding Guard_Nat by simp
    next
      case (succ m)
      have mem: "ts ! 0 \<in> set ts" using succ(2) by simp
      obtain F where symbolic:
          "csr_guard_symbolic_rank z su len ni co ta zs Guard_Nat
            (ts ! 0) = Some F"
        and realized: "csr_guard_requirements_realized z su len ni co ta zs \<sigma>
            (csr_guard_rank_environment z su len ni co ta zs \<sigma>)
            (csr_guard_form_requirements F)"
        and valF: "csr_guard_form_value
            (csr_guard_rank_environment z su len ni co ta zs \<sigma>) F = m"
        using Fun.IH[OF mem succ(3)] by blast
      obtain req cs c where F: "F = Guard_Form req cs c" by (cases F)
      show ?thesis
        unfolding Guard_Nat using succ symbolic realized valF F distinct
        by (intro exI[of _ "Guard_Form req cs (Suc c)"]) simp
    next
      case (length m)
      have mem: "ts ! 0 \<in> set ts" using length(2) by simp
      obtain F where symbolic:
          "csr_guard_symbolic_rank z su len ni co ta zs Guard_List
            (ts ! 0) = Some F"
        and realized: "csr_guard_requirements_realized z su len ni co ta zs \<sigma>
            (csr_guard_rank_environment z su len ni co ta zs \<sigma>)
            (csr_guard_form_requirements F)"
        and valF: "csr_guard_form_value
            (csr_guard_rank_environment z su len ni co ta zs \<sigma>) F = m"
        using Fun.IH[OF mem length(3)] by blast
      show ?thesis unfolding Guard_Nat using length symbolic realized valF distinct by force
    qed
  next
    case Guard_List
    have ground': "csr_guard_rank z su len ni co ta zs Guard_List
        (Fun f ts \<cdot> \<sigma>) = Some n"
      using Fun.prems Guard_List by simp
    consider
        (nil) "f = ni" "ts = []" "n = 0"
      | (cons) q where "f = co" "length ts = 2"
          "csr_guard_rank z su len ni co ta zs Guard_List
            (ts ! 1 \<cdot> \<sigma>) = Some q" "n = Suc q"
      | (take) p q where "f = ta" "length ts = 2"
          "csr_guard_rank z su len ni co ta zs Guard_Nat
            (ts ! 0 \<cdot> \<sigma>) = Some p"
          "csr_guard_rank z su len ni co ta zs Guard_IList
            (ts ! 1 \<cdot> \<sigma>) = Some q" "n = p"
      using ground' distinct
      by (auto simp: csr_guard_rank.simps
          split: if_splits option.splits)
    then show ?thesis
    proof cases
      case nil
      then show ?thesis unfolding Guard_List by simp
    next
      case (cons q)
      have mem1: "ts ! 1 \<in> set ts" using cons(2) by auto
      obtain Fl where sl:
          "csr_guard_symbolic_rank z su len ni co ta zs Guard_List (ts ! 1) = Some Fl"
        and rl: "csr_guard_requirements_realized z su len ni co ta zs \<sigma>
          (csr_guard_rank_environment z su len ni co ta zs \<sigma>)
          (csr_guard_form_requirements Fl)"
        and vl: "csr_guard_form_value
          (csr_guard_rank_environment z su len ni co ta zs \<sigma>) Fl = q"
        using Fun.IH[OF mem1 cons(3)] by blast
      obtain reql csl cl where Fl: "Fl = Guard_Form reql csl cl" by (cases Fl)
      have co_ni: "co \<noteq> ni" using distinct by auto
      show ?thesis
        unfolding Guard_List using cons sl rl vl Fl co_ni
        by (intro exI[of _ "Guard_Form reql csl (Suc cl)"]) simp
    next
      case (take p q)
      have mem0: "ts ! 0 \<in> set ts" and mem1: "ts ! 1 \<in> set ts"
        using take(2) by auto
      obtain Fn where sn:
          "csr_guard_symbolic_rank z su len ni co ta zs Guard_Nat (ts ! 0) = Some Fn"
        and rn: "csr_guard_requirements_realized z su len ni co ta zs \<sigma>
          (csr_guard_rank_environment z su len ni co ta zs \<sigma>)
          (csr_guard_form_requirements Fn)"
        and vn: "csr_guard_form_value
          (csr_guard_rank_environment z su len ni co ta zs \<sigma>) Fn = p"
        using Fun.IH[OF mem0 take(3)] by blast
      obtain Fi where si:
          "csr_guard_symbolic_rank z su len ni co ta zs Guard_IList (ts ! 1) = Some Fi"
        and ri: "csr_guard_requirements_realized z su len ni co ta zs \<sigma>
          (csr_guard_rank_environment z su len ni co ta zs \<sigma>)
          (csr_guard_form_requirements Fi)"
        and vi: "csr_guard_form_value
          (csr_guard_rank_environment z su len ni co ta zs \<sigma>) Fi = q"
        using Fun.IH[OF mem1 take(4)] by blast
      obtain reqn csn cn where Fn: "Fn = Guard_Form reqn csn cn" by (cases Fn)
      obtain reqi csi ci where Fi: "Fi = Guard_Form reqi csi ci" by (cases Fi)
      have ta_ni: "ta \<noteq> ni" and ta_co: "ta \<noteq> co"
        using distinct by auto
      show ?thesis
        unfolding Guard_List using take sn rn vn si ri vi Fn Fi ta_ni ta_co
        by (intro exI[of _ "Guard_Form (reqn @ reqi) csn cn"]) simp
    qed
  next
    case Guard_IList
    have ground': "csr_guard_rank z su len ni co ta zs Guard_IList
        (Fun f ts \<cdot> \<sigma>) = Some n"
      using Fun.prems Guard_IList by simp
    consider
        (zeros) "f = zs" "ts = []" "n = 0"
      | (cons) q where "f = co" "length ts = 2"
          "csr_guard_rank z su len ni co ta zs Guard_IList
            (ts ! 1 \<cdot> \<sigma>) = Some q" "n = 0"
      | (nil) "f = ni" "ts = []" "n = 0"
      | (take) p q where "f = ta" "length ts = 2"
          "csr_guard_rank z su len ni co ta zs Guard_Nat
            (ts ! 0 \<cdot> \<sigma>) = Some p"
          "csr_guard_rank z su len ni co ta zs Guard_IList
            (ts ! 1 \<cdot> \<sigma>) = Some q" "n = 0"
      using ground' distinct
      by (auto simp: csr_guard_rank.simps
          split: if_splits option.splits)
    then show ?thesis
    proof cases
      case zeros
      then show ?thesis unfolding Guard_IList by simp
    next
      case (cons q)
      have mem1: "ts ! 1 \<in> set ts" using cons(2) by auto
      obtain Fi where si:
          "csr_guard_symbolic_rank z su len ni co ta zs Guard_IList (ts ! 1) = Some Fi"
        and ri: "csr_guard_requirements_realized z su len ni co ta zs \<sigma>
          (csr_guard_rank_environment z su len ni co ta zs \<sigma>)
          (csr_guard_form_requirements Fi)"
        using Fun.IH[OF mem1 cons(3)] by blast
      obtain reqi csi ci where Fi: "Fi = Guard_Form reqi csi ci" by (cases Fi)
      have co_zs: "co \<noteq> zs" using distinct by auto
      show ?thesis
        unfolding Guard_IList using cons si ri Fi co_zs
        by (intro exI[of _ "Guard_Form reqi [] 0"]) simp
    next
      case nil
      have ni_zs: "ni \<noteq> zs" and ni_co: "ni \<noteq> co"
        using distinct by auto
      show ?thesis unfolding Guard_IList using nil ni_zs ni_co by simp
    next
      case (take p q)
      have mem0: "ts ! 0 \<in> set ts" and mem1: "ts ! 1 \<in> set ts"
        using take(2) by auto
      obtain Fn where sn:
          "csr_guard_symbolic_rank z su len ni co ta zs Guard_Nat (ts ! 0) = Some Fn"
        and rn: "csr_guard_requirements_realized z su len ni co ta zs \<sigma>
          (csr_guard_rank_environment z su len ni co ta zs \<sigma>)
          (csr_guard_form_requirements Fn)"
        using Fun.IH[OF mem0 take(3)] by blast
      obtain Fi where si:
          "csr_guard_symbolic_rank z su len ni co ta zs Guard_IList (ts ! 1) = Some Fi"
        and ri: "csr_guard_requirements_realized z su len ni co ta zs \<sigma>
          (csr_guard_rank_environment z su len ni co ta zs \<sigma>)
          (csr_guard_form_requirements Fi)"
        using Fun.IH[OF mem1 take(4)] by blast
      obtain reqn csn cn where Fn: "Fn = Guard_Form reqn csn cn" by (cases Fn)
      obtain reqi csi ci where Fi: "Fi = Guard_Form reqi csi ci" by (cases Fi)
      have ta_zs: "ta \<noteq> zs" and ta_co: "ta \<noteq> co" and ta_ni: "ta \<noteq> ni"
        using distinct by auto
      show ?thesis
        unfolding Guard_IList using take sn rn si ri Fn Fi ta_zs ta_co ta_ni
        by (intro exI[of _ "Guard_Form (reqn @ reqi) [] 0"]) simp
    qed
  qed
qed

lemma csr_guard_erased_symbolic_rank_sound:
  assumes distinct: "distinct [z,su,len,ni,co,ta,zs]"
    and symbolic:
      "csr_guard_erased_symbolic_rank u11 u21 u31 z su len ni co ta zs A t =
        Some F"
    and realized: "csr_guard_requirements_realized z su len ni co ta zs
      (\<lambda>x. csr_guard_erase_admin u11 u21 u31 su len ni co ta (\<sigma> x))
      \<rho> (csr_guard_form_requirements F)"
  shows "csr_guard_erased_rank u11 u21 u31 z su len ni co ta zs A (t \<cdot> \<sigma>) =
    Some (csr_guard_form_value \<rho> F)"
proof -
  have symbolic': "csr_guard_symbolic_rank z su len ni co ta zs A
      (csr_guard_erase_admin u11 u21 u31 su len ni co ta t) = Some F"
    using symbolic unfolding csr_guard_erased_symbolic_rank_def .
  have sound: "csr_guard_rank z su len ni co ta zs A
      (csr_guard_erase_admin u11 u21 u31 su len ni co ta t \<cdot>
        (\<lambda>x. csr_guard_erase_admin u11 u21 u31 su len ni co ta (\<sigma> x))) =
      Some (csr_guard_form_value \<rho> F)"
    by (rule csr_guard_symbolic_rank_sound[OF distinct symbolic' realized])
  show ?thesis
    unfolding csr_guard_erased_rank_def csr_guard_erase_admin_subst
    by (rule sound)
qed

lemma csr_guard_normal_symbolic_rank_sound:
  assumes distinct: "distinct [z,su,len,ni,co,ta,zs]"
    and symbolic:
      "csr_guard_normal_symbolic_rank a u11 u21 u31 z su len ni co ta zs A t =
        Some F"
    and realized: "csr_guard_requirements_realized z su len ni co ta zs
      (\<lambda>x. csr_guard_normalize a u11 u21 u31 su len ni co ta (\<sigma> x))
      \<rho> (csr_guard_form_requirements F)"
  shows "csr_guard_normal_rank a u11 u21 u31 z su len ni co ta zs A (t \<cdot> \<sigma>) =
    Some (csr_guard_form_value \<rho> F)"
proof -
  have symbolic': "csr_guard_symbolic_rank z su len ni co ta zs A
      (csr_guard_normalize a u11 u21 u31 su len ni co ta t) = Some F"
    using symbolic unfolding csr_guard_normal_symbolic_rank_def .
  have sound: "csr_guard_rank z su len ni co ta zs A
      (csr_guard_normalize a u11 u21 u31 su len ni co ta t \<cdot>
        (\<lambda>x. csr_guard_normalize a u11 u21 u31 su len ni co ta (\<sigma> x))) =
      Some (csr_guard_form_value \<rho> F)"
    by (rule csr_guard_symbolic_rank_sound[OF distinct symbolic' realized])
  show ?thesis
    unfolding csr_guard_normal_rank_def csr_guard_normalize_subst
    by (rule sound)
qed

definition csr_guard_normal_rank_environment where
  "csr_guard_normal_rank_environment a u11 u21 u31 z su len ni co ta zs \<sigma> =
    csr_guard_rank_environment z su len ni co ta zs
      (\<lambda>x. csr_guard_normalize a u11 u21 u31 su len ni co ta (\<sigma> x))"

lemma csr_guard_normal_symbolic_rank_complete:
  assumes distinct: "distinct [z,su,len,ni,co,ta,zs]"
    and ground:
      "csr_guard_normal_rank a u11 u21 u31 z su len ni co ta zs A
        (t \<cdot> \<sigma>) = Some n"
  shows "\<exists>F.
    csr_guard_normal_symbolic_rank a u11 u21 u31 z su len ni co ta zs A t = Some F \<and>
    csr_guard_requirements_realized z su len ni co ta zs
      (\<lambda>x. csr_guard_normalize a u11 u21 u31 su len ni co ta (\<sigma> x))
      (csr_guard_normal_rank_environment a u11 u21 u31 z su len ni co ta zs \<sigma>)
      (csr_guard_form_requirements F) \<and>
    csr_guard_form_value
      (csr_guard_normal_rank_environment a u11 u21 u31 z su len ni co ta zs \<sigma>) F = n"
proof -
  have ground': "csr_guard_rank z su len ni co ta zs A
      (csr_guard_normalize a u11 u21 u31 su len ni co ta t \<cdot>
        (\<lambda>x. csr_guard_normalize a u11 u21 u31 su len ni co ta (\<sigma> x))) = Some n"
    using ground unfolding csr_guard_normal_rank_def csr_guard_normalize_subst .
  obtain F where symbolic:
      "csr_guard_symbolic_rank z su len ni co ta zs A
        (csr_guard_normalize a u11 u21 u31 su len ni co ta t) = Some F"
    and realized: "csr_guard_requirements_realized z su len ni co ta zs
      (\<lambda>x. csr_guard_normalize a u11 u21 u31 su len ni co ta (\<sigma> x))
      (csr_guard_rank_environment z su len ni co ta zs
        (\<lambda>x. csr_guard_normalize a u11 u21 u31 su len ni co ta (\<sigma> x)))
      (csr_guard_form_requirements F)"
    and valF: "csr_guard_form_value
      (csr_guard_rank_environment z su len ni co ta zs
        (\<lambda>x. csr_guard_normalize a u11 u21 u31 su len ni co ta (\<sigma> x))) F = n"
    using csr_guard_symbolic_rank_complete[OF distinct ground'] by blast
  show ?thesis
    using symbolic realized valF
    unfolding csr_guard_normal_symbolic_rank_def
      csr_guard_normal_rank_environment_def by blast
qed

fun csr_guard_coefficients_le where
  "csr_guard_coefficients_le [] ys = True"
| "csr_guard_coefficients_le (x # xs) ys =
    (x \<in> set ys \<and> csr_guard_coefficients_le xs (remove1 x ys))"

lemma csr_guard_coefficients_le_sum:
  fixes \<rho> :: "'a \<Rightarrow> nat"
  assumes "csr_guard_coefficients_le xs ys"
  shows "sum_list (map \<rho> xs) \<le> sum_list (map \<rho> ys)"
  using assms
proof (induction xs arbitrary: ys)
  case Nil
  then show ?case by simp
next
  case (Cons x xs)
  then have x: "x \<in> set ys"
    and rest: "csr_guard_coefficients_le xs (remove1 x ys)"
    by simp_all
  have ih: "sum_list (map \<rho> xs) \<le>
      sum_list (map \<rho> (remove1 x ys))"
    by (rule Cons.IH[OF rest])
  have decompose: "sum_list (map \<rho> ys) =
      \<rho> x + sum_list (map \<rho> (remove1 x ys))"
    by (rule sum_list_map_remove1[OF x])
  show ?case using ih decompose by simp
qed

fun csr_guard_form_ge where
  "csr_guard_form_ge (Guard_Form req_l cs_l c_l)
      (Guard_Form req_r cs_r c_r) =
    (set req_r \<subseteq> set req_l \<and>
     csr_guard_coefficients_le cs_r cs_l \<and> c_r \<le> c_l)"

fun csr_guard_form_gt where
  "csr_guard_form_gt (Guard_Form req_l cs_l c_l)
      (Guard_Form req_r cs_r c_r) =
    (set req_r \<subseteq> set req_l \<and>
     csr_guard_coefficients_le cs_r cs_l \<and> c_r < c_l)"

fun csr_guard_form_backward_eq where
  "csr_guard_form_backward_eq (Guard_Form req_l cs_l c_l)
      (Guard_Form req_r cs_r c_r) =
    (set req_l \<subseteq> set req_r \<and>
     csr_guard_coefficients_le cs_l cs_r \<and>
     csr_guard_coefficients_le cs_r cs_l \<and> c_l = c_r)"

lemma csr_guard_requirements_realized_mono:
  assumes realized: "csr_guard_requirements_realized
      z su len ni co ta zs \<sigma> \<rho> req_l"
    and subset: "set req_r \<subseteq> set req_l"
  shows "csr_guard_requirements_realized
      z su len ni co ta zs \<sigma> \<rho> req_r"
  using realized subset unfolding csr_guard_requirements_realized_def by auto

lemma csr_guard_form_ge_value:
  assumes "csr_guard_form_ge F G"
  shows "csr_guard_form_value \<rho> F \<ge> csr_guard_form_value \<rho> G"
proof (cases F; cases G)
  fix req_l cs_l c_l req_r cs_r c_r
  assume F: "F = Guard_Form req_l cs_l c_l"
    and G: "G = Guard_Form req_r cs_r c_r"
  have constants: "c_r \<le> c_l" and coefficients:
      "csr_guard_coefficients_le cs_r cs_l"
    using assms unfolding F G by simp_all
  have sums: "sum_list (map \<rho> cs_r) \<le> sum_list (map \<rho> cs_l)"
    by (rule csr_guard_coefficients_le_sum[OF coefficients])
  show ?thesis unfolding F G using add_le_mono[OF constants sums] by simp
qed

lemma csr_guard_form_gt_value:
  assumes "csr_guard_form_gt F G"
  shows "csr_guard_form_value \<rho> F > csr_guard_form_value \<rho> G"
proof (cases F; cases G)
  fix req_l cs_l c_l req_r cs_r c_r
  assume F: "F = Guard_Form req_l cs_l c_l"
    and G: "G = Guard_Form req_r cs_r c_r"
  have constants: "c_r < c_l" and coefficients:
      "csr_guard_coefficients_le cs_r cs_l"
    using assms unfolding F G by simp_all
  have sums: "sum_list (map \<rho> cs_r) \<le> sum_list (map \<rho> cs_l)"
    by (rule csr_guard_coefficients_le_sum[OF coefficients])
  show ?thesis unfolding F G using add_less_le_mono[OF constants sums] by simp
qed

lemma csr_guard_form_backward_eq_value:
  assumes "csr_guard_form_backward_eq F G"
  shows "csr_guard_form_value \<rho> F = csr_guard_form_value \<rho> G"
proof (cases F; cases G)
  fix req_l cs_l c_l req_r cs_r c_r
  assume F: "F = Guard_Form req_l cs_l c_l"
    and G: "G = Guard_Form req_r cs_r c_r"
  have constants: "c_l = c_r"
    and lr: "csr_guard_coefficients_le cs_l cs_r"
    and rl: "csr_guard_coefficients_le cs_r cs_l"
    using assms unfolding F G by simp_all
  have sums: "sum_list (map \<rho> cs_l) = sum_list (map \<rho> cs_r)"
    using csr_guard_coefficients_le_sum[OF lr]
      csr_guard_coefficients_le_sum[OF rl] by (rule antisym)
  show ?thesis unfolding F G using constants sums by simp
qed

definition csr_guard_normal_rule_backward_eq where
  "csr_guard_normal_rule_backward_eq a u11 u21 u31 z su len ni co ta zs A l r \<longleftrightarrow>
    (case csr_guard_normal_symbolic_rank
              a u11 u21 u31 z su len ni co ta zs A r of
       None \<Rightarrow> True
     | Some G \<Rightarrow>
         (case csr_guard_normal_symbolic_rank
                a u11 u21 u31 z su len ni co ta zs A l of
            None \<Rightarrow> False
          | Some F \<Rightarrow> csr_guard_form_backward_eq F G))"

lemma csr_guard_normal_rule_backward_eq_sound:
  assumes distinct: "distinct [z,su,len,ni,co,ta,zs]"
    and checked: "csr_guard_normal_rule_backward_eq
      a u11 u21 u31 z su len ni co ta zs A l r"
    and target: "csr_guard_normal_rank
      a u11 u21 u31 z su len ni co ta zs A (r \<cdot> \<sigma>) = Some n"
  shows "csr_guard_normal_rank
      a u11 u21 u31 z su len ni co ta zs A (l \<cdot> \<sigma>) = Some n"
proof -
  obtain F G where lhs:
      "csr_guard_normal_symbolic_rank
        a u11 u21 u31 z su len ni co ta zs A l = Some F"
    and rhs: "csr_guard_normal_symbolic_rank
        a u11 u21 u31 z su len ni co ta zs A r = Some G"
    and eq: "csr_guard_form_backward_eq F G"
    using checked unfolding csr_guard_normal_rule_backward_eq_def
    using csr_guard_normal_symbolic_rank_complete[OF distinct target]
    by (auto split: option.splits)
  obtain H where rhs_again:
      "csr_guard_normal_symbolic_rank
        a u11 u21 u31 z su len ni co ta zs A r = Some H"
    and realized_H: "csr_guard_requirements_realized z su len ni co ta zs
      (\<lambda>x. csr_guard_normalize a u11 u21 u31 su len ni co ta (\<sigma> x))
      (csr_guard_normal_rank_environment a u11 u21 u31 z su len ni co ta zs \<sigma>)
      (csr_guard_form_requirements H)"
    and value_H: "csr_guard_form_value
      (csr_guard_normal_rank_environment a u11 u21 u31 z su len ni co ta zs \<sigma>) H = n"
    using csr_guard_normal_symbolic_rank_complete[OF distinct target] by blast
  have HG: "H = G" using rhs rhs_again by simp
  have req_subset: "set (csr_guard_form_requirements F) \<subseteq>
      set (csr_guard_form_requirements G)"
    using eq by (cases F; cases G) simp
  have realized_F: "csr_guard_requirements_realized z su len ni co ta zs
      (\<lambda>x. csr_guard_normalize a u11 u21 u31 su len ni co ta (\<sigma> x))
      (csr_guard_normal_rank_environment a u11 u21 u31 z su len ni co ta zs \<sigma>)
      (csr_guard_form_requirements F)"
    by (rule csr_guard_requirements_realized_mono[OF realized_H[unfolded HG] req_subset])
  have source: "csr_guard_normal_rank
      a u11 u21 u31 z su len ni co ta zs A (l \<cdot> \<sigma>) =
      Some (csr_guard_form_value
        (csr_guard_normal_rank_environment a u11 u21 u31 z su len ni co ta zs \<sigma>) F)"
    by (rule csr_guard_normal_symbolic_rank_sound[OF distinct lhs realized_F])
  have vals: "csr_guard_form_value
      (csr_guard_normal_rank_environment a u11 u21 u31 z su len ni co ta zs \<sigma>) F =
      csr_guard_form_value
      (csr_guard_normal_rank_environment a u11 u21 u31 z su len ni co ta zs \<sigma>) G"
    by (rule csr_guard_form_backward_eq_value[OF eq])
  show ?thesis using source value_H vals HG by simp
qed

lemma csr_guard_rank_Fun_backward:
  assumes distinct: "distinct [z,su,guard_len_sym,ni,co,ta,zs]"
    and len: "length xs = length ys"
    and args: "\<And>i A n. i < length ys \<Longrightarrow>
      csr_guard_rank z su guard_len_sym ni co ta zs A (ys ! i) = Some n \<Longrightarrow>
      csr_guard_rank z su guard_len_sym ni co ta zs A (xs ! i) = Some n"
    and target: "csr_guard_rank z su guard_len_sym ni co ta zs A (Fun f ys) = Some n"
  shows "csr_guard_rank z su guard_len_sym ni co ta zs A (Fun f xs) = Some n"
proof (cases A)
  case Guard_Nat
  consider
      (zero) "f = z" "ys = []" "n = 0"
    | (succ) m where "f = su" "length ys = 1"
        "csr_guard_rank z su guard_len_sym ni co ta zs Guard_Nat (ys ! 0) = Some m"
        "n = Suc m"
    | (length) m where "f = guard_len_sym" "length ys = 1"
        "csr_guard_rank z su guard_len_sym ni co ta zs Guard_List (ys ! 0) = Some m"
        "n = m"
    using target unfolding Guard_Nat
    by (auto simp: csr_guard_rank.simps split: if_splits option.splits)
  then show ?thesis
  proof cases
    case zero
    with len have "xs = []" by simp
    with zero show ?thesis unfolding Guard_Nat by simp
  next
    case (succ m)
    have child: "csr_guard_rank z su guard_len_sym ni co ta zs Guard_Nat (xs ! 0) = Some m"
      by (rule args[OF _ succ(3)], use succ(2) in simp)
    show ?thesis unfolding Guard_Nat using len succ child distinct by simp
  next
    case (length m)
    have child: "csr_guard_rank z su guard_len_sym ni co ta zs Guard_List (xs ! 0) = Some m"
      by (rule args[OF _ length(3)], use length(2) in simp)
    show ?thesis unfolding Guard_Nat using len length child distinct by fastforce
  qed
next
  case Guard_List
  consider
      (nil) "f = ni" "ys = []" "n = 0"
    | (cons) q where "f = co" "length ys = 2"
        "csr_guard_rank z su guard_len_sym ni co ta zs Guard_List (ys ! 1) = Some q"
        "n = Suc q"
    | (take) p q where "f = ta" "length ys = 2"
        "csr_guard_rank z su guard_len_sym ni co ta zs Guard_Nat (ys ! 0) = Some p"
        "csr_guard_rank z su guard_len_sym ni co ta zs Guard_IList (ys ! 1) = Some q"
        "n = p"
    using target unfolding Guard_List
    by (auto simp: csr_guard_rank.simps split: if_splits option.splits)
  then show ?thesis
  proof cases
    case nil
    with len have "xs = []" by simp
    with nil show ?thesis unfolding Guard_List by simp
  next
    case (cons q)
    have child1: "csr_guard_rank z su guard_len_sym ni co ta zs Guard_List (xs ! 1) = Some q"
      by (rule args[OF _ cons(3)], use cons(2) in simp)
    have co_ni: "co \<noteq> ni" using distinct by auto
    show ?thesis unfolding Guard_List using len cons child1 co_ni by simp
  next
    case (take p q)
    have child0: "csr_guard_rank z su guard_len_sym ni co ta zs Guard_Nat (xs ! 0) = Some p"
      by (rule args[OF _ take(3)], use take(2) in simp)
    have child1: "csr_guard_rank z su guard_len_sym ni co ta zs Guard_IList (xs ! 1) = Some q"
      by (rule args[OF _ take(4)], use take(2) in simp)
    have ta_ni: "ta \<noteq> ni" and ta_co: "ta \<noteq> co" using distinct by auto
    show ?thesis unfolding Guard_List using len take child0 child1 ta_ni ta_co by simp
  qed
next
  case Guard_IList
  consider
      (zeros) "f = zs" "ys = []" "n = 0"
    | (cons) q where "f = co" "length ys = 2"
        "csr_guard_rank z su guard_len_sym ni co ta zs Guard_IList (ys ! 1) = Some q"
        "n = 0"
    | (nil) "f = ni" "ys = []" "n = 0"
    | (take) p q where "f = ta" "length ys = 2"
        "csr_guard_rank z su guard_len_sym ni co ta zs Guard_Nat (ys ! 0) = Some p"
        "csr_guard_rank z su guard_len_sym ni co ta zs Guard_IList (ys ! 1) = Some q"
        "n = 0"
    using target unfolding Guard_IList
    by (auto simp: csr_guard_rank.simps split: if_splits option.splits)
  then show ?thesis
  proof cases
    case zeros
    with len have "xs = []" by simp
    with zeros show ?thesis unfolding Guard_IList by simp
  next
    case (cons q)
    have child1: "csr_guard_rank z su guard_len_sym ni co ta zs Guard_IList (xs ! 1) = Some q"
      by (rule args[OF _ cons(3)], use cons(2) in simp)
    have co_zs: "co \<noteq> zs" using distinct by auto
    show ?thesis unfolding Guard_IList using len cons child1 co_zs by simp
  next
    case nil
    with len have "xs = []" by simp
    moreover have ni_zs: "ni \<noteq> zs" and ni_co: "ni \<noteq> co"
      using distinct by auto
    ultimately show ?thesis unfolding Guard_IList using nil by simp
  next
    case (take p q)
    have child0: "csr_guard_rank z su guard_len_sym ni co ta zs Guard_Nat (xs ! 0) = Some p"
      by (rule args[OF _ take(3)], use take(2) in simp)
    have child1: "csr_guard_rank z su guard_len_sym ni co ta zs Guard_IList (xs ! 1) = Some q"
      by (rule args[OF _ take(4)], use take(2) in simp)
    have ta_zs: "ta \<noteq> zs" and ta_co: "ta \<noteq> co" and ta_ni: "ta \<noteq> ni"
      using distinct by auto
    show ?thesis unfolding Guard_IList using len take child0 child1 ta_zs ta_co ta_ni by simp
  qed
qed

lemma csr_guard_rank_ctxt_backward:
  assumes distinct: "distinct [z,su,len,ni,co,ta,zs]"
    and local: "\<And>A n.
      csr_guard_rank z su len ni co ta zs A y = Some n \<Longrightarrow>
      csr_guard_rank z su len ni co ta zs A x = Some n"
    and target: "csr_guard_rank z su len ni co ta zs A C\<langle>y\<rangle> = Some n"
  shows "csr_guard_rank z su len ni co ta zs A C\<langle>x\<rangle> = Some n"
  using target
proof (induction C arbitrary: A n)
  case Hole
  then show ?case using local by simp
next
  case (More f bef C aft)
  have nth_backward: "\<And>i A n.
      i < length (bef @ C\<langle>y\<rangle> # aft) \<Longrightarrow>
      csr_guard_rank z su len ni co ta zs A
        ((bef @ C\<langle>y\<rangle> # aft) ! i) = Some n \<Longrightarrow>
      csr_guard_rank z su len ni co ta zs A
        ((bef @ C\<langle>x\<rangle> # aft) ! i) = Some n"
  proof -
    fix i A n
    assume bound: "i < length (bef @ C\<langle>y\<rangle> # aft)"
      and target: "csr_guard_rank z su len ni co ta zs A
        ((bef @ C\<langle>y\<rangle> # aft) ! i) = Some n"
    show "csr_guard_rank z su len ni co ta zs A
        ((bef @ C\<langle>x\<rangle> # aft) ! i) = Some n"
    proof (cases "i < length bef")
      case True
      then show ?thesis using target by (simp add: nth_append)
    next
      case False
      note not_less = False
      show ?thesis
      proof (cases "i = length bef")
        case True
        then show ?thesis using More.IH target by (simp add: nth_append)
      next
        case False
        with not_less have "length bef < i" by simp
        then show ?thesis using target bound by (simp add: nth_append)
      qed
    qed
  qed
  have target': "csr_guard_rank z su len ni co ta zs A
      (Fun f (bef @ C\<langle>y\<rangle> # aft)) = Some n"
    using More.prems by simp
  have result: "csr_guard_rank z su len ni co ta zs A
      (Fun f (bef @ C\<langle>x\<rangle> # aft)) = Some n"
    by (rule csr_guard_rank_Fun_backward[OF distinct _ nth_backward target'], simp)
  show ?case using result by simp
qed

definition csr_guard_context_normalizes where
  "csr_guard_context_normalizes a u11 u21 u31 su len ni co ta C \<longleftrightarrow>
    ((\<exists>D. \<forall>t. csr_guard_normalize a u11 u21 u31 su len ni co ta C\<langle>t\<rangle> =
        D\<langle>csr_guard_normalize a u11 u21 u31 su len ni co ta t\<rangle>) \<or>
     (\<exists>u. \<forall>t. csr_guard_normalize a u11 u21 u31 su len ni co ta C\<langle>t\<rangle> = u))"

lemma csr_guard_context_normalizes_More_independent:
  assumes distinct: "distinct [a,u11,u21,u31,su,len,ni,co,ta]"
    and independent: "\<And>t.
      csr_guard_normalize a u11 u21 u31 su len ni co ta C\<langle>t\<rangle> = u"
  shows "csr_guard_context_normalizes a u11 u21 u31 su len ni co ta
    (More f bef C aft)"
  unfolding csr_guard_context_normalizes_def
proof (intro disjI2 exI allI)
  fix t
  have maps: "map (csr_guard_normalize a u11 u21 u31 su len ni co ta)
      (bef @ C\<langle>t\<rangle> # aft) =
    map (csr_guard_normalize a u11 u21 u31 su len ni co ta)
      (bef @ C\<langle>undefined\<rangle> # aft)"
    using independent by simp
  show "csr_guard_normalize a u11 u21 u31 su len ni co ta
      (More f bef C aft)\<langle>t\<rangle> =
    csr_guard_normalize a u11 u21 u31 su len ni co ta
      (More f bef C aft)\<langle>undefined\<rangle>"
    by (simp, rule csr_guard_normalize_Fun_cong[OF distinct maps])
qed

lemma csr_guard_context_normalizes_More_dependent:
  assumes distinct: "distinct [a,u11,u21,u31,su,len,ni,co,ta]"
    and dependent: "\<And>t.
      csr_guard_normalize a u11 u21 u31 su len ni co ta C\<langle>t\<rangle> =
        D\<langle>csr_guard_normalize a u11 u21 u31 su len ni co ta t\<rangle>"
  shows "csr_guard_context_normalizes a u11 u21 u31 su len ni co ta
    (More f bef C aft)"
proof (cases "f = u11 \<and> length (bef @ C\<langle>undefined\<rangle> # aft) = 2")
  case True
  then have f: "f = u11" and arity: "length bef + length aft = 1" by auto
  show ?thesis
  proof (cases bef)
    case Nil
    then obtain q where aft: "aft = [q]" using arity by (cases aft) auto
    show ?thesis unfolding csr_guard_context_normalizes_def
    proof (intro disjI2 exI allI)
      fix t
      show "csr_guard_normalize a u11 u21 u31 su len ni co ta
          (More f bef C aft)\<langle>t\<rangle> =
        Fun su [Fun len [csr_guard_normalize a u11 u21 u31 su len ni co ta q]]"
        using f Nil aft by (simp add: csr_guard_normalize_Fun[OF distinct])
    qed
  next
    case (Cons b bs)
    then have bs: "bs = []" and aft: "aft = []" using arity by auto
    show ?thesis unfolding csr_guard_context_normalizes_def
    proof (intro disjI1 exI allI)
      fix t
      show "csr_guard_normalize a u11 u21 u31 su len ni co ta
          (More f bef C aft)\<langle>t\<rangle> =
        (More su [] (More len [] D []) [])\<langle>
          csr_guard_normalize a u11 u21 u31 su len ni co ta t\<rangle>"
        using f Cons bs aft dependent
        by (simp add: csr_guard_normalize_Fun[OF distinct])
    qed
  qed
next
  case False
  note not_u11 = False
  show ?thesis
  proof (cases "f = u21 \<and> length (bef @ C\<langle>undefined\<rangle> # aft) = 1")
    case True
    then have f: "f = u21" and bef: "bef = []" and aft: "aft = []" by auto
    show ?thesis unfolding csr_guard_context_normalizes_def
    proof (intro disjI2 exI allI)
      fix t
      show "csr_guard_normalize a u11 u21 u31 su len ni co ta
          (More f bef C aft)\<langle>t\<rangle> = Fun ni []"
        using f bef aft not_u11
        by (simp add: csr_guard_normalize_Fun[OF distinct])
    qed
  next
    case False
    note not_u21 = False
    show ?thesis
    proof (cases "f = u31 \<and> length (bef @ C\<langle>undefined\<rangle> # aft) = 4")
      case True
      then have f: "f = u31" and arity: "length bef + length aft = 3" by auto
      show ?thesis
      proof (cases bef)
        case Nil
        then obtain q1 q2 q3 where aft: "aft = [q1,q2,q3]"
          using arity by (cases aft; cases "tl aft"; cases "tl (tl aft)") auto
        show ?thesis unfolding csr_guard_context_normalizes_def
        proof (intro disjI2 exI allI)
          fix t
          show "csr_guard_normalize a u11 u21 u31 su len ni co ta
              (More f bef C aft)\<langle>t\<rangle> =
            Fun co
              [csr_guard_normalize a u11 u21 u31 su len ni co ta q3,
               Fun ta
                [csr_guard_normalize a u11 u21 u31 su len ni co ta q2,
                 csr_guard_normalize a u11 u21 u31 su len ni co ta q1]]"
            using f Nil aft not_u11 not_u21
            by (simp add: csr_guard_normalize_Fun[OF distinct])
        qed
      next
        case (Cons b0 bs)
        note bef_Cons = Cons
        show ?thesis
        proof (cases bs)
          case Nil
          then obtain q2 q3 where aft: "aft = [q2,q3]"
            using arity bef_Cons Nil by (cases aft; cases "tl aft") auto
          show ?thesis unfolding csr_guard_context_normalizes_def
          proof (intro disjI1 exI allI)
            fix t
            show "csr_guard_normalize a u11 u21 u31 su len ni co ta
                (More f bef C aft)\<langle>t\<rangle> =
              (More co [csr_guard_normalize a u11 u21 u31 su len ni co ta q3]
                (More ta [csr_guard_normalize a u11 u21 u31 su len ni co ta q2] D []) [])\<langle>
                csr_guard_normalize a u11 u21 u31 su len ni co ta t\<rangle>"
              using f bef_Cons Nil aft dependent not_u11 not_u21
              by (simp add: csr_guard_normalize_Fun[OF distinct])
          qed
        next
          case (Cons b1 bs')
          note bs_Cons = Cons
          show ?thesis
          proof (cases bs')
            case Nil
            then obtain q3 where aft: "aft = [q3]"
              using arity bef_Cons bs_Cons Nil by (cases aft) auto
            show ?thesis unfolding csr_guard_context_normalizes_def
            proof (intro disjI1 exI allI)
              fix t
              show "csr_guard_normalize a u11 u21 u31 su len ni co ta
                  (More f bef C aft)\<langle>t\<rangle> =
                (More co [csr_guard_normalize a u11 u21 u31 su len ni co ta q3]
                  (More ta [] D [csr_guard_normalize a u11 u21 u31 su len ni co ta b1]) [])\<langle>
                  csr_guard_normalize a u11 u21 u31 su len ni co ta t\<rangle>"
                using f bef_Cons bs_Cons Nil aft dependent not_u11 not_u21
                by (simp add: csr_guard_normalize_Fun[OF distinct])
            qed
          next
            case (Cons b2 bs'')
            note bs'_Cons = Cons
            then have tail: "bs'' = []" and aft: "aft = []"
              using arity bef_Cons bs_Cons by auto
            show ?thesis unfolding csr_guard_context_normalizes_def
            proof (intro disjI1 exI allI)
              fix t
              show "csr_guard_normalize a u11 u21 u31 su len ni co ta
                  (More f bef C aft)\<langle>t\<rangle> =
                (More co [] D
                  [Fun ta
                    [csr_guard_normalize a u11 u21 u31 su len ni co ta b2,
                     csr_guard_normalize a u11 u21 u31 su len ni co ta b1]])\<langle>
                  csr_guard_normalize a u11 u21 u31 su len ni co ta t\<rangle>"
                using f bef_Cons bs_Cons bs'_Cons tail aft dependent not_u11 not_u21
                by (simp add: csr_guard_normalize_Fun[OF distinct])
            qed
          qed
        qed
      qed
    next
      case False
      note not_u31 = False
      show ?thesis
      proof (cases "f = a \<and> length (bef @ C\<langle>undefined\<rangle> # aft) = 2")
        case True
        then have f: "f = a" and arity: "length bef + length aft = 1" by auto
        show ?thesis
        proof (cases bef)
          case Nil
          then obtain q where aft: "aft = [q]" using arity by (cases aft) auto
          show ?thesis unfolding csr_guard_context_normalizes_def
          proof (intro disjI2 exI allI)
            fix t
            show "csr_guard_normalize a u11 u21 u31 su len ni co ta
                (More f bef C aft)\<langle>t\<rangle> =
              csr_guard_normalize a u11 u21 u31 su len ni co ta q"
              using f Nil aft not_u11 not_u21 not_u31
              by (simp add: csr_guard_normalize_Fun[OF distinct])
          qed
        next
          case (Cons b bs)
          then have bs: "bs = []" and aft: "aft = []" using arity by auto
          show ?thesis unfolding csr_guard_context_normalizes_def
          proof (intro disjI1 exI allI)
            fix t
            show "csr_guard_normalize a u11 u21 u31 su len ni co ta
                (More f bef C aft)\<langle>t\<rangle> =
              D\<langle>csr_guard_normalize a u11 u21 u31 su len ni co ta t\<rangle>"
              using f Cons bs aft dependent not_u11 not_u21 not_u31
              by (simp add: csr_guard_normalize_Fun[OF distinct])
          qed
        qed
      next
        case False
        note not_and = False
        have n11: "\<not> (f = u11 \<and> length bef + length aft = 1)"
          using not_u11 by simp
        have n21: "\<not> (f = u21 \<and> length bef + length aft = 0)"
          using not_u21 by simp
        have n31: "\<not> (f = u31 \<and> length bef + length aft = 3)"
          using not_u31 by simp
        have na: "\<not> (f = a \<and> length bef + length aft = 1)"
          using not_and by simp
        show ?thesis unfolding csr_guard_context_normalizes_def
        proof (intro disjI1 exI allI)
          fix t
          let ?N = "csr_guard_normalize a u11 u21 u31 su len ni co ta"
          have b11: "\<not> (f = u11 \<and> length (bef @ C\<langle>t\<rangle> # aft) = 2)"
            using not_u11 by simp
          have b21: "\<not> (f = u21 \<and> length (bef @ C\<langle>t\<rangle> # aft) = 1)"
            using not_u21 by simp
          have b31: "\<not> (f = u31 \<and> length (bef @ C\<langle>t\<rangle> # aft) = 4)"
            using not_u31 by simp
          have ba: "\<not> (f = a \<and> length (bef @ C\<langle>t\<rangle> # aft) = 2)"
            using not_and by simp
          have top: "?N (Fun f (bef @ C\<langle>t\<rangle> # aft)) =
            (if f = u11 \<and> length (bef @ C\<langle>t\<rangle> # aft) = 2 then
               Fun su [Fun len [?N ((bef @ C\<langle>t\<rangle> # aft) ! 1)]]
             else if f = u21 \<and> length (bef @ C\<langle>t\<rangle> # aft) = 1 then Fun ni []
             else if f = u31 \<and> length (bef @ C\<langle>t\<rangle> # aft) = 4 then
               Fun co [?N ((bef @ C\<langle>t\<rangle> # aft) ! 3),
                 Fun ta [?N ((bef @ C\<langle>t\<rangle> # aft) ! 2),
                   ?N ((bef @ C\<langle>t\<rangle> # aft) ! 1)]]
             else if f = a \<and> length (bef @ C\<langle>t\<rangle> # aft) = 2 then
               ?N ((bef @ C\<langle>t\<rangle> # aft) ! 1)
             else Fun f (map ?N (bef @ C\<langle>t\<rangle> # aft)))"
            by (rule csr_guard_normalize_Fun[OF distinct])
          have top': "?N (Fun f (bef @ C\<langle>t\<rangle> # aft)) =
              Fun f (map ?N (bef @ C\<langle>t\<rangle> # aft))"
            using top by (simp only: b11 b21 b31 ba if_False)
          show "?N (More f bef C aft)\<langle>t\<rangle> =
            (More f (map ?N bef) D (map ?N aft))\<langle>?N t\<rangle>"
            using top' dependent
            by simp
        qed
      qed
    qed
  qed
qed

lemma csr_guard_context_normalizes_all:
  assumes distinct: "distinct [a,u11,u21,u31,su,len,ni,co,ta]"
  shows "csr_guard_context_normalizes a u11 u21 u31 su len ni co ta C"
proof (induction C)
  case Hole
  show ?case unfolding csr_guard_context_normalizes_def
    by (intro disjI1 exI[of _ Hole] allI) simp
next
  case (More f bef C aft)
  from More.IH consider
      (dependent) D where "\<And>t.
        csr_guard_normalize a u11 u21 u31 su len ni co ta C\<langle>t\<rangle> =
          D\<langle>csr_guard_normalize a u11 u21 u31 su len ni co ta t\<rangle>"
    | (independent) u where "\<And>t.
        csr_guard_normalize a u11 u21 u31 su len ni co ta C\<langle>t\<rangle> = u"
    unfolding csr_guard_context_normalizes_def by blast
  then show ?case
  proof cases
    case (dependent D)
    show ?thesis
      by (rule csr_guard_context_normalizes_More_dependent[OF distinct dependent])
  next
    case (independent u)
    show ?thesis
      by (rule csr_guard_context_normalizes_More_independent[OF distinct independent])
  qed
qed

lemma csr_guard_normal_rank_ctxt_backward_if:
  assumes distinct: "distinct [z,su,len,ni,co,ta,zs]"
    and normalized: "csr_guard_context_normalizes
      a u11 u21 u31 su len ni co ta C"
    and local: "\<And>A n.
      csr_guard_normal_rank a u11 u21 u31 z su len ni co ta zs A y = Some n \<Longrightarrow>
      csr_guard_normal_rank a u11 u21 u31 z su len ni co ta zs A x = Some n"
    and target: "csr_guard_normal_rank
      a u11 u21 u31 z su len ni co ta zs A C\<langle>y\<rangle> = Some n"
  shows "csr_guard_normal_rank
      a u11 u21 u31 z su len ni co ta zs A C\<langle>x\<rangle> = Some n"
proof -
  from normalized consider
      (dependent) D where "\<And>t. csr_guard_normalize a u11 u21 u31 su len ni co ta C\<langle>t\<rangle> =
        D\<langle>csr_guard_normalize a u11 u21 u31 su len ni co ta t\<rangle>"
    | (independent) u where "\<And>t.
        csr_guard_normalize a u11 u21 u31 su len ni co ta C\<langle>t\<rangle> = u"
    unfolding csr_guard_context_normalizes_def by blast
  then show ?thesis
  proof cases
    case (dependent D)
    have local': "\<And>A n.
        csr_guard_rank z su len ni co ta zs A
          (csr_guard_normalize a u11 u21 u31 su len ni co ta y) = Some n \<Longrightarrow>
        csr_guard_rank z su len ni co ta zs A
          (csr_guard_normalize a u11 u21 u31 su len ni co ta x) = Some n"
      using local unfolding csr_guard_normal_rank_def by blast
    have target': "csr_guard_rank z su len ni co ta zs A
        D\<langle>csr_guard_normalize a u11 u21 u31 su len ni co ta y\<rangle> = Some n"
      using target dependent unfolding csr_guard_normal_rank_def by simp
    have "csr_guard_rank z su len ni co ta zs A
        D\<langle>csr_guard_normalize a u11 u21 u31 su len ni co ta x\<rangle> = Some n"
      by (rule csr_guard_rank_ctxt_backward[OF distinct local' target'])
    then show ?thesis using dependent unfolding csr_guard_normal_rank_def by simp
  next
    case (independent u)
    then show ?thesis using target unfolding csr_guard_normal_rank_def by simp
  qed
qed

lemma csr_guard_normal_rank_ctxt_backward:
  assumes symbols: "distinct [a,u11,u21,u31,su,len,ni,co,ta]"
    and constructors: "distinct [z,su,len,ni,co,ta,zs]"
    and local: "\<And>A n.
      csr_guard_normal_rank a u11 u21 u31 z su len ni co ta zs A y = Some n \<Longrightarrow>
      csr_guard_normal_rank a u11 u21 u31 z su len ni co ta zs A x = Some n"
    and target: "csr_guard_normal_rank
      a u11 u21 u31 z su len ni co ta zs A C\<langle>y\<rangle> = Some n"
  shows "csr_guard_normal_rank
      a u11 u21 u31 z su len ni co ta zs A C\<langle>x\<rangle> = Some n"
  by (rule csr_guard_normal_rank_ctxt_backward_if[
      OF constructors csr_guard_context_normalizes_all[OF symbols] local target])

definition csr_guard_normal_rules_backward_eq where
  "csr_guard_normal_rules_backward_eq
      a u11 u21 u31 z su len ni co ta zs R \<longleftrightarrow>
    (\<forall>l r. (l,r) \<in> R \<longrightarrow> (\<forall>A.
      csr_guard_normal_rule_backward_eq
        a u11 u21 u31 z su len ni co ta zs A l r))"

lemma csr_guard_normal_rules_csstep_backward:
  assumes symbols: "distinct [a,u11,u21,u31,su,len,ni,co,ta]"
    and constructors: "distinct [z,su,len,ni,co,ta,zs]"
    and checked: "csr_guard_normal_rules_backward_eq
      a u11 u21 u31 z su len ni co ta zs R"
    and step: "(s,t) \<in> csstep \<mu> R"
    and target: "csr_guard_normal_rank
      a u11 u21 u31 z su len ni co ta zs A t = Some n"
  shows "csr_guard_normal_rank
      a u11 u21 u31 z su len ni co ta zs A s = Some n"
proof -
  from step obtain p lr \<sigma> where rewrite:
      "(s,t) \<in> rstep_r_p_s R lr p \<sigma>"
    unfolding csstep_def csstep_p_def by auto
  from rewrite[unfolded rstep_r_p_s_def'] have lr: "lr \<in> R"
    and pos: "p \<in> poss s"
    and redex: "s |_ p = fst lr \<cdot> \<sigma>"
    and reduct: "t = replace_at s p (snd lr \<cdot> \<sigma>)"
    by auto
  let ?C = "ctxt_of_pos_term p s"
  have source: "s = ?C\<langle>fst lr \<cdot> \<sigma>\<rangle>"
    using ctxt_supt_id[OF pos] redex by simp
  have target_ctxt: "t = ?C\<langle>snd lr \<cdot> \<sigma>\<rangle>"
    using ctxt_supt_id[OF pos] redex reduct by simp
  have local: "\<And>A n.
      csr_guard_normal_rank a u11 u21 u31 z su len ni co ta zs A
        (snd lr \<cdot> \<sigma>) = Some n \<Longrightarrow>
      csr_guard_normal_rank a u11 u21 u31 z su len ni co ta zs A
        (fst lr \<cdot> \<sigma>) = Some n"
  proof -
    fix A n
    assume rhs: "csr_guard_normal_rank a u11 u21 u31 z su len ni co ta zs A
      (snd lr \<cdot> \<sigma>) = Some n"
    have rule_checked: "csr_guard_normal_rule_backward_eq
        a u11 u21 u31 z su len ni co ta zs A (fst lr) (snd lr)"
      using checked lr unfolding csr_guard_normal_rules_backward_eq_def
      by (cases lr) auto
    show "csr_guard_normal_rank a u11 u21 u31 z su len ni co ta zs A
        (fst lr \<cdot> \<sigma>) = Some n"
      by (rule csr_guard_normal_rule_backward_eq_sound[
          OF constructors rule_checked rhs])
  qed
  have target': "csr_guard_normal_rank a u11 u21 u31 z su len ni co ta zs A
      ?C\<langle>snd lr \<cdot> \<sigma>\<rangle> = Some n"
    using target target_ctxt by simp
  have result: "csr_guard_normal_rank a u11 u21 u31 z su len ni co ta zs A
      ?C\<langle>fst lr \<cdot> \<sigma>\<rangle> = Some n"
    by (rule csr_guard_normal_rank_ctxt_backward[
        OF symbols constructors local target'])
  show ?thesis using result source by simp
qed

lemma csr_guard_normal_rules_csnrstep_backward:
  assumes symbols: "distinct [a,u11,u21,u31,su,len,ni,co,ta]"
    and constructors: "distinct [z,su,len,ni,co,ta,zs]"
    and checked: "csr_guard_normal_rules_backward_eq
      a u11 u21 u31 z su len ni co ta zs R"
    and step: "(s,t) \<in> csnrstep \<mu> R"
    and target: "csr_guard_normal_rank
      a u11 u21 u31 z su len ni co ta zs A t = Some n"
  shows "csr_guard_normal_rank
      a u11 u21 u31 z su len ni co ta zs A s = Some n"
  by (rule csr_guard_normal_rules_csstep_backward[
      OF symbols constructors checked csnrstep_imp_csstep[OF step] target])

lemma csr_guard_rank_rules_csstep_backward:
  fixes z su len ni co ta zs :: 'f and R :: "('f,'v) trs"
  assumes constructors: "distinct [z,su,len,ni,co,ta,zs]"
    and checked: "csr_guard_rank_rules_backward R z su len ni co ta zs"
    and step: "(s,t) \<in> csstep \<mu> R"
    and target: "csr_guard_rank z su len ni co ta zs A t = Some n"
  shows "csr_guard_rank z su len ni co ta zs A s = Some n"
proof -
  from step obtain p lr \<sigma> where rewrite:
      "(s,t) \<in> rstep_r_p_s R lr p \<sigma>"
    unfolding csstep_def csstep_p_def by auto
  from rewrite[unfolded rstep_r_p_s_def'] have lr: "lr \<in> R"
    and pos: "p \<in> poss s"
    and redex: "s |_ p = fst lr \<cdot> \<sigma>"
    and reduct: "t = replace_at s p (snd lr \<cdot> \<sigma>)" by auto
  let ?C = "ctxt_of_pos_term p s"
  have source: "s = ?C\<langle>fst lr \<cdot> \<sigma>\<rangle>"
    using ctxt_supt_id[OF pos] redex by simp
  have target_ctxt: "t = ?C\<langle>snd lr \<cdot> \<sigma>\<rangle>"
    using ctxt_supt_id[OF pos] redex reduct by simp
  have local: "\<And>B m. csr_guard_rank z su len ni co ta zs B
      (snd lr \<cdot> \<sigma>) = Some m \<Longrightarrow>
    csr_guard_rank z su len ni co ta zs B (fst lr \<cdot> \<sigma>) = Some m"
  proof -
    fix B m
    assume rhs: "csr_guard_rank z su len ni co ta zs B
      (snd lr \<cdot> \<sigma>) = Some m"
    have obligations:
      "(csr_guard_rank z su len ni co ta zs Guard_Nat (snd lr \<cdot> \<sigma>) = Some m \<longrightarrow>
        csr_guard_rank z su len ni co ta zs Guard_Nat (fst lr \<cdot> \<sigma>) = Some m) \<and>
       (csr_guard_rank z su len ni co ta zs Guard_List (snd lr \<cdot> \<sigma>) = Some m \<longrightarrow>
        csr_guard_rank z su len ni co ta zs Guard_List (fst lr \<cdot> \<sigma>) = Some m) \<and>
       (csr_guard_rank z su len ni co ta zs Guard_IList (snd lr \<cdot> \<sigma>) = Some m \<longrightarrow>
        csr_guard_rank z su len ni co ta zs Guard_IList (fst lr \<cdot> \<sigma>) = Some m)"
      using checked[unfolded csr_guard_rank_rules_backward_def,
          rule_format, OF lr, of \<sigma> m] .
    show "csr_guard_rank z su len ni co ta zs B
      (fst lr \<cdot> \<sigma>) = Some m"
    proof (cases B)
      case Guard_Nat
      then show ?thesis using obligations rhs unfolding Guard_Nat by blast
    next
      case Guard_List
      then show ?thesis using obligations rhs unfolding Guard_List by blast
    next
      case Guard_IList
      then show ?thesis using obligations rhs unfolding Guard_IList by blast
    qed
  qed
  have target': "csr_guard_rank z su len ni co ta zs A
      ?C\<langle>snd lr \<cdot> \<sigma>\<rangle> = Some n"
    using target target_ctxt by simp
  have result: "csr_guard_rank z su len ni co ta zs A
      ?C\<langle>fst lr \<cdot> \<sigma>\<rangle> = Some n"
    by (rule csr_guard_rank_ctxt_backward[OF constructors local target'])
  show ?thesis using result source by simp
qed

lemma csr_guard_truth_Fun_backward:
  assumes names: "distinct [tt,a,natp,listp,ilistp]"
    and len: "length xs = length ys"
    and truth_args: "\<And>i. i < length ys \<Longrightarrow>
      csr_guard_truth tt a natp listp ilistp z su guard_len ni co ta zs (ys ! i) \<Longrightarrow>
      csr_guard_truth tt a natp listp ilistp z su guard_len ni co ta zs (xs ! i)"
    and rank_args: "\<And>i k n. i < length ys \<Longrightarrow>
      csr_guard_rank z su guard_len ni co ta zs k (ys ! i) = Some n \<Longrightarrow>
      csr_guard_rank z su guard_len ni co ta zs k (xs ! i) = Some n"
    and target: "csr_guard_truth tt a natp listp ilistp
      z su guard_len ni co ta zs (Fun f ys)"
  shows "csr_guard_truth tt a natp listp ilistp
      z su guard_len ni co ta zs (Fun f xs)"
proof -
  consider
      (truth) "f = tt" "ys = []"
    | (conj) "f = a" "length ys = 2"
        "csr_guard_truth tt a natp listp ilistp z su guard_len ni co ta zs (ys ! 0)"
        "csr_guard_truth tt a natp listp ilistp z su guard_len ni co ta zs (ys ! 1)"
    | (nat) m where "f = natp" "length ys = 1"
        "csr_guard_rank z su guard_len ni co ta zs Guard_Nat (ys ! 0) = Some m"
    | (list) m where "f = listp" "length ys = 1"
        "csr_guard_rank z su guard_len ni co ta zs Guard_List (ys ! 0) = Some m"
    | (ilist) m where "f = ilistp" "length ys = 1"
        "csr_guard_rank z su guard_len ni co ta zs Guard_IList (ys ! 0) = Some m"
    using target names by (auto simp: csr_guard_truth.simps
        split: if_splits option.splits)
  then show ?thesis
  proof cases
    case truth
    with len have "xs = []" by simp
    with truth show ?thesis by simp
  next
    case conj
    have left: "csr_guard_truth tt a natp listp ilistp
        z su guard_len ni co ta zs (xs ! 0)"
      by (rule truth_args[OF _ conj(3)], use conj(2) in simp)
    have right: "csr_guard_truth tt a natp listp ilistp
        z su guard_len ni co ta zs (xs ! 1)"
      by (rule truth_args[OF _ conj(4)], use conj(2) in simp)
    show ?thesis using conj len left right names by (simp add: neq_commute)
  next
    case (nat m)
    have child: "csr_guard_rank z su guard_len ni co ta zs
        Guard_Nat (xs ! 0) = Some m"
      by (rule rank_args[OF _ nat(3)], use nat(2) in simp)
    show ?thesis using nat len child names by (simp add: neq_commute)
  next
    case (list m)
    have child: "csr_guard_rank z su guard_len ni co ta zs
        Guard_List (xs ! 0) = Some m"
      by (rule rank_args[OF _ list(3)], use list(2) in simp)
    show ?thesis using list len child names by (simp add: neq_commute)
  next
    case (ilist m)
    have child: "csr_guard_rank z su guard_len ni co ta zs
        Guard_IList (xs ! 0) = Some m"
      by (rule rank_args[OF _ ilist(3)], use ilist(2) in simp)
    show ?thesis using ilist len child names by (simp add: neq_commute)
  qed
qed

lemma csr_guard_truth_ctxt_backward:
  assumes names: "distinct [tt,a,natp,listp,ilistp]"
    and constructors: "distinct [z,su,guard_len,ni,co,ta,zs]"
    and local_truth:
      "csr_guard_truth tt a natp listp ilistp z su guard_len ni co ta zs y \<Longrightarrow>
       csr_guard_truth tt a natp listp ilistp z su guard_len ni co ta zs x"
    and local_rank: "\<And>k n.
      csr_guard_rank z su guard_len ni co ta zs k y = Some n \<Longrightarrow>
      csr_guard_rank z su guard_len ni co ta zs k x = Some n"
    and target: "csr_guard_truth tt a natp listp ilistp
      z su guard_len ni co ta zs C\<langle>y\<rangle>"
  shows "csr_guard_truth tt a natp listp ilistp
      z su guard_len ni co ta zs C\<langle>x\<rangle>"
  using target
proof (induction C)
  case Hole
  have target_y: "csr_guard_truth tt a natp listp ilistp
      z su guard_len ni co ta zs y" using Hole.prems by simp
  have source_x: "csr_guard_truth tt a natp listp ilistp
      z su guard_len ni co ta zs x" by (rule local_truth[OF target_y])
  show ?case using source_x by simp
next
  case (More f ss1 C ss2)
  let ?xs = "ss1 @ C\<langle>x\<rangle> # ss2"
  let ?ys = "ss1 @ C\<langle>y\<rangle> # ss2"
  have len: "length ?xs = length ?ys" by simp
  have truth_args: "\<And>i. i < length ?ys \<Longrightarrow>
      csr_guard_truth tt a natp listp ilistp z su guard_len ni co ta zs (?ys ! i) \<Longrightarrow>
      csr_guard_truth tt a natp listp ilistp z su guard_len ni co ta zs (?xs ! i)"
  proof -
    fix i
    assume ilen: "i < length ?ys"
      and truth: "csr_guard_truth tt a natp listp ilistp
        z su guard_len ni co ta zs (?ys ! i)"
    show "csr_guard_truth tt a natp listp ilistp
        z su guard_len ni co ta zs (?xs ! i)"
    proof (cases "i < length ss1")
      case True
      then show ?thesis using truth by (simp add: nth_append)
    next
      case False
      show ?thesis
      proof (cases "i = length ss1")
        case True
        from More.IH[OF truth[unfolded True, simplified]]
        show ?thesis unfolding True by simp
      next
        case False2: False
        then have "i > length ss1" using False by auto
        then show ?thesis using truth ilen by (simp add: nth_append)
      qed
    qed
  qed
  have rank_args: "\<And>i k n. i < length ?ys \<Longrightarrow>
      csr_guard_rank z su guard_len ni co ta zs k (?ys ! i) = Some n \<Longrightarrow>
      csr_guard_rank z su guard_len ni co ta zs k (?xs ! i) = Some n"
  proof -
    fix i k n
    assume ilen: "i < length ?ys"
      and rank: "csr_guard_rank z su guard_len ni co ta zs k (?ys ! i) = Some n"
    show "csr_guard_rank z su guard_len ni co ta zs k (?xs ! i) = Some n"
    proof (cases "i < length ss1")
      case True
      then show ?thesis using rank by (simp add: nth_append)
    next
      case False
      show ?thesis
      proof (cases "i = length ss1")
        case True
        have hole: "csr_guard_rank z su guard_len ni co ta zs k C\<langle>y\<rangle> = Some n"
          using rank unfolding True by simp
        have "csr_guard_rank z su guard_len ni co ta zs k C\<langle>x\<rangle> = Some n"
          by (rule csr_guard_rank_ctxt_backward[OF constructors local_rank hole])
        then show ?thesis unfolding True by simp
      next
        case False2: False
        then have "i > length ss1" using False by auto
        then show ?thesis using rank ilen by (simp add: nth_append)
      qed
    qed
  qed
  have target_fun: "csr_guard_truth tt a natp listp ilistp
      z su guard_len ni co ta zs (Fun f ?ys)"
    using More.prems by simp
  have result: "csr_guard_truth tt a natp listp ilistp
      z su guard_len ni co ta zs (Fun f ?xs)"
    by (rule csr_guard_truth_Fun_backward[
        OF names len truth_args rank_args target_fun])
  show ?case using result by simp
qed

lemma csr_guard_truth_rules_csstep_backward:
  fixes R :: "('f,'v) trs"
  assumes names: "distinct [tt,a,natp,listp,ilistp]"
    and constructors: "distinct [z,su,guard_len,ni,co,ta,zs]"
    and truth_checked: "csr_guard_truth_rules_backward
      tt a natp listp ilistp z su guard_len ni co ta zs R"
    and rank_checked: "csr_guard_rank_rules_backward
      R z su guard_len ni co ta zs"
    and step: "(s,t) \<in> csstep \<mu> R"
    and target: "csr_guard_truth tt a natp listp ilistp
      z su guard_len ni co ta zs t"
  shows "csr_guard_truth tt a natp listp ilistp
      z su guard_len ni co ta zs s"
proof -
  from step obtain p lr \<sigma> where rewrite:
      "(s,t) \<in> rstep_r_p_s R lr p \<sigma>"
    unfolding csstep_def csstep_p_def by auto
  from rewrite[unfolded rstep_r_p_s_def'] have lr: "lr \<in> R"
    and pos: "p \<in> poss s"
    and redex: "s |_ p = fst lr \<cdot> \<sigma>"
    and reduct: "t = replace_at s p (snd lr \<cdot> \<sigma>)" by auto
  let ?C = "ctxt_of_pos_term p s"
  have source: "s = ?C\<langle>fst lr \<cdot> \<sigma>\<rangle>"
    using ctxt_supt_id[OF pos] redex by simp
  have target_ctxt: "t = ?C\<langle>snd lr \<cdot> \<sigma>\<rangle>"
    using ctxt_supt_id[OF pos] redex reduct by simp
  have local_truth: "csr_guard_truth tt a natp listp ilistp
      z su guard_len ni co ta zs (snd lr \<cdot> \<sigma>) \<Longrightarrow>
    csr_guard_truth tt a natp listp ilistp
      z su guard_len ni co ta zs (fst lr \<cdot> \<sigma>)"
    using truth_checked lr unfolding csr_guard_truth_rules_backward_def by blast
  have local_rank: "\<And>k n.
      csr_guard_rank z su guard_len ni co ta zs k (snd lr \<cdot> \<sigma>) = Some n \<Longrightarrow>
    csr_guard_rank z su guard_len ni co ta zs k (fst lr \<cdot> \<sigma>) = Some n"
  proof -
    fix k n
    have one: "(snd lr \<cdot> \<sigma>,fst lr \<cdot> \<sigma>)
        \<in> {(y,x). csr_guard_rank z su guard_len ni co ta zs k y = Some n \<longrightarrow>
          csr_guard_rank z su guard_len ni co ta zs k x = Some n}"
      using rank_checked lr unfolding csr_guard_rank_rules_backward_def
      by (cases k; blast)
    show "csr_guard_rank z su guard_len ni co ta zs k (snd lr \<cdot> \<sigma>) = Some n \<Longrightarrow>
      csr_guard_rank z su guard_len ni co ta zs k (fst lr \<cdot> \<sigma>) = Some n"
      using one by auto
  qed
  have target': "csr_guard_truth tt a natp listp ilistp
      z su guard_len ni co ta zs ?C\<langle>snd lr \<cdot> \<sigma>\<rangle>"
    using target target_ctxt by simp
  have result: "csr_guard_truth tt a natp listp ilistp
      z su guard_len ni co ta zs ?C\<langle>fst lr \<cdot> \<sigma>\<rangle>"
    by (rule csr_guard_truth_ctxt_backward[
        OF names constructors local_truth local_rank target'])
  show ?thesis using result source by simp
qed

lemma csr_guard_truth_rules_cssteps_backward:
  fixes R :: "('f,'v) trs"
  assumes names: "distinct [tt,a,natp,listp,ilistp]"
    and constructors: "distinct [z,su,guard_len,ni,co,ta,zs]"
    and truth_checked: "csr_guard_truth_rules_backward
      tt a natp listp ilistp z su guard_len ni co ta zs R"
    and rank_checked: "csr_guard_rank_rules_backward
      R z su guard_len ni co ta zs"
    and steps: "(s,t) \<in> (csstep \<mu> R)\<^sup>*"
    and target: "csr_guard_truth tt a natp listp ilistp
      z su guard_len ni co ta zs t"
  shows "csr_guard_truth tt a natp listp ilistp
      z su guard_len ni co ta zs s"
  using steps target
proof (induction rule: converse_rtrancl_induct)
  case base
  then show ?case .
next
  case (step s u)
  have truth_u: "csr_guard_truth tt a natp listp ilistp
      z su guard_len ni co ta zs u"
    by (rule step.IH[OF step.prems])
  show ?case
    by (rule csr_guard_truth_rules_csstep_backward[
        OF names constructors truth_checked rank_checked step.hyps(1) truth_u])
qed

lemma csr_guard_successful_nat_list_test:
  fixes R :: "('f,'v) trs"
  assumes names: "distinct [tt,a,natp,listp,ilistp]"
    and constructors: "distinct [z,su,guard_len,ni,co,ta,zs]"
    and truth_checked: "csr_guard_truth_rules_backward
      tt a natp listp ilistp z su guard_len ni co ta zs R"
    and rank_checked: "csr_guard_rank_rules_backward
      R z su guard_len ni co ta zs"
    and steps: "(Fun a [Fun listp [L], Fun natp [N]], Fun tt [])
      \<in> (csstep \<mu> R)\<^sup>*"
  shows "csr_guard_rank z su guard_len ni co ta zs Guard_List L \<noteq> None"
proof -
  have target: "csr_guard_truth tt a natp listp ilistp
      z su guard_len ni co ta zs (Fun tt [])"
    using names by simp
  have source: "csr_guard_truth tt a natp listp ilistp
      z su guard_len ni co ta zs (Fun a [Fun listp [L], Fun natp [N]])"
    by (rule csr_guard_truth_rules_cssteps_backward[
        OF names constructors truth_checked rank_checked steps target])
  show ?thesis using source names by (simp add: neq_commute)
qed

lemma csdp_step_preserves_fresh_target_root:
  fixes R :: "('f::{showl,compare_order},'v) trs" and s t :: "('f,'v) term"
  assumes step: "(s,t) \<in> csdp_step shp \<mu> R"
    and target_root: "root t = Some (g,n)"
    and rhs_fresh: "\<And>lr (\<sigma> :: 'v \<Rightarrow> ('f,'v) term). lr \<in> R \<Longrightarrow>
      root (snd lr \<cdot> \<sigma>) \<noteq> Some (g,n)"
  shows "root s = Some (g,n)"
proof -
  from step obtain p lr \<sigma> where rewrite:
      "(s,t) \<in> rstep_r_p_s R lr p \<sigma>"
    unfolding csdp_step_def csdp_step_p_def by auto
  from rewrite[unfolded rstep_r_p_s_def'] have lr: "lr \<in> R"
    and pos: "p \<in> poss s"
    and reduct: "t = replace_at s p (snd lr \<cdot> \<sigma>)"
    by auto
  have p_ne: "p \<noteq> []"
  proof
    assume "p = []"
    then have "t = snd lr \<cdot> \<sigma>" using reduct by simp
    with target_root rhs_fresh[OF lr, of \<sigma>] show False by simp
  qed
  from p_ne obtain i q where p: "p = i # q" by (cases p) auto
  from pos p obtain f ts where s: "s = Fun f ts" and i: "i < length ts"
    by (cases s) auto
  have "root t = root s"
    using rewrite p s unfolding rstep_r_p_s_def' by auto
  then show ?thesis using target_root by simp
qed

lemma csr_guard_symbolic_rank_ge_sound:
  assumes distinct: "distinct [z,su,len,ni,co,ta,zs]"
    and lhs: "csr_guard_symbolic_rank z su len ni co ta zs A l = Some F"
    and rhs: "csr_guard_symbolic_rank z su len ni co ta zs A r = Some G"
    and orient: "csr_guard_form_ge F G"
    and realized: "csr_guard_requirements_realized
      z su len ni co ta zs \<sigma> \<rho> (csr_guard_form_requirements F)"
  obtains m n where
    "csr_guard_rank z su len ni co ta zs A (l \<cdot> \<sigma>) = Some m"
    "csr_guard_rank z su len ni co ta zs A (r \<cdot> \<sigma>) = Some n"
    "m \<ge> n"
proof
  have req_subset: "set (csr_guard_form_requirements G) \<subseteq>
      set (csr_guard_form_requirements F)"
    using orient by (cases F; cases G) simp
  have realized_r: "csr_guard_requirements_realized
      z su len ni co ta zs \<sigma> \<rho> (csr_guard_form_requirements G)"
    by (rule csr_guard_requirements_realized_mono[OF realized req_subset])
  show "csr_guard_rank z su len ni co ta zs A (l \<cdot> \<sigma>) =
      Some (csr_guard_form_value \<rho> F)"
    by (rule csr_guard_symbolic_rank_sound[OF distinct lhs realized])
  show "csr_guard_rank z su len ni co ta zs A (r \<cdot> \<sigma>) =
      Some (csr_guard_form_value \<rho> G)"
    by (rule csr_guard_symbolic_rank_sound[OF distinct rhs realized_r])
  show "csr_guard_form_value \<rho> F \<ge> csr_guard_form_value \<rho> G"
    by (rule csr_guard_form_ge_value[OF orient])
qed

lemma csr_guard_symbolic_rank_gt_sound:
  assumes distinct: "distinct [z,su,len,ni,co,ta,zs]"
    and lhs: "csr_guard_symbolic_rank z su len ni co ta zs A l = Some F"
    and rhs: "csr_guard_symbolic_rank z su len ni co ta zs A r = Some G"
    and orient: "csr_guard_form_gt F G"
    and realized: "csr_guard_requirements_realized
      z su len ni co ta zs \<sigma> \<rho> (csr_guard_form_requirements F)"
  obtains m n where
    "csr_guard_rank z su len ni co ta zs A (l \<cdot> \<sigma>) = Some m"
    "csr_guard_rank z su len ni co ta zs A (r \<cdot> \<sigma>) = Some n"
    "m > n"
proof
  have req_subset: "set (csr_guard_form_requirements G) \<subseteq>
      set (csr_guard_form_requirements F)"
    using orient by (cases F; cases G) simp
  have realized_r: "csr_guard_requirements_realized
      z su len ni co ta zs \<sigma> \<rho> (csr_guard_form_requirements G)"
    by (rule csr_guard_requirements_realized_mono[OF realized req_subset])
  show "csr_guard_rank z su len ni co ta zs A (l \<cdot> \<sigma>) =
      Some (csr_guard_form_value \<rho> F)"
    by (rule csr_guard_symbolic_rank_sound[OF distinct lhs realized])
  show "csr_guard_rank z su len ni co ta zs A (r \<cdot> \<sigma>) =
      Some (csr_guard_form_value \<rho> G)"
    by (rule csr_guard_symbolic_rank_sound[OF distinct rhs realized_r])
  show "csr_guard_form_value \<rho> F > csr_guard_form_value \<rho> G"
    by (rule csr_guard_form_gt_value[OF orient])
qed

text \<open>
  The guarded list measure is observed at the two marked roots of the hard
  component.  Both marked calls denote the length of their list argument;
  the surrounding guard argument of the marked U-call is deliberately
  ignored by the numerical measure but remains available to the later
  recognizer check.
\<close>

fun csr_guard_pair_symbolic_rank where
  "csr_guard_pair_symbolic_rank u11s lens z su len ni co ta zs (Var x) = None"
| "csr_guard_pair_symbolic_rank u11s lens z su len ni co ta zs (Fun f ts) =
    (if f = u11s \<and> length ts = 2 then
       csr_guard_symbolic_rank z su len ni co ta zs Guard_List (ts ! 1)
     else if f = lens \<and> length ts = 1 then
       csr_guard_symbolic_rank z su len ni co ta zs Guard_List (ts ! 0)
     else None)"

fun csr_guard_pair_rank where
  "csr_guard_pair_rank u11s lens z su len ni co ta zs (Var x) = None"
| "csr_guard_pair_rank u11s lens z su len ni co ta zs (Fun f ts) =
    (if f = u11s \<and> length ts = 2 then
       csr_guard_rank z su len ni co ta zs Guard_List (ts ! 1)
     else if f = lens \<and> length ts = 1 then
       csr_guard_rank z su len ni co ta zs Guard_List (ts ! 0)
     else None)"

definition csr_guard_normal_pair_symbolic_rank where
  "csr_guard_normal_pair_symbolic_rank a u11 u21 u31 u11s lens
      z su len ni co ta zs t =
    csr_guard_pair_symbolic_rank u11s lens z su len ni co ta zs
      (csr_guard_normalize a u11 u21 u31 su len ni co ta t)"

definition csr_guard_normal_pair_rank where
  "csr_guard_normal_pair_rank a u11 u21 u31 u11s lens
      z su len ni co ta zs t =
    csr_guard_pair_rank u11s lens z su len ni co ta zs
      (csr_guard_normalize a u11 u21 u31 su len ni co ta t)"

lemma csr_guard_normal_pair_rank_sharp_u11:
  assumes symbols: "distinct [a,u11,u21,u31,su,len,ni,co,ta]"
    and marked: "Sharp u11 \<notin> set [a,u11,u21,u31]"
    and wrappers: "Sharp u11 \<noteq> Sharp len"
  shows "csr_guard_normal_pair_rank a u11 u21 u31 (Sharp u11) (Sharp len)
      z su len ni co ta zs (sharp_term Sharp (Fun u11 [q,l])) =
    csr_guard_normal_rank a u11 u21 u31 z su len ni co ta zs Guard_List l"
  unfolding csr_guard_normal_pair_rank_def csr_guard_normal_rank_def
  using marked wrappers
  by (simp add: csr_guard_normalize_Fun[OF symbols])

lemma csr_guard_normal_pair_rank_sharp_length:
  assumes symbols: "distinct [a,u11,u21,u31,su,len,ni,co,ta]"
    and marked: "Sharp len \<notin> set [a,u11,u21,u31]"
    and wrappers: "Sharp len \<noteq> Sharp u11"
  shows "csr_guard_normal_pair_rank a u11 u21 u31 (Sharp u11) (Sharp len)
      z su len ni co ta zs (sharp_term Sharp (Fun len [l])) =
    csr_guard_normal_rank a u11 u21 u31 z su len ni co ta zs Guard_List l"
  unfolding csr_guard_normal_pair_rank_def csr_guard_normal_rank_def
  using marked wrappers
  by (simp add: csr_guard_normalize_Fun[OF symbols])

lemma sharp_csdp_step_Fun_shape:
  assumes wf: "wf_trs R"
    and fresh: "\<And>g n. \<not> defined R (Sharp g,n)"
    and step: "(sharp_term Sharp (Fun f ss),v) \<in> csdp_step Sharp \<mu> R"
  obtains ts where "v = sharp_term Sharp (Fun f ts)"
    "length ts = length ss"
proof -
  from sharp_csdp_step_imp_csnrstep[OF wf fresh inj_Sharp step]
  obtain t where v: "v = sharp_term Sharp t"
    and st: "(Fun f ss,t) \<in> csnrstep \<mu> R"
    by blast
  from st show thesis
  proof (rule csnrstep_FunE)
    fix i ts
    assume i: "i < length ss" and active: "i \<in> \<mu> (f,length ss)"
      and t: "t = Fun f ts" and len: "length ts = length ss"
      and substep: "(ss ! i,ts ! i) \<in> csstep \<mu> R"
      and same: "\<And>j. j < length ss \<Longrightarrow> j \<noteq> i \<Longrightarrow>
        ts ! j = ss ! j"
    have v': "v = sharp_term Sharp (Fun f ts)" using v t by simp
    show thesis by (rule that[OF v' len])
  qed
qed

lemma sharp_csdp_steps_Fun_shape:
  assumes wf: "wf_trs R"
    and fresh: "\<And>g n. \<not> defined R (Sharp g,n)"
    and shape: "s = sharp_term Sharp (Fun f ss)"
    and steps: "(s,t) \<in> (csdp_step Sharp \<mu> R)\<^sup>*"
  shows "\<exists>ts. t = sharp_term Sharp (Fun f ts) \<and>
    length ts = length ss"
  using steps shape
proof (induction arbitrary: ss rule: converse_rtrancl_induct)
  case base
  have t: "t = sharp_term Sharp (Fun f ss)" using base.prems by simp
  show ?case using t by blast
next
  case (step s u)
  have s: "s = sharp_term Sharp (Fun f ss)" by (rule step.prems)
  from sharp_csdp_step_Fun_shape[OF wf fresh step.hyps(1)[unfolded s]]
  obtain us where u: "u = sharp_term Sharp (Fun f us)"
    and len_us: "length us = length ss" .
  from step.IH[OF u] obtain ts where
    t: "t = sharp_term Sharp (Fun f ts)"
    and len_ts: "length ts = length us" by blast
  show ?case using t len_ts len_us by auto
qed

lemma csr_guard_normal_pair_rank_csdp_u11:
  assumes symbols: "distinct [a,u11,u21,u31,su,len,ni,co,ta]"
    and marked: "Sharp u11 \<notin> set [a,u11,u21,u31]"
    and wrappers: "Sharp u11 \<noteq> Sharp len"
    and wf: "wf_trs R"
    and fresh: "\<And>f n. \<not> defined R (Sharp f,n)"
    and frozen: "1 \<notin> \<mu> (u11,Suc (Suc 0))"
    and step: "(sharp_term Sharp (Fun u11 [q,l]),v) \<in> csdp_step Sharp \<mu> R"
  shows "csr_guard_normal_pair_rank a u11 u21 u31 (Sharp u11) (Sharp len)
      z su len ni co ta zs v =
    csr_guard_normal_pair_rank a u11 u21 u31 (Sharp u11) (Sharp len)
      z su len ni co ta zs (sharp_term Sharp (Fun u11 [q,l]))"
proof -
  from sharp_csdp_step_imp_csnrstep[OF wf fresh inj_Sharp step]
  obtain t where v: "v = sharp_term Sharp t"
    and st: "(Fun u11 [q,l],t) \<in> csnrstep \<mu> R"
    by blast
  have ex: "\<exists>i ts. i < length [q,l] \<and>
      i \<in> \<mu> (u11,length [q,l]) \<and> t = Fun u11 ts \<and>
      length ts = length [q,l] \<and>
      ([q,l] ! i, ts ! i) \<in> csstep \<mu> R \<and>
      (\<forall>j<length [q,l]. j \<noteq> i \<longrightarrow> ts ! j = [q,l] ! j)"
  proof -
    from st show ?thesis
    proof (rule csnrstep_FunE)
      fix i ts
      assume i: "i < length [q,l]" "i \<in> \<mu> (u11,length [q,l])"
        and t: "t = Fun u11 ts" and len: "length ts = length [q,l]"
        and substep: "([q,l] ! i, ts ! i) \<in> csstep \<mu> R"
        and same: "\<And>j. j < length [q,l] \<Longrightarrow> j \<noteq> i \<Longrightarrow>
          ts ! j = [q,l] ! j"
      show ?thesis using i t len substep same by blast
    qed
  qed
  then obtain i ts where i: "i < length [q,l]"
      "i \<in> \<mu> (u11,length [q,l])"
    and t: "t = Fun u11 ts" and len: "length ts = length [q,l]"
    and substep: "([q,l] ! i, ts ! i) \<in> csstep \<mu> R"
    and same: "\<And>j. j < length [q,l] \<Longrightarrow> j \<noteq> i \<Longrightarrow>
      ts ! j = [q,l] ! j"
    by blast
  have cases: "i = 0 \<or> i = 1"
    using i(1) by (cases i; simp; rename_tac j; cases j; simp_all)
  have imu: "i \<in> \<mu> (u11,Suc (Suc 0))" using i(2) by simp
  have i0: "i = 0" using cases imu frozen by blast
  have one_lt: "1 < length [q,l]" by simp
  have one_ne: "1 \<noteq> i" using i0 by simp
  have tail0: "ts ! 1 = [q,l] ! 1" by (rule same[OF one_lt one_ne])
  have tail: "ts ! 1 = l" using tail0 by simp
  have shape: "t = Fun u11 [ts ! 0,l]"
    using t len tail by (cases ts; cases "tl ts"; auto)
  have target_rank:
      "csr_guard_normal_pair_rank a u11 u21 u31 (Sharp u11) (Sharp len)
        z su len ni co ta zs (sharp_term Sharp (Fun u11 [ts ! 0,l])) =
       csr_guard_normal_rank a u11 u21 u31 z su len ni co ta zs Guard_List l"
    by (rule csr_guard_normal_pair_rank_sharp_u11[OF symbols marked wrappers])
  have source_rank:
      "csr_guard_normal_pair_rank a u11 u21 u31 (Sharp u11) (Sharp len)
        z su len ni co ta zs (sharp_term Sharp (Fun u11 [q,l])) =
       csr_guard_normal_rank a u11 u21 u31 z su len ni co ta zs Guard_List l"
    by (rule csr_guard_normal_pair_rank_sharp_u11[OF symbols marked wrappers])
  show ?thesis
    unfolding v shape
    using target_rank source_rank by simp
qed

lemma sharp_csdp_step_u11_guard:
  assumes wf: "wf_trs R"
    and fresh: "\<And>f n. \<not> defined R (Sharp f,n)"
    and frozen: "1 \<notin> \<mu> (u11,Suc (Suc 0))"
    and step: "(sharp_term Sharp (Fun u11 [q,l]),v)
      \<in> csdp_step Sharp \<mu> R"
  obtains q' where
    "v = sharp_term Sharp (Fun u11 [q',l])"
    "(q,q') \<in> csstep \<mu> R"
proof -
  from sharp_csdp_step_imp_csnrstep[OF wf fresh inj_Sharp step]
  obtain t where v: "v = sharp_term Sharp t"
    and st: "(Fun u11 [q,l],t) \<in> csnrstep \<mu> R"
    by blast
  from st show thesis
  proof (rule csnrstep_FunE)
    fix i ts
    assume i: "i < length [q,l]" "i \<in> \<mu> (u11,length [q,l])"
      and t: "t = Fun u11 ts" and len: "length ts = length [q,l]"
      and substep: "([q,l] ! i,ts ! i) \<in> csstep \<mu> R"
      and same: "\<And>j. j < length [q,l] \<Longrightarrow> j \<noteq> i \<Longrightarrow>
        ts ! j = [q,l] ! j"
    have cases: "i = 0 \<or> i = 1"
      using i(1) by (cases i; simp; rename_tac j; cases j; simp_all)
    have imu: "i \<in> \<mu> (u11,Suc (Suc 0))" using i(2) by simp
    have i0: "i = 0" using cases imu frozen by blast
    have tail: "ts ! 1 = l"
      using same[of 1] i0 by simp
    have shape: "ts = [ts ! 0,l]"
      using len tail by (cases ts; cases "tl ts"; auto)
    have v': "v = sharp_term Sharp (Fun u11 [ts ! 0,l])"
      using v t shape by simp
    have child: "(q,ts ! 0) \<in> csstep \<mu> R"
      using substep i0 by simp
    show thesis by (rule that[OF v' child])
  qed
qed

lemma sharp_csdp_steps_u11_guard:
  assumes wf: "wf_trs R"
    and fresh: "\<And>f n. \<not> defined R (Sharp f,n)"
    and frozen: "1 \<notin> \<mu> (u11,Suc (Suc 0))"
    and shape: "s = sharp_term Sharp (Fun u11 [q,l])"
    and steps: "(s,v) \<in> (csdp_step Sharp \<mu> R)\<^sup>*"
    and target: "v = sharp_term Sharp (Fun u11 [q',l'])"
  shows "l' = l \<and> (q,q') \<in> (csstep \<mu> R)\<^sup>*"
  using steps shape target
proof (induction arbitrary: q l rule: converse_rtrancl_induct)
  case base
  then show ?case using sharp_term_Sharp_inject by auto
next
  case (step s u)
  have source: "s = sharp_term Sharp (Fun u11 [q,l])"
    by (rule step.prems(1))
  from sharp_csdp_step_u11_guard[
      OF wf fresh frozen step.hyps(1)[unfolded source]]
  obtain q1 where u: "u = sharp_term Sharp (Fun u11 [q1,l])"
    and child: "(q,q1) \<in> csstep \<mu> R" .
  have tail: "l' = l \<and> (q1,q') \<in> (csstep \<mu> R)\<^sup>*"
    by (rule step.IH[OF u step.prems(2)])
  show ?case using child tail by auto
qed

lemma csr_guard_normal_pair_rank_csdp_length:
  assumes symbols: "distinct [a,u11,u21,u31,su,len,ni,co,ta]"
    and constructors: "distinct [z,su,len,ni,co,ta,zs]"
    and marked: "Sharp len \<notin> set [a,u11,u21,u31]"
    and wrappers: "Sharp len \<noteq> Sharp u11"
    and checked: "csr_guard_normal_rules_backward_eq
      a u11 u21 u31 z su len ni co ta zs R"
    and wf: "wf_trs R"
    and fresh: "\<And>f n. \<not> defined R (Sharp f,n)"
    and step: "(sharp_term Sharp (Fun len [l]),v) \<in> csdp_step Sharp \<mu> R"
    and target: "csr_guard_normal_pair_rank a u11 u21 u31
      (Sharp u11) (Sharp len) z su len ni co ta zs v = Some n"
  shows "csr_guard_normal_pair_rank a u11 u21 u31
      (Sharp u11) (Sharp len) z su len ni co ta zs
      (sharp_term Sharp (Fun len [l])) = Some n"
proof -
  from sharp_csdp_step_imp_csnrstep[OF wf fresh inj_Sharp step]
  obtain t where v: "v = sharp_term Sharp t"
    and st: "(Fun len [l],t) \<in> csnrstep \<mu> R"
    by blast
  have ex: "\<exists>i ts. i < length [l] \<and>
      i \<in> \<mu> (len,length [l]) \<and> t = Fun len ts \<and>
      length ts = length [l] \<and>
      ([l] ! i, ts ! i) \<in> csstep \<mu> R \<and>
      (\<forall>j<length [l]. j \<noteq> i \<longrightarrow> ts ! j = [l] ! j)"
  proof -
    from st show ?thesis
    proof (rule csnrstep_FunE)
      fix i ts
      assume i: "i < length [l]" "i \<in> \<mu> (len,length [l])"
        and t: "t = Fun len ts" and len_ts: "length ts = length [l]"
        and substep: "([l] ! i, ts ! i) \<in> csstep \<mu> R"
        and same: "\<And>j. j < length [l] \<Longrightarrow> j \<noteq> i \<Longrightarrow>
          ts ! j = [l] ! j"
      show ?thesis using i t len_ts substep same by blast
    qed
  qed
  then obtain i ts where i: "i < length [l]"
    and t: "t = Fun len ts" and len_ts: "length ts = length [l]"
    and substep: "([l] ! i, ts ! i) \<in> csstep \<mu> R"
    by blast
  have i0: "i = 0" using i by (cases i; simp_all)
  have shape: "t = Fun len [ts ! 0]"
    using t len_ts by (cases ts; auto)
  have target_rank:
      "csr_guard_normal_pair_rank a u11 u21 u31 (Sharp u11) (Sharp len)
        z su len ni co ta zs (sharp_term Sharp (Fun len [ts ! 0])) =
       csr_guard_normal_rank a u11 u21 u31 z su len ni co ta zs
        Guard_List (ts ! 0)"
    by (rule csr_guard_normal_pair_rank_sharp_length[OF symbols marked wrappers])
  have target_child: "csr_guard_normal_rank a u11 u21 u31
      z su len ni co ta zs Guard_List (ts ! 0) = Some n"
    using target v shape target_rank by simp
  have child_step: "(l,ts ! 0) \<in> csstep \<mu> R"
    using substep i0 by simp
  have source_child: "csr_guard_normal_rank a u11 u21 u31
      z su len ni co ta zs Guard_List l = Some n"
    by (rule csr_guard_normal_rules_csstep_backward[
        OF symbols constructors checked child_step target_child])
  have source_rank:
      "csr_guard_normal_pair_rank a u11 u21 u31 (Sharp u11) (Sharp len)
        z su len ni co ta zs (sharp_term Sharp (Fun len [l])) =
       csr_guard_normal_rank a u11 u21 u31 z su len ni co ta zs Guard_List l"
    by (rule csr_guard_normal_pair_rank_sharp_length[OF symbols marked wrappers])
  show ?thesis using source_rank source_child by simp
qed

lemma csr_guard_normal_pair_rank_csdp_steps_u11:
  assumes symbols: "distinct [a,u11,u21,u31,su,len,ni,co,ta]"
    and marked: "Sharp u11 \<notin> set [a,u11,u21,u31]"
    and wrappers: "Sharp u11 \<noteq> Sharp len"
    and wf: "wf_trs R"
    and fresh: "\<And>f n. \<not> defined R (Sharp f,n)"
    and frozen: "1 \<notin> \<mu> (u11,Suc (Suc 0))"
    and shape: "\<exists>q l. s = sharp_term Sharp (Fun u11 [q,l])"
    and steps: "(s,t) \<in> (csdp_step Sharp \<mu> R)\<^sup>*"
    and target: "csr_guard_normal_pair_rank a u11 u21 u31
      (Sharp u11) (Sharp len) z su len ni co ta zs t = Some n"
  shows "csr_guard_normal_pair_rank a u11 u21 u31
      (Sharp u11) (Sharp len) z su len ni co ta zs s = Some n"
  using steps shape target
proof (induction rule: converse_rtrancl_induct)
  case base
  then show ?case by simp
next
  case (step s u)
  from step.prems(1) obtain q l where
    s: "s = sharp_term Sharp (Fun u11 [q,l])" by blast
  from sharp_csdp_step_Fun_shape[OF wf fresh step.hyps(1)[unfolded s]]
  obtain ts where u: "u = sharp_term Sharp (Fun u11 ts)"
    and len_ts: "length ts = length [q,l]" .
  have ts_shape: "ts = [ts ! 0,ts ! 1]"
    using len_ts by (cases ts; cases "tl ts"; auto)
  have u_shape: "\<exists>q l. u = sharp_term Sharp (Fun u11 [q,l])"
    by (rule exI[of _ "ts ! 0"], rule exI[of _ "ts ! 1"],
        use u ts_shape in simp)
  have u_rank: "csr_guard_normal_pair_rank a u11 u21 u31
      (Sharp u11) (Sharp len) z su len ni co ta zs u = Some n"
    by (rule step.IH[OF u_shape step.prems(2)])
  have eq: "csr_guard_normal_pair_rank a u11 u21 u31
      (Sharp u11) (Sharp len) z su len ni co ta zs u =
    csr_guard_normal_pair_rank a u11 u21 u31
      (Sharp u11) (Sharp len) z su len ni co ta zs s"
    unfolding s by (rule csr_guard_normal_pair_rank_csdp_u11[
        OF symbols marked wrappers wf fresh frozen step.hyps(1)[unfolded s]])
  show ?case using eq u_rank by simp
qed

