        snd (csr_guard_strict_pair (Sharp len) co (Sharp u11)
          a listp natp N L) \<cdot> \<tau>)
      \<in> csr_guard_normal_pair_rank_gt a u11 u21 u31
        (Sharp u11) (Sharp len) z su len ni co ta zs"
      by (rule csr_guard_strict_pair_instance_gt[
          where listp = listp and natp = natp and N = N and L = L and \<sigma> = \<tau>,
          OF rank_symbols marked_u11 marked_len wrappers ranked])
    show ?thesis using strict u v by simp
  qed
qed

definition csr_guard_pair_rank_gt where
  "csr_guard_pair_rank_gt u11s lens z su len ni co ta zs =
    {(s,t). \<exists>m n.
      csr_guard_pair_rank u11s lens z su len ni co ta zs s = Some m \<and>
      csr_guard_pair_rank u11s lens z su len ni co ta zs t = Some n \<and> m > n}"

definition csr_guard_pair_rank_ge where
  "csr_guard_pair_rank_ge u11s lens z su len ni co ta zs =
    {(s,t). \<exists>m n.
      csr_guard_pair_rank u11s lens z su len ni co ta zs s = Some m \<and>
      csr_guard_pair_rank u11s lens z su len ni co ta zs t = Some n \<and> m \<ge> n}"

lemma csr_guard_normal_pair_rank_gt_ge_comp:
  "csr_guard_normal_pair_rank_gt a u11 u21 u31 u11s lens z su len ni co ta zs O
      csr_guard_normal_pair_rank_ge a u11 u21 u31 u11s lens z su len ni co ta zs
    \<subseteq> csr_guard_normal_pair_rank_gt a u11 u21 u31 u11s lens z su len ni co ta zs"
  unfolding csr_guard_normal_pair_rank_gt_def csr_guard_normal_pair_rank_ge_def by auto

lemma csr_guard_normal_pair_rank_ge_gt_comp:
  "csr_guard_normal_pair_rank_ge a u11 u21 u31 u11s lens z su len ni co ta zs O
      csr_guard_normal_pair_rank_gt a u11 u21 u31 u11s lens z su len ni co ta zs
    \<subseteq> csr_guard_normal_pair_rank_gt a u11 u21 u31 u11s lens z su len ni co ta zs"
  unfolding csr_guard_normal_pair_rank_gt_def csr_guard_normal_pair_rank_ge_def by auto

lemma csr_guard_normal_pair_rank_ge_trans:
  "trans (csr_guard_normal_pair_rank_ge
      a u11 u21 u31 u11s lens z su len ni co ta zs)"
  unfolding trans_def csr_guard_normal_pair_rank_ge_def by auto

lemma SN_csr_guard_normal_pair_rank_gt:
  "SN (csr_guard_normal_pair_rank_gt
      a u11 u21 u31 u11s lens z su len ni co ta zs)"
proof -
  have sub: "csr_guard_normal_pair_rank_gt
      a u11 u21 u31 u11s lens z su len ni co ta zs
      \<subseteq> inv_image {(m,n). m > n}
        (the \<circ> csr_guard_normal_pair_rank
          a u11 u21 u31 u11s lens z su len ni co ta zs)"
    unfolding csr_guard_normal_pair_rank_gt_def inv_image_def by auto
  have "SN (inv_image {(m,n). m > n}
      (the \<circ> csr_guard_normal_pair_rank
        a u11 u21 u31 u11s lens z su len ni co ta zs))"
    by (rule SN_inv_image[OF SN_nat_gt])
  then show ?thesis by (rule SN_subset[OF _ sub])
qed

lemma SN_rel_csr_guard_normal_pair_rank:
  "SN_rel
    (csr_guard_normal_pair_rank_gt a u11 u21 u31 u11s lens z su len ni co ta zs)
