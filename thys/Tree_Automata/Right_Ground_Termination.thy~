term "SN (rstep R)" (* termination of the rewrite-relation of a TRS R *)
       
find_theorems "SN" (* several facts on termination *)
find_theorems (200) SN_on (* even more on termination w.r.t. a set of starting objects *)
find_theorems (200) SN_on "_ :: nat \<Rightarrow> _" (* connection between termination
  and functions from nat to elements *)
