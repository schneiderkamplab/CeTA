find_theorems ground "_ :: (_,_)trs" (* search for facts on ground terms and
  TRSs. The second pattern means: anything that contains an expression of
  term-type. *)

thm rstep.induct (* induction-rule over terms that comes from the
  inductive definition of rstep *)

thm term.induct (* induction over terms *)
thm ctxt.induct (* induction over contexts *)

