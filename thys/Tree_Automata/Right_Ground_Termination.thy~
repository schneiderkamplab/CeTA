lemma "R \<noteq> {} \<Longrightarrow> rstep R \<noteq> {}" 
  sorry (* just assume this lemma (or some proof step) *)

typ "('f,'v)trs" (* the type of a TRS *)
typ "('f,'v)term" (* the type of a term with variable of type 'v and 
                     function symbols of type 'f *)
term rrstep (* a root-rewrite step *)

find_theorems (10) rstep rrstep (* in the output-panel you can inspect the 
  10 top-most known lemmas that contain both rstep and rrstep *)

