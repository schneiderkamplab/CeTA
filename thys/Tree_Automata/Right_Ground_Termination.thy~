theory Right_Ground_Termination
  imports 
    Rewriting.Trs (* abstract version *)
    Rewriting.Trs_Impl (* includes a few algorithms, e.g., compute one-step relation *)
begin

text \<open>Hints:
You can ctrl-click (cmd-click on Mac) 
