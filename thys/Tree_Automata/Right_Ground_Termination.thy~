find_theorems ideriv


(*https://stackoverflow.com/questions/28633353/converting-a-set-to-a-list-in-isabelle *)
fun set_to_list :: "'a set \<Rightarrow> 'a list" where
"set_to_list s = (SOME l. set l = s)"

fun list_to_set :: "'a list \<Rightarrow> 'a set" where
"list_to_set [] = {}"|
"list_to_set (x#xs) = {x} \<union> list_to_set xs"


fun right_ground::"(('f,'v) rule) \<Rightarrow> bool " where
"right_ground (l,r) = ground r"

fun right_ground_TRS :: "('f, 'v) trs \<Rightarrow> bool " where 
"right_ground_TRS x = Ball x (right_ground)"

fun is_subterm :: "('f,'v) rule \<Rightarrow> bool" where
"is_subterm (s,t) = s \<lhd> t"


inductive_set rhs_tuple :: "_ \<Rightarrow> ('f,'v) rule set" for R :: "('f, 'v) trs"
  where
  rhs_tuple: "\<And>r. (_, r) \<in> R \<Longrightarrow> (r,r) \<in> rhs_tuple R"


fun rewrite_tuple :: "('f,'v) rule set \<Rightarrow>  ('f, 'v) rule \<Rightarrow> ('f,'v) rule set" where
"rewrite_tuple rs (r,t) = {(r,t_i) . t_i \<in> list_to_set (rewrite (set_to_list rs) t)}"

fun rewrite_tuple_v2 :: "('f,'v) rules \<Rightarrow> ('f,'v) rule \<Rightarrow> ('f,'v) rules" where
"rewrite_tuple_v2 rs (r,t) = [(r,t_i) . t_i \<leftarrow> (rewrite rs t)]"


fun init :: "('f,'v) rule set \<Rightarrow> ('f,'v) rule set" where
"init R =  \<Union>( rewrite_tuple R ` rhs_tuple R )"


fun advance_sequence :: " ('f,'v) rules \<Rightarrow> ('f,'v) rules \<Rightarrow> ('f,'v) rules" where
"advance_sequence R [] = []" |
"advance_sequence R (x#xs) = (rewrite_tuple_v2 R x)  @ (advance_sequence R xs)"

function right_ground_termination_step :: "('f, 'v) rules \<Rightarrow> ('f, 'v) rules \<Rightarrow> bool" where
"right_ground_termination_step T S = 
  (if S = []
  then True
  else
    (if (find is_subterm S) = None
    then right_ground_termination_step T ( advance_sequence T S)
    else False
    ) 
  )"
  by auto
 

fun right_ground_termination :: "('f, 'v) trs \<Rightarrow> bool" where
"right_ground_termination T = 
  (if right_ground_TRS T
  then right_ground_termination_step (set_to_list T) (set_to_list (init T))
  else False)"

end