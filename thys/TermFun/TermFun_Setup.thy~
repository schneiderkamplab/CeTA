setup \<open>
let
  fun quote (Const (@{const_name emb_const}, _) $ Const (n, _)) =
      SOME (@{term "Fun :: string \<Rightarrow> (string,string) term list \<Rightarrow> (string,string) term"} $ HOLogic.mk_string n)
    | quote _ = NONE

  fun unquote (Const (@{const_name Term.Fun}, _) $ n) =
      ((SOME (Const (@{const_name emb_const}, dummyT)
        $ Const(HOLogic.dest_string n, dummyT)))
      handle TERM _ => NONE)
    | unquote _ = NONE

  fun rew f ts ctxt =
    let 
      val thy = Proof_Context.theory_of ctxt
      val ts' = map (Pattern.rewrite_term thy [] [f]) ts
    in
      if forall (aconv) (ts ~~ ts') then NONE
      else SOME (ts', ctxt)
    end
in
   Context.theory_map 
    (Syntax_Phases.term_check' ~1 "quote_funs" (rew quote)
    #> Syntax_Phases.term_uncheck' 1 "quote_funs" (rew unquote)) 
end
\<close>

lemma length_eqI: "length xs = length ys \<Longrightarrow> length (x#xs) = length (y#ys)"
  by auto

lemma pairwiseI1: "\<forall>i<length []. P i"
  and pairwiseI2: "(x, y) \<in> R
  \<Longrightarrow> \<forall>i<length xs. (xs ! i, ys ! i) \<in> R
  \<Longrightarrow> \<forall>i<length (x#xs). ((x#xs) ! i, (y#ys) ! i) \<in> R"
  by auto (case_tac i, auto)

lemma list_memberI1: "x \<in> set (x # xs)"
  and list_memberI2: "y \<in> set xs \<Longrightarrow> y \<in> set (x # xs)"
  by auto

lemma fixes f shows inv_imageI: "(f a, f b) \<in> R \<Longrightarrow> (a, b) \<in> inv_image R f"
  by auto

lemmas into_ctxt_closure =  subsetD[OF ctxt.subset_closure]

abbreviation (input) def_prefix :: "char" where "def_prefix \<equiv> CHR ''d''"
abbreviation (input) con_prefix :: "char" where "con_prefix \<equiv> CHR ''c''"

abbreviation (input) tf_Defs :: "string set" where "tf_Defs \<equiv> {f . f \<noteq> [] \<and> hd f = def_prefix}"
definition tf_Q :: "(string,string)terms" where "tf_Q \<equiv> {Fun f ts | f ts. f \<in> tf_Defs}"
abbreviation (input) tf_QL :: "(string,string)term list" where "tf_QL \<equiv> []"

definition map_constructor :: "(string,string)term \<Rightarrow> (string,string)term"
  where "map_constructor \<equiv> map_funs_term (Cons con_prefix)"

lemma map_constructor_Fun[simp]: "map_constructor (Fun f ts) = Fun (Cons con_prefix f) (map map_constructor ts)"
  unfolding map_constructor_def by simp

definition check_constructor :: "(string,string)term \<Rightarrow> bool"
  where "check_constructor \<equiv> \<lambda> t. funs_term t \<inter> tf_Defs = {}"

lemma check_constructor_map_constructor[simp]: "check_constructor (map_constructor t)"
  unfolding check_constructor_def map_constructor_def
  by (induction t, auto)

lemma check_constructor_fun[simp]: "check_constructor (Fun f ts) = ((f = [] \<or> hd f \<noteq> def_prefix) \<and> Ball (set ts) check_constructor)"
  unfolding check_constructor_def by auto

lemmas check_constructor_simps = check_constructor_map_constructor check_constructor_fun

lemma check_constructor_NF: assumes check: "check_constructor t"
  shows "t \<in> NF_terms tf_Q"
proof
  fix C l \<sigma>
  assume "l \<in> tf_Q" and t: "t = C \<langle> l \<cdot> \<sigma> \<rangle>" 
  from this[unfolded tf_Q_def] obtain f ls where l: "l = Fun f ls" and f: "f \<in> tf_Defs" by auto
  have "(f,length ls) \<in> funas_term t" unfolding t l by simp
  then have ft: "f \<in> funs_term t" unfolding funs_term_funas_term by force
  with check[unfolded check_constructor_def] f show False by auto
qed

abbreviation dp_step :: "(string,string)trs \<Rightarrow> (string,string)trs"
  where "dp_step P \<equiv> rqrstep True tf_Q P \<inter> NF_terms tf_Q \<times> UNIV"    

lemma tf_Q_rqrstepI: assumes lr: "(l,r) \<in> R"
  and no_defs: "Ball (set (args (l \<cdot> \<sigma>))) check_constructor \<and> Ball (set (map \<sigma> (vars_rule_list (l,r)))) check_constructor"
  shows "(l \<cdot> \<sigma>, r \<cdot> \<sigma>) \<in> rqrstep True tf_Q R"
  by (rule rqrstepI[OF _ lr refl refl], unfold NF_terms_args_conv[symmetric] NF_subst_def,
  insert no_defs, auto intro: check_constructor_NF)

lemma tf_Q_qrstepI: assumes lr: "(l,r) \<in> R"
  and no_defs: "Ball (set (args (l \<cdot> \<sigma>))) check_constructor \<and> Ball (set (map \<sigma> (vars_rule_list (l,r)))) check_constructor"
  shows "(l \<cdot> \<sigma>, r \<cdot> \<sigma>) \<in> qrstep True tf_Q R"
  using tf_Q_rqrstepI[OF lr no_defs] unfolding qrstep_iff_rqrstep_or_nrqrstep by auto

lemma dp_stepI: assumes lr: "(l,r) \<in> P"
  and no_defs: "check_constructor (l \<cdot> \<sigma>) \<and> Ball (set (map \<sigma> (vars_rule_list (l,r)))) check_constructor"
    (is "?a \<and> ?b")
  shows "(l \<cdot> \<sigma>, r \<cdot> \<sigma>) \<in> dp_step P"
proof -
  from no_defs have "Ball (set (args (l \<cdot> \<sigma>))) check_constructor" (is ?c)
    by (cases "l \<cdot> \<sigma>", auto)
  with no_defs have "?c \<and> ?b" and "?a" by auto
  from tf_Q_rqrstepI[OF lr this(1)] check_constructor_NF[OF \<open>?a\<close>]
  show ?thesis by simp
qed

