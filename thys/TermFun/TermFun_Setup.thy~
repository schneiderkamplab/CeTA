abbreviation "sub_steps R \<equiv> (supt \<union> qrstep True tf_Q R)^*"

definition "dpr_step P R \<equiv> relto (dp_step P) (qrstep True tf_Q R)"

lemma finite_dpp_imp_SN_dpr_step: assumes "finite_dpp (True,False,P,{},tf_Q,{},R)"
  shows "SN (dpr_step P R)" unfolding dpr_step_def
proof 
  fix f
  let ?R = "qrstep True tf_Q R"
  let ?P = "dp_step P"
  let ?RP = "?R^* O ?P O ?R^*"
  assume steps: "\<forall> i. (f i, f (Suc i)) \<in> ?RP"
  then have "\<forall> i. \<exists> u v. (f i, u) \<in> ?R^* \<and> (u,v) \<in> ?P \<and> (v, f (Suc i)) \<in> ?R^*" by blast
  from choice[OF this] obtain u where "\<forall> i. \<exists> v. (f i, u i) \<in> ?R^* \<and> (u i,v) \<in> ?P \<and> (v, f (Suc i)) \<in> ?R^*" by blast
  from choice[OF this] obtain v where bef: "\<And> i. (f i, u i) \<in> ?R^*" and step: "\<And> i. (u i,v i) \<in> ?P" and aft: "\<And> i. (v i, f (Suc i)) \<in> ?R^*" by blast  
  {
    fix i
    from step[of i, unfolded rqrstep_def]
    have
    "\<exists> l r \<sigma> . (l, r) \<in> P \<and> u i = l \<cdot> \<sigma> \<and> v i = r \<cdot> \<sigma> \<and> NF_subst True (l, r) \<sigma> tf_Q" by auto
  }
  from choice[OF allI[OF this]] obtain l 
    where "\<forall> i. \<exists> r \<sigma> . (l i, r) \<in> P \<and> u i = l i \<cdot> \<sigma> \<and> v i = r \<cdot> \<sigma> \<and> NF_subst True (l i, r) \<sigma> tf_Q" ..
  from choice[OF this] obtain r
    where "\<forall> i. \<exists> \<sigma> . (l i, r i) \<in> P \<and> u i = l i \<cdot> \<sigma> \<and> v i = r i \<cdot> \<sigma> \<and> NF_subst True (l i, r i) \<sigma> tf_Q" ..
  from choice[OF this] obtain \<sigma>
    where P: "\<And> i. (l i, r i) \<in> P" and u: "\<And> i. u i = l i \<cdot> \<sigma> i" 
      and v: "\<And> i. v i = r i \<cdot> \<sigma> i" and nfs: "\<And> i. NF_subst True (l i, r i) (\<sigma> i) tf_Q" 
    by blast
  {
    fix i
    from step[of i] u[of i] have nf: "l i \<cdot> \<sigma> i \<in> NF_terms tf_Q" by auto
    from aft[of i] bef[of "Suc i"] have "(r i \<cdot> \<sigma> i, l (Suc i) \<cdot> \<sigma> (Suc i)) \<in> ?R^*" unfolding u v by auto
    note nf this
  } note NF_steps = this
  have "QDP_Framework.ichain (True,False,P,{},tf_Q,{},R) l r \<sigma>" unfolding QDP_Framework.ichain.simps
    using P NF_steps nfs by auto
  with assms show False unfolding finite_dpp_def by auto
qed

abbreviation "dpr_steps P R \<equiv> (dp_step P \<union> qrstep True tf_Q R)^*"

lemma qterm_relI_initial:
  "(x, y) \<in> qrstep True tf_Q R \<Longrightarrow> (y, z) \<in> sub_steps R \<Longrightarrow> (x,z) \<in> (supt \<union> qrstep True tf_Q R)^+"
  by (rule rtrancl_into_trancl2) (rule UnI2)

lemma dp_qterm_relI_initial:
  "(x, y) \<in> dp_step P \<Longrightarrow> (y, z) \<in> dpr_steps P R \<Longrightarrow> (x,z) \<in> (dpr_step P R)^+"
  unfolding relto_trancl_conv dpr_step_def by blast

lemma dp_SN_dpr_step_trancl: "SN (dpr_step P R) \<Longrightarrow> SN ((dpr_step P R)^+)"
  by (rule SN_imp_SN_trancl)

lemma SN_supt_qrstep_trancl: "SN (qrstep True Q R) \<Longrightarrow> SN ((supt \<union> qrstep True Q R)^+)"
  using SN_imp_SN_trancl[OF SN_imp_SN_union_supt[OF _ ctxt_closed_qrstep], of True Q R] 
  unfolding Un_commute[of supt "qrstep True Q R"] .

lemma qterm_relI_step:
  "(x, y) \<in> qrstep True tf_Q R \<Longrightarrow> (y, z) \<in> sub_steps R \<Longrightarrow> (x,z) \<in> sub_steps R"
  by (rule converse_rtrancl_into_rtrancl) (rule UnI2)

lemma qterm_relI_steps:
  "(x, y) \<in> (qrstep True tf_Q R)^* \<Longrightarrow> (y, z) \<in> sub_steps R \<Longrightarrow> (x,z) \<in> sub_steps R"
  apply (rule rtrancl_trans)
  apply (rule subsetD[OF rtrancl_mono])
  by (rule Un_upper2)

lemma dp_qterm_relI_steps:
  assumes xy: "(x, y) \<in> (qrstep True tf_Q R)^*"
  and yz: "(y, z) \<in> dpr_steps P R"
  shows "(x,z) \<in> dpr_steps P R"
proof -
  have "(x,y) \<in> dpr_steps P R"
    by (rule set_mp[OF rtrancl_mono xy], auto)
  with yz show ?thesis by auto
qed

lemma qterm_relI_sub:
  "(x, y) \<in> supt \<Longrightarrow> (y, z) \<in> sub_steps R \<Longrightarrow> (x,z) \<in> sub_steps R"
  by (rule converse_rtrancl_into_rtrancl) (rule UnI1)

lemma finite_dpp_mono_tf_Q: assumes Q: "Q \<subseteq> tf_Q"
  and fin: "finite_dpp (nfs,False,P,Pw,Q,R,Rw)"
  shows "finite_dpp (nfs,False,P,Pw,tf_Q,R,Rw)"
  unfolding finite_dpp_def
proof (intro notI, elim exE)
  fix s t \<sigma>
  assume "min_ichain (nfs, False, P,Pw,tf_Q,R,Rw) s t \<sigma>"
  then have "QDP_Framework.ichain (nfs, False, P,Pw,tf_Q,R,Rw) s t \<sigma>" by simp
  from ichain_mono[OF this subset_refl subset_refl NF_terms_anti_mono[OF Q] subset_refl subset_refl]
  fin show False unfolding finite_dpp_def by auto
qed

lemma SN_trs_mono_tf_Q: assumes Q: "Q \<subseteq> tf_Q"
  and SN: "SN (qrstep True Q R)"
  shows "SN (qrstep True tf_Q R)"
  by (rule SN_subset[OF SN qrstep_NF_anti_mono[OF Q]])

  
